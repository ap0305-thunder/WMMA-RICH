(* ::Section::Initialization:: *)
(*(*(*(*generatePhotonEnergy*)*)*)*)


(* ::Input::Initialization:: *)
generatePhotonEnergy[rich`num_,minEne_:\[Epsilon][\[Lambda]MaxRef],maxEne_:\[Epsilon][\[Lambda]MinRef]]:=Module[{rich`w,photonEnergies,reNorma,solReNorma,p,q},
myNotebookInit`bigBanner[" SIMULATION - bad to fix ..... "];
miniBanner[" USING HERE THE DATA FROM LAST RUN OF calcDetectedPhotons "];
(*printD@whichRICH;printD@rad;printD@sensor;*)
Off[InterpolatingFunction::dmval];
Off[FindRoot::lstol];
rich`Private`debugPrint[" minEne = ",minEne," --- maxEne = ",maxEne];
reNorma=1;
If[(normalizedInterpolatedIntegratedYieldEne[maxEne]!=1)||(normalizedInterpolatedIntegratedYieldEne[minEne]!=0)
,
Print[" WARNING - renorma - normalizedInterpolatedIntegratedYieldEne[minEne] = ",normalizedInterpolatedIntegratedYieldEne[minEne]];
Print[" WARNING - renorma - normalizedInterpolatedIntegratedYieldEne[maxEne] = ",normalizedInterpolatedIntegratedYieldEne[maxEne]];
solReNorma=First@Solve[
p*normalizedInterpolatedIntegratedYieldEne[maxEne]+q==precisionify[1.0]
&&
p*normalizedInterpolatedIntegratedYieldEne[minEne]+q==precisionify[0.0]
,{p,q}
