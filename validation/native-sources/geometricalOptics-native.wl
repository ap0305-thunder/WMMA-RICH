fn[x_,y_,z_]:=(10r^2-r*x^2-5y^2-4z^2)
normalVector[fn_,x1_,y1_,z1_]:=Module[{nv,pt,func,tanpt,x,y,z},
func[x_,y_,z_]=fn[x,y,z];
nv={D[func[x,y],x],D[func[x,y],y],-1};
nv=nv/Norm[nv]/.{x->x1,y->y1};
pt={x1,y1,func[x1,y1]};
tanpt={x,y,z};
Return[Assuming[r>0,Simplify@nv]]
]
