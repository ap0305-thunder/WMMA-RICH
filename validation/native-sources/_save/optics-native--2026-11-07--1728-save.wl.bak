calcFlatSecMirFromLowerAngle[size_,tilt_,thetaMinSecMir_,p4z$local_]:=Module[{p,q,sol,
zSecMirMinVar,xSecMirMinVar,zSecMirMaxVar,xSecMirMaxVar,
zSecMirMin,xSecMirMin,zSecMirMax,xSecMirMax,zSecMir,xSecMir,
thetaMinSecMir2
},
