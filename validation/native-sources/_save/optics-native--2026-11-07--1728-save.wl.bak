(* ::Subsubtitle:: *)
(*optics geometry printout/export*)


(* ::Input:: *)
(*ClearAll[deg,mm,normal2,tangent2,rot2,closedPolygon,transverseRangeFromAperture,thirdDimRangeFromAperture,transverseExtentFromAperture,thirdDimExtentFromAperture,flatSegmentFromFullSize,sphericalSegmentFromAperture,shiftPointList,sphericalBandFromAperture,componentData,opticsComponentTable,opticsSideView,opticsApertureView,opticsGeometryReport,exportOpticsGeometry];*)
(**)
(*(*Small utilities*)*)
(**)
(*deg[a_]:=Quiet@N[a/Degree];*)
(*mm[x_]:=NumberForm[Quiet@N[x],{10,2}];*)
(*normal2[t_]:={Cos[t],Sin[t]};*)
(*tangent2[t_]:={-Sin[t],Cos[t]};*)
(*swapAxes[pts_]:=Reverse/@pts;*)
(*swapPoint[p_]:=Reverse[p];*)
(**)
(**)
(*(*Local surface coordinates:dn=displacement along surface normal dt=displacement along transverse(radial) coordinate Global side-view coordinates:{z,x}*)*)
(*rot2[{z0_,x0_},t_,{dn_,dt_}]:={z0,x0}+dn normal2[t]+dt tangent2[t];*)
(*closedPolygon[p_]:=If[First[p]===Last[p],p,Append[p,First[p]]];*)
(*transverseRangeFromAperture[apert_]:=Module[{qvals},qvals=apert[[All,1]];*)
(*{Min[qvals],Max[qvals]}];*)
(*thirdDimRangeFromAperture[apert_]:=Module[{uvals},uvals=apert[[All,2]];*)
(*{Min[uvals],Max[uvals]}];*)
(*transverseExtentFromAperture[apert_]:=Subtract@@Reverse[transverseRangeFromAperture[apert]];*)
(*thirdDimExtentFromAperture[apert_]:=Subtract@@Reverse[thirdDimRangeFromAperture[apert]];*)
(**)
(*(*Geometry construction*)*)
(**)
(*(*Flat mirrors and screens.In your definitions:SphericalMirror[...,{sizeTrnsvrs,sizeThrdDim},...] Screen[{sizeTrnsvrs,sizeThrdDim},...] sizeTrnsvrs and sizeThrdDim are full aperture sizes.Therefore the side-view segment runs from-sizeTrnsvrs/2 to+sizeTrnsvrs/2.*)*)
(*flatSegmentFromFullSize[z_,x_,t_,fullTransverseSize_]:=Module[{half=fullTransverseSize/2},{rot2[{z,x},t,{0,-half}],rot2[{z,x},t,{0,+half}]}];*)
(**)
(*(*Primary mirror side-view curve.The primary mirrors use real aperture polygons.Therefore the transverse(radial) range is taken from apertPriMirL/H,not from+/-sizeTrnsvrsPriMirL/H.*)*)
(*sphericalSegmentFromAperture[z_,x_,t_,radius_,apert_,n_:160]:=Module[{r=N[radius],qmin,qmax,qs,sag},{qmin,qmax}=transverseRangeFromAperture[apert];*)
(*qs=Subdivide[qmin,qmax,n];*)
(*Table[sag=Sqrt[Max[0,r^2-q^2]]-r;*)
(*rot2[{z,x},t,{sag,q}],{q,qs}]];*)
(**)
(*(*Shift a list of {z,x} points by a vector.This avoids Thread::tdlen from expressions like curve+offset.*)*)
(*shiftPointList[pts_,v_]:=(#+v)&/@pts;*)
