            RowBox[{"{", 
             
             RowBox[{"\"\<p (GeV/c)\>\"", 
              ",", "\"\<chrAngle @ \[Epsilon]Min\>\"", 
              ",", "\"\<chrAngle @ \[Epsilon]Max\>\""}], "}"}]}], "]"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"localHisto", "=", 
