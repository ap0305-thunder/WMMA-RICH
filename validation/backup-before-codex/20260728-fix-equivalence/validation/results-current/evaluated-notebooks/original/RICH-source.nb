     RowBox[{
      RowBox[{
      "myNotebookInit`bigBanner", "[", "\"\< sensor not relevant here \>\"", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"printD", "[", "fileNameTagRichRad", "]"}], ";", 
      "\[IndentingNewLine]", 
