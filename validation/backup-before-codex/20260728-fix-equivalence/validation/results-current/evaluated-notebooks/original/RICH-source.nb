      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"If", " ", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"whichRICH", "==", "xyz"}], " ", "&&", " ", 
          RowBox[{"rad", "==", "abc"}]}], ","}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"pMin", "=", "10"}], ";", "\[IndentingNewLine]", 
      RowBox[{"pMax", "=", "101"}], ";", "\[IndentingNewLine]", 
