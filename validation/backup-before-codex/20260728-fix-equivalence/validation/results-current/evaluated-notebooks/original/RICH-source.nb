      RowBox[{"(*", 
       RowBox[{"]", ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
      "miniBanner", 
       "[", "\"\< p (GeV/c)   ---|---   chrAngle at \[Epsilon]Min   ---|---   \
chrAngle at \[Epsilon]Max \>\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ttt", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
