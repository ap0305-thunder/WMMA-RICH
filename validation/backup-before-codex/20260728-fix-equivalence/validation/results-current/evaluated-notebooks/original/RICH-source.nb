            RowBox[{"tCAllPart", "[", 
             RowBox[{"p", ",", "\[Epsilon]Max"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", "pMin", ",", "pMax", ",", "10"}], "}"}]}], 
