                    RowBox[{"ItemStyle", "->", "\"\<Text\>\""}], ",", 
                    RowBox[{"Background", "->", 
                    RowBox[{"{", 
                    RowBox[{"{", "None", "}"}], "}"}]}]}], "]"}], "}"}], 
                  "]"}]}], "}"}], "]"}]}], ")"}]}], ")"}]}]}], "]"}]}], 
      "]"}]}], "\[IndentingNewLine]", "]"}], ";"}], "*)"}]], "Input",
