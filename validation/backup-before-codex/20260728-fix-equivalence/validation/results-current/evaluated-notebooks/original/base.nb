Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "sortByColumn", " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"ClearAll", "[", "sortByColumn", "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"https", ":"}], "//", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"mathematica", ".", "stackexchange", ".", "com"}], "/", 
         "questions"}], "/", "2934"}], "/", "sort"}], "-", "data", "-", 
      "after", "-", "specific", "-", "ordering", "-", "ascending", "-", 
      "descending", "-", "in", "-", "multiple", "-", "columns"}]}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sortByColumn", "::", "usage"}], 
     "=", "\"\<Arguments: [Table, Direction, Priority]. \nReturns the list \
sorted by the directions for each column specified in `Direction`. \nFor \
ascending order, use `1`, and for descending order, use `-1`. \nFor sorting \
more than one column, input `Direction` as a list. For example, \
Direction={-1,1} will sort the first column in descending order followed by \
the second column in ascending order, ignoring any other column. To sort on \
the second column, use {0,1} for the syntax.\nWhen sorting two or more \
columns, you can provide the `Priority` for which column should be sorted \
first. For example, `sortByColumn[data,{-1,1},{1,2}]`\nwould sort first in \
ascending order on the second column (because it has a higher priority) and \
then in descending order on the first column.\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sortByColumn", "[", 
      RowBox[{
       RowBox[{"list_", "?", "MatrixQ"}], ",", 
       RowBox[{"dir", ":", 
        RowBox[{"_Integer", "|", 
         RowBox[{"{", "__Integer", "}"}]}]}], ",", 
       RowBox[{"priority_", ":", " ", 
        RowBox[{"{", "}"}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"l", "=", 
          RowBox[{"Length", "@", 
           RowBox[{"list", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "All"}], "]"}], "]"}]}]}], ",", "w", ",", "p", 
         ",", "d"}], "}"}], ",", 
       RowBox[{
        RowBox[{"w", "=", 
         RowBox[{"Reverse", "@", 
          RowBox[{"Range", "@", "l"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"p", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "@", "priority"}], ">", "0"}], ",", 
           RowBox[{"PadRight", "[", 
            RowBox[{
             RowBox[{"Flatten", "@", 
              RowBox[{"{", "priority", "}"}]}], ",", "l"}], "]"}], ",", 
           RowBox[{"p", "=", 
            RowBox[{"Range", "@", "l"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"w", "=", 
         RowBox[{"w", "[", 
          RowBox[{"[", 
           RowBox[{"Ordering", "@", "p"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"d", "=", 
         RowBox[{"PadRight", "[", 
          RowBox[{
           RowBox[{"Flatten", "@", 
            RowBox[{"{", "dir", "}"}]}], ",", "l"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Sort", "[", 
         RowBox[{"list", ",", 
          RowBox[{
           RowBox[{"NonNegative", "@", 
            RowBox[{"Total", "[", 
             RowBox[{"(", 
              RowBox[{"w", " ", "d", " ", 
               RowBox[{"MapThread", "[", 
                RowBox[{"Order", ",", 
                 RowBox[{"{", "##", "}"}]}], "]"}]}], ")"}], "]"}]}], "&"}]}],
          "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
 InitializationCell->True,
 InitializationGroup->True,
 CellLabel->
  "7/27/26 20:09:17  \
In[253]:=",ExpressionUUID->"193c552f-f30c-0249-baa5-902760c3002d"]
