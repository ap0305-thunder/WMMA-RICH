Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cleanText", "[", 
    RowBox[{"text_", ",", 
     RowBox[{"outChar_", ":", "\"\<\>\""}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", "test", ",", "toClean"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"toClean", "=", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Whitespace", "\[Rule]", "outChar"}], ",", 
         RowBox[{"PunctuationCharacter", "\[Rule]", "outChar"}], ",", 
         RowBox[{"\"\< \>\"", "\[Rule]", "outChar"}], ",", 
         RowBox[{"\"\<\[NonBreakingSpace]\>\"", "\[Rule]", "outChar"}], ",", 
         RowBox[{"\"\<'\>\"", "\[Rule]", "outChar"}], ",", 
         RowBox[{"\"\<-\>\"", "\[Rule]", "outChar"}], ",", 
         RowBox[{"\"\<(\>\"", "\[Rule]", "outChar"}], ",", 
         RowBox[{"\"\<)\>\"", "\[Rule]", "outChar"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"name", "=", 
       RowBox[{"StringTrim", "[", 
        RowBox[{"RemoveDiacritics", "[", "text", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"name", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"name", ",", "toClean"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"BELOW", " ", "NOT", " ", "NEEDED"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{"LetterQ", ",", "name"}], "]"}], ",", 
          RowBox[{
           RowBox[{"#", "==", "False"}], "&"}]}], "]"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"test", "=", 
       RowBox[{"Extract", "[", 
        RowBox[{"name", ",", 
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{"LetterQ", ",", "name"}], "]"}], ",", "False"}], "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"test", "\[Equal]", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"debugPrint", "[", "\"\< Cleanup OK \>\"", "]"}], ",", 
        RowBox[{"debugPrint", "[", 
         RowBox[{"\"\< we have a problem cleaning-up text \>\"", ",", 
          "test"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "name", "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"normalizeString", "[", "w_", "]"}], ":=", 
   RowBox[{"cleanText", "[", 
    RowBox[{
     RowBox[{"Capitalize", "[", 
      RowBox[{
       RowBox[{"ToLowerCase", "[", 
        RowBox[{"cleanText", "[", 
         RowBox[{"w", ",", "\"\< \>\""}], "]"}], "]"}], 
       ",", "\"\<AllWords\>\""}], "]"}], ",", "\"\<\>\""}], "]"}]}], 
  ";"}]}], "Input",
 InitializationCell->True,
 InitializationGroup->True,
