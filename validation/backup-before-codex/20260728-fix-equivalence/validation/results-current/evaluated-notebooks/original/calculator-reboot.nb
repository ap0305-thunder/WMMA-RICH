     RowBox[{"(*", 
      RowBox[{"(*", "OK", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"fiducialAreaOfTheRing2", "[", 
         RowBox[{"r_", ",", 
          RowBox[{"\[Delta]r_", ":", "0"}], ",", 
          RowBox[{"\[Alpha]_", ":", "1"}]}], "]"}], ":=", 
        RowBox[{"Simplify", "@", 
