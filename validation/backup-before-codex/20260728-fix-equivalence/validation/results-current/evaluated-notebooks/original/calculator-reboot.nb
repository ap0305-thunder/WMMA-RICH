    RowBox[{"(*", " ", 
     RowBox[{"bckgPerArea", " ", 
      RowBox[{"background", "/", "area"}]}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fiducialAreaOfTheRing", "[", 
      RowBox[{"radius_", ",", "\[Delta]r_", ",", 
       RowBox[{"\[Alpha]_", ":", "1"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", "rVar"}], "}"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{"\[Alpha]", "*", 
             RowBox[{"(", 
              RowBox[{"2", "*", "\[Pi]", "*", "r"}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", "radius", ",", "rVar"}], "}"}]}], "]"}], "/.", 
          RowBox[{"rVar", "->", 
           RowBox[{"radius", "+", "\[Delta]r"}]}]}], "]"}], "]"}]}], "]"}]}], 
    ";", 
    RowBox[{"(*", 
     RowBox[{"r", ">", "0"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"\[Alpha]", " ", 
       RowBox[{"TBD", ":", " ", 
        RowBox[{"if", " ", "\[Alpha]"}]}]}], "=", 
      RowBox[{"1", " ", "it", " ", "is", " ", "the", " ", "area"}]}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"fiducialAreaOfTheRing", "[", 
      RowBox[{"r", ",", "\[Delta]r", ",", "\[Alpha]"}], "]"}], "]"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Unprotect", "[", "fiducialAreaOfTheRing", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "fiducialAreaOfTheRing", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", "\[Delta]r", ",", "r1", ",", "r2"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"middle", " ", 
         RowBox[{"radius", "!"}]}]}], "*)"}], 
