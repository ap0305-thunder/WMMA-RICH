Cell["\<\
y[b, n0] = ArcCos[0.999511239004127/b]
FullSimplify[Series[y[b, n0], {b, 1, 3}]] = SeriesData[b, 1, \
{ArcCos[1000000/1000489], 31.97256556230077, -16373.869386053886, \
1.6743584541018749*^7}, 0, 4, 1]
FullSimplify[Rationalize[Normal[Series[y[b, n], {b, 1, 3}]] /. b -> beta[\
\[Gamma]]]] = ArcSec[n] + (-1 + beta[\[Gamma]])/(Sqrt[1 - n^(-2)]*n) - (n*(-1 \
+ 2*n^2)*(-1 + beta[\[Gamma]])^2)/(2*Sqrt[n^2]*(-1 + n^2)^(3/2)) + (n*(2 - \
5*n^2 + 6*n^4)*(-1 + beta[\[Gamma]])^3)/(6*Sqrt[n^2]*(-1 + n^2)^(5/2))\
\>", "Print",
