Cell["\<\
fullRationalize[numRelPhoNoConditions] = numRelPho[beta[\[Gamma]], n]
gammaOverThr = \[Gamma] /. Solve[numRelPho[beta[\[Gamma]], n] == 1/100 && n > \
1 && \[Gamma] > n/Sqrt[-1 + n^2] && 0 < \[Nu] < 1, \[Gamma], Reals]
gamma1 = \[Gamma] /. Solve[numRelPho[beta[\[Gamma]], n] == 1/10 && n > 1 && \
\[Gamma] > n/Sqrt[-1 + n^2] && 0 < \[Nu] < 1, \[Gamma], Reals]
gammaHalf = \[Gamma] /. Solve[numRelPho[beta[\[Gamma]], n] == 1/2 && n > 1 && \
\[Gamma] > n/Sqrt[-1 + n^2] && 0 < \[Nu] < 1, \[Gamma], Reals]
gamma9 = \[Gamma] /. Solve[numRelPho[beta[\[Gamma]], n] == 9/10 && n > 1 && \
\[Gamma] > n/Sqrt[-1 + n^2] && 0 < \[Nu] < 1, \[Gamma], Reals]
gammaAsym = \[Gamma] /. Solve[numRelPho[beta[\[Gamma]], n] == 99/100 && n > 1 \
&& \[Gamma] > n/Sqrt[-1 + n^2] && 0 < \[Nu] < 1, \[Gamma], Reals]
gammaVal[f] = \[Gamma] /. Solve[f == numRelPho[beta[\[Gamma]], n] && n > 1 && \
\[Gamma] > n/Sqrt[-1 + n^2] && 0 < f < 1, \[Gamma], Reals]
FullSimplify[gammaOverThr/fullRationalize[gamThr[n]]] = (\[Gamma] /. \
Solve[100*numRelPho[beta[\[Gamma]], n] == 1 && n > 1 && \[Gamma] > n/Sqrt[-1 \
+ n^2] && 0 < \[Nu] < 1, \[Gamma], Reals])/gamThr[n]\
\>", "Print",
