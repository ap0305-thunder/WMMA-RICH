Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"theTrue", ",", "theObs"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WithCleanup", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Print", "@", 
      RowBox[{"PDF", "[", 
       RowBox[{
        RowBox[{"PoissonDistribution", "[", "\[Mu]", "]"}], ",", "k"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gg0", "=", 
      RowBox[{"PDF", "[", 
       RowBox[{
        RowBox[{"PoissonDistribution", "[", "\[Mu]", "]"}], ",", "0"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gg1", "=", 
      RowBox[{"1", "-", 
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"PoissonDistribution", "[", "\[Mu]", "]"}], ",", "0"}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"theTrue", "[", "obs_", "]"}], ":=", 
      RowBox[{"\[Mu]", "/.", 
       RowBox[{"First", "@", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"gg1", "==", "obs"}], ",", "\[Mu]", ",", "Reals"}], 
         "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"theObs", "[", "true_", "]"}], ":=", 
      RowBox[{"gg1", "/.", 
       RowBox[{"\[Mu]", "->", "true"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "@", 
      RowBox[{"theTrue", "[", "obs", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "@", 
      RowBox[{"theObs", "[", "true", "]"}]}]}], "\[IndentingNewLine]", ",", 
    "\[IndentingNewLine]", 
