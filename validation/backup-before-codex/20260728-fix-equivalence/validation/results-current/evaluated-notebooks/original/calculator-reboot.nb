Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "checkedStageResult", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"checkedStageResult", ",", "HoldFirst"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"checkedStageResult", "[", 
   RowBox[{
   "calculation_", ",", "stage_String", ",", "expectedLength_Integer"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "result", "}"}], ",", 
    RowBox[{
     RowBox[{"result", "=", 
      RowBox[{"CheckAbort", "[", 
       RowBox[{"calculation", ",", 
        RowBox[{"Failure", "[", 
         RowBox[{"\"\<StageAborted\>\"", ",", 
          RowBox[{"<|", 
           RowBox[{"\"\<Stage\>\"", "->", "stage"}], "|>"}]}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"FailureQ", "[", "result", "]"}], ",", "result", ",", 
       RowBox[{
        RowBox[{"result", "===", "$Failed"}], "||", 
        RowBox[{"result", "===", "$Aborted"}]}], ",", 
       RowBox[{"Failure", "[", 
        RowBox[{"\"\<StageFailed\>\"", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Stage\>\"", "->", "stage"}], ",", 
           RowBox[{"\"\<Result\>\"", "->", "result"}]}], "|>"}]}], "]"}], ",", 
       RowBox[{"!", 
        RowBox[{"ListQ", "[", "result", "]"}]}], ",", 
       RowBox[{"Failure", "[", 
        RowBox[{"\"\<InvalidStageResult\>\"", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Stage\>\"", "->", "stage"}], ",", 
           RowBox[{"\"\<ExpectedHead\>\"", "->", "List"}], ",", 
           RowBox[{"\"\<ActualHead\>\"", "->", 
            RowBox[{"Head", "[", "result", "]"}]}], ",", 
           RowBox[{"\"\<Result\>\"", "->", "result"}]}], "|>"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"Length", "[", "result", "]"}], "=!=", "expectedLength"}], ",", 
       RowBox[{"Failure", "[", 
        RowBox[{"\"\<InvalidStageLength\>\"", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Stage\>\"", "->", "stage"}], ",", 
           RowBox[{"\"\<ExpectedLength\>\"", "->", "expectedLength"}], ",", 
           RowBox[{"\"\<ActualLength\>\"", "->", 
            RowBox[{"Length", "[", "result", "]"}]}]}], "|>"}]}], "]"}], ",", 
       RowBox[{"!", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"result", ",", 
          RowBox[{"Indeterminate", "|", "ComplexInfinity", "|", 
           RowBox[{"DirectedInfinity", "[", "_", "]"}], "|", "_Missing"}]}], 
         "]"}]}], ",", 
       RowBox[{"Failure", "[", 
        RowBox[{"\"\<InvalidStageValue\>\"", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Stage\>\"", "->", "stage"}], ",", 
           RowBox[{"\"\<Result\>\"", "->", "result"}]}], "|>"}]}], "]"}], ",",
        "True", ",", "result"}], "]"}]}]}], "]"}]}]}], "Input",
