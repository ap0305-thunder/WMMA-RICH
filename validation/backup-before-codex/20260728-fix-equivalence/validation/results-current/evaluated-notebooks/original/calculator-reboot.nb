        RowBox[{"full", " ", "range"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fiducialAreaOfTheRing", "[", 
        RowBox[{"r_", ",", 
         RowBox[{"\[Delta]r_", ":", "0"}], ",", 
         RowBox[{"\[Alpha]_", ":", "1"}]}], "]"}], ":=", 
       RowBox[{"Simplify", "@", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"QuantityMagnitude", "[", 
            RowBox[{"r", "-", 
             RowBox[{"\[Delta]r", "/", "2"}]}], "]"}], ">", "0"}], ",", 
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Alpha]", "*", "\[Pi]", 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["r2", "2"], "-", 
                SuperscriptBox["r1", "2"]}], ")"}]}], "/.", 
             RowBox[{"r2", "->", 
              RowBox[{"(", 
               RowBox[{"r", "+", 
                RowBox[{"\[Delta]r", "/", "2"}]}], ")"}]}]}], "/.", 
            RowBox[{"r1", "->", 
             RowBox[{"(", 
              RowBox[{"r", "-", 
               RowBox[{"\[Delta]r", "/", "2"}]}], ")"}]}]}], "]"}], ",", 
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Alpha]", "*", "\[Pi]", 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["r2", "2"], "-", 
                SuperscriptBox["r1", "2"]}], ")"}]}], "/.", 
             RowBox[{"r2", "->", 
              RowBox[{"(", 
               RowBox[{"r", "+", 
                RowBox[{"\[Delta]r", "/", "2"}]}], ")"}]}]}], "/.", 
            RowBox[{"r1", "->", "0"}]}], "]"}]}], "]"}]}]}]}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "@", 
        RowBox[{"Simplify", "[", 
