Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"finiteRealQ", ",", "momentumThresholdFromScan"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"finiteRealQ", "[", "value_", "]"}], ":=", 
    RowBox[{
     RowBox[{"NumericQ", "[", "value", "]"}], "&&", 
     RowBox[{"FreeQ", "[", 
      RowBox[{"value", ",", 
       RowBox[{"Indeterminate", "|", "ComplexInfinity", "|", 
        RowBox[{"DirectedInfinity", "[", "_", "]"}], "|", "_Missing"}]}], 
      "]"}], "&&", 
     RowBox[{"TrueQ", "[", 
      RowBox[{"PossibleZeroQ", "[", 
       RowBox[{"Im", "[", 
        RowBox[{"N", "[", "value", "]"}], "]"}], "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"momentumThresholdFromScan", "[", 
   RowBox[{"scan_", ",", 
    RowBox[{"target_", "?", "NumericQ"}], ",", "momentumColumn_Integer", ",", 
    "significanceColumn_Integer", ",", "particle_String"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "data", ",", "significances", ",", "significanceRange", ",", 
      "interpolator", ",", "threshold"}], "}"}], ",", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"!", 
         RowBox[{"ListQ", "[", "scan", "]"}]}], "||", 
        RowBox[{"scan", "===", 
         RowBox[{"{", "}"}]}], "||", 
        RowBox[{"!", 
         RowBox[{"MatrixQ", "[", "scan", "]"}]}], "||", 
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"First", "[", "scan", "]"}], "]"}], "<", 
         RowBox[{"Max", "[", 
          RowBox[{"momentumColumn", ",", "significanceColumn"}], "]"}]}]}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"Failure", "[", 
         RowBox[{"\"\<InvalidMomentumScan\>\"", ",", 
          RowBox[{"<|", 
           RowBox[{"\"\<Particle\>\"", "->", "particle"}], "|>"}]}], "]"}], 
        "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Interpolation", " ", 
       RowBox[{"data", ":", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"significance", ",", "momentum"}], "}"}], "."}]}]}], "*)"}], 
     RowBox[{"data", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "significanceColumn", "]"}], "]"}], ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "momentumColumn", "]"}], "]"}]}], "}"}], "&"}], "/@", 
       "scan"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"MatrixQ", "[", 
         RowBox[{"data", ",", "finiteRealQ"}], "]"}]}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"Failure", "[", 
         RowBox[{"\"\<NonNumericMomentumScan\>\"", ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Particle\>\"", "->", "particle"}], ",", 
            RowBox[{"\"\<Data\>\"", "->", "data"}]}], "|>"}]}], "]"}], 
        "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"significances", "=", 
      RowBox[{"data", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"DuplicateFreeQ", "[", "significances", "]"}]}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"Failure", "[", 
         RowBox[{"\"\<DuplicateSignificanceValues\>\"", ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Particle\>\"", "->", "particle"}], ",", 
            RowBox[{"\"\<Significances\>\"", "->", "significances"}]}], 
           "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"The", " ", "inverse", " ", "significance"}], "->", 
       RowBox[{
        RowBox[{"momentum", " ", "must", " ", "be", " ", "single"}], "-", 
        RowBox[{"valued", "."}]}]}], "*)"}], 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"!", 
