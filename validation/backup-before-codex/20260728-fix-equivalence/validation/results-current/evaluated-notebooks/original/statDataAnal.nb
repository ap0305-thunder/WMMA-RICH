Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"varlist", "=", 
     RowBox[{"ToExpression", "[", "variables", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"funct", "=", 
     RowBox[{"ToExpression", "[", "function", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"errorFunction", "[", 
     RowBox[{"variables", ",", "function"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"variables", ",", "\"\<{M,m}\>\""}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"function", ",", "\"\<g*(M-m)/(M+m)\>\""}], "}"}], ",", 
   RowBox[{"LabelStyle", "->", 
    RowBox[{"{", 
     RowBox[{"FontSize", "->", "17"}], "}"}]}], ",", 
   RowBox[{"AutoAction", "->", "False"}], ",", 
   RowBox[{"Initialization", ":>", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"errorFunction", "[", 
       RowBox[{"v_", ",", "theFunc_"}], "]"}], ":=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"varlist", "=", 
         RowBox[{"ToExpression", "[", "v", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"funct", "=", 
         RowBox[{"ToExpression", "[", "theFunc", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"varlength", "=", 
         RowBox[{"Length", "[", 
          RowBox[{"Variables", "[", "varlist", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"theoretical", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"(", 
           RowBox[{"Total", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"D", "[", 
                  RowBox[{"funct", ",", 
                   RowBox[{"Part", "[", 
                    RowBox[{"varlist", ",", "n"}], "]"}]}], "]"}], "*", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"U", ",", 
                   RowBox[{"Part", "[", 
                    RowBox[{"varlist", ",", "n"}], "]"}]}], "]"}]}], ")"}], "^",
                "2"}], ",", 
              RowBox[{"{", 
               RowBox[{"n", ",", "1", ",", "varlength"}], "}"}]}], "]"}], 
            "]"}], ")"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Part", "[", 
         RowBox[{"theoretical", ",", "1"}], "]"}], ";", "\[IndentingNewLine]",
         "varlist", ";", "\[IndentingNewLine]", 
        RowBox[{"uncert", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"U", ",", 
             RowBox[{"Part", "[", 
              RowBox[{"varlist", ",", "n"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", "varlength"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"uncert", "=", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{"uncert", ",", 
           RowBox[{"Alternatives", "@@", 
            RowBox[{"{", "0", "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"theoretical", "=", 
         RowBox[{"Simplify", "[", "theoretical", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"Grid", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"\"\<Variables\>\"", ",", "varlist"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"\"\<Uncertainties\>\"", ",", "uncert"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"\"\<Function\>\"", ",", "function"}], "}"}], ",", 
                 RowBox[{"{", 
                  
                  RowBox[{"\"\<Uncertainty Function\>\"", ",", 
                   "theoretical"}], "}"}]}], "}"}], ",", 
               RowBox[{"Alignment", "->", "Left"}], ",", 
               RowBox[{"Spacings", "->", 
                RowBox[{"{", 
                 RowBox[{"2", ",", "1"}], "}"}]}], ",", 
               RowBox[{"Frame", "->", "All"}], ",", 
               RowBox[{"ItemStyle", "->", 
                RowBox[{"{", 
                 RowBox[{"\"\<Text\>\"", ",", 
                  RowBox[{"FontSize", "->", "20"}]}], "}"}]}], ",", 
               RowBox[{"Background", "->", 
                RowBox[{"{", 
                 RowBox[{"{", 
                  RowBox[{"LightGray", ",", "None"}], "}"}], "}"}]}]}], "]"}],
              "}"}], "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"Grid", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"{", "\"\<Brian Gennow  March/24/2015\>\"", "}"}], 
