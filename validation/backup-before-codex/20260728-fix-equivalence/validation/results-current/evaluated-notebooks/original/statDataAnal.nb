Cell[OutputFormData["\<\
Manipulate[varlist = ToExpression[variables]; funct = ToExpression[function]; \
errorFunction[variables, function], {variables, {M,m}}, {function, \
g*(M-m)/(M+m)}, LabelStyle -> {FontSize -> 17}, AutoAction -> False, \
Initialization :> (errorFunction[v_, theFunc_] := (varlist = ToExpression[v]; \
funct = ToExpression[theFunc]; varlength = Length[Variables[varlist]]; \
theoretical = Sqrt[Total[Table[(D[funct, varlist[[n]]]*Subscript[U, \
varlist[[n]]])^2, {n, 1, varlength}]]]; theoretical[[1]]; varlist; uncert = \
Table[Subscript[U, varlist[[n]]], {n, 1, varlength}]; uncert = \
DeleteCases[uncert, Alternatives @@ {0}]; theoretical = \
Simplify[theoretical]; Column[{Grid[{{Variables, varlist}, {Uncertainties, \
uncert}, {Function, function}, {Uncertainty Function, theoretical}}, \
Alignment -> Left, Spacings -> {2, 1}, Frame -> All, ItemStyle -> {Text, \
FontSize -> 20}, Background -> {{LightGray, None}}], Grid[{{Brian Gennow  \
March/24/2015}}, Alignment -> Left, Spacings -> {2, 1}, ItemStyle -> Text, \
Background -> {{None}}]}]))]\
\>"], "Output",
 CellLabel->
  "7/27/26 20:16:58 ",ExpressionUUID->"37f2c6b3-f325-cc4b-853c-76b077311082"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "errorProp", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"errorProp", "[", 
    RowBox[{"func_", ",", "vars_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"derivs", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"Length", "[", "vars", "]"}], "}"}]}], "]"}]}], ",", 
       "funcErrorForm", ",", "funcEval", ",", "funcErrorEval", ",", 
       "rplcVals", ",", "rplcErrors"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"For", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ii", "=", "1"}], ",", 
         RowBox[{"ii", "<=", 
          RowBox[{"Length", "[", "vars", "]"}]}], ",", 
         RowBox[{"ii", "++"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"derivs", "[", 
            RowBox[{"[", "ii", "]"}], "]"}], "=", 
           RowBox[{"D", "[", 
            RowBox[{"func", ",", 
             RowBox[{"vars", "[", 
              RowBox[{"[", 
               RowBox[{"ii", ",", "1"}], "]"}], "]"}]}], "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"derivs", "[", 
          RowBox[{"[", "ii", "]"}], "]"}], "=", 
         RowBox[{"D", "[", 
          RowBox[{"func", ",", 
           RowBox[{"vars", "[", 
            RowBox[{"[", 
             RowBox[{"ii", ",", "1"}], "]"}], "]"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"ii", ",", "1", ",", 
          RowBox[{"Length", "[", "vars", "]"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"funcErrorForm", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"derivs", "[", 
              RowBox[{"[", "ii", "]"}], "]"}], "*", 
             RowBox[{"vars", "[", 
              RowBox[{"[", 
               RowBox[{"ii", ",", "3"}], "]"}], "]"}]}], ")"}], "^", "2"}], ",", 
          RowBox[{"{", 
           RowBox[{"ii", ",", 
            RowBox[{"Length", "[", "vars", "]"}]}], "}"}]}], "]"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"SetAttributes", "[", 
       RowBox[{"rplcVals", ",", "Listable"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rplcVals", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Evaluate", "[", 
           RowBox[{"vars", "[", 
            RowBox[{"[", 
             RowBox[{"ii", ",", "1"}], "]"}], "]"}], "]"}], ":>", 
          RowBox[{"Evaluate", "[", 
           RowBox[{"vars", "[", 
            RowBox[{"[", 
             RowBox[{"ii", ",", "2"}], "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", 
           RowBox[{"Length", "[", "vars", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SetAttributes", "[", 
       RowBox[{"rplcErrors", ",", "Listable"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rplcErrors", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Evaluate", "[", 
           RowBox[{"vars", "[", 
            RowBox[{"[", 
             RowBox[{"ii", ",", "3"}], "]"}], "]"}], "]"}], ":>", 
          RowBox[{"Evaluate", "[", 
           RowBox[{"vars", "[", 
            RowBox[{"[", 
             RowBox[{"ii", ",", "4"}], "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", 
           RowBox[{"Length", "[", "vars", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"funcEval", "=", 
       RowBox[{"func", "/.", " ", "rplcVals"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"funcErrorEval", "=", 
       RowBox[{
        RowBox[{"funcErrorForm", "/.", " ", "rplcVals"}], "/.", " ", 
        "rplcErrors"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{"funcErrorForm", ",", "funcEval", ",", "funcErrorEval"}], 
        "}"}], "]"}], ";"}]}], "]"}]}], ";"}]}], "Input",
