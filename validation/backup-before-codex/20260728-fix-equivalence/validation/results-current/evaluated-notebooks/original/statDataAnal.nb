            RowBox[{"-", "1"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"sigmaKurtosis", "=", 
            RowBox[{"-", "1"}]}]}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
