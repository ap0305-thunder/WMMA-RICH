               SuperscriptBox["\[Sigma]", "4"]}]}], " ", ")"}]}], ")"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nBootstrap", ">", "0"}], ",", "\[IndentingNewLine]", 
