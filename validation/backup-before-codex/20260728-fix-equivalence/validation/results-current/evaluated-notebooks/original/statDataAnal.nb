       "===", "===", "===", "===", "===", "===", "==="}], "="}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "@", "statsDisplay"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"statsDisplay", "[", 
      RowBox[{"z0_", ",", 
       RowBox[{"showOut_", ":", "True"}], ",", 
       RowBox[{"nBootstrap_", ":", "0"}], ",", 
       RowBox[{"nBins_", ":", "100"}], ",", 
       RowBox[{"title_", ":", "\"\<\>\""}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "num", ",", "cm1", ",", "cm2", ",", "cm3", ",", "cm4", ",", "z", ",", 
         "sigmaMedian", ",", "sigmaSkewness", ",", "sigmaKurtosis", ",", "nf",
          ",", "\[Mu]", ",", "\[Sigma]", ",", "sigmaMean", ",", 
         "sigmaSigma"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"nf", "[", "z_", "]"}], ":=", 
         RowBox[{"PaddedForm", "[", 
