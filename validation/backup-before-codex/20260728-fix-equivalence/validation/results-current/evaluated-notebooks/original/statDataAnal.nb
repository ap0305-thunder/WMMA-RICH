             ",", "\"\< \[PlusMinus] \>\"", ",", 
             RowBox[{"nf", "[", 
              RowBox[{"2", "*", "\[Sigma]", "*", "sigmaSigma"}], "]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
