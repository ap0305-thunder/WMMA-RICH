data elements OR die !!! \>\"", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< Stats :  # f data  =   \>\"", ",", "num"}], "]"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< Stats :  Mean      = \>\"", ",", 
             RowBox[{"nf", "[", "\[Mu]", "]"}], ",", "\"\< \[PlusMinus] \>\"",
              ",", 
             RowBox[{"nf", "[", "sigmaMean", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< Stats :  StdDev    = \>\"", ",", 
             RowBox[{"nf", "[", "\[Sigma]", "]"}], 
             ",", "\"\< \[PlusMinus] \>\"", ",", 
             RowBox[{"nf", "[", "sigmaSigma", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
