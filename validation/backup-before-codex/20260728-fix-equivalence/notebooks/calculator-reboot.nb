  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
     "validateDoSetExperimentConfig", "[", "theExperimentConfig_Association", 
      "]"}], " ", ":=", "\n", "  ", 
     RowBox[{"Module", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
