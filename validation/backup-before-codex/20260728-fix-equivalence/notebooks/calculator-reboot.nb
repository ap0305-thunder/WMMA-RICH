Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "runRICHOrAbort", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"runRICHOrAbort", ",", "HoldFirst"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"runRICHOrAbort", "[", 
    RowBox[{"calculation_", ",", "label_String"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "res", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"res", "=", 
       RowBox[{"CheckAbort", "[", 
        RowBox[{"calculation", ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<ABORTED during: \>\"", ",", "label"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"res", "===", "$Failed"}], "||", 
         RowBox[{"res", "===", "$Aborted"}], "||", 
         RowBox[{"FailureQ", "[", "res", "]"}], "||", 
         RowBox[{"!", 
          RowBox[{"ListQ", "[", "res", "]"}]}], "||", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "res", "]"}], "=!=", "lengthDataRecord"}], 
           "||"}], "*)"}], 
         RowBox[{"!", 
          RowBox[{"FreeQ", "[", 
           RowBox[{"res", ",", 
            RowBox[{"Indeterminate", "|", "ComplexInfinity", "|", 
             RowBox[{"DirectedInfinity", "[", "_", "]"}], "|", "_Missing"}]}],
            "]"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<INVALID RICH RESULT \[LongDash] aborting: \>\"", ",", 
           "label"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Result: \>\"", ",", "res"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Abort", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", "res"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
