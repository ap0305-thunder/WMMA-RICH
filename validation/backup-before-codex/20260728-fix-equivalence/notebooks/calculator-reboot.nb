Cell["fiducialAreaOfTheRing", \
"Subsection",ExpressionUUID->"ec8620d4-30dc-c64a-b259-a84bfb4ffe46"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "fiducialAreaOfTheRing", ",", "r", ",", "\[Delta]r", ",", "\[Alpha]"}], 
     "]"}], ";", 
    RowBox[{"(*", 
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"inner", " ", 
       RowBox[{"radius", "!"}]}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"bckgPerArea", " ", 
      RowBox[{"background", "/", "area"}]}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fiducialAreaOfTheRing", "[", 
      RowBox[{"radius_", ",", "\[Delta]r_", ",", 
       RowBox[{"\[Alpha]_", ":", "1"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", "rVar"}], "}"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{"\[Alpha]", "*", 
             RowBox[{"(", 
              RowBox[{"2", "*", "\[Pi]", "*", "r"}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", "radius", ",", "rVar"}], "}"}]}], "]"}], "/.", 
          RowBox[{"rVar", "->", 
           RowBox[{"radius", "+", "\[Delta]r"}]}]}], "]"}], "]"}]}], "]"}]}], 
    ";", 
    RowBox[{"(*", 
     RowBox[{"r", ">", "0"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"\[Alpha]", " ", 
       RowBox[{"TBD", ":", " ", 
        RowBox[{"if", " ", "\[Alpha]"}]}]}], "=", 
      RowBox[{"1", " ", "it", " ", "is", " ", "the", " ", "area"}]}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"fiducialAreaOfTheRing", "[", 
      RowBox[{"r", ",", "\[Delta]r", ",", "\[Alpha]"}], "]"}], "]"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Unprotect", "[", "fiducialAreaOfTheRing", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "fiducialAreaOfTheRing", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", "\[Delta]r", ",", "r1", ",", "r2"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"middle", " ", 
         RowBox[{"radius", "!"}]}]}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{"\[Delta]r", "=", 
        RowBox[{"full", " ", "range"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fiducialAreaOfTheRing", "[", 
        RowBox[{"r_", ",", 
         RowBox[{"\[Delta]r_", ":", "0"}], ",", 
         RowBox[{"\[Alpha]_", ":", "1"}]}], "]"}], ":=", 
       RowBox[{"Simplify", "@", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"QuantityMagnitude", "[", 
            RowBox[{"r", "-", 
             RowBox[{"\[Delta]r", "/", "2"}]}], "]"}], ">", "0"}], ",", 
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Alpha]", "*", "\[Pi]", 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["r2", "2"], "-", 
                SuperscriptBox["r1", "2"]}], ")"}]}], "/.", 
             RowBox[{"r2", "->", 
              RowBox[{"(", 
               RowBox[{"r", "+", 
                RowBox[{"\[Delta]r", "/", "2"}]}], ")"}]}]}], "/.", 
            RowBox[{"r1", "->", 
             RowBox[{"(", 
              RowBox[{"r", "-", 
               RowBox[{"\[Delta]r", "/", "2"}]}], ")"}]}]}], "]"}], ",", 
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Alpha]", "*", "\[Pi]", 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["r2", "2"], "-", 
                SuperscriptBox["r1", "2"]}], ")"}]}], "/.", 
             RowBox[{"r2", "->", 
              RowBox[{"(", 
               RowBox[{"r", "+", 
                RowBox[{"\[Delta]r", "/", "2"}]}], ")"}]}]}], "/.", 
            RowBox[{"r1", "->", "0"}]}], "]"}]}], "]"}]}]}]}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "@", 
        RowBox[{"Simplify", "[", 
         RowBox[{"fiducialAreaOfTheRing", "[", 
          RowBox[{"r", ",", "\[Delta]r", ",", "\[Alpha]"}], "]"}], "]"}]}], 
       ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"(*", "OK", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"fiducialAreaOfTheRing2", "[", 
         RowBox[{"r_", ",", 
          RowBox[{"\[Delta]r_", ":", "0"}], ",", 
          RowBox[{"\[Alpha]_", ":", "1"}]}], "]"}], ":=", 
        RowBox[{"Simplify", "@", 
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Alpha]", "*", "\[Pi]", 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["r2", "2"], "-", 
               SuperscriptBox["r1", "2"]}], ")"}]}], "/.", 
            RowBox[{"r2", "->", 
             RowBox[{"(", 
              RowBox[{"r", "+", 
               RowBox[{"\[Delta]r", "/", "2"}]}], ")"}]}]}], "/.", 
           RowBox[{"r1", "->", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"r", "-", 
                RowBox[{"\[Delta]r", "/", "2"}]}], ")"}], ",", "0"}], 
             "]"}]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "@", 
        RowBox[{"Simplify", "[", 
         RowBox[{"fiducialAreaOfTheRing2", "[", 
          RowBox[{"r", ",", "\[Delta]r", ",", "\[Alpha]"}], "]"}], "]"}]}]}], 
      "*)"}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
