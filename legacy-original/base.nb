Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"vLookup", "[", 
    RowBox[{
    "lookupVal_", ",", "targetTable_", ",", "targetCol_", ",", "pickCol_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rowMatch", ",", "matchVal", ",", "allMatchedValues", ",", "numMatches",
        ",", "jdMatchVal", ",", "\n", "jdNumMatch", ",", "\n", 
       "jdAllMatchVal", ",", "\n", "jdRowMatch"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"jdMatchVal", "=", "1"}], ";", "\[IndentingNewLine]", 
      RowBox[{"jdNumMatch", "=", "2"}], ";", "\[IndentingNewLine]", 
      RowBox[{"jdAllMatchVal", "=", "3"}], ";", "\[IndentingNewLine]", 
      RowBox[{"jdRowMatch", "=", "4"}], ";", " ", "\[IndentingNewLine]", 
      RowBox[{
      "debugPrint", 
       "[", "\"\< vLookup returns: { matchVal , numMatches , allMatchedValues \
, rowMatch } \>\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"rowMatch", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"targetTable", "\[LeftDoubleBracket]", 
           RowBox[{"All", ",", "targetCol"}], "\[RightDoubleBracket]"}], ",", 
          RowBox[{"n_", "/;", 
           RowBox[{"n", "\[Equal]", "lookupVal"}]}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "rowMatch", "]"}], "\[Equal]", "0"}], 
        "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", "\"\<n/a\>\"", "}"}], ",", "0"}], "}"}], "]"}], 
        "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"matchVal", "=", 
          RowBox[{"targetTable", "\[LeftDoubleBracket]", 
           RowBox[{"rowMatch", ",", 
            RowBox[{"targetCol", "+", "pickCol"}]}], 
           "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"numMatches", "=", 
          RowBox[{"Length", "[", "matchVal", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"allMatchedValues", "=", "matchVal"}], ";", 
         "\[IndentingNewLine]", 
