Cell[BoxData[
 RowBox[{"(*", "\n", 
  RowBox[{
   RowBox[{"ClearAll", "[", "removeDeclareContext", "]"}], ";", "\n", 
   RowBox[{
    RowBox[{"removeDeclareContext", "[", "context_String", "]"}], ":=", 
    RowBox[{
     RowBox[{"$NewSymbol", "::", "declarativeContexts"}], "=", 
     RowBox[{
      RowBox[{"StringDelete", "[", 
       RowBox[{
        RowBox[{"$NewSymbol", "::", "declarativeContexts"}], ",", 
        RowBox[{"\"\<|\>\"", "<>", "context"}]}], "]"}], "\[IndentingNewLine]", 
      RowBox[{"ClearAll", "[", "declareContext", "]"}]}]}]}], ";", "\n", 
   RowBox[{
    RowBox[{"declareContext", "[", "context_String", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"$NewSymbol", "::", "undeclared"}], 
        "=", "\"\<`1``2` was not previously declared.\>\""}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ValueQ", "[", 
           RowBox[{"$NewSymbol", "::", "declarativeContexts"}], "]"}], "\[Equal]",
           "False"}], ",", 
         RowBox[{
          RowBox[{"$NewSymbol", "::", "declarativeContexts"}], 
          "=", "\"\<\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"$NewSymbol", "::", "declarativeContexts"}], "=", 
        RowBox[{"StringJoin", "[", 
         RowBox[{
          RowBox[{"$NewSymbol", "::", "declarativeContexts"}], 
          ",", "\"\<|\>\"", ",", "context"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"$NewSymbol", ":=", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ContainsAny", "[", 
             RowBox[{
              RowBox[{"StringSplit", "[", 
               RowBox[{
                RowBox[{"$NewSymbol", "::", "declarativeContexts"}], 
                ",", "\"\<|\>\""}], "]"}], ",", 
              RowBox[{"{", "#2", "}"}]}], "]"}], "&&", 
            RowBox[{"ContainsNone", "[", 
             RowBox[{
              RowBox[{"Names", "[", 
               RowBox[{"#2", "<>", "\"\<*\>\""}], "]"}], ",", 
              RowBox[{"{", "#1", "}"}]}], "]"}]}], ",", 
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"$NewSymbol", "::", "undeclared"}], ",", "#2", ",", 
             "#1"}], "]"}]}], "]"}], "&"}]}]}]}], "]"}]}]}], "\n", 
  "*)"}]], "Input",
