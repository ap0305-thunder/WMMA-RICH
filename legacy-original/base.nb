Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tickFormat", "[", 
    RowBox[{"xmin_", ",", " ", "xmax_", ",", " ", "digits_", ",", " ", 
     RowBox[{"divisions_", ":", "10"}]}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{
    RowBox[{"Function", "[", "\n", "      ", 
     RowBox[{"tickNumber", "\n", "      ", ",", "\n", "      ", 
      RowBox[{"{", 
       RowBox[{"tickNumber", ",", " ", 
        RowBox[{"PaddedForm", "[", 
         RowBox[{
          RowBox[{"Round", "[", 
           RowBox[{"tickNumber", ",", " ", "0.01"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
