                    RowBox[{"Background", "->", 
                    RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{"LightGray", ",", "None"}], "}"}], "}"}]}]}], 
                    "]"}], "}"}], "]"}], ",", 
                 RowBox[{"Row", "[", 
                  RowBox[{"{", 
                   RowBox[{"Grid", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"{", "\"\<Brian Gennow  March/24/2015\>\"", "}"}],
                     "}"}], ",", 
                    RowBox[{"Alignment", "->", "Left"}], ",", 
                    RowBox[{"Spacings", "->", 
                    RowBox[{"{", 
                    RowBox[{"2", ",", "1"}], "}"}]}], ",", 
                    RowBox[{"ItemStyle", "->", "\"\<Text\>\""}], ",", 
                    RowBox[{"Background", "->", 
                    RowBox[{"{", 
                    RowBox[{"{", "None", "}"}], "}"}]}]}], "]"}], "}"}], 
                  "]"}]}], "}"}], "]"}]}], ")"}]}], ")"}]}]}], "]"}]}], 
      "]"}]}], "\[IndentingNewLine]", "]"}], ";"}], "*)"}]], "Input",
