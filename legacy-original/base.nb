Cell[BoxData[{
 RowBox[{
  RowBox[{"Unprotect", "[", "variableize", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "variableize", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"variableize", "[", 
    RowBox[{"text_", ",", 
     RowBox[{"prefix_", ":", "\"\<id\>\""}], ",", 
     RowBox[{"suffix_", ":", "\"\<\>\""}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Symbol", "[", 
       RowBox[{"StringJoin", "[", 
        RowBox[{"prefix", ",", 
         RowBox[{"StringReplace", "[", 
          RowBox[{
           RowBox[{"Capitalize", "[", 
            RowBox[{
             RowBox[{"ToLowerCase", "[", "text", "]"}], 
             ",", "\"\<AllWords\>\""}], "]"}], ",", 
           RowBox[{"Whitespace", "\[Rule]", "\"\<\>\""}]}], "]"}]}], "]"}], 
       "]"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Symbol", "[", "\[IndentingNewLine]", 
      RowBox[{"StringJoin", "[", "\[IndentingNewLine]", 
       RowBox[{"prefix", ",", "\[IndentingNewLine]", 
        RowBox[{"StringReplace", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "prefix", "]"}], "==", "0"}], ",", 
            RowBox[{"Decapitalize", "[", "text", "]"}], ",", 
            RowBox[{"Capitalize", "[", 
             RowBox[{"text", ",", "\"\<AllWords\>\""}], "]"}]}], "]"}], ",", 
          RowBox[{"Whitespace", "\[Rule]", "\"\<\>\""}]}], "]"}], ",", 
        "\[IndentingNewLine]", "suffix"}], "\[IndentingNewLine]", "]"}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"variableize", ",", "Listable"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Protect", "[", "variableize", "]"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"head", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<aaa\>\"", ",", "\"\< bbb \>\"", ",", "\"\<ccccc\>\"", 
       ",", "\"\< Ale\>\"", ",", "\"\<PPP\>\""}], "}"}]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
