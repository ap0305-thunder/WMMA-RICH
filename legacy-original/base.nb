Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sortMatrixRows", "[", 
    RowBox[{"matrix_", ",", "numCol_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"sll", "[", 
            RowBox[{
             RowBox[{"matrixCore", "[", "matrix", "]"}], ",", "numCol"}], 
            "]"}], ",", 
           RowBox[{
            RowBox[{"takeFirstRow", "[", "matrix", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"2", ";;", "All"}], "]"}], "]"}]}], "]"}], "]"}], ",", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Rest", "[", 
            RowBox[{"takeFirstCol", "[", "matrix", "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"Ordering", "[", 
             RowBox[{
              RowBox[{"matrixCore", "[", "matrix", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "numCol"}], "]"}], "]"}], "]"}], "]"}], 
           "]"}], ",", "\"\<\\\\\>\""}], "]"}]}], "]"}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sortMatrixCols", "[", 
    RowBox[{"matrix_", ",", "numRow_"}], "]"}], ":=", 
   RowBox[{"Transpose", "[", 
