Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"varlist", "=", 
     RowBox[{"ToExpression", "[", "variables", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"funct", "=", 
     RowBox[{"ToExpression", "[", "function", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"errorFunction", "[", 
     RowBox[{"variables", ",", "function"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"variables", ",", "\"\<{M,m}\>\""}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"function", ",", "\"\<g*(M-m)/(M+m)\>\""}], "}"}], ",", 
   RowBox[{"LabelStyle", "->", 
    RowBox[{"{", 
     RowBox[{"FontSize", "->", "17"}], "}"}]}], ",", 
   RowBox[{"AutoAction", "->", "False"}], ",", 
   RowBox[{"Initialization", ":>", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"errorFunction", "[", 
       RowBox[{"v_", ",", "theFunc_"}], "]"}], ":=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"varlist", "=", 
         RowBox[{"ToExpression", "[", "v", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"funct", "=", 
         RowBox[{"ToExpression", "[", "theFunc", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"varlength", "=", 
         RowBox[{"Length", "[", 
          RowBox[{"Variables", "[", "varlist", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"theoretical", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"(", 
           RowBox[{"Total", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"D", "[", 
                  RowBox[{"funct", ",", 
                   RowBox[{"Part", "[", 
                    RowBox[{"varlist", ",", "n"}], "]"}]}], "]"}], "*", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"U", ",", 
                   RowBox[{"Part", "[", 
                    RowBox[{"varlist", ",", "n"}], "]"}]}], "]"}]}], ")"}], "^",
                "2"}], ",", 
              RowBox[{"{", 
               RowBox[{"n", ",", "1", ",", "varlength"}], "}"}]}], "]"}], 
