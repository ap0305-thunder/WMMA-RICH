       RowBox[{"Length", "[", "hdr", "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lgd", ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Text", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"ltxt", "[", 
            RowBox[{"[", "#", "]"}], "]"}], ",", "Bold", ",", 
           RowBox[{"FontFamily", "->", "\"\<Courier\>\""}]}], "]"}], ",", 
         RowBox[{"Scaled", "[", 
          RowBox[{"{", 
           RowBox[{"0.9", ",", 
            RowBox[{"1", "-", 
             RowBox[{"0.04", "#"}]}]}], "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], "]"}], "&"}], "/@", 
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "hdr", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
