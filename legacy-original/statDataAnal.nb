   RowBox[{
    RowBox[{
     RowBox[{"displayHistoStats", "[", 
      RowBox[{"z0_", ",", "\[IndentingNewLine]", 
       RowBox[{"bspec", ":", 
        RowBox[{"(", 
         RowBox[{"_Integer", "|", "_List", "|", "Automatic"}], ")"}], ":", 
