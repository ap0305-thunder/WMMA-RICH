       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "==="}], "="}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "@", "statsDisplay"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"statsDisplay", "[", 
      RowBox[{"z0_", ",", 
       RowBox[{"showOut_", ":", "True"}], ",", 
       RowBox[{"nBootstrap_", ":", "0"}], ",", 
       RowBox[{"nBins_", ":", "100"}], ",", 
       RowBox[{"title_", ":", "\"\<\>\""}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "num", ",", "cm1", ",", "cm2", ",", "cm3", ",", "cm4", ",", "z", ",", 
         "sigmaMedian", ",", "sigmaSkewness", ",", "sigmaKurtosis", ",", "nf",
          ",", "\[Mu]", ",", "\[Sigma]", ",", "sigmaMean", ",", 
         "sigmaSigma"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"nf", "[", "z_", "]"}], ":=", 
         RowBox[{"PaddedForm", "[", 
          RowBox[{
           RowBox[{"N", "[", "z", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"10", ",", "6"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"num", "=", 
         RowBox[{"Length", "[", "z0", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"num", "<=", "3"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\< ERROR : only ******* \>\"", ",", "num", 
             ",", "\"\< ******* data: too few for all statistics here\>\""}], 
            "]"}], ";", 
           RowBox[{"Return", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"z", " ", "=", " ", 
         RowBox[{"N", "[", "z0", "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"Make", " ", "z", " ", 
          RowBox[{
           RowBox[{"Real", " ", "!!"}], "!"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"\[Mu]", "=", 
         RowBox[{"cm1", "=", 
          RowBox[{"Mean", "[", "z", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Sigma]", "=", 
         RowBox[{"cm2", "=", 
          RowBox[{"StandardDeviation", "[", "z", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cm3", "=", 
         RowBox[{"CentralMoment", "[", 
          RowBox[{"z", ",", "3"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"cm4", "=", 
         RowBox[{"CentralMoment", "[", 
          RowBox[{"z", ",", "4"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sigmaMean", "=", 
         RowBox[{"\[Sigma]", "/", 
          RowBox[{"\[Sqrt]", "num"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sigmaSigma", "=", 
         RowBox[{"\[Sqrt]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", 
              RowBox[{"(", 
               RowBox[{"4", "*", "num", "*", 
                SuperscriptBox["\[Sigma]", "2"]}], ")"}]}], ")"}], "*", 
            RowBox[{"(", 
             RowBox[{"cm4", "-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"num", "-", "3"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"num", "-", "1"}], ")"}]}], ")"}], 
               SuperscriptBox["\[Sigma]", "4"]}]}], " ", ")"}]}], ")"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nBootstrap", ">", "0"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"sigmaMedian", "=", 
            RowBox[{"bootstrap", "[", 
             RowBox[{"z", ",", "nBootstrap", ",", "Median"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"sigmaSkewness", "=", 
            RowBox[{"bootstrap", "[", 
             RowBox[{"z", ",", "nBootstrap", ",", "Skewness"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"sigmaKurtosis", "=", 
            RowBox[{"bootstrap", "[", 
             RowBox[{"z", ",", "nBootstrap", ",", "Kurtosis"}], "]"}]}]}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"sigmaMedian", "=", 
            RowBox[{"-", "1"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"sigmaSkewness", "=", 
            RowBox[{"-", "1"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"sigmaKurtosis", "=", 
            RowBox[{"-", "1"}]}]}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"showOut", "\[Equal]", "True"}], "\[IndentingNewLine]", ",",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
           "miniBanner", 
            "[", "\"\< Histogram statistics summary --- !!! Assume at least 5 \
data elements OR die !!! \>\"", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< Stats :  # f data  =   \>\"", ",", "num"}], "]"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< Stats :  Mean      = \>\"", ",", 
             RowBox[{"nf", "[", "\[Mu]", "]"}], ",", "\"\< \[PlusMinus] \>\"",
              ",", 
             RowBox[{"nf", "[", "sigmaMean", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< Stats :  StdDev    = \>\"", ",", 
             RowBox[{"nf", "[", "\[Sigma]", "]"}], 
             ",", "\"\< \[PlusMinus] \>\"", ",", 
             RowBox[{"nf", "[", "sigmaSigma", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< Stats :  Var       = \>\"", ",", 
             RowBox[{"nf", "[", 
              RowBox[{"\[Sigma]", "^", "2"}], "]"}], 
             ",", "\"\< \[PlusMinus] \>\"", ",", 
             RowBox[{"nf", "[", 
              RowBox[{"2", "*", "\[Sigma]", "*", "sigmaSigma"}], "]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< Stats :  Min       = \>\"", ",", 
             RowBox[{"nf", "[", 
              RowBox[{"Min", "[", "z", "]"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< Stats :  Max       = \>\"", ",", 
             RowBox[{"nf", "[", 
              RowBox[{"Max", "[", "z", "]"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< Stats :  Range     = \>\"", ",", 
             RowBox[{"nf", "[", 
              RowBox[{
               RowBox[{"Max", "[", "z", "]"}], "-", 
               RowBox[{"Min", "[", "z", "]"}]}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< Stats :  Sq. RMS   = \>\"", ",", 
             RowBox[{"nf", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Max", "[", "z", "]"}], "-", 
                 RowBox[{"Min", "[", "z", "]"}]}], ")"}], "/", 
               RowBox[{"Sqrt", "[", "12", "]"}]}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< Stats :  median    = \>\"", ",", 
             RowBox[{"nf", "[", 
              RowBox[{"Median", "[", "z", "]"}], "]"}], 
             ",", "\"\< \[PlusMinus]\>\"", ",", 
             RowBox[{"nf", "[", 
              RowBox[{"standardErrorOfSampleMedian", "[", "z", "]"}], "]"}], 
             ",", "\"\< (gaussian hypothesis)\>\""}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"nBootstrap", ">", "0"}], ",", 
             RowBox[{"Print", "[", 
              
              RowBox[{"\"\<                 Bootstrap median StdErr     =\>\"",
                ",", 
               RowBox[{"nf", "[", "sigmaMedian", "]"}]}], "]"}]}], "]"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< Stats :  skewness (naive)      = \>\"", ",", 
             RowBox[{"nf", "[", 
              RowBox[{"sampleSkewness", "[", "z", "]"}], "]"}], 
             ",", "\"\< \[PlusMinus]\>\"", ",", 
             RowBox[{"nf", "[", 
              RowBox[{"standardErrorOfSampleSkewness", "[", "z", "]"}], "]"}],
              ",", "\"\< (gaussian hypothesis)\>\""}], "]"}], ";", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"nBootstrap", ">", "0"}], ",", 
             RowBox[{"Print", "[", 
              
              RowBox[{"\"\<                 Bootstrap skewness StdErr   =\>\"",
                ",", 
               RowBox[{"nf", "[", "sigmaSkewness", "]"}]}], "]"}]}], "]"}], ";", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< Stats :  kurtosis (naive)      = \>\"", ",", 
             RowBox[{"nf", "[", 
              RowBox[{"sampleKurtosis", "[", "z", "]"}], "]"}], 
             ",", "\"\< \[PlusMinus]\>\"", ",", 
             RowBox[{"nf", "[", 
              RowBox[{"standardErrorOfSampleKurtosis", "[", "z", "]"}], "]"}],
              ",", "\"\< (gaussian hypothesis)\>\""}], "]"}], ";", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"nBootstrap", ">", "0"}], ",", 
             RowBox[{"Print", "[", 
              
              RowBox[{"\"\<                 Bootstrap kurtosis StdErr   =\>\"",
                ",", 
               RowBox[{"nf", "[", "sigmaKurtosis", "]"}]}], "]"}]}], 
            "]"}]}]}], 
         StyleBox["\[IndentingNewLine]",
          FontFamily->"Courier New",
          FontWeight->"Bold",
          FontColor->GrayLevel[0]], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Show", "[", 
