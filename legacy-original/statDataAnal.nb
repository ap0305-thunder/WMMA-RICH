           RowBox[{"Print", "[", 
            
            RowBox[{"\"\< !@#$% displayHistoStats : non positive \[Sigma] = \
\>\"", ",", "\[Sigma]", ",", "\"\<  // Return \>\""}], "]"}], ";", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
