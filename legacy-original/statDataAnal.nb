              ",", "\"\< (gaussian hypothesis)\>\""}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<                 Bootstrap skewness std error   = \>\
\"", ",", 
