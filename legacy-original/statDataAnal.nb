              ",", 
             RowBox[{"nfpm5", "[", 
              RowBox[{"standardErrorOfSampleKurtosis", "[", "z", "]"}], "]"}],
              ",", "\"\< (gaussian hypothesis)\>\""}], "]"}], ";", 
           "\[IndentingNewLine]", 
