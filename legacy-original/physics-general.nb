  "\[IndentingNewLine]", 
  RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"energy", "[", 
      RowBox[{"mass_", ",", "momentum_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", "mass", ")"}], "2"], "+", 
