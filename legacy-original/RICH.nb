Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{
   "(*", "*************************************************************************************************)"}\
],
   FontColor->RGBColor[0.5, 0, 0.5],
   Background->RGBColor[1., 0.4823529411764706, 1.]], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"ticks", ",", "ticks2", ",", "grids"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ticks", "[", 
      RowBox[{"min_", ",", "max_"}], "]"}], ":=", 
     RowBox[{"Join", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Style", "[", 
            RowBox[{"i", ",", "12"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{".04", ",", "0"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Ceiling", "[", "min", "]"}], ",", 
           RowBox[{"Floor", "[", "max", "]"}]}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"j", "+", ".5"}], ",", 
           RowBox[{"{", 
            RowBox[{".02", ",", "0"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Round", "[", "min", "]"}], ",", 
           RowBox[{"Round", "[", 
            RowBox[{"max", "-", "1"}], "]"}], ",", "1"}], "}"}]}], "]"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ticks2", "[", 
      RowBox[{"min_", ",", "max_"}], "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"EvenQ", "[", "i", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "i", ",", ".06", ",", "Red"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "i", ",", ".02", ",", "Blue"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Ceiling", "[", "min", "]"}], ",", 
         RowBox[{"Floor", "[", "max", "]"}], ",", "1"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"grids", "[", 
