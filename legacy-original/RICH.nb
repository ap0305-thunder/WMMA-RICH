   RowBox[{
    RowBox[{"doMonitorAllVariables", ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"symbolsNew", "=", 
         RowBox[{"Names", "[", "\"\<Global`*\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "@", "symbolsSave"}], ">", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"TableForm", "[", 
             RowBox[{"Sort", "[", 
              RowBox[{"Complement", "[", 
               RowBox[{"symbolsNew", ",", "symbolsSave"}], "]"}], "]"}], 
             "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Remove", "/@", 
           RowBox[{"Select", "[", 
