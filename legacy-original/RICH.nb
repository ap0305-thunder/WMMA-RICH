Cell[CellGroupData[{

Cell["Plot Cherenkov angle chromatic limits", "Section",
 InitializationCell->
  True,ExpressionUUID->"20483706-f8a1-0b45-b602-ba72cb9ffece"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "plotCherenkovAngleChromaticLimits", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plotCherenkovAngleChromaticLimits", "[", 
    RowBox[{
     RowBox[{"whichRICH_", ":", "0"}], ",", 
     RowBox[{"rad_", ":", "\"\<AIR\>\""}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "localHisto", ",", "ttt", ",", "pMin", ",", "pMax", ",", "thetaCMax"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
      "myNotebookInit`bigBanner", "[", "\"\< sensor not relevant here \>\"", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"printD", "[", "fileNameTagRichRad", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "To", " ", "define", " ", "limits", " ", "according", " ", "to", " ", 
         "experiment"}], " ", "//", " ", 
        RowBox[{"random", " ", "so", " ", "far"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"If", " ", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"whichRICH", "==", "xyz"}], " ", "&&", " ", 
          RowBox[{"rad", "==", "abc"}]}], ","}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"pMin", "=", "10"}], ";", "\[IndentingNewLine]", 
      RowBox[{"pMax", "=", "101"}], ";", "\[IndentingNewLine]", 
      RowBox[{"thetaCMax", "=", "60"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"]", ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
      "miniBanner", 
       "[", "\"\< p (GeV/c)   ---|---   chrAngle at \[Epsilon]Min   ---|---   \
chrAngle at \[Epsilon]Max \>\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ttt", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", 
           RowBox[{"nf", "@", 
            RowBox[{"tCAllPart", "[", 
             RowBox[{"p", ",", "\[Epsilon]Min"}], "]"}]}], ",", 
           RowBox[{"nf", "@", 
            RowBox[{"tCAllPart", "[", 
             RowBox[{"p", ",", "\[Epsilon]Max"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", "pMin", ",", "pMax", ",", "10"}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "@", 
       RowBox[{"ReplacePart", "[", 
        RowBox[{
         RowBox[{"Insert", "[", 
          RowBox[{
           RowBox[{"Grid", "[", "ttt", "]"}], ",", 
           RowBox[{"Alignment", "\[Rule]", "Center"}], ",", "2"}], "]"}], ",", 
         RowBox[{"1", "\[Rule]", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"First", "[", 
             RowBox[{"Grid", "[", "ttt", "]"}], "]"}], ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<p (GeV/c)\>\"", 
              ",", "\"\<chrAngle @ \[Epsilon]Min\>\"", 
              ",", "\"\<chrAngle @ \[Epsilon]Max\>\""}], "}"}]}], "]"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"localHisto", "=", 
       RowBox[{"LogLinearPlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"tCAllPart", "[", 
            RowBox[{"p", ",", "\[Epsilon]Min"}], "]"}], ",", 
           RowBox[{"tCAllPart", "[", 
            RowBox[{"p", ",", "\[Epsilon]Max"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", "pMin", ",", "pMax"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PlotRange", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"pMin", ",", "pMax"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "thetaCMax"}], "}"}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"ImageSize", "\[Rule]", "Large"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"AxesLabel", "\[Rule]", 
          RowBox[{"{", 
           
           RowBox[{"\"\<p (GeV/c)\>\"", 
            ",", "\"\<\!\(\*SubscriptBox[\(\[Theta]\), \(c\)]\) (mrad)\>\""}],
            "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
         "PlotLabel", "->", "\"\< emission - chromatic limits \>\""}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"\"\<C:\\\\TEMP\\\\chrErrLimitsVersusMomentum-\>\"", "<>", 
         "fileNameTagRichRad", "<>", "\"\<.pdf\>\""}], ",", "localHisto", 
        ",", "\"\<PDF\>\""}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
