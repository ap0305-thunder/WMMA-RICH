Cell[CellGroupData[{

Cell["generatePhotonEnergy", "Section",
 InitializationCell->
  True,ExpressionUUID->"c458bc41-dff2-4b4d-ae39-4be9f7f5b7f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"generatePhotonEnergy", "[", 
    RowBox[{"num_", ",", 
     RowBox[{"minEne_", ":", 
      RowBox[{"\[Epsilon]", "[", "\[Lambda]MaxRef", "]"}]}], ",", 
     RowBox[{"maxEne_", ":", 
      RowBox[{"\[Epsilon]", "[", "\[Lambda]MinRef", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "w", ",", "photonEnergies", ",", "reNorma", ",", "solReNorma", ",", "p",
        ",", "q"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
      "myNotebookInit`bigBanner", 
       "[", "\"\< SIMULATION - bad to fix ..... \>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
      "miniBanner", 
       "[", "\"\< USING HERE THE DATA FROM LAST RUN OF calcDetectedPhotons \>\
\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"printD", "@", "whichRICH"}], ";", 
        RowBox[{"printD", "@", "rad"}], ";", 
        RowBox[{"printD", "@", "sensor"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Off", "[", 
       RowBox[{"InterpolatingFunction", "::", "dmval"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Off", "[", 
       RowBox[{"FindRoot", "::", "lstol"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"debugPrint", "[", 
       RowBox[{"\"\< minEne = \>\"", ",", "minEne", 
        ",", "\"\< --- maxEne = \>\"", ",", "maxEne"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"reNorma", "=", "1"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
           "normalizedInterpolatedIntegratedYieldEne", "[", "maxEne", "]"}], "!=",
            "1"}], ")"}], "||", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
           "normalizedInterpolatedIntegratedYieldEne", "[", "minEne", "]"}], "!=",
            "0"}], ")"}]}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\< WARNING - renorma - \
normalizedInterpolatedIntegratedYieldEne[minEne] = \>\"", ",", 
           RowBox[{
           "normalizedInterpolatedIntegratedYieldEne", "[", "minEne", "]"}]}],
           "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\< WARNING - renorma - \
normalizedInterpolatedIntegratedYieldEne[maxEne] = \>\"", ",", 
           RowBox[{
           "normalizedInterpolatedIntegratedYieldEne", "[", "maxEne", "]"}]}],
           "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"solReNorma", "=", 
          RowBox[{"First", "@", 
           RowBox[{"Solve", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"p", "*", 
                 RowBox[{
                 "normalizedInterpolatedIntegratedYieldEne", "[", "maxEne", 
                  "]"}]}], "+", "q"}], "==", 
               RowBox[{"precisionify", "[", "1.0", "]"}]}], 
              "\[IndentingNewLine]", "&&", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"p", "*", 
                 RowBox[{
                 "normalizedInterpolatedIntegratedYieldEne", "[", "minEne", 
                  "]"}]}], "+", "q"}], "==", 
               RowBox[{"precisionify", "[", "0.0", "]"}]}]}], 
             "\[IndentingNewLine]", ",", 
             RowBox[{"{", 
              RowBox[{"p", ",", "q"}], "}"}]}], "\[IndentingNewLine]", 
            "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
          "reNormaNormalizedInterpolatedIntegratedYieldEne", "[", 
           "\[Epsilon]_", "]"}], "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"p", "*", 
              RowBox[{
              "normalizedInterpolatedIntegratedYieldEne", "[", "\[Epsilon]", 
               "]"}]}], "+", "q"}], ")"}], "/.", "solReNorma"}]}], ";", 
         RowBox[{"printD", "@", 
          RowBox[{
          "reNormaNormalizedInterpolatedIntegratedYieldEne", "[", "minEne", 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", 
          RowBox[{
          "reNormaNormalizedInterpolatedIntegratedYieldEne", "[", "maxEne", 
           "]"}]}]}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", "\"\< INFO - renorma - no renorma \>\"", "]"}],
          ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
          "reNormaNormalizedInterpolatedIntegratedYieldEne", "[", 
           "\[Epsilon]_", "]"}], "=", 
          RowBox[{
          "normalizedInterpolatedIntegratedYieldEne", "[", "\[Epsilon]", 
           "]"}]}]}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"photonEnergies", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"photonEnergies", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"w", "/.", 
          RowBox[{"FindRoot", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
              "reNormaNormalizedInterpolatedIntegratedYieldEne", "[", "w", 
               "]"}], ")"}], "==", "#"}], ",", 
            RowBox[{"{", 
             RowBox[{"w", ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"minEne", "+", "maxEne"}], ")"}], "/", "2"}], ",", 
              "minEne", ",", "maxEne"}], "}"}], "\[IndentingNewLine]", ",", 
            RowBox[{"WorkingPrecision", "->", "MachinePrecision"}], 
            "\[IndentingNewLine]", ",", 
            RowBox[{"PrecisionGoal", "->", "7"}], "\[IndentingNewLine]", ",", 
            RowBox[{"AccuracyGoal", "->", "7"}]}], "\[IndentingNewLine]", 
           "]"}]}], "&"}], "/@", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", "num"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"debugPrintD", "@", 
       RowBox[{"MinMax", "[", "photonEnergies", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"debugPrintD", "@", 
       RowBox[{"MinMax", "[", 
        RowBox[{"\[Lambda]", "[", "photonEnergies", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "@", 
       RowBox[{"Histogram", "@", 
        RowBox[{"\[Lambda]", "[", "photonEnergies", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"On", "[", 
       RowBox[{"InterpolatingFunction", "::", "dmval"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"On", "[", 
       RowBox[{"FindRoot", "::", "lstol"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "photonEnergies", "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellLabel->
  "5/7/26 14:50:11 \
In[630]:=",ExpressionUUID->"aea09e1d-6d46-468f-993c-877f980d73c1"]
}, Closed]],

