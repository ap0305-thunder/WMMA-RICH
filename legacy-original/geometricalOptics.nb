    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ========== cross-check must be zero                     \>\
\"", ",", 
      RowBox[{
       RowBox[{"Dot", "[", 
        RowBox[{"dirTheTrk", ",", 
         RowBox[{"Cross", "[", 
          RowBox[{"dirTheChrInnerAzimuth", ",", "dirTheChrOuterAzimuth"}], 
          "]"}]}], "]"}], "//", "blob"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ========== cross-check must be zero                     \>\
\"", ",", 
      RowBox[{
       RowBox[{"Dot", "[", 
        RowBox[{"eZ", ",", 
         RowBox[{"Cross", "[", 
