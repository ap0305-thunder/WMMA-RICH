Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Section", "::", "Initialization", "::"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Notebook", " ", "bootstrap", " ", 
    RowBox[{"(", 
     RowBox[{"WL", " ", "14.3"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dir", ",", "pkg"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dir", "=", 
        RowBox[{"Quiet", "@", 
         RowBox[{"NotebookDirectory", "[", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"StringQ", "[", "dir", "]"}]}], ",", 
         RowBox[{"dir", "=", "$HomeDirectory"}]}], "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"unsaved", " ", "notebook", " ", "fallback"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"pkg", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"dir", ",", "\"\<myNotebookInit.wl\>\""}], "}"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"FileExistsQ", "[", "pkg", "]"}]}], ",", 
         RowBox[{
          RowBox[{"MessageDialog", "[", 
           RowBox[{"\"\<Missing myNotebookInit.wl at:\\n\>\"", "<>", "pkg"}], 
           "]"}], ";", 
          RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Get", "[", "pkg", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "@", 
        RowBox[{"Column", "[", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Button", "[", 
            RowBox[{"\"\<Save a versioned copy\>\"", ",", 
             RowBox[{"myNotebookInit`saveVersionedCopy", "[", 
              RowBox[{"myNotebookInit`versionTAG", ",", "$dirSave"}], "]"}], ",", 
             RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], ",", 
           RowBox[{"Button", "[", 
            RowBox[{"\"\<Save a txt copy\>\"", ",", 
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"out", "=", 
                 RowBox[{"myNotebookInit`saveNotebookTextCopy", "[", "]"}]}], 
                "}"}], ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"StringQ", "[", "out", "]"}], ",", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<Saved: \>\"", ",", "out"}], "]"}]}], "]"}]}], 
              "]"}], ",", 
             RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], ",", 
           RowBox[{"Button", "[", 
            RowBox[{"\"\<List init code (prints)\>\"", ",", 
             RowBox[{"Print", "/@", 
              RowBox[{"myNotebookInit`listInitializationCells", "[", "]"}]}], 
             ",", 
             RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], ",", 
           RowBox[{"Button", "[", 
            RowBox[{"\"\<Highlight init cells\>\"", ",", 
             RowBox[{"myNotebookInit`selectInitializationCells", "[", "]"}], ",", 
             RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], ",", 
           RowBox[{"Button", "[", 
            RowBox[{"\"\<Mark ALL Input cells as initialization\>\"", ",", 
             RowBox[{
             "myNotebookInit`markInputCellsAsInitialization", "[", "True", 
              "]"}], ",", 
             RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], ",", 
           RowBox[{"Button", "[", 
            RowBox[{"\"\<Clear initialization on Input cells\>\"", ",", 
             RowBox[{
             "myNotebookInit`markInputCellsAsInitialization", "[", "False", 
              "]"}], ",", 
             RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], ",", 
           RowBox[{"Button", "[", 
            
            RowBox[{"\"\<Delete all empty cells\>\"", ",", 
             "myNotebookInit`deleteAllEmptyCellsInNotebook", ",", 
             RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], ",", 
           RowBox[{"Button", "[", 
            RowBox[{"\"\<Export all Output cells to PNG (notebook dir)\>\"", ",", 
             RowBox[{"myNotebookInit`saveAsPngAllOutputCells", "[", "]"}], ",", 
             RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], ",", 
           RowBox[{"Button", "[", 
            RowBox[{"\"\<Export all Output cells to PDF (notebook dir)\>\"", ",", 
             RowBox[{"myNotebookInit`saveAsPdfAllOutputCells", "[", "]"}], ",", 
             RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], ",", 
           RowBox[{"Button", "[", 
            RowBox[{"\"\<Show diagnostics\>\"", ",", 
             RowBox[{"myNotebookInit`showDiagnostics", "[", "]"}], ",", 
             RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Button", "[", 
            RowBox[{"\"\<Show error message cells\>\"", ",", 
             RowBox[{"Print", "[", 
              RowBox[{"Cells", "[", 
               RowBox[{"CellStyle", "->", 
                RowBox[{"{", 
                 RowBox[{"\"\<MSG\>\"", ",", "\"\<Message\>\""}], "}"}]}], 
               "]"}], "]"}], ",", 
             RowBox[{"Method", "->", "\"\<Preemptive\>\""}]}], "]"}]}], 
          "\[IndentingNewLine]", "}"}], "]"}]}]}]}], "\[IndentingNewLine]", 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Apply", " ", "default", " ", "options"}], "+", 
     RowBox[{"optional", " ", "stylesheet"}], "+", 
     RowBox[{"optional", " ", "session", " ", "init"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"myNotebookInit`applyNotebookDefaults", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"myNotebookInit`loadSessionInit", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"myNotebookInit`manageMyStyleNotebook", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "myNotebookInit`applyStyleSheetIfPresent", "[", "\"\<myStyle.nb\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"For", " ", "string", " ", "patterns"}], ",", 
     RowBox[{
     "Information", " ", "gives", " ", "a", " ", "clickable", " ", "list", " ",
       "of", " ", "matching", " ", 
      RowBox[{"symbols", ":"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Information", "[", 
    RowBox[{"\"\<myNotebookInit`*\>\"", ",", "\"\<Usage\>\""}], 
    "]"}]}]}]], "Input",
