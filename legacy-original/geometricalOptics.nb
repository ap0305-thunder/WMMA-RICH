Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "just", " ", "another", " ", "parametrization", " ", "of", " ", "the", " ",
      "ray"}], ",", " ", 
    RowBox[{"starting", " ", "from", " ", "the", " ", "calcPeriCentPnt"}]}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"thePeriAxis", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theRay1", "[", "s_", "]"}], "=", 
     RowBox[{"blob", "[", 
      RowBox[{"First", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"+", "thePeriAxis"}], "+", 
         RowBox[{"s", "*", "dirTheRay"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"rule", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{"Dot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"theRay0", "[", "t", "]"}], "-", 
          RowBox[{"theRay1", "[", "s", "]"}]}], ",", "dirTheRay"}], "]"}], 
       "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"theRay1", "[", "s", "]"}], "-", 
       RowBox[{"theRay0", "[", "t", "]"}]}], "/.", 
      RowBox[{"s", "->", 
       RowBox[{"t", "+", 
        RowBox[{"h", " ", 
         RowBox[{"Sin", "[", "\[Alpha]", "]"}]}]}]}]}], "//", "Simplify"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}]}]}]], "Input",
 CellLabel->
  "4/27/24 21:35:33 \
In[535]:=",ExpressionUUID->"4033efc0-dbb4-48cf-a451-feff9dea8249"],

