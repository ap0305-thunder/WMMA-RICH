Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"\[Alpha]", ",", "r", ",", "d", ",", "\[Phi]", ",", "\[Delta]"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xc", "=", "0"}], ";", 
  RowBox[{"yc", "=", "0"}], ";", 
  RowBox[{"zc", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ax", "=", "1"}], ";", 
  RowBox[{"ay", "=", "1"}], ";", 
  RowBox[{"az", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Assumptions", "=", "True"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"$Assumptions", "=", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"\[Alpha]", "|", "\[Delta]", "|", "d", "|", "r"}], ",", 
      "Reals"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"\[Pi]", "/", "2"}]}], "<", "\[Alpha]", "<", 
     RowBox[{
      RowBox[{"+", "\[Pi]"}], "/", "2"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"-", "\[Pi]"}], "<", "\[Phi]", "<=", 
     RowBox[{"+", "\[Pi]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"\[Pi]", "/", "2"}]}], "<", "\[Delta]", "<", 
     RowBox[{
      RowBox[{"+", "\[Pi]"}], "/", "2"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"0", "<", "r"}], ",", "\[IndentingNewLine]", 
    RowBox[{"0", "<", "d"}], ",", "\[IndentingNewLine]", 
    RowBox[{"d", "<", "r"}]}], "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Beta]", ":=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Pi]", "/", "2"}], "+", "\[Alpha]"}], ")"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"z", " ", "left"}], "-", "to", "-", "right"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"y", " ", "up"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"x", " ", "enters"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"p0", "=", 
  RowBox[{"d", "*", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", "\[Phi]", "]"}], ",", 
     RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", "0"}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dirTheRay", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"+", 
        RowBox[{"Sin", "[", "\[Alpha]", "]"}]}], 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Phi]", "+", "\[Delta]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"+", 
        RowBox[{"Sin", "[", "\[Alpha]", "]"}]}], 
       RowBox[{"Cos", "[", 
        RowBox[{"\[Phi]", "+", "\[Delta]"}], "]"}]}], ",", 
      RowBox[{"+", 
       RowBox[{"Cos", "[", "\[Alpha]", "]"}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"theRay", "[", "t_", "]"}], "=", 
   RowBox[{"blob", "[", 
    RowBox[{
     RowBox[{"First", "@", 
      RowBox[{"{", 
       RowBox[{"p0", "+", 
        RowBox[{"t", "*", "dirTheRay"}]}], "}"}]}], ",", "$Assumptions"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"theRay", "[", "t", "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol1", "=", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"theRay", "[", "t", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "-", "xc"}], ")"}], "2"], "/", 
        SuperscriptBox["ax", "2"]}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"theRay", "[", "t", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", "yc"}], ")"}], "2"], "/", 
        SuperscriptBox["ay", "2"]}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"theRay", "[", "t", "]"}], "[", 
            RowBox[{"[", "3", "]"}], "]"}], "-", "zc"}], ")"}], "2"], "/", 
        SuperscriptBox["az", "2"]}]}], "==", 
      SuperscriptBox["r", "2"]}], ",", 
     RowBox[{"{", "t", "}"}], ",", "Reals"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\< # of sol1 = \>\"", ",", 
    RowBox[{"Length", "@", "sol1"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t1", "=", 
   RowBox[{"TrigReduce", "@", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"t", "/.", 
       RowBox[{"blob", "@", 
        RowBox[{"Last", "@", "sol1"}]}]}], ",", "$Assumptions"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pntOnMir", "=", 
   RowBox[{"theRay", "[", "t1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pntOnMir", "//", "TableForm"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dirNormal", "=", 
   RowBox[{"blob", "[", 
    RowBox[{"Normalize", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xc", ",", "yc", ",", "zc"}], "}"}], "-", "pntOnMir"}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dirNormal", "//", "TableForm"}], "\n", 
  RowBox[{"(*", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dirReflectedRay", "=", 
   RowBox[{"blob", "[", 
    RowBox[{"reflect", "[", 
     RowBox[{"dirTheRay", ",", "dirNormal"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dirReflectedRay", "//", "TableForm"}], "\[IndentingNewLine]", 
