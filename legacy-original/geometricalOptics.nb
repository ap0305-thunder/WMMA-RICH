Cell[BoxData[
 TagBox[GridBox[{
    {
     ButtonBox["\<\"Save a versioned copy\"\>",
      Appearance->Automatic,
      ButtonFunction:>myNotebookInit`saveVersionedCopy[
       myNotebookInit`versionTAG, $CellContext`$dirSave],
      Evaluator->Automatic,
      Method->"Queued"]},
    {
     ButtonBox["\<\"Save a txt copy\"\>",
      Appearance->Automatic,
      ButtonFunction:>
       With[{$CellContext`out = myNotebookInit`saveNotebookTextCopy[]}, 
        If[
         StringQ[$CellContext`out], 
         Print["Saved: ", $CellContext`out]]],
      Evaluator->Automatic,
      Method->"Queued"]},
    {
     ButtonBox["\<\"List init code (prints)\"\>",
      Appearance->Automatic,
      ButtonFunction:>Map[Print, 
        myNotebookInit`listInitializationCells[]],
      Evaluator->Automatic,
      Method->"Queued"]},
    {
     ButtonBox["\<\"Highlight init cells\"\>",
      Appearance->Automatic,
      ButtonFunction:>myNotebookInit`selectInitializationCells[],
      Evaluator->Automatic,
      Method->"Queued"]},
    {
     ButtonBox["\<\"Mark ALL Input cells as initialization\"\>",
      Appearance->Automatic,
      ButtonFunction:>myNotebookInit`markInputCellsAsInitialization[True],
      Evaluator->Automatic,
      Method->"Queued"]},
    {
     ButtonBox["\<\"Clear initialization on Input cells\"\>",
      Appearance->Automatic,
      ButtonFunction:>myNotebookInit`markInputCellsAsInitialization[False],
      Evaluator->Automatic,
      Method->"Queued"]},
    {
     ButtonBox["\<\"Delete all empty cells\"\>",
      Appearance->Automatic,
      ButtonFunction:>myNotebookInit`deleteAllEmptyCellsInNotebook,
      Evaluator->Automatic,
      Method->"Queued"]},
    {
     ButtonBox["\<\"Export all Output cells to PNG (notebook dir)\"\>",
      Appearance->Automatic,
      ButtonFunction:>myNotebookInit`saveAsPngAllOutputCells[],
      Evaluator->Automatic,
      Method->"Queued"]},
    {
     ButtonBox["\<\"Export all Output cells to PDF (notebook dir)\"\>",
      Appearance->Automatic,
      ButtonFunction:>myNotebookInit`saveAsPdfAllOutputCells[],
      Evaluator->Automatic,
      Method->"Queued"]},
    {
     ButtonBox["\<\"Show diagnostics\"\>",
      Appearance->Automatic,
      ButtonFunction:>myNotebookInit`showDiagnostics[],
      Evaluator->Automatic,
      Method->"Queued"]},
    {
     ButtonBox["\<\"Show error message cells\"\>",
      Appearance->Automatic,
      ButtonFunction:>Print[
