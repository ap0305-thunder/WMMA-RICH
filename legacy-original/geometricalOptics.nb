Cell[BoxData[
 RowBox[{
  RowBox[{
  "(*", "*************************************************************************************************)"}\
], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"CHERENKOV", " ", "PHOTON"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"\[Gamma]", ",", 
    RowBox[{
     RowBox[{
     "\[Eta]", " ", "photon", " ", "angle", " ", "with", " ", "respect", " ", 
      "to", " ", "the", " ", "track"}], " ", "//", " ", 
     RowBox[{"RELATIVE", " ", "ANGLES"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
  "(*", "*************************************************************************************************)"}\
], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"eZ", "=", 
     RowBox[{"UnitVector", "[", 
      RowBox[{"3", ",", "3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"urkX", ":=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Cross", "[", 
         RowBox[{"eZ", ",", "dirTheTrk"}], "]"}], "/", 
        RowBox[{"Sin", "[", "\[CapitalTheta]", "]"}]}], "//.", "ruleTrig"}], "//",
       "blob"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"urkY", ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Cross", "[", 
        RowBox[{"dirTheTrk", ",", "urkX"}], "]"}], "//.", "ruleTrig"}], "//", 
      "blob"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dirTheChr", ":=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", "\[Gamma]", "]"}], "*", "dirTheTrk"}], "+", 
       RowBox[{
        RowBox[{"Sin", "[", "\[Gamma]", "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"urkY", "*", 
           RowBox[{"Cos", "[", "\[Eta]", "]"}]}], "+", 
          RowBox[{"urkX", "*", 
           RowBox[{"Sin", "[", "\[Eta]", "]"}]}]}], ")"}]}]}], "//", 
      "blob"}]}], ";"}], "\n", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ===================== cross-check must be 1                \
 \>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Dot", "[", 
         RowBox[{"urkX", ",", "urkX"}], "]"}], "//.", "ruleTrig"}], "//", 
       "blob"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ===================== cross-check must be 1                \
 \>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Dot", "[", 
         RowBox[{"urkY", ",", "urkY"}], "]"}], "//.", "ruleTrig"}], "//", 
       "blob"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ================= urkX                                     \
  \>\"", ",", "urkX"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ================= urkY                                     \
  \>\"", ",", "urkY"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ===================== cross-check must be 1                \
 \>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Dot", "[", 
         RowBox[{"dirTheChr", ",", "dirTheChr"}], "]"}], "//.", "ruleTrig"}], 
       "//", "Simplify"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ===================== cross-check must be ?{0,0,0}?        \
 \>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"dirTheTrk", "-", 
          RowBox[{"Cross", "[", 
           RowBox[{"urkX", ",", "urkY"}], "]"}]}], ")"}], "//.", "ruleTrig"}],
        "//", "blob"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ============ dirThePho (generic photon with {\[Theta],\
\[Phi]}            \>\"", ",", "dirThePho"}], "]"}], ";"}], "\n", 
