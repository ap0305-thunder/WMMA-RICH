              RowBox[{"[", "1", "]"}], "]"}], "-", "xc"}], ")"}], "2"], "/", 
          SuperscriptBox["ax", "2"]}], "+", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"theRay1", "[", "t", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", "yc"}], ")"}], "2"], "/", 
          SuperscriptBox["ay", "2"]}], "+", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"theRay1", "[", "t", "]"}], "[", 
              RowBox[{"[", "3", "]"}], "]"}], "-", "zc"}], ")"}], "2"], "/", 
          SuperscriptBox["az", "2"]}]}], "==", 
        SuperscriptBox["r", "2"]}], ",", 
       RowBox[{"{", "t", "}"}], ",", "Reals"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol1", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"sol1", ",", "$Assumptions"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
