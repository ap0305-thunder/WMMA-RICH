           RowBox[{"z0", ",", "y0", ",", "x0"}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"MoveDirected", "[", 
         RowBox[{
          RowBox[{"GridOfRays", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"size", ",", "size"}], "}"}], ",", 
            RowBox[{"NumberOfRays", "\[Rule]", "numRays"}], ",", 
            RowBox[{"RayLineRGB", "\[Rule]", "Red"}]}], "]"}], ",", 
          RowBox[{"{", 
