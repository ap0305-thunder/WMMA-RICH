}]}]}]}]}]}]}]}]}]}]}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"trackGen", "[", 
     RowBox[{"num_", ",", "minAcc_", ",", "maxYAcc_", ",", "maxXAcc_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Theta]", ",", "\[Phi]", ",", "zeta", ",", "radius", ",", "theta0X", 
        ",", "theta0Y"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"zSphe", "[", 
         RowBox[{"radius_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], "=", 
        RowBox[{"radius", "*", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"xSphe", "[", 
         RowBox[{"radius_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], "=", 
        RowBox[{"radius", "*", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
         RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"ySphe", "[", 
         RowBox[{"radius_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], "=", 
        RowBox[{"radius", "*", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"xRect", "[", 
         RowBox[{"zeta_", ",", "thetaX_", ",", "thetaY_"}], "]"}], "=", 
        RowBox[{"zeta", "*", 
         RowBox[{"Tan", "[", "thetaX", "]"}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"yRect", "[", 
         RowBox[{"zeta_", ",", "thetaX_", ",", "thetaY_"}], "]"}], "=", 
        RowBox[{"zeta", "*", 
         RowBox[{"Tan", "[", "thetaY", "]"}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"thetaX", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"thetaY", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"phi", "=", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"+", "\[Pi]"}]}], "}"}], ",", "num"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theta", "=", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"minAcc", ",", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"maxYAcc", "^", "2"}], "+", 
              RowBox[{"maxXAcc", "^", "2"}]}], "]"}]}], "}"}], ",", "num"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Histogram", "[", "phi", "]"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"Histogram", "[", "theta", "]"}], "]"}], ";"}], "*)"}], 
       RowBox[{"theta0X", "=", 
        RowBox[{"ArcTan", "[", 
         RowBox[{
          RowBox[{"xSphe", "[", 
           RowBox[{"1", ",", "theta", ",", "phi"}], "]"}], "/", 
          RowBox[{"zSphe", "[", 
           RowBox[{"1", ",", "theta", ",", "phi"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theta0Y", "=", 
        RowBox[{"ArcTan", "[", 
         RowBox[{
          RowBox[{"ySphe", "[", 
           RowBox[{"1", ",", "theta", ",", "phi"}], "]"}], "/", 
          RowBox[{"zSphe", "[", 
           RowBox[{"1", ",", "theta", ",", "phi"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"theta0Y", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "]"}], ">", "maxYAcc"}], "||", 
            
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"theta0X", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "]"}], ">", "maxXAcc"}]}], ",",
            "Null", ",", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"thetaX", ",", 
              RowBox[{"theta0X", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], "]"}], ";", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"thetaY", ",", 
              RowBox[{"theta0Y", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], "]"}], ";"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "num"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"angle", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"thetaX", ",", "thetaY"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Length", "[", "angle", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"Point", "[", "angle", "]"}], ",", 
          RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
          RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], "]"}], ";"}]}], 
     "]"}]}], ";"}]}]], "Input",
