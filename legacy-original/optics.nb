   FontColor->RGBColor[0.5, 0, 0.5],
   Background->RGBColor[1., 0.4823529411764706, 1.]], 
  RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"If", "[", 
