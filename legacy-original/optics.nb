  RowBox[{
   RowBox[{
    RowBox[{"calcFS", "[", 
     RowBox[{"zCc_", ",", "xCc_", ",", "radius_", ",", "tilt_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"alpha", ",", "beta", ",", "gamma"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"diffXCcIp", "=", "xCc"}], ";", "\[IndentingNewLine]", 
       RowBox[{"diffZCcIp", "=", 
        RowBox[{"-", "zCc"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"CHToIPToCcAngle", "=", 
        RowBox[{"ArcTan", "[", 
         RowBox[{"diffXCcIp", "/", "diffZCcIp"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"betaVrtx", "=", 
        RowBox[{"CHToIPToCcAngle", "-", "tilt"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"gamma", "[", "alpha_", "]"}], ":=", 
        RowBox[{"ArcSin", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"diffZCcIp", "^", "2"}], "+", 
              RowBox[{"diffXCcIp", "^", "2"}]}], "]"}], "/", "radius"}], 
           ")"}], "*", 
          RowBox[{"Sin", "[", 
           RowBox[{"alpha", "+", "CHToIPToCcAngle"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"nu", "[", "alpha_", "]"}], ":=", 
        RowBox[{
         RowBox[{"ArcSin", "[", 
          RowBox[{"2", "*", 
           RowBox[{"Sin", "[", 
            RowBox[{"gamma", "[", "alpha", "]"}], "]"}]}], "]"}], "-", 
         RowBox[{"gamma", "[", "alpha", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"beta", "[", "alpha_", "]"}], ":=", 
        RowBox[{"alpha", "+", "CHToIPToCcAngle", "-", 
         RowBox[{"gamma", "[", "alpha", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"tau", "[", "alpha_", "]"}], ":=", 
        RowBox[{
         RowBox[{"nu", "[", "alpha", "]"}], "+", 
         RowBox[{"beta", "[", "alpha", "]"}], "-", "CHToIPToCcAngle"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"edgeParaFSNear", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"radius", "/", "2"}], ")"}], "*", 
          RowBox[{"Cos", "[", 
           RowBox[{"tau", "[", "0", "]"}], "]"}]}], "+", "zCc"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"edgeParaFSNear", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"radius", "/", "2"}], ")"}], "*", 
          RowBox[{"Sin", "[", 
           RowBox[{"tau", "[", "0", "]"}], "]"}]}], "+", "xCc"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"edgeParaFSAway", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"radius", "/", "2"}], ")"}], "*", 
          RowBox[{"Cos", "[", 
           RowBox[{"tau", "[", "trnsvrsAcc", "]"}], "]"}]}], "+", "zCc"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"edgeParaFSAway", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"radius", "/", "2"}], ")"}], "*", 
          RowBox[{"Sin", "[", 
           RowBox[{"tau", "[", "trnsvrsAcc", "]"}], "]"}]}], "+", "xCc"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< CHToIPToCcAngle   \>\"", ",", 
         RowBox[{"nf1", "[", "CHToIPToCcAngle", "]"}], 
         ",", "\"\<   --- betaVrtx   \>\"", ",", 
         RowBox[{"nf1", "[", "betaVrtx", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
       "miniBanner", 
        "[", "\"\< \\n PD-PLANE \
========================================================================= \
\>\"", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< P8 *** {z} PD-PLANE center  : \>\"", ",", 
         RowBox[{"nf1", "[", "zScreen", "]"}], 
         ",", "\"\< ----- {transverseCoordinate} PD-PLANE center  : \>\"", ",", 
         RowBox[{"nf1", "[", "xScreen", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
