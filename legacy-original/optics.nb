                    "--", "--"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}]}]}]}]}]}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{
      RowBox[{"@", "#$"}], "%", " ", "IF", " ", "Module"}]}], ":=", " ", 
    RowBox[{"IT", " ", "DOES", " ", "NOT", " ", 
     RowBox[{
      RowBox[{"WORK", " ", "!!"}], "!"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"myFocalSurfaceAnalyze", "[", 
     RowBox[{
     "points3DOnTheFS_", ",", "points2DOnTheFS_", ",", "pointsTiltOnTheFS_", ",",
       "tilt_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
       "sizeFSTrnsvrs", ",", "sizeFSThrdDim", ",", "\[IndentingNewLine]", 
        "areaFS", ",", "numSensors", ",", "\[IndentingNewLine]", 
        "resThetaProj", ",", "resTheta", ",", "\[IndentingNewLine]", 
        "theDirScreenInCentralPlane", ",", "pointsTiltProjOnTheFS", ",", 
        "\[IndentingNewLine]", "uuu", ",", "vvv", ",", "\[IndentingNewLine]", 
        "trnsvrsMagnification", ",", "thrdDimMagnification", ",", 
        "\[IndentingNewLine]", "zPDACenter", ",", "xPDACenter", ",", 
        "\[IndentingNewLine]", "finalRaysDir"}], "\[IndentingNewLine]", "}"}],
       ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"!", 
        RowBox[{
         RowBox[{"@", "#$"}], "%", " ", "changed", " ", "for", " ", "a", " ", 
         "split", " ", 
         RowBox[{"PD", ":", " ", 
          RowBox[{
          "pass", " ", "all", " ", "data", " ", "and", " ", "only", " ", "do",
            " ", "calculations", " ", "here"}]}]}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", " ", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Length", "@", "points3DOnTheFS"}], " ", "\[LessEqual]", 
           "0"}], " ", "||", " ", 
          RowBox[{
           RowBox[{"Length", "@", "points2DOnTheFS"}], "\[LessEqual]", " ", 
           "0"}]}], ",", 
         RowBox[{
          RowBox[{
          "bigBanner", 
           "[", "\"\< ERROR ON myFocalSurfaceAnalyze - Returning \>\"", "]"}],
           ";", 
          RowBox[{"Return", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"improve", ":", " ", 
         RowBox[{
         "tilt", " ", "screen", " ", "can", " ", "be", " ", "determined", " ",
           "by", " ", "points3DOnTheFS"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"zPDACenter", "=", 
        RowBox[{"Median", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", "points3DOnTheFS", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xPDACenter", "=", 
        RowBox[{"Median", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", "points3DOnTheFS", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Histogram", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", "points2DOnTheFS", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "100", ",", 
         RowBox[{"AspectRatio", "\[Rule]", 
          RowBox[{"1", "/", "2"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Histogram", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", "points2DOnTheFS", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", "100", ",", 
         RowBox[{"AspectRatio", "\[Rule]", 
          RowBox[{"1", "/", "2"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"sizeFSTrnsvrs", "=", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "points2DOnTheFS", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "-", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "points2DOnTheFS", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sizeFSThrdDim", "=", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "points2DOnTheFS", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "-", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "points2DOnTheFS", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"areaFS", "=", 
        RowBox[{"sizeFSTrnsvrs", "*", 
         RowBox[{"sizeFSThrdDim", "/", "1000000"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"numSensors", "=", 
        RowBox[{"sizeFSTrnsvrs", "*", 
         RowBox[{"sizeFSThrdDim", "/", 
          SuperscriptBox["sensorPitch", "2"]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"resThetaProj", "=", 
        RowBox[{"{", "}"}]}], ";", 
       RowBox[{"resTheta", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"theDirScreenInCentralPlane", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"tilt", "*", "Degree"}], "]"}], ",", 
          RowBox[{"Sin", "[", 
           RowBox[{"tilt", "*", "Degree"}], "]"}], ",", "0"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"finalRaysDir", "=", 
        RowBox[{
         RowBox[{"Mean", "[", 
          RowBox[{"ArcTan", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Transpose", "[", "pointsTiltOnTheFS", "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], "/", 
            RowBox[{
             RowBox[{"Transpose", "[", "pointsTiltOnTheFS", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], "/", 
         "Degree"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "pointsTiltOnTheFS", "]"}], ">", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"resTheta", ",", 
           RowBox[{"1000", "*", 
            RowBox[{"ArcCos", "[", 
             RowBox[{"pointsTiltOnTheFS", ".", "theDirScreenInCentralPlane"}],
              "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", "\"\<zero length pointsTiltOnTheFS  \>\"", "]"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "pointsTiltOnTheFS", "]"}], ">", "0"}], ",", 
         
         RowBox[{
          RowBox[{"pointsTiltProjOnTheFS", "=", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Transpose", "[", "pointsTiltOnTheFS", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"Transpose", "[", "pointsTiltOnTheFS", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", 
                RowBox[{"Length", "[", "pointsTiltOnTheFS", "]"}]}], "]"}]}], 
             "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"uuu", "=", 
           RowBox[{"Map", "[", 
            RowBox[{"Normalize", ",", "pointsTiltProjOnTheFS"}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"vvv", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Cross", "[", 
              RowBox[{"theDirScreenInCentralPlane", ",", 
               RowBox[{"uuu", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", 
               RowBox[{"Length", "[", "uuu", "]"}]}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"resThetaProj", ",", 
            RowBox[{"1000", "*", 
             RowBox[{"ArcSin", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", "vvv", "]"}], "[", 
               RowBox[{"[", "3", "]"}], "]"}], "]"}]}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", "\"\<zero length pointsTiltOnTheFS\>\"", "]"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"trnsvrsMagnification", "=", 
        RowBox[{"sizeFSTrnsvrs", "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "halfOpenAngleMRad"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"thrdDimMagnification", "=", 
        RowBox[{"sizeFSThrdDim", "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "halfOpenAngleMRad"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"resThetaProj", "=", 
        RowBox[{"Flatten", "[", "resThetaProj", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"resTheta", "=", 
        RowBox[{"Flatten", "[", "resTheta", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Histogram", "[", 
         RowBox[{"resThetaProj", ",", 
          RowBox[{
          "ChartElementFunction", "\[Rule]", "\"\<FadingRectangle\>\""}], ",", 
          RowBox[{"ChartStyle", "\[Rule]", "Orange"}], ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<resThetaProj (mrad)\>\""}], ",", 
          RowBox[{"AspectRatio", "\[Rule]", 
           RowBox[{"1", "/", "2"}]}], ",", 
          RowBox[{"Frame", "->", "True"}]}], "]"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Histogram", "[", 
         RowBox[{"resTheta", ",", 
          RowBox[{
          "ChartElementFunction", "\[Rule]", "\"\<FadingRectangle\>\""}], ",", 
          RowBox[{"ChartStyle", "\[Rule]", "Orange"}], ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<resTheta (mrad)\>\""}], ",", 
          RowBox[{"AspectRatio", "\[Rule]", 
           RowBox[{"1", "/", "2"}]}], ",", 
          RowBox[{"Frame", "->", "True"}]}], "]"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<   zPDACenter                                            \
           \>\"", ",", 
         RowBox[{"nf1", "[", "zPDACenter", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<   xPDACenter                                            \
           \>\"", ",", 
         RowBox[{"nf1", "[", "xPDACenter", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<   finalRaysDir in plane z-x (degrees)                   \
           \>\"", ",", 
         RowBox[{"nf1", "[", "finalRaysDir", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<   Mean resThetaProj         (mrad)                      \
           \>\"", ",", 
         RowBox[{"nf1", "[", 
          RowBox[{"Mean", "[", "resThetaProj", "]"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<   Median resThetaProj       (mrad)                      \
           \>\"", ",", 
         RowBox[{"nf1", "[", 
          RowBox[{"Median", "[", "resThetaProj", "]"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<   Mean resTheta             (mrad)                      \
           \>\"", ",", 
         RowBox[{"nf1", "[", 
          RowBox[{"Mean", "[", "resTheta", "]"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<   Median resTheta           (mrad)                      \
           \>\"", ",", 
         RowBox[{"nf1", "[", 
          RowBox[{"Median", "[", "resTheta", "]"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<   Estimated size PD-plane local z-Trnsvrs coordinate \
(mm)          \>\"", ",", 
         RowBox[{"nf1", "[", "sizeFSTrnsvrs", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<   Estimated size PD-plane ThrdDim (mm)                  \
          \>\"", ",", 
         RowBox[{"nf1", "[", "sizeFSThrdDim", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<   Estimated area of the PD-plane (m**2)                 \
           \>\"", ",", 
         RowBox[{"nf1", "[", "areaFS", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<   Estimated number of sensors (one half detector)       \
           \>\"", ",", 
         RowBox[{"nf1", "[", "numSensors", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<   Assumed Nominal Sensor Pitch                          \
           \>\"", ",", 
         RowBox[{"nf1", "[", "sensorPitch", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<   Transverse Magnification (mm/mrad) - meaningful for \
single trace \>\"", ",", 
         RowBox[{"nf3", "[", "trnsvrsMagnification", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<   ThrdDim Magnification   (mm/mrad) - meaningful for \
single trace \>\"", ",", 
         RowBox[{"nf3", "[", "thrdDimMagnification", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<   Average Magnification    (mm/mrad) - meaningful for \
single trace \>\"", ",", 
         RowBox[{"nf3", "[", 
          RowBox[{"average", "[", 
           RowBox[{"trnsvrsMagnification", ",", "thrdDimMagnification"}], 
           "]"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "*)"}]], "Input",
 Evaluatable->True,
