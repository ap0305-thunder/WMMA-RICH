    RowBox[{"zBoxCen", ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"zBoxMin", "+", "zBoxMax"}], ")"}], "/", "2"}]}], 
    ";"}]}]}]], "Input",
