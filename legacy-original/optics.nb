  RowBox[{
   RowBox[{
    RowBox[{"pixelize", "[", 
     RowBox[{"tracedPointsFS_", ",", "pixelSize_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "x", ",", "y", ",", "res", ",", "tracedPointsFSDigitized", ",", 
        "centerScreen"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tracedPointsFSDigitized", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"res", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"unitVectorScreen", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "tiltScreen", "]"}], ",", 
          RowBox[{"Sin", "[", "tiltScreen", "]"}], ",", "0"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"eX", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", "tiltScreen", "]"}]}], ",", 
          RowBox[{"+", 
           RowBox[{"Cos", "[", "tiltScreen", "]"}]}], ",", "0"}], "}"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"eY", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"centerScreen", "=", 
        RowBox[{"{", 
         RowBox[{"zScreen", ",", "xScreen", ",", "0"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"x", "=", 
        RowBox[{
         RowBox[{"Transpose", "[", "tracedPointsFS", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"y", "=", 
        RowBox[{
         RowBox[{"Transpose", "[", "tracedPointsFS", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"digitize", "[", 
        RowBox[{"x", ",", "y", ",", "pixelSize", ",", "0"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"tracedPointsFSDigitized", ",", 
           RowBox[{"centerScreen", "+", 
            RowBox[{
             RowBox[{"xd", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "*", "eX"}], "+", 
            RowBox[{
             RowBox[{"yd", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "*", "eY"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"Length", "[", "tracedPointsFS", "]"}]}], "}"}]}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"plt1", "=", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Point", "[", "tracedPointsFSDigitized", "]"}], ",", 
             "Green"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"plt2", "=", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Point", "[", "tracedPointsFS", "]"}], ",", "Red"}], 
            "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Show", "[", 
          RowBox[{"plt1", ",", "plt2"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Histogram", "[", "xd", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Histogram", "[", 
          RowBox[{"xd", "-", "x"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Histogram", "[", "yd", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Histogram", "[", 
          RowBox[{"yd", "-", "y"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"xd", ",", "yd"}], "}"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Dot", "[", 
          RowBox[{"unitVectorScreen", ",", "centerScreen"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Map", "[", 
             RowBox[{"Norm", ",", 
              RowBox[{"tracedPointsFSDigitized", "-", "tracedPointsFS"}]}], 
             "]"}], "]"}], "*", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"res", ",", 
             RowBox[{
              RowBox[{"Norm", "[", 
               RowBox[{
                RowBox[{"tracedPointsFSDigitized", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "-", 
                RowBox[{"tracedPointsFS", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "*", 
              RowBox[{"Sqrt", "[", "2", "]"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", 
             RowBox[{"Length", "[", "tracedPointsFS", "]"}]}], "}"}]}], "]"}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"Histogram", "[", "res", "]"}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "tracedPointsFSDigitized", "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
