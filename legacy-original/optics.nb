            "90"}], "]"}], "&"}], "\[IndentingNewLine]", ",", 
         "directionAnglesLineLight"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"mySource", "=", "mySourceLine"}], ";", "\[IndentingNewLine]", 
