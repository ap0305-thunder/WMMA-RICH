         RowBox[{"Part", "[", 
          RowBox[{
           RowBox[{"Dimensions", "@", "data"}], ",", "2"}], "]"}]}], ")"}], ",", 
       RowBox[{"(", 
        RowBox[{"0", "===", 
         RowBox[{"Max", "@", 
          RowBox[{"Abs", "@", 
           RowBox[{"Im", "@", 
            RowBox[{"Flatten", "@", "data"}]}]}]}]}], ")"}], ",", 
       RowBox[{"(", 
        RowBox[{"3", "<", 
         RowBox[{"Length", "@", 
          RowBox[{"Union", "@", "data"}]}]}], ")"}]}], "]"}]}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "machinePrec", ",", "exactData", ",", "x", ",", "y", ",", "d1", ",", 
        "d2", ",", "s1", ",", "s2", ",", "m", ",", "mInverse", ",", "t", ",", 
