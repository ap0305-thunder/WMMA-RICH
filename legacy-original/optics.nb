        RowBox[{"(", 
         RowBox[{"zBoxMax", "-", "zBoxMin"}], ")"}], "*", 
        RowBox[{"3", "/", "4"}]}]}], "//", "N"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"z4Step", ":=", 
     RowBox[{"zBoxMax", "//", "N"}]}], ";"}], "\[IndentingNewLine]", 
