   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "plotDetailedSideView", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PlotRange", "->", "plotRange2DFull"}], ",", 
       RowBox[{"ImageSize", "->", "Full"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"plotDetailedSideView", "[", 
      RowBox[{
       RowBox[{"suffixes_List", ":", 
        RowBox[{"{", "\"\<\>\"", "}"}]}], ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"epilog", ",", "plot"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"epilog", "=", 
         RowBox[{"detailedSideViewEpilog", "[", "suffixes", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"propagateSystemYes", "==", "True"}], ")"}], "||", 
           RowBox[{"(", 
            RowBox[{"turboTraceYes", "==", "True"}], ")"}]}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"plot", "=", 
            RowBox[{"ShowSystem", "[", 
             RowBox[{"analyzedSystem", ",", "\[IndentingNewLine]", 
              RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
              RowBox[{"Axes", "->", "True"}], ",", 
              RowBox[{"AxesLabel", "->", 
               RowBox[{"{", 
                
                RowBox[{"\"\<z (mm)\>\"", 
                 ",", "\"\<transverse/radial (mm)\>\""}], "}"}]}], ",", 
              RowBox[{"AxesStyle", "->", "Thick"}], ",", 
              RowBox[{"Background", "->", "White"}], ",", 
              RowBox[{"ColorView", "->", "SourceID"}], ",", 
              RowBox[{"Frame", "->", "True"}], ",", 
              RowBox[{"FrameStyle", "->", 
               RowBox[{"Directive", "[", 
                RowBox[{"Black", ",", "15"}], "]"}]}], ",", 
              RowBox[{"FrameTicks", "->", "True"}], ",", 
              RowBox[{"GraphicDesign", "->", "Wire"}], ",", 
              RowBox[{"GridLines", "->", "myGrid"}], ",", 
              RowBox[{"ImageSize", "->", 
               RowBox[{"OptionValue", "[", "ImageSize", "]"}]}], ",", 
              RowBox[{"LabelStyle", "->", 
               RowBox[{"Directive", "[", 
                RowBox[{
                 RowBox[{"Background", "->", "White"}], ",", 
                 RowBox[{"FontFamily", "->", "\"\<Helvetica\>\""}], ",", 
                 "Bold", ",", "16"}], "]"}]}], ",", 
              RowBox[{"OutputType", "->", "StandardGraphics"}], ",", 
              RowBox[{"PlotRange", "->", 
               RowBox[{"OptionValue", "[", "PlotRange", "]"}]}], ",", 
              RowBox[{"PlotType", "->", "TopView"}], ",", 
