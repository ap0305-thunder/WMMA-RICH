     RowBox[{"PlotLabel", "\[Rule]", "\"\< generated waveln \>\""}]}], "]"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"wavelnList", "=", 
