         RowBox[{
          RowBox[{"localDebugPrintFlag", "==", "True"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\< straight track from : \>\"", ",", "rStartTrack"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< thetaX = \>\"", ",", "thetaX"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\< thetaY = \>\"", ",", "thetaY"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\< Number of calculated virtual hits from the track \>\
\"", ",", 
             RowBox[{"numHits", "=", 
              RowBox[{"Length", "@", "allHits"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"rayDump", "[", "tracedTrack", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "@", 
            RowBox[{"AnalyzeSystem", "[", "tracedTrack", "]"}]}]}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"rStrTra", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"ReadRays", "[", 
           RowBox[{"tracedTrack", ",", "RayStart", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"IntersectionNumber", "->", "1"}], ",", 
              RowBox[{"GenerationNumber", "->", "1"}]}], "}"}]}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "@", "rStrTra"}], "<", "1"}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", "\"\< ERROR on track geometry - no start point \>\"",
             "]"}], ";", 
           RowBox[{"Return", "[", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"use", " ", "only"}], " ", "\[Equal]"}], ",", " ", 
           RowBox[{"not", " ", "===", " ", 
            RowBox[{"to", " ", "avoid", " ", "difference", " ", 
             RowBox[{"integer", "/", "float"}], " ", 
             RowBox[{"(", 
              RowBox[{"OR", " ", "something", " ", "better"}], ")"}]}]}]}], 
          " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"checkEqualRealNumbers", "[", 
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"rStartTrack", "-", "rStrTra"}], "]"}], ",", "0", ",", 
            "1000"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"debugPrint", "[", 
           
           RowBox[{"\"\< OK on track geometry: rStartTrack == rStrTra \>\"", ",",
             "localDebugPrintFlag"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
           "Print", 
            "[", "\"\< ERROR on track geometry : rStartTrack =!= rStrTra \>\"",
             "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"rEndTra", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"ReadRays", "[", 
           RowBox[{"tracedTrack", ",", "RayEnd", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"IntersectionNumber", "->", "1"}], ",", 
              RowBox[{"GenerationNumber", "->", "1"}]}], "}"}]}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rOnTheFS", "=", 
         RowBox[{"(*", 
          RowBox[{"Flatten", "[", 
           RowBox[{"ReadRays", "[", 
            RowBox[{
            "tracedTrack", ",", "SurfaceCoordinates", ",", "onTheFS"}], "]"}],
            "]"}], "*)"}], 
         RowBox[{"Last", "@", 
          RowBox[{"ReadRays", "[", 
           RowBox[{"tracedTrack", ",", "RayEnd"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rOnTheFS2D", "=", 
         RowBox[{"Last", "@", 
          RowBox[{"ReadRays", "[", 
           RowBox[{"tracedTrack", ",", "SurfaceCoordinates"}], "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "@", "rOnTheFS"}], "<", "1"}], ",", 
          RowBox[{"Message", "[", 
           RowBox[{"getTrackGeometry", "::", "noPointOnFS"}], "]"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"localDebugPrintFlag", "==", "True"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\< myTrack                     = \>\"", ",", 
             "myTrack"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\< rStartTrack                 = \>\"", ",", 
             "rStartTrack", ",", "\"\< must be rStrTra==rStartTrack \>\""}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\< rStrTra                     = \>\"", ",", "rStrTra",
              ",", "\"\< must be rStrTra==rStartTrack \>\""}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\< rEndTra (first segment)     = \>\"", ",", 
             "rEndTra"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\< rOnTheFS (FS point)         = \>\"", ",", 
             "rOnTheFS"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\< rOnTheFS2D (FS point)       = \>\"", ",", 
             "rOnTheFS2D"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"{", 
          RowBox[{
          "rStrTra", ",", "rEndTra", ",", "rOnTheFS", ",", "rOnTheFS2D"}], 
          "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}]}]}]], "Input",
