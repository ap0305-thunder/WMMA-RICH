  RowBox[{
   RowBox[{
    RowBox[{"calcFlatSecMirFromLowerAngle", "[", 
     RowBox[{
     "size_", ",", "tilt_", ",", "thetaMinSecMir_", ",", "p4z$local_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p", ",", "q", ",", "sol", ",", "\[IndentingNewLine]", "zSecMirMinVar",
         ",", "xSecMirMinVar", ",", "zSecMirMaxVar", ",", "xSecMirMaxVar", ",",
         "\[IndentingNewLine]", "zSecMirMin", ",", "xSecMirMin", ",", 
        "zSecMirMax", ",", "xSecMirMax", ",", "zSecMir", ",", "xSecMir", ",", 
        "\[IndentingNewLine]", "thetaMinSecMir2"}], "\[IndentingNewLine]", 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
       "bigBanner", 
        "[", "\"\< BEWARE: IT IS OLD !!! ??? it works.... compare with: \
doCalcPlaneSidewiseCoords\>\"", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
       "bigBanner", 
        "[", "\"\< DO NOT USE FOR SPLIT OPTICS WHERE YOU DO NOT NEED TO PUT \
THE H- FLAT MIRROR AS LOW AS POSSIBLE \>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zSecMirMinVar", "=", "p4z$local"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xSecMirMinVar", "=", "q"}], ";", "\[IndentingNewLine]", 
       RowBox[{"zSecMirMaxVar", "=", 
        RowBox[{
         RowBox[{"Cos", "[", "thetaMinSecMir", "]"}], "*", "p"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xSecMirMaxVar", "=", 
        RowBox[{
         RowBox[{"Sin", "[", "thetaMinSecMir", "]"}], "*", "p"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"N", "@", 
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"dist", "[", 
               RowBox[{
               "zSecMirMinVar", ",", "xSecMirMinVar", ",", "zSecMirMaxVar", ",",
                 "xSecMirMaxVar"}], "]"}], "\[Equal]", "size"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"1", "/", 
               RowBox[{"AngCoeff", "[", 
                RowBox[{
                "zSecMirMinVar", ",", "xSecMirMinVar", ",", "zSecMirMaxVar", ",",
                  "xSecMirMaxVar"}], "]"}]}], "\[Equal]", 
              RowBox[{"-", 
               RowBox[{"Tan", "[", "tilt", "]"}]}]}]}], "\[IndentingNewLine]",
             "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"p", ",", "q"}], "}"}]}], "\[IndentingNewLine]", 
          "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"zSecMirMin", "=", 
        RowBox[{"zSecMirMinVar", "/.", 
         RowBox[{"sol", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xSecMirMin", "=", 
        RowBox[{"xSecMirMinVar", "/.", 
         RowBox[{"sol", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"zSecMirMax", "=", 
        RowBox[{"zSecMirMaxVar", "/.", 
         RowBox[{"sol", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xSecMirMax", "=", 
        RowBox[{"xSecMirMaxVar", "/.", 
         RowBox[{"sol", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"zSecMir", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"zSecMirMin", "+", "zSecMirMax"}], ")"}], "/", "2"}], "/.", 
         RowBox[{"sol", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xSecMir", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"xSecMirMin", "+", "xSecMirMax"}], ")"}], "/", "2"}], "/.", 
         RowBox[{"sol", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"secMirNorm3D", "=", 
        RowBox[{"Normalize", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"xSecMirMax", "-", "xSecMirMin"}], ")"}]}], ",", 
           RowBox[{"+", 
            RowBox[{"(", 
             RowBox[{"zSecMirMax", "-", "zSecMirMin"}], ")"}]}], ",", "0"}], 
          "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"thetaMinSecMir2", "=", 
        RowBox[{"ArcTan", "[", 
         RowBox[{"xSecMirMax", "/", "zSecMirMax"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"miniBanner", "[", "\"\< Flat mirror \>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< Flat mirror ROC : \>\"", ",", "radiusSecMir"}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< P4 *** {z} Flat mirror min     : \>\"", ",", 
         RowBox[{"nf1", "[", "zSecMirMin", "]"}], 
         ",", "\"\< ----- {transverseCoordinate} Flat mirror min     : \>\"", 
         ",", 
         RowBox[{"nf1", "[", "xSecMirMin", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<        {z} Flat mirror center  : \>\"", ",", 
         RowBox[{"nf1", "[", "zSecMir", "]"}], ",", 
         "       ", "\"\< ----- {transverseCoordinate} Flat mirror center  : \
\>\"", ",", 
         RowBox[{"nf1", "[", "xSecMir", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< P3 *** {z} Flat mirror max     : \>\"", ",", 
         RowBox[{"nf1", "[", "zSecMirMax", "]"}], 
         ",", "\"\< ----- {transverseCoordinate} Flat mirror max     : \>\"", 
         ",", 
         RowBox[{"nf1", "[", "xSecMirMax", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< thetaMinSecMir (imposed): \>\"", ",", "thetaMinSecMir", 
         ",", "\"\< thetaMinSecMir (calculated) DEGREES: \>\"", ",", 
         RowBox[{"thetaMinSecMir2", "/", "Degree"}], 
         ",", "\"\< ===>>> RADIANS: \>\"", ",", "thetaMinSecMir2"}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< Tilt Flat mirror (with respect to the beam-line :=: \
positive z-axis) DEGREES: \>\"", ",", 
         RowBox[{"nf1", "[", 
          RowBox[{
           RowBox[{"tiltSecMir", "/", "Degree"}], "//", "N"}], "]"}], 
         ",", "\"\< RADIANS: \>\"", ",", 
         RowBox[{"nf1", "[", 
          RowBox[{"tiltSecMir", "//", "N"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< Flat mirror width :     \>\"", ",", 
         RowBox[{"nf1", "[", "sizeTrnsvrsSecMir", "]"}], 
         ",", "\"\< ----- Flat mirror ThrdDim :     \>\"", ",", 
         RowBox[{"nf1", "[", "sizeThrdDimSecMir", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{
         "zSecMir", ",", "xSecMir", ",", "zSecMirMin", ",", "xSecMirMin", ",",
           "zSecMirMax", ",", "xSecMirMax"}], "}"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 Evaluatable->True,
 InitializationCell->True,
