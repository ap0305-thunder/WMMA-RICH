              RowBox[{"Max", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", "tracedPoints", "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], "-", 
              RowBox[{"Min", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", "tracedPoints", "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"sizeSpotTrnsvrsRMS", "=", 
             RowBox[{"StandardDeviation", "[", 
