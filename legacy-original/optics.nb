              ",", "0", ",", "1", ",", "azimuthAngleTwist"}], "]"}], 
            "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
