Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"showEllipseResults", "[", "x_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a$", ",", "b$", ",", "c$", ",", "e$"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "@", "x"}], ">", "0"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"a$", "=", 
         RowBox[{"x", "[", 
          RowBox[{"[", "\"\<SemimajorAxisLength\>\"", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"b$", "=", 
         RowBox[{"x", "[", 
          RowBox[{"[", "\"\<SemiminorAxisLength\>\"", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"c$", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           SuperscriptBox["a$", "2"], "-", 
           SuperscriptBox["b$", "2"]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"e$", "=", 
         RowBox[{"x", "[", 
          RowBox[{"[", "\"\<Eccentricity\>\"", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\< a= \>\"", ",", "a$", ",", "\"\< b= \>\"", ",", "b$", 
          ",", "\"\< c= \>\"", ",", "c$", ",", "\"\< e= \>\"", ",", "e$"}], 
         "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.945862080410919*^9, 3.9468070237038136`*^9, {3.983872539984001*^9, 
