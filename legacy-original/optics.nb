Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"fff", ",", "a", ",", "b"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fff", "[", 
    RowBox[{"x_", ",", "a_", ",", "b_"}], "]"}], "=", 
   RowBox[{"a", "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"x", "/", "b"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"fff", "[", 
        RowBox[{"0", ",", "a", ",", "b"}], "]"}], "==", "p1"}], "&&", 
      RowBox[{
       RowBox[{"fff", "[", 
        RowBox[{"10", ",", "a", ",", "b"}], "]"}], "\[Equal]", "p2"}]}], ",", 
     
     RowBox[{"{", 
      RowBox[{"a", ",", "b"}], "}"}]}], "]"}], "/.", 
   RowBox[{
    TemplateBox[{"1"},
     "C"], "\[Rule]", "0"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
