                    "--", "--"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}]}]}]}]}]}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "myFocalSurfaceAnalyze", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"myFocalSurfaceAnalyze", "[", 
      RowBox[{
      "points3DOnTheFS_", ",", "points2DOnTheFS_", ",", "pointsTiltOnTheFS_", 
       ",", "tilt_", 
       RowBox[{"(*", " ", "RADIANS", " ", "*)"}], ",", 
       RowBox[{"sensorPitch_", ":", "1"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
        "sizeFSTrnsvrs", ",", "sizeFSThrdDim", ",", "areaFS", ",", 
         "numSensors", ",", "resThetaProj", ",", "resTheta", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"theDirScreenInCentralPlane", ","}], "*)"}], 
         "\[IndentingNewLine]", "pointsTiltProjOnTheFS", ",", "vvv", ",", 
         "uuu", ",", "\[IndentingNewLine]", "trnsvrsMagnification", ",", 
         "thrdDimMagnification", ",", "zPDACenter", ",", "xPDACenter", ",", 
         "finalRaysDir"}], "\[IndentingNewLine]", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"!", 
         RowBox[{
          RowBox[{"@", "#$"}], "%", " ", "changed", " ", "for", " ", "a", " ",
           "split", " ", 
          RowBox[{"PD", ":", 
           RowBox[{
           "pass", " ", "all", " ", "data", " ", "and", " ", "only", " ", 
            "do", " ", "calculations", " ", "here"}]}]}]}], "*)"}], 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "@", "points3DOnTheFS"}], "\[LessEqual]", "0"}],
            "||", 
           RowBox[{
            RowBox[{"Length", "@", "points2DOnTheFS"}], "\[LessEqual]", 
            "0"}]}], ",", 
          RowBox[{
           RowBox[{
           "bigBanner", 
            "[", "\"\< ERROR ON myFocalSurfaceAnalyze - Returning \>\"", 
            "]"}], ";", 
           RowBox[{"Return", "[", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"improve", ":", 
          RowBox[{
          "tilt", " ", "screen", " ", "can", " ", "be", " ", "determined", " ",
            "by", " ", "points3DOnTheFS"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"zPDACenter", "=", 
         RowBox[{"Median", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "points3DOnTheFS", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"xPDACenter", "=", 
         RowBox[{"Median", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "points3DOnTheFS", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Histogram", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Transpose", "[", "points2DOnTheFS", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "100", ",", 
          RowBox[{"AspectRatio", "\[Rule]", 
           RowBox[{"1", "/", "2"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Histogram", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Transpose", "[", "points2DOnTheFS", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "100", ",", 
          RowBox[{"AspectRatio", "\[Rule]", 
           RowBox[{"1", "/", "2"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"sizeFSTrnsvrs", "=", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "points2DOnTheFS", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "-", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "points2DOnTheFS", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sizeFSThrdDim", "=", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "points2DOnTheFS", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "-", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "points2DOnTheFS", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"areaFS", "=", 
         RowBox[{"sizeFSTrnsvrs", "*", 
          RowBox[{"sizeFSThrdDim", "/", "1000000"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"numSensors", "=", 
         RowBox[{"sizeFSTrnsvrs", "*", 
          RowBox[{"sizeFSThrdDim", "/", 
           RowBox[{"sensorPitch", "^", "2"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"resThetaProj", "=", 
         RowBox[{"{", "}"}]}], ";", 
        RowBox[{"resTheta", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"theDirScreenInCentralPlane", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", "tilt", "]"}], ",", 
             RowBox[{"Sin", "[", "tilt", "]"}], ",", "0"}], "}"}]}], ";"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"finalRaysDir", "=", 
         RowBox[{
          RowBox[{"Mean", "[", 
           RowBox[{"ArcTan", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Transpose", "[", "pointsTiltOnTheFS", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], "/", 
             RowBox[{
              RowBox[{"Transpose", "[", "pointsTiltOnTheFS", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], "/", 
          "Degree"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "pointsTiltOnTheFS", "]"}], ">", "0"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"resTheta", ",", 
             RowBox[{"1000", "*", 
              RowBox[{"ArcCos", "[", 
               RowBox[{"pointsTiltOnTheFS", ".", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Cos", "[", "tilt", "]"}], ",", 
                  RowBox[{"Sin", "[", "tilt", "]"}], ",", "0"}], "}"}]}], 
               "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"pointsTiltProjOnTheFS", "=", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"Transpose", "[", "pointsTiltOnTheFS", "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"Transpose", "[", "pointsTiltOnTheFS", "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"Length", "[", "pointsTiltOnTheFS", "]"}]}], "]"}]}],
               "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"uuu", "=", 
            RowBox[{"Map", "[", 
             RowBox[{"Normalize", ",", "pointsTiltProjOnTheFS"}], "]"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"vvv", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Cross", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Cos", "[", "tilt", "]"}], ",", 
                  RowBox[{"Sin", "[", "tilt", "]"}], ",", "0"}], "}"}], ",", 
                RowBox[{"uuu", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", 
                RowBox[{"Length", "[", "uuu", "]"}]}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"resThetaProj", ",", 
             RowBox[{"1000", "*", 
              RowBox[{"ArcSin", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", "vvv", "]"}], "[", 
                RowBox[{"[", "3", "]"}], "]"}], "]"}]}]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", "\"\<zero length pointsTiltOnTheFS\>\"", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Remove", "[", "uuu", "]"}]}], "\[IndentingNewLine]", ",", 
          "\[IndentingNewLine]", 
          RowBox[{
          "Print", "[", "\"\<zero length pointsTiltOnTheFS  \>\"", "]"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"trnsvrsMagnification", "=", 
         RowBox[{"sizeFSTrnsvrs", "/", 
          RowBox[{"(", 
           RowBox[{"2", "*", "halfOpenAngleMRad"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"thrdDimMagnification", "=", 
         RowBox[{"sizeFSThrdDim", "/", 
          RowBox[{"(", 
           RowBox[{"2", "*", "halfOpenAngleMRad"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"resThetaProj", "=", 
         RowBox[{"Flatten", "[", "resThetaProj", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"resTheta", "=", 
         RowBox[{"Flatten", "[", "resTheta", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"Histogram", "[", 
          RowBox[{"resThetaProj", ",", 
           RowBox[{
           "ChartElementFunction", "\[Rule]", "\"\<FadingRectangle\>\""}], ",", 
           RowBox[{"ChartStyle", "\[Rule]", "Orange"}], ",", 
           RowBox[{"PlotLabel", "\[Rule]", "\"\<resThetaProj (mrad)\>\""}], ",", 
           RowBox[{"AspectRatio", "\[Rule]", 
            RowBox[{"1", "/", "2"}]}], ",", 
           RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"Histogram", "[", 
          RowBox[{"resTheta", ",", 
           RowBox[{
           "ChartElementFunction", "\[Rule]", "\"\<FadingRectangle\>\""}], ",", 
           RowBox[{"ChartStyle", "\[Rule]", "Orange"}], ",", 
           RowBox[{"PlotLabel", "\[Rule]", "\"\<resTheta (mrad)\>\""}], ",", 
           RowBox[{"AspectRatio", "\[Rule]", 
            RowBox[{"1", "/", "2"}]}], ",", 
           RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   zPDACenter                                           \
            \>\"", ",", 
          RowBox[{"nf1", "[", "zPDACenter", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   xPDACenter                                           \
            \>\"", ",", 
          RowBox[{"nf1", "[", "xPDACenter", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   finalRaysDir in plane z-x (degrees)                  \
            \>\"", ",", 
          RowBox[{"nf1", "[", "finalRaysDir", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   Mean resThetaProj         (mrad)                     \
            \>\"", ",", 
          RowBox[{"nf1", "[", 
           RowBox[{"Mean", "[", "resThetaProj", "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   Median resThetaProj       (mrad)                     \
            \>\"", ",", 
          RowBox[{"nf1", "[", 
           RowBox[{"Median", "[", "resThetaProj", "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   Mean resTheta             (mrad)                     \
            \>\"", ",", 
          RowBox[{"nf1", "[", 
           RowBox[{"Mean", "[", "resTheta", "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   Median resTheta           (mrad)                     \
            \>\"", ",", 
          RowBox[{"nf1", "[", 
           RowBox[{"Median", "[", "resTheta", "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   Estimated size PD-plane local z-Trnsvrs coordinate \
(mm)          \>\"", ",", 
          RowBox[{"nf1", "[", "sizeFSTrnsvrs", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   Estimated size PD-plane ThrdDim (mm)                 \
            \>\"", ",", 
          RowBox[{"nf1", "[", "sizeFSThrdDim", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   Estimated area of the PD-plane (m**2)                \
            \>\"", ",", 
          RowBox[{"nf1", "[", "areaFS", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   Estimated number of sensors (one half detector)      \
            \>\"", ",", 
          RowBox[{"nf1", "[", "numSensors", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   Assumed Nominal Sensor Pitch                         \
            \>\"", ",", 
          RowBox[{"nf1", "[", "sensorPitch", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   Transverse Magnification (mm/mrad) - meaningful for \
one single particle ray-tracing \>\"", ",", 
          RowBox[{"nf3", "[", "trnsvrsMagnification", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   ThrdDim Magnification    (mm/mrad) - meaningful for \
one single particle ray-tracing \>\"", ",", 
          RowBox[{"nf3", "[", "thrdDimMagnification", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<   Average Magnification    (mm/mrad) - meaningful for \
one single particle ray-tracing \>\"", ",", 
          RowBox[{"nf3", "[", 
           RowBox[{"average", "[", 
            RowBox[{"trnsvrsMagnification", ",", "thrdDimMagnification"}], 
            "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
        "miniBanner", 
         "[", "\"\<For full PDA magnfication use \
(maxPos-asyRngRadius)/trackAngle\>\"", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<zPDACenter\>\"", ",", "\"\<xPDACenter\>\"", 
           ",", "\"\<sizeFSTrnsvrs\>\"", ",", "\"\<sizeFSThrdDim\>\"", 
           ",", "\"\<Median[resThetaProj]\>\"", 
           ",", "\"\<Median[resTheta]\>\""}], "}"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"{", 
          RowBox[{
          "zPDACenter", ",", "xPDACenter", ",", "sizeFSTrnsvrs", ",", 
           "sizeFSThrdDim", ",", 
           RowBox[{"Median", "[", "resThetaProj", "]"}], ",", 
           RowBox[{"Median", "[", "resTheta", "]"}]}], "}"}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 Evaluatable->True,
 InitializationCell->True,
