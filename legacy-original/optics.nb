Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"radialize", "[", 
    RowBox[{"center_", ",", "p1_", ",", "p2_", ",", 
     RowBox[{"point_", ":", "0"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Projection", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}], ",", "Dot"}], "]"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"point", "==", "0"}], ",", 
        RowBox[{"point", "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"p1", "+", "p2"}], ")"}], "/", "2"}], ")"}]}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"Projection", "[", 
        RowBox[{
         RowBox[{"p1", "-", "p2"}], ",", 
         RowBox[{"point", "-", "center"}], ",", "Dot"}], "]"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
