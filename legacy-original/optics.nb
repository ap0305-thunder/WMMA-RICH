     RowBox[{"rayFan", "[", 
      RowBox[{
      "size_", ",", "thetaY_", ",", "thetaX_", ",", "zeta_", ",", 
       "numRays_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", "x0", ",", "y0", ",", "z0"}], "}"}], ",", 
       RowBox[{
        RowBox[{"x0", "=", 
         RowBox[{"zeta", "*", 
