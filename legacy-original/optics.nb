                 ",", "\"\<RayStartPrevious\>\"", 
                 ",", "\"\<RayEndPrevious\>\"", ",", "\"\<RayStart\>\"", 
                 ",", "\"\<RayEnd\>\"", ",", "\"\<RayLengthPrevious\>\"", 
                 ",", "\"\<RayLength\>\"", ",", 
                 "\[IndentingNewLine]", "\"\<OpticalLengthPrevious\>\"", 
                 ",", "\"\<OpticalLength\>\"", 
                 ",", "\"\<IntersectionNumber\>\"", 
                 ",", "\"\<GenerationNumber\>\"", 
                 ",", "\"\<SurfaceCoordinates\>\""}], "}"}]}], 
              "\[IndentingNewLine]", "}"}]}]}], "]"}]}]}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
