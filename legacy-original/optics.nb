  RowBox[{
   RowBox[{
    RowBox[{"execBackTracing", "[", 
     RowBox[{"re_", ",", "rd_", ",", "rc_", ",", "rv_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p", ",", "q", ",", "d", ",", "gamma1", ",", "gamma2", ",", "gammap", ",",
         "gammaq", ",", "unitPerp", ",", "unitCE", ",", "unit3", ",", "rvRec",
         ",", "err", ",", "trackPhotonPlaneUnitVector", ",", 
        "trackUnitVector", ",", "projXLocal", ",", "projYLocal"}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"p", "=", 
        RowBox[{"Norm", "[", 
         RowBox[{"rd", "-", "rc"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"q", "=", 
        RowBox[{"Norm", "[", 
         RowBox[{"re", "-", "rc"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"d", "=", 
        RowBox[{"Norm", "[", 
         RowBox[{"rd", "-", "re"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"angles", "[", 
        RowBox[{"p", ",", "q", ",", "d", ",", "radiusPriMir"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gamma1", "=", 
        RowBox[{"ArcTan", "[", 
         RowBox[{
          RowBox[{"Sin", "[", "alpha", "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"radiusPriMir", "/", "q"}], "-", 
            RowBox[{"Cos", "[", "alpha", "]"}]}], ")"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gamma2", "=", 
        RowBox[{"ArcTan", "[", 
         RowBox[{
          RowBox[{"Sin", "[", "beta", "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"radiusPriMir", "/", "p"}], "-", 
            RowBox[{"Cos", "[", "beta", "]"}]}], ")"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gammaq", "=", 
        RowBox[{"ArcCos", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"radiusPriMir", "^", "2"}], "+", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"rv", "-", "re"}], "]"}], "^", "2"}], "-", 
            RowBox[{"q", "^", "2"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", "*", "radiusPriMir", "*", 
            RowBox[{"Norm", "[", 
             RowBox[{"rv", "-", "re"}], "]"}]}], ")"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gammap", "=", 
        RowBox[{"ArcCos", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"radiusPriMir", "^", "2"}], "+", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"rv", "-", "rd"}], "]"}], "^", "2"}], "-", 
            RowBox[{"p", "^", "2"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", "*", "radiusPriMir", "*", 
            RowBox[{"Norm", "[", 
             RowBox[{"rv", "-", "rd"}], "]"}]}], ")"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"unitPerp", "=", 
        RowBox[{"Normalize", "[", 
         RowBox[{"Cross", "[", 
          RowBox[{
           RowBox[{"re", "-", "rc"}], ",", 
           RowBox[{"rd", "-", "rc"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"unitCE", "=", 
        RowBox[{"Normalize", "[", 
         RowBox[{"re", "-", "rc"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"unit3", "=", 
        RowBox[{"Normalize", "[", 
         RowBox[{"Cross", "[", 
          RowBox[{"unitPerp", ",", "unitCE"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rvRec", "=", 
        RowBox[{
         RowBox[{"unitCE", "*", "radiusPriMir", "*", 
          RowBox[{"Cos", "[", "alpha", "]"}]}], "+", 
         RowBox[{"unit3", "*", "radiusPriMir", "*", 
          RowBox[{"Sin", "[", "alpha", "]"}]}], "+", "rc"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"err", "=", 
        RowBox[{"Norm", "[", 
         RowBox[{"rv", "-", "rvRec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Err:    \>\"", ",", "err"}], "]"}], ";"}], "*)"}], 
       RowBox[{"trackPhotonPlaneUnitVector", "=", 
        RowBox[{"Normalize", "[", 
         RowBox[{"Cross", "[", 
          RowBox[{"trackDir", ",", 
           RowBox[{"rvRec", "-", "re"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"localPerpUnitVector", ",", "localThirdUnitVector"}], "}"}], 
        "=", 
        RowBox[{"localTrackUnitVectors", "[", "trackDir", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"projXLocal", "=", 
        RowBox[{"Dot", "[", 
         RowBox[{"trackPhotonPlaneUnitVector", ",", "localPerpUnitVector"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"projYLocal", "=", 
        RowBox[{"Dot", "[", 
         RowBox[{"trackPhotonPlaneUnitVector", ",", "localThirdUnitVector"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"resChThe", ",", 
         RowBox[{"VectorAngle", "[", 
          RowBox[{
           RowBox[{"rvRec", "-", "re"}], ",", "trackDir"}], "]"}]}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"resChPhi", ",", 
         RowBox[{"ArcTan", "[", 
          RowBox[{"projXLocal", ",", "projYLocal"}], "]"}]}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"OLD", " ", "CASINO", " ", "BUGS"}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"trackUnitVector", "=", 
        RowBox[{"Normalize", "[", 
         RowBox[{"Cross", "[", 
          RowBox[{
           RowBox[{"Normalize", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"trackDir", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"trackDir", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "0"}], "}"}], "]"}], ",", 
           
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "trackPhotonPlaneUnitVector", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "trackUnitVector", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< A :\>\"", ",", "trackUnitVector"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< B :\>\"", ",", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Cross", "[", 
            RowBox[{"trackDir", ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", "30"}], 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"projYPrime", "=", 
        RowBox[{"Dot", "[", 
         RowBox[{"trackPhotonPlaneUnitVector", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"projXPrime", "=", 
        RowBox[{"Dot", "[", 
         RowBox[{"trackPhotonPlaneUnitVector", ",", "trackUnitVector"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"trackDir2", "=", "trackDir"}], ";", "\[IndentingNewLine]", 
       RowBox[{
       "trackPhotonPlaneUnitVector2", "=", "trackPhotonPlaneUnitVector"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"trackUnitVector2", "=", "trackUnitVector"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"trackUnitVector2BIS", "=", 
        RowBox[{"Normalize", "[", 
         RowBox[{"Cross", "[", 
          RowBox[{"trackDir", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"third", "=", 
        RowBox[{"-", 
         RowBox[{"Normalize", "[", 
          RowBox[{"Cross", "[", 
           RowBox[{"trackDir", ",", "trackUnitVector2BIS"}], "]"}], "]"}]}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"projXPrime2", "=", 
        RowBox[{"Dot", "[", 
         RowBox[{"trackPhotonPlaneUnitVector", ",", "trackUnitVector"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"projXPrime2BIS", "=", 
        RowBox[{"Dot", "[", 
         RowBox[{"trackPhotonPlaneUnitVector", ",", "trackUnitVector2BIS"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"projYPrime2", "=", 
        RowBox[{"Dot", "[", 
         RowBox[{"trackPhotonPlaneUnitVector", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"projYPrime2BIS", "=", 
        RowBox[{"Dot", "[", 
         RowBox[{"trackPhotonPlaneUnitVector", ",", "third"}], "]"}]}], ";"}],
       "*)"}], "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
