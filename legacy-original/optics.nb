           RowBox[{"integratedNumberWavLenSpectrum", "[", 
            RowBox[{"\[Lambda]2", ",", "beta"}], "]"}], "-", 
           RowBox[{"integratedNumberWavLenSpectrum", "[", 
            RowBox[{"\[Lambda]1", ",", "beta"}], "]"}]}], "]"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "x", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"numPho", "[", 
  RowBox[{"betaInfinity", ",", "\[Lambda]Min", ",", "\[Lambda]Max"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
