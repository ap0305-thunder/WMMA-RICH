Cell["Quartic solution to back - tracing", "Subsubtitle",
 InitializationCell->True,
 Background->RGBColor[
  1., 1., 0.7],ExpressionUUID->"e70155c3-cdab-4335-92e5-84a8967dc219"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"wp", "=", "50"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sumAB", "[", 
    RowBox[{"p_", ",", "q_", ",", "d_"}], "]"}], "=", 
   RowBox[{"ArcCos", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"p", "^", "2"}], "+", 
       RowBox[{"q", "^", "2"}], "-", 
       RowBox[{"d", "^", "2"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "p", " ", "q"}], ")"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "\[Alpha]", "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"radius", "/", "p"}], "-", 
          RowBox[{"Cos", "[", "\[Beta]", "]"}]}], ")"}]}], "-", 
       RowBox[{
        RowBox[{"Sin", "[", "\[Beta]", "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"radius", "/", "q"}], "-", 
          RowBox[{"Cos", "[", "\[Alpha]", "]"}]}], ")"}]}]}], "/.", 
      RowBox[{"\[Beta]", "\[Rule]", 
       RowBox[{
        RowBox[{"sumAB", "[", 
         RowBox[{"p", ",", "q", ",", "d"}], "]"}], "-", "\[Alpha]"}]}]}], "//",
      "TrigExpand"}], "//", "FullSimplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eq1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", "\[Alpha]", "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"radius", "/", "p"}], "-", 
         RowBox[{"Cos", "[", "\[Beta]", "]"}]}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Beta]", "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"radius", "/", "q"}], "-", 
         RowBox[{"Cos", "[", "\[Alpha]", "]"}]}], ")"}]}]}], "/.", 
     RowBox[{"\[Beta]", "\[Rule]", 
      RowBox[{
       RowBox[{"sumAB", "[", 
        RowBox[{"p", ",", "q", ",", "d"}], "]"}], "-", "\[Alpha]"}]}]}], "//",
     "TrigExpand"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eq2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", "\[Alpha]", "]"}], "^", "2"}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Alpha]", "]"}], "^", "2"}], "-", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eq2bis", "=", 
   RowBox[{"eq2", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "\[Alpha]", "]"}], "\[Rule]", "X"}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Alpha]", "]"}], "\[Rule]", "Y"}]}], "}"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"eq1bis", "=", 
   RowBox[{"eq1", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "\[Alpha]", "]"}], "^", "2"}], "\[Rule]", 
       RowBox[{"1", "-", 
        RowBox[{"X", "^", "2"}]}]}], ",", 
      RowBox[{
       RowBox[{"Cos", "[", "\[Alpha]", "]"}], "\[Rule]", "X"}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Alpha]", "]"}], "\[Rule]", "Y"}]}], "}"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"solY", "=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"eq1bis", "\[Equal]", "0"}], ",", 
      RowBox[{"{", "Y", "}"}], ",", 
      RowBox[{"WorkingPrecision", "\[Rule]", "wp"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eq2tris", "=", 
    RowBox[{"eq2bis", "/.", "solY"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"solX", "=", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"eq2tris", "\[Equal]", "0"}], ",", "X", ",", 
     RowBox[{"WorkingPrecision", "\[Rule]", "wp"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"resX", "[", 
    RowBox[{"p_", ",", "q_", ",", "d_", ",", "radius_"}], "]"}], "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"X", "/.", "solX"}], ",", "wp"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"resY", "[", 
     RowBox[{"p_", ",", "q_", ",", "d_", ",", "radius_"}], "]"}], "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Y", "/.", "solY"}], "/.", "solX"}], ",", "wp"}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]"}], "Input",
 Evaluatable->True,
 InitializationCell->True,
 Background->ThemeColor[{0.929 -> "Foreground", 0.071 -> "Background"}],
 CellLabel->
  "6/16/26 17:52:11 \
