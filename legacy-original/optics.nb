Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"tworaysout", "=", 
    RowBox[{"CustomDeflections", "[", 
     RowBox[{"myOptics", ",", 
      RowBox[{"Function", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Ray", "[", 
          RowBox[{
           RowBox[{"WaveLength", "->", ".6"}], ",", 
           RowBox[{"Intensity", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{".5", "*", "Intensity"}], "/.", "#"}], ")"}]}]}], 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{",", 
             RowBox[{
              RowBox[{
               RowBox[{"RayTilt", "->", 
                RowBox[{"(", 
                 RowBox[{"#", "/", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"#", ".", "#"}], "]"}]}], ")"}]}], "&"}], "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"100", ",", "0", ",", "0"}], "}"}], "-", 
               RowBox[{"(", 
                RowBox[{"RayEnd", "/.", "#"}], ")"}]}], "]"}]}], "]"}], 
           "*)"}], "]"}], ",", 
         RowBox[{"Ray", "[", 
          RowBox[{
           RowBox[{"Intensity", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{".5", "*", "Intensity"}], "/.", "#"}], ")"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"RayTilt", "->", 
              RowBox[{"(", 
               RowBox[{"#", "/", 
                RowBox[{"Sqrt", "[", 
                 RowBox[{"#", ".", "#"}], "]"}]}], ")"}]}], "&"}], "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"100", ",", "100", ",", "0"}], "}"}], "-", 
             RowBox[{"(", 
              RowBox[{"RayEnd", "/.", "#"}], ")"}]}], "]"}]}], "]"}]}], "}"}],
        "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\n", 
   RowBox[{"opticalSystemLHCbRICHAllTracks", "=", 
    RowBox[{"{", 
     RowBox[{"tworaysout", ",", "myOptics", ",", "myBoundary"}], "}"}]}], ";",
    "\[IndentingNewLine]", 
   RowBox[{"res", "=", 
    RowBox[{"AnalyzeSystem", "[", 
     RowBox[{"(*", "opticalSystemLHCbRICHAllTracks", "*)"}], 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"WedgeOfRays", "[", "10", "]"}], ",", "tworaysout", 
        RowBox[{"(*", 
         RowBox[{"Move", "[", 
          RowBox[{"tworaysout", ",", "100", ",", 
           RowBox[{"-", "45"}]}], "]"}], "*)"}], ",", 
        RowBox[{"Boundary", "[", "200", "]"}]}], "}"}], ",", 
      RowBox[{"PlotType", "->", "TopView"}]}], "]"}]}], ";"}], 
  "*)"}]], "Input",
