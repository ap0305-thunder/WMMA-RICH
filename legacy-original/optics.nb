Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "findRingCenter", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"findRingCenter", "[", "points_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "plot", ",", "sphermat", ",", "planeDirection", ",", "spherrhs", ",", 
       "spherparams", ",", "center", ",", "radius"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"adapted", " ", "from", " ", 
        RowBox[{"https", ":"}]}], "//", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"mathematica", ".", "stackexchange", ".", "com"}], "/", 
           "questions"}], "/", "16209"}], "/", "how"}], "-", "to", "-", 
        "determine", "-", "the", "-", "center", "-", "and", "-", "radius", "-",
         "of", "-", "a", "-", "circle", "-", "given", "-", "some", "-", 
        "points", "-", "in", "-", 
        RowBox[{"3", "d"}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"plot", "=", 
       RowBox[{"Graphics3D", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"PointSize", "[", "Large", "]"}], ",", "Red", ",", 
           RowBox[{"Point", "/@", "points"}]}], "}"}], ",", 
         RowBox[{"BoxRatios", "->", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
         RowBox[{"Axes", "->", "True"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"planeDirection", "=", 
       RowBox[{"Normalize", "@", 
        RowBox[{"Chop", "@", 
         RowBox[{"LeastSquares", "[", 
          RowBox[{"points", ",", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"1", ",", 
             RowBox[{"Length", "[", "points", "]"}]}], "]"}]}], "]"}]}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"sphermat", "=", 
       RowBox[{"ArrayPad", "[", 
        RowBox[{
         RowBox[{"2", "*", "points"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", "1"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"spherrhs", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", ".", "#"}], "&"}], ",", "points"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"spherparams", "=", 
       RowBox[{"LeastSquares", "[", 
        RowBox[{"sphermat", ",", "spherrhs"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"center", "=", 
       RowBox[{"Chop", "@", 
        RowBox[{"Most", "[", "spherparams", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"radius", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Last", "[", 
         RowBox[{"spherparams", "+", 
          RowBox[{"center", ".", "center"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{"center", ",", "radius", ",", "planeDirection", ",", "plot"}],
         "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 Evaluatable->True,
