(*****************************************************************************\
****************************************)
(* Realistic Cherenkov tracks *)
(* Acceptance uniform scan *)
(* very inefficient choice of source *)
(*****************************************************************************\
****************************************)
(* often the cell quits the kernel from here on *)
(*****************************************************************************\
****************************************)
(*
debugPrintEnabledFlag=True;
numRandomPhotons=1;
numPhoAlongTrack=3; (*!@#$% to fix end of track on mirror??? no... *)
numPhoInAzimuth=2;
(**)
If[numRandomPhotons>0
,
listOfWavLenSim=waveln[generatePhotonEnergy[numRandomPhotons]]
,
antiCl=1/(2*30);
numGeneratedPhotonsForWaveLengthBand=10000;
listOfWavLenSim=waveln[generatePhotonEnergy[\
numGeneratedPhotonsForWaveLengthBand]];
debugPrint[Histogram[listOfWavLenSim]];
q=Quantile[listOfWavLenSim,{0.+antiCl,1/2,1.-antiCl}];
lLo=q[[1]];
lMi=q[[2]];
lHi=q[[3]];
listOfWavLenSim={lLo,lMi,lHi};
numRandomPhotons=Length@listOfWavLenSim;
debugPrint[\" median   q= \",nf1[0.5],               \"         = \
\",nf1[q[[2]]]];
debugPrint[\" quantile q= \",nf1[0.+antiCl],\"         = \",nf1[lLo]];
debugPrint[\" quantile q= \",nf1[1.-antiCl],\"         = \",nf1[lHi]];
Clear[q]
];
(**)
generateSequence[xMin_,xMax_,n_]:=Module[{},
If[n<1||xMin>xMax,Return[{}],
If[n\[Equal]1&&xMin\[LessEqual]xMax,Return[{(xMin+xMax)/2}],
Return[DeleteDuplicates[Table[xMin+i*(xMax-xMin)/(n-1),{i,0,n-1}]]]
]
]
];
(**)
numStepsT=3;
numSteps3=3;
minDThetaT=0.025+0.010;
minDTheta3=0.0;
minDTheta3=minDThetaT;
maxDThetaT=0.250-0.015;
maxDTheta3=0.300-0.065;
thetaTList=generateSequence[minDThetaT,maxDThetaT,numStepsT];
theta3List=generateSequence[minDTheta3,maxDTheta3,numSteps3];
(* for an unbiased scan in \"3\" shoud use the symmetric interval to look at \
unbiased plots!!! *)
(**)
*)
(*
(* !@#$% PASS WavLen to OPTICA!!!! *)
mySource={};
trackImprintOnTheFS={};
Do[
Do[
bigBanner[\"NEW\"];
Do[AppendTo[mySource,CherenkovPhotonsXYTrack[
chrnkvAngle[partMass,partMomentum,Evaluate[listOfWavLenSim[[i]]]]/Degree,
numPhoAlongTrack,numPhoInAzimuth,thetaTList[[jT]],thetaTList[[j3]],0,1
(*,twist=k*)
]
];
Print[\" \[Theta]3 = \",nf1[N[theta3List[[j3]]]],\" --- \[Theta]T = \
\",nf1[N[thetaTList[[jT]]]]]
,{i,1,numRandomPhotons}
];
,{jT,1,Length@thetaTList}
];
,{j3,1,Length@theta3List}
];
*)\
\>", "Text",
