}]}]}]}]}]}]}]}]}]}]}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"calcSphericalPrimaryMirror", "[", 
     RowBox[{
     "size_", ",", "tilt_", ",", "radius_", ",", "thetaMinPriMir_", ",", 
      "p2z$local_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p", ",", "q", ",", "sol", ",", "halfAnglePriMir", ",", 
        "sagittaPriMir", ",", "antiSagittaPriMir", ",", "\[IndentingNewLine]",
         "crossPriMir", ",", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "centerPriMir", ",", "centerPriMir3D", ",", "vrtxPriMir", ",", 
          "zVrtxPriMir", ",", "xVrtxPriMir", ","}], "*)"}], 
        "\[IndentingNewLine]", "zPriMirMinVar", ",", "\[IndentingNewLine]", 
        "xPriMirMinVar", ",", "\[IndentingNewLine]", "zPriMirMaxVar", ",", 
        "\[IndentingNewLine]", "xPriMirMaxVar", ",", "\[IndentingNewLine]", 
        "lhcbTiltAngle"}], "\[IndentingNewLine]", "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"printD", "@", "size"}], ";", "\[IndentingNewLine]", 
       RowBox[{"printD", "@", "tilt"}], ";", "\[IndentingNewLine]", 
       RowBox[{"printD", "@", "radius"}], ";", "\[IndentingNewLine]", 
       RowBox[{"printD", "@", "thetaMinPriMir"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"printD", "@", "p2z$local"}], ";", "\[IndentingNewLine]", 
       RowBox[{"zPriMirMinVar", "=", 
        RowBox[{
         RowBox[{"Cos", "[", "thetaMinPriMir", "]"}], "*", "p"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xPriMirMinVar", "=", 
        RowBox[{
         RowBox[{"Sin", "[", "thetaMinPriMir", "]"}], "*", "p"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zPriMirMaxVar", "=", "p2z$local"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xPriMirMaxVar", "=", "q"}], ";", "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"N", "@", 
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"dist", "[", 
               RowBox[{
               "zPriMirMinVar", ",", "xPriMirMinVar", ",", "zPriMirMaxVar", ",",
                 "xPriMirMaxVar"}], "]"}], "\[Equal]", "size"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "1"}], "/", 
               RowBox[{"AngCoeff", "[", 
                RowBox[{
                "zPriMirMinVar", ",", "xPriMirMinVar", ",", "zPriMirMaxVar", ",",
                  "xPriMirMaxVar"}], "]"}]}], "\[Equal]", 
              RowBox[{"Tan", "[", "tilt", "]"}]}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"p", ",", "q"}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zPriMirMin", "=", 
        RowBox[{"zPriMirMinVar", "/.", 
         RowBox[{"sol", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xPriMirMin", "=", 
        RowBox[{"xPriMirMinVar", "/.", 
         RowBox[{"sol", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"zPriMirMax", "=", 
        RowBox[{"zPriMirMaxVar", "/.", 
         RowBox[{"sol", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xPriMirMax", "=", 
        RowBox[{"xPriMirMaxVar", "/.", 
         RowBox[{"sol", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"zPriMir", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"zPriMirMin", "+", "zPriMirMax"}], ")"}], "/", "2"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"xPriMir", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"xPriMirMin", "+", "xPriMirMax"}], ")"}], "/", "2"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Determine", " ", "the", " ", "axis", " ", "of", " ", "the", " ", 
         "SM"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"dirVectPriMir", "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"zPriMirMax", "-", "zPriMirMin"}], ",", 
           RowBox[{"xPriMirMax", "-", "xPriMirMin"}]}], "}"}], "/", 
         RowBox[{"dist", "[", 
          RowBox[{
          "zPriMirMin", ",", "xPriMirMin", ",", "zPriMirMax", ",", 
           "xPriMirMax"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dirVectPriMirAxis", "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"xPriMirMax", "-", "xPriMirMin"}], ",", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"zPriMirMax", "-", "zPriMirMin"}], ")"}]}]}], "}"}], "/", 
         RowBox[{"dist", "[", 
          RowBox[{
          "zPriMirMin", ",", "xPriMirMin", ",", "zPriMirMax", ",", 
           "xPriMirMax"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"halfAnglePriMir", "=", 
        RowBox[{"ArcSin", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"dist", "[", 
            RowBox[{
            "zPriMirMin", ",", "xPriMirMin", ",", "zPriMirMax", ",", 
             "xPriMirMax"}], "]"}], "/", "2"}], "/", "radius"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"sagittaPriMir", "=", 
        RowBox[{"radius", "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Cos", "[", "halfAnglePriMir", "]"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"antiSagittaPriMir", "=", 
        RowBox[{"radius", "*", 
         RowBox[{"(", 
          RowBox[{"Cos", "[", "halfAnglePriMir", "]"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"crossPriMir", "=", 
        RowBox[{"{", 
         RowBox[{"zPriMir", ",", "xPriMir"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"centerPriMir", "=", 
        RowBox[{"crossPriMir", "-", 
         RowBox[{"antiSagittaPriMir", "*", "dirVectPriMirAxis"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"centerPriMir3D", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{"centerPriMir", ",", "0"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vrtxPriMir", "=", 
        RowBox[{"crossPriMir", "+", 
         RowBox[{"sagittaPriMir", "*", "dirVectPriMirAxis"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zVrtxPriMir", "=", 
        RowBox[{"vrtxPriMir", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xVrtxPriMir", "=", 
        RowBox[{"vrtxPriMir", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"lhcbTiltAngle", "=", 
        RowBox[{"ArcSin", "[", 
         RowBox[{
          RowBox[{"centerPriMir", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "/", "radius"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
       "Print", 
        "[", "\"\< SPHERICAL MIRROR \
==============================================================================\
================== \>\"", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< Spherical mirror ROC : \>\"", ",", "radius"}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< P1 *** {z} Spherical mirror min : \>\"", ",", 
         RowBox[{"nf1", "[", "zPriMirMin", "]"}], 
         ",", "\"\< ----- {transverseCoordinate} Spherical mirror min : \>\"",
          ",", 
         RowBox[{"nf1", "[", "xPriMirMin", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< {z} Spherical mirror Vrtx: \>\"", ",", 
         RowBox[{"nf1", "[", "zVrtxPriMir", "]"}], 
         ",", "\"\< ----- {transverseCoordinate} Spherical mirror Vrtx: \>\"",
          ",", 
         RowBox[{"nf1", "[", "xVrtxPriMir", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< P2 *** {z} Spherical mirror max : \>\"", ",", 
         RowBox[{"nf1", "[", "zPriMirMax", "]"}], 
         ",", "\"\< ----- {transverseCoordinate} Spherical mirror max : \>\"",
          ",", 
         RowBox[{"nf1", "[", "xPriMirMax", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< Tilt Spherical mirror (with respect to the beam-line \
:=: negative z-axis) DEGREES: \>\"", ",", 
         RowBox[{"nf1", "[", 
          RowBox[{
           RowBox[{"180", "-", 
            RowBox[{"tiltPriMir", "/", "Degree"}]}], "//", "N"}], "]"}], 
         ",", "\"\< RADIANS: \>\"", ",", 
         RowBox[{"nf1", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"180", "Degree"}], "-", "tiltPriMir"}], "//", "N"}], 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< Tilt Spherical mirror (LHCb convention) DEGREES: \>\"", 
         ",", 
         RowBox[{"nf1", "[", 
          RowBox[{"lhcbTiltAngle", "/", "Degree"}], "]"}], 
         ",", "\"\< RADIANS: \>\"", ",", 
         RowBox[{"nf1", "[", "lhcbTiltAngle", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< COC Spherical mirror                   \
{z,transverseCoordinate} : \>\"", ",", 
         RowBox[{"nf1", "[", "centerPriMir", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< Vrtx Spherical mirror                  \
{z,transverseCoordinate} : \>\"", ",", 
         RowBox[{"nf1", "[", "vrtxPriMir", "]"}]}], "]"}], ";", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< Center of the Sagitta Spherical mirror \
{z,transverseCoordinate} : \>\"", ",", 
         RowBox[{"nf1", "[", "crossPriMir", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< Spherical mirror width : \>\"", ",", 
         RowBox[{"nf1", "[", "sizeTrnsvrsPriMir", "]"}], 
         ",", "\"\< ------ Spherical mirror ThrdDim : \>\"", ",", 
         RowBox[{"nf1", "[", "sizeThrdDimPriMir", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"printD", "@", "zPriMirMinVar"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "xPriMirMinVar"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "zPriMirMaxVar"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "xPriMirMaxVar"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "[", "sol", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "zPriMirMin"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "xPriMirMin"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "zPriMirMax"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "xPriMirMax"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "zPriMir"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "xPriMir"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "dirVectPriMir"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "dirVectPriMirAxis"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "halfAnglePriMir"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "sagittaPriMir"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "antiSagittaPriMir"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "crossPriMir"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "centerPriMir"}], ";", "\[IndentingNewLine]", 
         
         RowBox[{"printD", "@", "centerPriMir3D"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "vrtxPriMir"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "zVrtxPriMir"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "xVrtxPriMir"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "lhcbTiltAngle"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}]}]], "Input",
