          RowBox[{"\[Beta]", ">", "0"}]}]}]}], "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"numPho", "[", 
    RowBox[{"beta_", ",", "\[Lambda]1_", ",", "\[Lambda]2_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
