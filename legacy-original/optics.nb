  RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "="}], "*)"}], 
  StyleBox["\[IndentingNewLine]",
   FontColor->RGBColor[1, 0, 1],
   Background->RGBColor[0., 1., 0.25098039215686274`]], 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "doCalcPlaneSidewiseCoords", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"doCalcPlaneSidewiseCoords", "[", 
      RowBox[{"z_", ",", "x_", ",", "\[Alpha]_", ",", "l_", ",", 
       RowBox[{"d_", ":", "0"}]}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "zxCoords", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
        "Print", 
         "[", "\"\<\\n >>>>>>>>>>>>>>>>>>>>> plane coordinates sidewise calc \
and report // BEGIN \>\"", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"zxCoords", "=", 
         RowBox[{"(*", 
          RowBox[{"tiltTheViewRotTra3DZ0", "@"}], "*)"}], 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"z", ",", "x"}], "}"}], "+", 
             RowBox[{"#", "*", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Sin", "[", "\[Alpha]", "]"}], ",", 
                RowBox[{"-", 
                 RowBox[{"Cos", "[", "\[Alpha]", "]"}]}]}], "}"}]}]}], "&"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "l"}], "/", "2"}], ",", 
             RowBox[{
              RowBox[{"+", "l"}], "/", "2"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "@", "zxCoords"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"zxCoords", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], ">", " ", 
           RowBox[{
            RowBox[{"zxCoords", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"zxCoords", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"zxCoords", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"zxCoords", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], ";", 
           RowBox[{
           "Print", "[", "\"\<points swapped to get p4z < p3z \>\"", "]"}]}], 
          ",", 
          RowBox[{"Print", "[", "\"\< p4z < p3z\>\"", "]"}]}], " ", "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\< plane edges (P4)  : \>\"", 
          ",", "\"\< *** along z (beam) = \>\"", ",", 
          RowBox[{"nf3", "@", 
           RowBox[{"N", "@", 
            RowBox[{
             RowBox[{"zxCoords", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], 
          ",", "\"\< *** transverseCoordinate / radial from beam = \>\"", ",", 
          RowBox[{"nf3", "@", 
           RowBox[{"N", "@", 
            RowBox[{
             RowBox[{"zxCoords", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}]}], "]"}], ";", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\< plane center  C   : \>\"", 
          ",", "\"\< *** along z (beam) = \>\"", ",", 
          RowBox[{"nf3", "@", 
           RowBox[{"N", "@", "z"}]}], ",", 
          "          ", "\"\< *** transverseCoordinate / radial from beam = \
\>\"", ",", 
          RowBox[{"nf3", "@", 
           RowBox[{"N", "@", "x"}]}]}], "]"}], ";", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\< plane edges (P3)  : \>\"", 
          ",", "\"\< *** along z (beam) = \>\"", ",", 
          RowBox[{"nf3", "@", 
           RowBox[{"N", "@", 
            RowBox[{
             RowBox[{"zxCoords", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], 
          ",", "\"\< *** transverseCoordinate / radial from beam = \>\"", ",", 
          RowBox[{"nf3", "@", 
           RowBox[{"N", "@", 
            RowBox[{
             RowBox[{"zxCoords", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\< plane tilt (with respect to the beam-line :=: positive \
z-axis) DEGREES: \>\"", ",", 
          RowBox[{"nf1", "[", 
           RowBox[{
            RowBox[{"\[Alpha]", "/", "Degree"}], "//", "N"}], "]"}], 
          ",", "\"\< RADIANS: \>\"", ",", 
          RowBox[{"nf1", "[", 
           RowBox[{"\[Alpha]", "//", "N"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\< plane Transverse size       : \>\"", ",", 
          RowBox[{"nf1", "[", "l", "]"}], 
          ",", "\"\< ----- plane ThrdDim size :     \>\"", ",", 
          RowBox[{"nf1", "[", "d", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
        "Print", 
         "[", "\"\< <<<<<<<<<<<<<<<<<<<<< plane coordinates sidewise calc and \
report // END \\n\>\"", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"N", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"zxCoords", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"1.0", "*", 
               RowBox[{"{", 
                RowBox[{"z", ",", "x"}], "}"}]}], ",", 
              RowBox[{"zxCoords", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "d"}], "/", "2"}], ",", 
              RowBox[{
               RowBox[{"+", "d"}], "/", "2"}]}], "}"}]}], "}"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
