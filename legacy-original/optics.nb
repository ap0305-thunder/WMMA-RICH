           RowBox[{"{", 
            RowBox[{"xSecMirVar", ",", "xSecMir"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"tiltSecMirVar", ",", 
           RowBox[{"180", "+", 
            RowBox[{"tiltSecMir", "/", "Degree"}]}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"QUARTZ", " ", "PLATE"}], " ", "//", " ", 
        RowBox[{"TO", " ", 
         RowBox[{"FIX", "/", "check"}], " ", 
         RowBox[{"(", 
          RowBox[{"wavlen", " ", "model"}], ")"}]}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Optical Medium data\>\"", ",", 
        RowBox[{"SearchData", "[", 
         RowBox[{"OpticalMedium", "->", "\"\<F_SILICA\>\""}], "]"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"testQuartzPlate", "=", "False"}], ";", "\[IndentingNewLine]", 
