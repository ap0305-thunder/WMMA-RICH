            RowBox[{"halfOpenAngle", ",", "numPhoAlongTrack", ",", "1", ",", 
             RowBox[{"thetaY", "[", 
              RowBox[{"[", "k", "]"}], "]"}], ",", 
             RowBox[{"thetaX", "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], "]"}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"opticalSystemLHCbRICH", "=", 
          RowBox[{"{", 
           RowBox[{"mySource", ",", "myOptics", ",", "myBoundary"}], "}"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"tTracedSystem", "=", 
            RowBox[{"TurboPlot", "[", 
             RowBox[{"opticalSystemLHCbRICH", ",", 
              RowBox[{"SequentialTrace", "\[Rule]", "True"}]}], "]"}]}], 
           ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"tTracedSystem", "=", 
          RowBox[{"TurboTrace", "[", 
           RowBox[{"opticalSystemLHCbRICH", ",", 
            RowBox[{"SequentialTrace", "\[Rule]", "True"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tracedPoints", "=", 
          RowBox[{"ReadTurboRays", "[", 
           RowBox[{
           "tTracedSystem", ",", "SurfaceCoordinates", ",", "onTheFS"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"tracedPointsDir", "=", 
          RowBox[{"ReadTurboRays", "[", 
           RowBox[{"tTracedSystem", ",", "RayTilt", ",", "onTheFS"}], "]"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "tracedPointsDir", "]"}], ">", "0"}], ",", 
           
           RowBox[{"AppendTo", "[", 
            RowBox[{"resTheta", ",", 
             RowBox[{
              RowBox[{"ArcCos", "[", 
               RowBox[{"tracedPointsDir", ".", "dirScreen"}], "]"}], "/", 
              "Degree"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"\"\<zero length tracedPointsDir - iter: \>\"", ",", 
              RowBox[{"nf0", "[", "k", "]"}]}], "]"}], ";"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
            RowBox[{"OLD", " ", "SLOW", " ", "tracedPointsDir"}], "=", 
            RowBox[{"ReadTurboRays", "[", 
