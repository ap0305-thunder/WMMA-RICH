(*
(*****************************************************************************\
****************************************)
(* Realistic Cherenkov single track *)
(*****************************************************************************\
****************************************)
numRandomPhotons=1000;
stepAngleT=0.265;
stepAngle3=0.250;
mySource={
cherenkovPhotonsRandomGenerate[numRandomPhotons,partMass=toMass[\"Muo\"],\
partMomentum,stepAngleT,stepAngle3,1,0,2\[Pi],0],
cherenkovPhotonsRandomGenerate[numRandomPhotons,partMass=toMass[\"Pio\"],\
partMomentum,stepAngleT,stepAngle3,1,0,2\[Pi],0],
cherenkovPhotonsRandomGenerate[numRandomPhotons,partMass=toMass[\"Kao\"],\
partMomentum,stepAngleT,stepAngle3,1,0,2\[Pi],0]
};
