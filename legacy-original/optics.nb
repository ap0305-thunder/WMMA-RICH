  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EllipseFit", "[", 
      RowBox[{
       RowBox[{"data_", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"MatrixQ", "[", 
           RowBox[{"#", ",", "NumericQ"}], "]"}], "&"}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x0_Symbol", ",", "y0_Symbol"}], "}"}], ",", 
       RowBox[{"opts", ":", 
        RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], "/;", 
     RowBox[{"And", "[", 
      RowBox[{
       RowBox[{"CheckArguments", "[", 
        RowBox[{
         RowBox[{"EllipseFit", "[", 
          RowBox[{"data", ",", 
           RowBox[{"{", 
