Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"tiltAroundVertexMatrix", "[", "\[Alpha]_", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Alpha]", "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"Sin", "[", "\[Alpha]", "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Alpha]", "]"}], ",", 
         RowBox[{"Cos", "[", "\[Alpha]", "]"}]}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"doCalcSphereCenter", "[", 
      RowBox[{
      "zc0_", ",", "xc0_", ",", "zMir_", ",", "xMir_", ",", "tiltMir_"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"centerMirrorTemp", ",", "vrtxTemp", ",", "centerMir"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"centerMirrorTemp", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"zc0", "+", "zMir"}], ",", 
           RowBox[{"xc0", "+", "xMir"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vrtxTemp", "=", 
         RowBox[{"{", 
          RowBox[{"zMir", ",", "xMir"}], "}"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"centerMir", "=", 
         RowBox[{"vrtxTemp", "+", 
          RowBox[{
           RowBox[{"tiltAroundVertexMatrix", "[", "tiltMir", "]"}], ".", 
           RowBox[{"(", 
            RowBox[{"centerMirrorTemp", "-", "vrtxTemp"}], ")"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "centerMir", "]"}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]"}]}]], "Input",
