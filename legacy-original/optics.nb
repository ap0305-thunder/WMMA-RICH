Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "deg", ",", "mm", ",", "normal2", ",", "tangent2", ",", "rot2", ",", 
     "closedPolygon", ",", "transverseRangeFromAperture", ",", 
     "thirdDimRangeFromAperture", ",", "transverseExtentFromAperture", ",", 
     "thirdDimExtentFromAperture", ",", "flatSegmentFromFullSize", ",", 
     "sphericalSegmentFromAperture", ",", "shiftPointList", ",", 
     "sphericalBandFromAperture", ",", "componentData", ",", 
     "opticsComponentTable", ",", "opticsSideView", ",", "opticsApertureView",
      ",", "opticsGeometryReport", ",", "exportOpticsGeometry"}], "]"}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Small", " ", "utilities"}], "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"deg", "[", "a_", "]"}], ":=", 
   RowBox[{"Quiet", "@", 
    RowBox[{"N", "[", 
     RowBox[{"a", "/", "Degree"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mm", "[", "x_", "]"}], ":=", 
   RowBox[{"NumberForm", "[", 
    RowBox[{
     RowBox[{"Quiet", "@", 
      RowBox[{"N", "[", "x", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"10", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"normal2", "[", "t_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", "t", "]"}], ",", 
     RowBox[{"Sin", "[", "t", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tangent2", "[", "t_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sin", "[", "t", "]"}]}], ",", 
     RowBox[{"Cos", "[", "t", "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"swapAxes", "[", "pts_", "]"}], ":=", 
   RowBox[{"Reverse", "/@", "pts"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"swapPoint", "[", "p_", "]"}], ":=", 
    RowBox[{"Reverse", "[", "p", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
