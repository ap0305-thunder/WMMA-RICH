               RowBox[{
                RowBox[{"RayTilt", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"RayTilt", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", "0"}], "}"}], ",", 
              "onTheFS"}], "]"}]}], ";"}], "*)"}], 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "tracedPointsDir", "]"}], ">", "0"}], ",", 
           
           RowBox[{
            RowBox[{"tracedPointsDir", "=", 
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"Transpose", "[", "tracedPointsDir", "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"Transpose", "[", "tracedPointsDir", "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", 
                RowBox[{"ConstantArray", "[", 
                 RowBox[{"0", ",", 
                  RowBox[{"Length", "[", "tracedPointsDir", "]"}]}], "]"}]}], 
               "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"u", "=", 
             RowBox[{"Map", "[", 
              RowBox[{"Normalize", ",", "tracedPointsDir"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"v", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Cross", "[", 
                RowBox[{"dirScreen", ",", 
