  RowBox[{
   RowBox[{"?", "swap"}], 
   RowBox[{"(*", " ", 
    RowBox[{"already", " ", "defined"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "swapTheXYCoords", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"swapTheXYCoords", "[", "v_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "v", "]"}], "!=", "2"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Print", "[", "\"\<ERROR swapTheXYCoords \>\"", "]"}], 
          "]"}], ",", 
         RowBox[{"Return", "[", "  ", 
          RowBox[{
           RowBox[{"(", "1.0", ")"}], "*", "     ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"v", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"v", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"Attributes", "[", "swapTheXYCoords", "]"}]}]}]], "Input",
