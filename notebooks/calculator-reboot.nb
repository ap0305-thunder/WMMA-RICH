       RowBox[{"\[CapitalDelta]m", ">", "0"}], ",", 
       RowBox[{"\[CapitalDelta]mSq", ">", "0"}], ",", 
       RowBox[{"p", ">", "0"}], ",", 
       RowBox[{"0", "<", "\[Beta]", "<", "1"}], ",", 
       RowBox[{"\[Gamma]", "\[GreaterEqual]", "1"}], ",", 
       RowBox[{"m", ">", "0"}], ",", 
       RowBox[{"\[ScriptN]", ">", "1"}], ",", 
       RowBox[{"0", "<", "\[Theta]", "<", 
        RowBox[{"\[Pi]", "/", "2"}]}], ",", 
       RowBox[{"\[Delta]\[Theta]", ">", "0"}], ",", 
       RowBox[{"\[ScriptN]", ">", 
        RowBox[{"1", "/", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], ">", 
        RowBox[{"1", "/", "\[ScriptN]"}]}], ",", 
       RowBox[{"\[Theta]", "<", 
        RowBox[{"ArcCos", "[", 
         RowBox[{"1", "/", "\[ScriptN]"}], "]"}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
