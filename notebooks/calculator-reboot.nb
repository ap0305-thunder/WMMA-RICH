Cell[TextData[{
 "for 3rd degree polynomial\n(1 - \[Beta] Cos[\[Theta]]) = w > 0\n",
 Cell[BoxData[
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"\[Theta]_", ",", "a_", ",", "b_", ",", "\[Beta]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"a", "*", "b", "*", "\[Beta]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], ")"}], 
      RowBox[{"\[Sqrt]", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"a", "*", 
            SuperscriptBox["b", "2"], "*", "\[Beta]", "*", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            RowBox[{"\[Beta]", "*", 
             RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}]}]}], ")"}]}], 
      RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"\[Beta]", "*", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"a", "*", 
            SuperscriptBox["b", "2"]}]}], ")"}], "\[Beta]", "*", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}]}], ")"}]}]}]],
  ExpressionUUID->"07717c2b-29d0-4516-a71b-5e42d628edf8"]
}], "Text",
