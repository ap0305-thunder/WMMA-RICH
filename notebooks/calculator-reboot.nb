       RowBox[{"VertexNormals", "->", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"-", "pts"}], ",", "pts"}], "]"}]}]}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
