Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"z", ",", "l", ",", "f", ",", "g", ",", "c", ",", "t"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"genUnitBox", "[", 
    RowBox[{"z_", ",", 
     RowBox[{"l_", ":", "1"}]}], "]"}], ":=", 
   RowBox[{"UnitBox", "[", 
    RowBox[{"z", "/", "l"}], "]"}]}], 
  RowBox[{"(*", 
   RowBox[{"/;", 
    RowBox[{"l", ">", "0"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"genMovUnitBox", "[", 
    RowBox[{"z_", ",", "t_", ",", "l_", ",", "c_"}], "]"}], ":=", 
   RowBox[{"genUnitBox", "[", 
    RowBox[{
     RowBox[{"z", "-", 
      RowBox[{"c", "*", "t"}]}], ",", "l"}], "]"}]}], 
  RowBox[{"(*", 
   RowBox[{"/;", 
    RowBox[{
     RowBox[{"l", ">", "0"}], "&&", 
     RowBox[{"c", ">=", "0"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"rhoRho", "[", 
     RowBox[{"z_", ",", "t_", ",", 
      RowBox[{"lb_", ":", "1"}], ",", 
      RowBox[{"ld_", ":", "1"}], ",", 
      RowBox[{"cb_", ":", "0"}], ",", 
      RowBox[{"cd_", ":", "0"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"genMovUnitBox", "[", 
      RowBox[{"z", ",", "t", ",", "lb", ",", "cb"}], "]"}], "*", 
     RowBox[{"genMovUnitBox", "[", 
      RowBox[{"z", ",", "t", ",", "ld", ",", "cd"}], "]"}]}]}], 
   RowBox[{"(*", 
    RowBox[{"/;", 
     RowBox[{
      RowBox[{"ld", ">", "0"}], "&&", 
      RowBox[{"lb", ">", "0"}], "&&", 
      RowBox[{"c", ">=", "0"}]}]}], "*)"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoRho", "[", 
   RowBox[{"z_", ",", "t_", ",", 
    RowBox[{"lb_", ":", "1"}], ",", 
    RowBox[{"ld_", ":", "1"}], ",", 
    RowBox[{"cb_", ":", "0"}], ",", 
    RowBox[{"cd_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"genUnitBox", "[", 
    RowBox[{
     RowBox[{"z", "-", 
      RowBox[{"cb", "*", "t"}]}], ",", "lb"}], "]"}], "*", 
   RowBox[{"genUnitBox", "[", 
    RowBox[{
     RowBox[{"z", "+", 
      RowBox[{"cd", "*", "t"}]}], ",", "ld"}], "]"}], 
   RowBox[{"(*", 
    RowBox[{"/;", 
     RowBox[{
      RowBox[{"ld", ">", "0"}], "&&", 
      RowBox[{"lb", ">", "0"}], "&&", 
      RowBox[{"c", ">=", "0"}]}]}], "*)"}]}]}]}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->
  "9/4/25 18:25:09 \
In[4]:=",ExpressionUUID->"905a5054-ed2b-d148-a580-4288e70323bd"],

