        "\[IndentingNewLine]", 
        RowBox[{"totOccupInPixelInBCOTime", " ", ":=", 
         RowBox[{"toCounts", "@", 
          RowBox[{"calcBinaryOccupancyFromTrueToApparent", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
             "bckTrueCntsInPixelInBCOTime", "+", 
              "dniTrueCntsInPixelInBCOTime"}], ")"}], "/", 
