Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "@", "digitize"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"digitize", "[", 
      RowBox[{"x_", ",", "y_", ",", 
       RowBox[{"pixelSize_", ":", "1"}], ",", 
       RowBox[{"offset_", ":", "0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xd", ",", "yd"}], "}"}], ",", 
       RowBox[{
        RowBox[{"xd", "=", 
         RowBox[{
          RowBox[{"pixelSize", "*", 
           RowBox[{"Floor", "[", 
            RowBox[{"x", "/", "pixelSize"}], "]"}]}], "+", 
          RowBox[{"pixelSize", "/", "2"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"yd", "=", 
         RowBox[{
          RowBox[{"pixelSize", "*", 
           RowBox[{"Floor", "[", 
            RowBox[{"y", "/", "pixelSize"}], "]"}]}], "+", 
          RowBox[{"pixelSize", "/", "2"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"N", "@", 
          RowBox[{"{", 
           RowBox[{"xd", ",", "yd"}], "}"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]"}]}]], "Input",
 CellTags->{
  "i:3", "i:4"},ExpressionUUID->"f03342db-b4d3-4608-950a-2b3d49bdd882"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"almostOne", "=", "0.9999999"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "doExecRadiusScans", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"doExecRadiusScans", "[", 
      RowBox[{"numb_", ",", "theRadius_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "resNumb", ",", "resMean", ",", "resStDv", ",", "radius0", ",", 
         "radius", ",", "dataRad", ",", "dataThe", ",", "xRing", ",", "yRing",
          ",", 
         RowBox[{"(*", 
          RowBox[{
          "dataCenterX", ",", "dataCenterY", ",", "xCenter", ",", "yCenter", ",",
            "center", ",", "binnedHit", ",", "varTotBckgPlusNoiseHit", ","}], 
          "*)"}], "binnedRadius", ",", "dist", ",", "distTrue", ",", 
         "distBin"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"allData", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"radius0", "=", 
            RowBox[{"theRadius", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"yCenter", "=", 
               RowBox[{"jy", "*", "centerSize"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"xCenter", "=", 
                  RowBox[{"jx", "*", "centerSize"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
                 RowBox[{"resNumb", "=", 
                  RowBox[{"{", "}"}]}], ";", 
                 RowBox[{"resMean", "=", 
                  RowBox[{"{", "}"}]}], ";", 
                 RowBox[{"resStDv", "=", 
                  RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{
                 "bigBanner", 
                  "[", "\"\< new step: given radius0 xCenter yCenter \>\"", 
                  "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\< radius0            = \>\"", ",", "radius0"}], 
                  "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\< radius/pixel ratio = \>\"", ",", 
                   RowBox[{"radius0", "/", "pixSize"}]}], "]"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\< xCenter            = \>\"", ",", "xCenter"}], 
                  "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\< yCenter            = \>\"", ",", "yCenter"}], 
                  "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\< expected sigma pix = \>\"", ",", 
                   RowBox[{"pixSize", "/", 
                    RowBox[{"Sqrt", "[", "12.", "]"}]}]}], "]"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"Do", "[", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"radius", "=", 
                    RowBox[{"radius0", "+", 
                    RowBox[{"k", "*", "pixSize"}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    
                    RowBox[{"\"\< Start scan radius // radius = \>\"", ",", 
                    "radius", ",", "\"\<     ..... number of steps       \>\"",
                     ",", "numStepsRadius"}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"dataCenterX", "=", 
                    RowBox[{"RandomVariate", "[", 
                    RowBox[{
                    RowBox[{"UniformDistribution", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "centerSize"}], "/", "2"}], ",", 
                    RowBox[{
                    RowBox[{"+", "centerSize"}], "/", "2"}]}], "}"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"numb", ",", "1"}], "}"}]}], "]"}]}], ";", 
                    RowBox[{"dataCenterY", "=", 
                    RowBox[{"RandomVariate", "[", 
                    RowBox[{
                    RowBox[{"UniformDistribution", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "centerSize"}], "/", "2"}], ",", 
                    RowBox[{
                    RowBox[{"+", "centerSize"}], "/", "2"}]}], "}"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"numb", ",", "1"}], "}"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"dataCenterX", "=", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"xCenter", ",", "numb"}], "]"}]}], ";"}], "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"dataCenterY", "=", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"yCenter", ",", "numb"}], "]"}]}], ";"}], "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"center", "=", 
                    RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{"dataCenterX", ",", "dataCenterY"}], "}"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"dataRad", "=", 
                    RowBox[{"RandomVariate", "[", 
                    RowBox[{
                    RowBox[{"NormalDistribution", "[", 
                    RowBox[{"radius", ",", "sigmaChr"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"numb", ",", "1"}], "}"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"dataThe", "=", 
                    RowBox[{"RandomVariate", "[", 
                    RowBox[{
                    RowBox[{"UniformDistribution", "[", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", 
                    RowBox[{"2", "\[Pi]"}]}], "}"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"numb", ",", "1"}], "}"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"xRing", "=", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{"dataRad", "*", 
                    RowBox[{"Cos", "[", "dataThe", "]"}]}], "+", 
                    "dataCenterX"}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"yRing", "=", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{"dataRad", "*", 
                    RowBox[{"Sin", "[", "dataThe", "]"}]}], "+", 
                    "dataCenterY"}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"varTotBckgPlusNoiseHit", "=", 
                    RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{"xRing", ",", "yRing"}], "}"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"binnedHit", "=", 
                    RowBox[{"Transpose", "[", 
                    RowBox[{"digitize", "[", 
                    RowBox[{"xRing", ",", "yRing", ",", "pixSize"}], "]"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"dist", "=", 
                    RowBox[{"MapThread", "[", 
                    RowBox[{"EuclideanDistance", ",", 
                    RowBox[{"{", 
                    RowBox[{"varTotBckgPlusNoiseHit", ",", "binnedHit"}], 
                    "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"distTrue", "=", 
                    RowBox[{"MapThread", "[", 
                    RowBox[{"EuclideanDistance", ",", 
                    RowBox[{"{", 
                    RowBox[{"center", ",", "varTotBckgPlusNoiseHit"}], 
                    "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"bigBanner", "[", "\"\< distTrue \>\"", "]"}], ";",
                     "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"displayHistoStats", "[", 
                    RowBox[{"distTrue", ",", "20"}], "]"}], ";"}], "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"distBin", "=", 
                    RowBox[{"MapThread", "[", 
                    RowBox[{"EuclideanDistance", ",", 
                    RowBox[{"{", 
                    RowBox[{"center", ",", "binnedHit"}], "}"}]}], "]"}]}], ";",
                     "\[IndentingNewLine]", 
                    RowBox[{"bigBanner", "[", "\"\<distBin\>\"", "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"displayHistoStats", "[", 
                    RowBox[{"distBin", ",", "20"}], "]"}], ";"}], "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"binnedRadius", "=", 
                    RowBox[{"Map", "[", 
                    RowBox[{"Norm", ",", 
                    RowBox[{"binnedHit", "-", "center"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"resNumb", ",", "numb"}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"resMean", ",", 
                    RowBox[{"Mean", "[", 
                    RowBox[{"binnedRadius", "-", "radius"}], "]"}]}], "]"}], ";",
                     "\[IndentingNewLine]", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"resStDv", ",", 
                    RowBox[{"StandardDeviation", "[", 
                    RowBox[{"binnedRadius", "-", "radius"}], "]"}]}], "]"}], ";",
                     "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Point", "[", 
                    RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Flatten", "@", "dataCenterX"}], ",", 
