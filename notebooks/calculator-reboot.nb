Cell[BoxData[
 RowBox[{
  RowBox[{"simul", "[", "nRun_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vars", ",", "startVars", ",", "sol", ",", "res0Out", ",", "res1Out", ",",
       "res2Out"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"res0Out", "=", 
        RowBox[{"Flatten", "@", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"RandomVariate", "[", 
             RowBox[{
              RowBox[{"PoissonDistribution", "[", "#", "]"}], ",", "1"}], 
             "]"}], "&"}], ",", "res0"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"res1Out", "=", 
          RowBox[{"Flatten", "@", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"RandomVariate", "[", 
               RowBox[{
                RowBox[{"PoissonDistribution", "[", "#", "]"}], ",", "1"}], 
               "]"}], "&"}], ",", "res1"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"res2Out", "=", 
          RowBox[{"Flatten", "@", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"RandomVariate", "[", 
               RowBox[{
                RowBox[{"PoissonDistribution", "[", "#", "]"}], ",", "1"}], 
               "]"}], "&"}], ",", "res2"}], "]"}]}]}], ";"}], 
        "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"vars", "=", "allVars"}], ";", "\[IndentingNewLine]", 
       RowBox[{"startVars", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"yISrc0Start", ",", "yEffStart"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
           RowBox[{"chi", "[", "res0Out", "]"}], ",", "\\n", ",", 
           RowBox[{"chi1", "[", "res1Out", "]"}], ",", "\\n", ",", 
           RowBox[{"chi2", "[", "res2Out", "]"}]}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"FindMinimum", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"chi", "[", "res0Out", "]"}], "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{",", 
             RowBox[{
              RowBox[{"Fold", "[", 
               RowBox[{"And", ",", "True", ",", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"eff", "[", "i", "]"}], "<", "1"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "1", ",", "numPix"}], "}"}]}], "]"}]}], 
               "]"}], "&&", 
              RowBox[{
               RowBox[{"iSrc", "[", "1", "]"}], ">", "yISrc0Min"}], "&&", 
              RowBox[{
               RowBox[{"iSrc", "[", "1", "]"}], "<", "yISrc0Max"}]}]}], 
            "*)"}], "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"+", 
             RowBox[{"chi1", "[", "res1Out", "]"}]}], "+", 
            RowBox[{"chi2", "[", "res2Out", "]"}]}], "*)"}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
            RowBox[{"{", 
             RowBox[{"vars", ",", "startVars"}], "}"}]}], "]"}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"MaxIterations", "\[Rule]", "100"}], "\[IndentingNewLine]", 
          ",", 
          RowBox[{"WorkingPrecision", "\[Rule]", "15"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", "sol", "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"allRes", ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"xEff", ",", "xISrc", ",", 
             RowBox[{"First", "@", "sol"}]}], "}"}], "/.", 
           RowBox[{"Last", "@", "sol"}]}], "]"}]}], "]"}]}], 
      "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "nRun"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
