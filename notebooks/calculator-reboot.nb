Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"almostOne", "=", "0.9999999"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "doExecRadiusScans", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"doExecRadiusScans", "[", 
      RowBox[{"numb_", ",", "theRadius_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "resNumb", ",", "resMean", ",", "resStDv", ",", "radius0", ",", 
         "radius", ",", "dataRad", ",", "dataThe", ",", "xRing", ",", "yRing",
          ",", 
         RowBox[{"(*", 
          RowBox[{
          "dataCenterX", ",", "dataCenterY", ",", "xCenter", ",", "yCenter", ",",
            "center", ",", "binnedHit", ",", "varTotBckgPlusNoiseHit", ","}], 
          "*)"}], "binnedRadius", ",", "dist", ",", "distTrue", ",", 
         "distBin"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"allData", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"radius0", "=", 
            RowBox[{"theRadius", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"yCenter", "=", 
               RowBox[{"jy", "*", "centerSize"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"xCenter", "=", 
                  RowBox[{"jx", "*", "centerSize"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
                 RowBox[{"resNumb", "=", 
                  RowBox[{"{", "}"}]}], ";", 
                 RowBox[{"resMean", "=", 
                  RowBox[{"{", "}"}]}], ";", 
                 RowBox[{"resStDv", "=", 
                  RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{
                 "bigBanner", 
                  "[", "\"\< new step: given radius0 xCenter yCenter \>\"", 
                  "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\< radius0            = \>\"", ",", "radius0"}], 
                  "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\< radius/pixel ratio = \>\"", ",", 
                   RowBox[{"radius0", "/", "pixSize"}]}], "]"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\< xCenter            = \>\"", ",", "xCenter"}], 
                  "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\< yCenter            = \>\"", ",", "yCenter"}], 
                  "]"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\< expected sigma pix = \>\"", ",", 
                   RowBox[{"pixSize", "/", 
                    RowBox[{"Sqrt", "[", "12.", "]"}]}]}], "]"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"Do", "[", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"radius", "=", 
                    RowBox[{"radius0", "+", 
                    RowBox[{"k", "*", "pixSize"}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    
                    RowBox[{"\"\< Start scan radius // radius = \>\"", ",", 
                    "radius", ",", "\"\<     ..... number of steps       \>\"",
                     ",", "numStepsRadius"}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"dataCenterX", "=", 
                    RowBox[{"RandomVariate", "[", 
                    RowBox[{
                    RowBox[{"UniformDistribution", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "centerSize"}], "/", "2"}], ",", 
                    RowBox[{
                    RowBox[{"+", "centerSize"}], "/", "2"}]}], "}"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"numb", ",", "1"}], "}"}]}], "]"}]}], ";", 
                    RowBox[{"dataCenterY", "=", 
                    RowBox[{"RandomVariate", "[", 
                    RowBox[{
                    RowBox[{"UniformDistribution", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "centerSize"}], "/", "2"}], ",", 
                    RowBox[{
                    RowBox[{"+", "centerSize"}], "/", "2"}]}], "}"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"numb", ",", "1"}], "}"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"dataCenterX", "=", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"xCenter", ",", "numb"}], "]"}]}], ";"}], "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"dataCenterY", "=", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"yCenter", ",", "numb"}], "]"}]}], ";"}], "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{"center", "=", 
                    RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{"dataCenterX", ",", "dataCenterY"}], "}"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"dataRad", "=", 
                    RowBox[{"RandomVariate", "[", 
                    RowBox[{
                    RowBox[{"NormalDistribution", "[", 
