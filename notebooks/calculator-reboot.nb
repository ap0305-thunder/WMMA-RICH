             RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Button", "[", 
            RowBox[{"\"\<Show error message cells\>\"", ",", 
             RowBox[{"Print", "[", 
              RowBox[{"Cells", "[", 
               RowBox[{"CellStyle", "->", 
                RowBox[{"{", 
                 RowBox[{"\"\<MSG\>\"", ",", "\"\<Message\>\""}], "}"}]}], 
               "]"}], "]"}], ",", 
             RowBox[{"Method", "->", "\"\<Preemptive\>\""}]}], "]"}]}], 
          "\[IndentingNewLine]", "}"}], "]"}]}]}]}], "\[IndentingNewLine]", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
