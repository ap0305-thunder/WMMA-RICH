       "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xyzSrc", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"-", "xNumPix"}], "/", "numSrc"}], "/", "2"}], "+", 
          RowBox[{"i", "*", 
           RowBox[{"xNumPix", "/", "numSrc"}]}]}], ",", 
         RowBox[{"gSmooth", "[", 
          RowBox[{
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"yNumPix", "+", "1"}]}], "}"}], "]"}], ",", "1"}], 
          "]"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "numSrc"}], "}"}]}], "]"}]}], ";"}], 
   RowBox[{"(*", " ", 
    RowBox[{"!", 
     RowBox[{
      RowBox[{"@", "#$"}], "%", " ", "to", " ", "clean"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Blue", ",", 
          RowBox[{"PointSize", "\[Rule]", "Large"}], ",", 
          RowBox[{"Point", "[", "xyzPix", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"PointSize", "\[Rule]", "Large"}], ",", 
          RowBox[{"Point", "[", "xyzSrc", "]"}]}], "}"}]}], "}"}], "]"}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
