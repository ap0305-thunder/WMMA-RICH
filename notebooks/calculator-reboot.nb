              RowBox[{"xyzPix", "[", 
               RowBox[{"[", "iPix", "]"}], "]"}], ",", 
              RowBox[{"xyzSrc", "[", 
               RowBox[{"[", "is", "]"}], "]"}]}], "]"}], ")"}], "2"]}], 
         "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"iPix", ",", "1", ",", "numPix"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"is", ",", "1", ",", "numSrc"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
