    RowBox[{"pntMin", "=", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{"Length", "[", "pdeWavLen", "]"}], "*", 
       RowBox[{"3", "/", "4"}]}], "]"}]}], ";", 
    RowBox[{"pntMax", "=", 
     RowBox[{"Length", "[", "pdeWavLen", "]"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
