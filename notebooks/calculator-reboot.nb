           "Print", 
            "[", "\"\< *********************************** Calculating the \
derived global variables of the RICH \>\"", "]"}]}], "\[IndentingNewLine]", 
          "*)"}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"theNumChrPhoInGaussianBandAsympt", ":=", 
         RowBox[{"theNumPhoRawAsympt", "*", 
          RowBox[{"N", "@", 
           RowBox[{"Probability", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", "x", "]"}], "<", 
              RowBox[{"theScaleFactorBandRadius", "*", "\[Sigma]"}]}], ",", 
             RowBox[{"x", "\[Distributed]", 
              RowBox[{"NormalDistribution", "[", 
               RowBox[{"0", ",", "\[Sigma]"}], "]"}]}]}], "]"}]}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"two", "-", "sided"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"radiusChrAsympt", ":=", 
         RowBox[{"thetaChrAsympt", "*", "thisMRadToMm"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"it", " ", "is", " ", "a", " ", 
          RowBox[{"calculation", ":", " ", "here"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"radiusChrInPixelsAsympt", ":=", 
         RowBox[{"toNumPixels", "[", 
          RowBox[{"thetaChrAsympt", "/", "thePixAngSize"}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"in", " ", "pixels"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"bandHalfRadiusChrAsympt", ":=", 
         RowBox[{"theScaleFactorBandRadius", "*", 
          RowBox[{"createMRad", "[", 
           RowBox[{"sumInQuadr", "[", "        ", 
            RowBox[{
            "QuantityMagnitude", "[", "       ", "theSigmaSnglPhAsympt", 
             "]"}], "]"}], "]"}]}]}], ";", 
        RowBox[{"(*", "today", "*)"}], 
        RowBox[{"(*", "ASSUMPTION", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"bandTotalRadiusChrAsympt", ":=", 
         RowBox[{"2", "*", "bandHalfRadiusChrAsympt"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"to", " ", "become", " ", "two"}], "-", "sided"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"printD", "@", "theSigmaSnglPhAsympt"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
