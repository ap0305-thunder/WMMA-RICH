Cell[CellGroupData[{

Cell["Irwin\[Dash]Hall distribution", "Subsubtitle",
 CellTags->{
  "Irwin\[Dash]Hall \n\ndistribution", "i:3", 
   "i:4"},ExpressionUUID->"26e19603-9918-4c24-af8b-c4446a14debe"],

Cell["\<\
In probability and statistics, the Irwin\[Dash]Hall distribution, named after 
Joseph Oscar Irwin and Philip Hall, is a probability distribution for a 
random variable defined as the sum of a number of independent random 
variables, each having a uniform distribution. For this reason it is also 
known as the uniform sum distribution. 
\
\>", "Text",
 Background->RGBColor[
  0.3686274509803922, 0.7098039215686275, 0.9333333333333333],
 CellTags->{
  "i:3", "i:4"},ExpressionUUID->"a0546400-39f0-491b-b880-1e401b340805"],

Cell[BoxData[{
 RowBox[{
