      RowBox[{
       RowBox[{"but", " ", "are", " ", "zero", " ", "below", " ", "270"}], "-", 
       RowBox[{
       "280", " ", "so", " ", "you", " ", "can", " ", "use", " ", "200", " ", 
        "anyway"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]MaxRef", "=", "700"}], ";"}], "\[IndentingNewLine]", 
