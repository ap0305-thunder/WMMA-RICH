Cell["Angular dependence", \
"Subsubtitle",ExpressionUUID->"b08583ee-c112-0e45-9b62-9b4a3d790f8d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "\[Theta]_", "]"}], "=", 
   RowBox[{"1", "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}], ")"}], "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"2", "Pi", "*", 
    RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "0", ",", "Pi"}], "}"}]}], "]"}], "\n", 
 RowBox[{"angNorma", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"2", "Pi", "*", 
     RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
     RowBox[{"f", "[", "\[Theta]", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", "0", ",", "Pi"}], "}"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"diffSigma", "[", "\[Theta]_", "]"}], "=", 
  RowBox[{"sigma", "*", 
   RowBox[{"(", 
    FractionBox[
     RowBox[{"2", "Pi", "*", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
      RowBox[{"f", "[", "\[Theta]", "]"}]}], "angNorma"], ")"}]}]}], "\n", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"diffSigma", "[", "\[Theta]", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "0", ",", "Pi"}], "}"}]}], 
  "]"}], "\n", "sigma"}], "Input",
 CellLabel->
