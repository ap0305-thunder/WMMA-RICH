     "*)"}], "\n", 
   RowBox[{
    RowBox[{"nbContent", "=", 
     RowBox[{"NotebookGet", "[", "sourceNB", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "all", " ", "Text", " ", "cells"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"textCells", "=", 
     RowBox[{"Cases", "[", 
      RowBox[{"nbContent", ",", 
       RowBox[{"Cell", "[", 
        RowBox[{"_", ",", "\"\<Text\>\"", ",", "___"}], "]"}], ",", 
       "Infinity"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Debug", ":", 
     RowBox[{"check", " ", "how", " ", "many", " ", "were", " ", "found"}]}], 
