  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "c", ",", "r", ",", "\[Phi]1", ",", "\[Phi]2", ",", "p1", ",", "p2", ",",
        "p3", ",", "h", ",", 
       RowBox[{"rot", "=", 
