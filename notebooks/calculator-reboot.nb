Cell[BoxData[{
 RowBox[{
  RowBox[{"Unprotect", "[", 
   RowBox[{
   "theMass", ",", "pd\[Theta]", ",", "pdp", ",", "pdn", ",", 
    "\[Delta]mSqAbs", ",", "\[Delta]mSqRel"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "theMass", ",", "pd\[Theta]", ",", "pdp", ",", "pdn", ",", 
    "\[Delta]mSqAbs", ",", "\[Delta]mSqRel"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"theMass", "[", 
    RowBox[{"\[Theta]_", ",", "p_", 
     RowBox[{"(*", 
      RowBox[{"/;", 
       RowBox[{"p", ">", "0"}]}], "*)"}], ",", "n_"}], 
    RowBox[{"(*", 
     RowBox[{"/;", 
      RowBox[{"n", ">", "1"}]}], "*)"}], "]"}], "=", 
   RowBox[{"p", "*", 
    RowBox[{"\[Sqrt]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["n", "2"], "*", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "-", "1"}], 
      ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pd\[Theta]", "=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"theMass", "[", 
      RowBox[{"\[Theta]", ",", "p", ",", "n"}], "]"}], ",", "\[Theta]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pdp", "=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"theMass", "[", 
      RowBox[{"\[Theta]", ",", "p", ",", "n"}], "]"}], ",", "p"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pdn", "=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"theMass", "[", 
      RowBox[{"\[Theta]", ",", "p", ",", "n"}], "]"}], ",", "n"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]mSqAbs", "[", 
    RowBox[{
    "m_", ",", "n_", ",", "\[Delta]n_", ",", "p_", ",", "\[Delta]p_", ",", 
     "\[Delta]\[Theta]_", ",", "f\[Sigma]_"}], "]"}], 
   RowBox[{"(*", 
    RowBox[{"dont", " ", "delay"}], "*)"}], "=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", "pd\[Theta]", ")"}], "2"], 
          SuperscriptBox[
           RowBox[{"(", "\[Delta]\[Theta]", ")"}], "2"]}], "+", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", "pdp", ")"}], "2"], 
          SuperscriptBox[
           RowBox[{"(", "\[Delta]p", ")"}], "2"]}], "+", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", "pdn", ")"}], "2"], 
          SuperscriptBox[
           RowBox[{"(", "\[Delta]n", ")"}], "2"]}]}], "//.", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], "->", 
         RowBox[{"1", "-", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]}], "//.", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{
          SuperscriptBox["n", "2"], "*", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}], "->", 
        RowBox[{
         SuperscriptBox["m", "2"], "/", 
         SuperscriptBox["p", "2"]}]}]}], "//.", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], "->", 
       RowBox[{"1", "/", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"n", "*", "\[Beta]"}], ")"}], "2"]}]}]}], "//.", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Cos", "[", "\[Theta]", "]"}], "4"], "->", 
      RowBox[{"1", "/", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"n", "*", "\[Beta]"}], ")"}], "4"]}]}]}], "//.", 
    RowBox[{"\[Beta]", "->", 
     RowBox[{"betaParticleFromMassAndMomentum", "[", 
      RowBox[{"m", ",", "p"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Delta]mSqRel", "[", 
     RowBox[{
     "m_", ",", "n_", ",", "\[Delta]n_", ",", "p_", ",", "\[Delta]p_", ",", 
      "\[Delta]\[Theta]_", ",", "f\[Sigma]_"}], "]"}], 
    RowBox[{"(*", 
     RowBox[{"dont", " ", "delay"}], "*)"}], "=", "\[IndentingNewLine]", 
