Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"output", "/", "print"}], " ", "cells"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", 
        RowBox[{"Cells", "[", 
         RowBox[{"CellStyle", "->", "\"\<Output\>\""}], "]"}]}], ">", "0"}], ",", 
      RowBox[{
       RowBox[{"Echo", "@", 
        RowBox[{"Cells", "[", 
