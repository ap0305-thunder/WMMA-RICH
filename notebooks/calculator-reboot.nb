         RowBox[{"RotationMatrix", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
            RowBox[{"Cross", "[", 
             RowBox[{
              RowBox[{"#1", "-", "#2"}], ",", 
              RowBox[{"#3", "-", "#2"}]}], "]"}]}], "}"}], "]"}], "&"}]}]}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{
