       RowBox[{
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}], ".", 
        RowBox[{"rot", "[", 
         RowBox[{"q1", ",", "q2", ",", "q3"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
