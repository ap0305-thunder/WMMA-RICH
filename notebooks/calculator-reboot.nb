          RowBox[{"calcBinaryOccupancyFromTrueToApparent", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
             "bckTrueCntsInPixelInGateTimeEquiv", "+", 
              "dniTrueCntsInPixelInGateTimeUnifo"}], ")"}], "/", 
            RowBox[{"toCounts", "[", "1", "]"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"areaPDAFromNominalGeoAccept", ":=", 
         RowBox[{"2", "*", 
          RowBox[{"First", "[", 
           RowBox[{"Flatten", "@", 
            RowBox[{"Outer", "[", 
             RowBox[{"Times", ",", 
              RowBox[{"Differences", "@", "thePDAGeoLong"}], ",", 
              RowBox[{"Differences", "@", "thePDAGeoShrt"}]}], "]"}]}], "]"}],
           "*", 
          SuperscriptBox["thisMRadToMm", "2"]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"maxIdealNumChannels", ":=", 
         RowBox[{"2", "*", 
          RowBox[{"First", "[", 
           RowBox[{
            RowBox[{"Flatten", "@", 
             RowBox[{"Outer", "[", 
              RowBox[{"Times", ",", 
               RowBox[{"Differences", "@", "thePDAGeoLong"}], ",", 
               RowBox[{"Differences", "@", "thePDAGeoShrt"}]}], "]"}]}], "/", 
            SuperscriptBox["thePixAngSize", "2"]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         SubscriptBox["n", "\[Sigma]"], "=", "5"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"thePMaxSmallAngleApprox", ":=", 
         SqrtBox[
          FractionBox[
           RowBox[{"\[CapitalDelta]m", "*", "\[Mu]m"}], 
           RowBox[{
            SuperscriptBox["thisRefrIndex", "2"], "*", 
            SubscriptBox["n", "\[Sigma]"], "*", 
            "\[CapitalDelta]\[CapitalTheta]", "*", 
            "\[Mu]\[CapitalTheta]"}]]]}], ";", "\[IndentingNewLine]", 
        RowBox[{"pMaxSepPionKaon5s", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
