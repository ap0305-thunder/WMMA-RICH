   RowBox[{"eps", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"\[ScriptCapitalD]1", "=", 
    RowBox[{"TransformedDistribution", "[", 
     RowBox[{
      SuperscriptBox["u", "2"], ",", 
      RowBox[{"u", "\[Distributed]", 
       RowBox[{"UniformDistribution", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"100", "-", "eps"}], ",", 
          RowBox[{
           RowBox[{"+", "100"}], "+", "eps"}]}], "}"}], "]"}]}]}], "]"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"\[ScriptCapitalD]2", "=", 
    RowBox[{"TransformedDistribution", "[", 
     RowBox[{
      SuperscriptBox["v", "2"], ",", 
      RowBox[{"v", "\[Distributed]", 
       RowBox[{"UniformDistribution", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"100", "-", "eps"}], ",", 
          RowBox[{
           RowBox[{"+", "100"}], "+", "eps"}]}], "}"}], "]"}]}]}], "]"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"\[ScriptCapitalD]1", "=", 
