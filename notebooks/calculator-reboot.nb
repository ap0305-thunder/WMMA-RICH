Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
     "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
     "**", "**", "**", "**", "**", "**"}], "*****)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"To", " ", "simplify"}], ",", " ", 
    RowBox[{
     RowBox[{"assume", " ", "high"}], "-", 
     RowBox[{"momentum", " ", "that", " ", "is", " ", 
      SubscriptBox["\[Theta]", "C"], " ", "asymptotic"}]}], ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "p"}], "-", "independent"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
     "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
     "**", "**", "**", "**", "**", "**"}], "*****)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Unprotect", "[", 
     RowBox[{
     "m", ",", "\[Beta]", ",", "p", ",", "theMom", ",", "\[CapitalDelta]mSq", 
      ",", "\[ScriptCapitalN]", ",", "theTheta", ",", "\[Theta]", ",", 
      "\[CapitalDelta]m", ",", "theMass"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "m", ",", "\[Beta]", ",", "p", ",", "theMom", ",", "\[CapitalDelta]mSq", 
      ",", "\[ScriptCapitalN]", ",", "theTheta", ",", "\[Theta]", ",", 
      "\[CapitalDelta]m", ",", "theMass"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$Assumptions", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalDelta]m", ">", "0"}], ",", 
       RowBox[{"\[CapitalDelta]mSq", ">", "0"}], ",", 
       RowBox[{"p", ">", "0"}], ",", 
       RowBox[{"0", "<", "\[Beta]", "<", "1"}], ",", 
       RowBox[{"\[Gamma]", "\[GreaterEqual]", "1"}], ",", 
       RowBox[{"m", ">", "0"}], ",", 
       RowBox[{"\[ScriptN]", ">", "1"}], ",", 
       RowBox[{"0", "<", "\[Theta]", "<", 
        RowBox[{"\[Pi]", "/", "2"}]}], ",", 
       RowBox[{"\[Delta]\[Theta]", ">", "0"}], ",", 
       RowBox[{"\[ScriptN]", ">", 
        RowBox[{"1", "/", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], ">", 
        RowBox[{"1", "/", "\[ScriptN]"}]}], ",", 
       RowBox[{"\[Theta]", "<", 
        RowBox[{"ArcCos", "[", 
         RowBox[{"1", "/", "\[ScriptN]"}], "]"}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theMom", "=", 
     RowBox[{
      RowBox[{"momentumFromMassAndBeta", "[", 
       RowBox[{"m", ",", "\[Beta]"}], "]"}], "//", "fullRationalize"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"printD", "@", "theMom"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"theMom", "==", "p"}], ",", "\[Beta]", ",", "Reals"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theSol", "=", 
     RowBox[{"\[Beta]", "/.", "sol"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theTheta", "=", 
     RowBox[{
      RowBox[{"ArcCos", "[", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"\[ScriptN]", "*", "\[Beta]"}], ")"}]}], "]"}], "/.", 
      RowBox[{"\[Beta]", "\[Rule]", 
       RowBox[{"theSol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"printD", "@", "theTheta"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"theTheta", "==", "\[Theta]"}], ",", "m", ",", "Reals"}], 
       "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theSol", "=", 
     RowBox[{"m", "/.", "sol"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theMass", "=", 
     RowBox[{"m", "/.", 
      RowBox[{"m", "->", 
       RowBox[{"theSol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"printD", "@", "theMass"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Protect", "[", 
     RowBox[{
     "m", ",", "\[Beta]", ",", "p", ",", "theMom", ",", "\[CapitalDelta]mSq", 
      ",", "\[ScriptCapitalN]", ",", "theTheta", ",", "\[Theta]", ",", 
      "\[CapitalDelta]m", ",", "theMass"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"deltaTheMass", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"D", "[", 
         RowBox[{"theMass", ",", "\[Theta]"}], "]"}], "]"}], "*", 
       "\[Delta]\[Theta]"}], 
      RowBox[{"(*", 
       RowBox[{"/.", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "->", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"\[Beta]", "*", "\[ScriptN]"}], ")"}]}]}]}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{"/.", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "->", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"m", "^", "2"}], "+", 
            RowBox[{"p", "^", "2"}]}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"p", " ", "\[ScriptN]"}], ")"}]}]}]}], " ", "*)"}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"printD", "@", "deltaTheMass"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"deltaTheMass", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"deltaTheMass", "/.", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "->", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"m", "^", "2"}], "+", 
           RowBox[{"p", "^", "2"}]}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"p", " ", "\[ScriptN]"}], ")"}]}]}]}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"First", "@", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"deltaTheMass", "==", "\[CapitalDelta]m"}], ",", "p", ",", 
        "Reals"}], "]"}]}]}], ";"}], 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Nsolve", " ", "gives", " ", "easier", " ", "result"}], "..."}], 
    "*)"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"but", " ", "\[Theta]", " ", "depends", " ", "on", " ", "p"}], 
      "..."}], "."}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"deltaTheMass", "==", "\[CapitalDelta]m"}], ",", "p", ",", 
         "Reals"}], "]"}], ",", "$Assumptions"}], "]"}], "//", "TrigExpand"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pSepMaxBa", "=", 
     RowBox[{"FullSimplify", "[", 
