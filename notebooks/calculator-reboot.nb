 RowBox[{
  RowBox[{
   RowBox[{"FresnelEqP", "[", 
    RowBox[{"\[Theta]_", ",", "n1_", ",", "n2_"}], "]"}], "=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
