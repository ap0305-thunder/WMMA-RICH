  RowBox[{"(*", " ", 
   RowBox[{
   "momentum", " ", "thr", " ", "and", " ", "asymptotic", " ", "number", " ", 
    "of", " ", "photons"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"printD", "@", 
     RowBox[{"momentumCherenkovThreshold", "[", 
      RowBox[{"m", ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      SuperscriptBox[
       RowBox[{"Sin", "[", 
        RowBox[{"thetaChrTheMax", "[", "n", "]"}], "]"}], "2"], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1.0001", ",", "1.0027"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
