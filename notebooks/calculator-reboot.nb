           RowBox[{
           "rescale", " ", "Bck", " ", "and", " ", "DNI", " ", "for", " ", 
            "time"}], "-", 
           RowBox[{"gating", " ", "rejection"}]}]}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{
           "bck", " ", "and", " ", "DNI", " ", "are", " ", "treated", " ", 
