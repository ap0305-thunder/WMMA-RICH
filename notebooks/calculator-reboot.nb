                   RowBox[{"Cos", "[", "\[Theta]a", "]"}], "2"]}], "-", "1"}],
                 ")"}]}]}], ")"}], "2"], ")"}]}], ")"}]}], "]"}], "/.", 
      "massTransform"}]}], ";"}], "\[IndentingNewLine]", 
