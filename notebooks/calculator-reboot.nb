Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "circleFromPoints", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"arc", "->", "False"}], "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"circleFromPoints", "[", 
   RowBox[{
    RowBox[{"m", ":", 
     RowBox[{"{", 
      RowBox[{"q1_", ",", "q2_", ",", "q3_"}], "}"}]}], ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "c", ",", "r", ",", "\[Phi]1", ",", "\[Phi]2", ",", "p1", ",", "p2", ",",
        "p3", ",", "h", ",", 
       RowBox[{"rot", "=", 
        RowBox[{
         RowBox[{"RotationMatrix", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
            RowBox[{"Cross", "[", 
             RowBox[{
              RowBox[{"#1", "-", "#2"}], ",", 
              RowBox[{"#3", "-", "#2"}]}], "]"}]}], "}"}], "]"}], "&"}]}]}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}], "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}], ".", 
        RowBox[{"rot", "[", 
         RowBox[{"q1", ",", "q2", ",", "q3"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"h", "=", 
       RowBox[{"p1", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}], "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{";;", "2"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c", ",", "r"}], "}"}], "=", 
       RowBox[{"List", "@@", 
        RowBox[{"Circumsphere", "[", 
         RowBox[{"{", 
          RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Phi]1", "=", 
       RowBox[{"ArcTan", "@@", 
        RowBox[{"(", 
         RowBox[{"p3", "-", "c"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Phi]2", "=", 
       RowBox[{"ArcTan", "@@", 
        RowBox[{"(", 
         RowBox[{"p1", "-", "c"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{"Append", "[", 
        RowBox[{"c", ",", "h"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OptionValue", "[", "arc", "]"}], "//", "TrueQ"}], ",", 
        RowBox[{"MapAt", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"{", "p", "}"}], ",", 
              RowBox[{
               RowBox[{"rot", "[", 
                RowBox[{"q1", ",", "q2", ",", "q3"}], "]"}], ".", "p"}]}], 
             "]"}], "/@", "#"}], "&"}], ",", 
          RowBox[{"splineCircle", "[", 
           RowBox[{"c", ",", "r", ",", 
            RowBox[{"{", 
             RowBox[{"\[Phi]1", ",", "\[Phi]2"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", "1", "}"}]}], "]"}], ",", 
        RowBox[{"MapAt", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"{", "p", "}"}], ",", 
              RowBox[{
               RowBox[{"rot", "[", 
                RowBox[{"q1", ",", "q2", ",", "q3"}], "]"}], ".", "p"}]}], 
             "]"}], "/@", "#"}], "&"}], ",", 
          RowBox[{"splineCircle", "[", 
           RowBox[{"c", ",", "r"}], "]"}], ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}]}]}], "]"}], "/;", 
   RowBox[{
    RowBox[{"MatrixQ", "[", 
     RowBox[{"m", ",", "NumericQ"}], "]"}], "&&", 
    RowBox[{
     RowBox[{"Dimensions", "[", "m", "]"}], "==", 
     RowBox[{"{", 
      RowBox[{"3", ",", "3"}], "}"}]}]}]}]}], "\n"}], "Input",
