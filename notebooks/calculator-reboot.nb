  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Unprotect", "[", 
     RowBox[{"\[Lambda]MinRef", ",", "\[Lambda]MaxRef"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]MinRef", "=", "200"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"OK", " ", "FOR", " ", "MAPMT22"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"\[Lambda]MinRef", ":=", "270"}], ";", " ", 
