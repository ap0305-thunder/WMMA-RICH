    RowBox[{"Print", "[", 
     RowBox[{"\"\<Found \>\"", ",", 
      RowBox[{"Length", "[", "textCells", "]"}], ",", "\"\< Text cells\>\""}],
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
