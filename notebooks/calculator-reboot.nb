  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"To", " ", "simplify"}], ",", " ", 
    RowBox[{
     RowBox[{"assume", " ", "high"}], "-", 
     RowBox[{"momentum", " ", "that", " ", "is", " ", 
      SubscriptBox["\[Theta]", "C"], " ", "asymptotic"}]}], ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "p"}], "-", "independent"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
     "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
     "**", "**", "**", "**", "**", "**"}], "*****)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Unprotect", "[", 
     RowBox[{
     "m", ",", "\[Beta]", ",", "p", ",", "theMom", ",", "\[CapitalDelta]mSq", 
      ",", "\[ScriptCapitalN]", ",", "theTheta", ",", "\[Theta]", ",", 
      "\[CapitalDelta]m", ",", "theMass"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "m", ",", "\[Beta]", ",", "p", ",", "theMom", ",", "\[CapitalDelta]mSq", 
