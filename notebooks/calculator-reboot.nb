Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"transformToMeanAndDiff", "[", 
    RowBox[{
     RowBox[{"ma_", ":", "xa"}], ",", 
     RowBox[{"mb_", ":", "xb"}], ",", 
     RowBox[{"\[Mu]m_", ":", "xm"}], ",", 
     RowBox[{"\[CapitalDelta]m_", ":", "xd"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ma", "\[Rule]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "*", "\[Mu]m"}], "-", "\[CapitalDelta]m"}], ")"}]}]}], 
      ",", 
      RowBox[{"mb", "\[Rule]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "*", "\[Mu]m"}], "+", "\[CapitalDelta]m"}], 
         ")"}]}]}]}], "}"}], "//", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"transformToMeanAndDiff", "[", 
   RowBox[{"xa", ",", "xb", ",", "xm", ",", "xd"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  FractionBox[
   RowBox[{"(", 
    RowBox[{"xa", "+", "xb"}], ")"}], "2"], "/.", 
  RowBox[{"transformToMeanAndDiff", "[", 
   RowBox[{"xa", ",", "xb", ",", "xm", ",", "xd"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"xb", "-", "xa"}], ")"}], "/.", 
  RowBox[{"transformToMeanAndDiff", "[", "]"}], 
  RowBox[{"(*", 
   RowBox[{"[", 
    RowBox[{"xa", ",", "xb", ",", "xm", ",", "xd"}], "]"}], 
   "*)"}]}]}], "Input",
