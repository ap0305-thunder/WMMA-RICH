 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"geometry", " ", "//", " ", "fixed"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xyzPix", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ix", ",", "iy", ",", "0"}], "}"}], ",", 
