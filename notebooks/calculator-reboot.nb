    RowBox[{"{", 
     RowBox[{"r1_", ",", "r2_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Theta]1_", ",", "\[Theta]2_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Phi]1_", ",", "\[Phi]2_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"plot", ",", "pts", ",", "surf", ",", "bdy"}], "}"}], ",", 
