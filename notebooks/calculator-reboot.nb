            SuperscriptBox[
             RowBox[{"(", "thePixLinSiz", ")"}], "2"]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", "apparent", " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"occupancy", " ", "==", " ", 
          RowBox[{
           RowBox[{"apparent", "/", "observed"}], " ", "counts", " ", "as", " ",
            "opposed", " ", "to", " ", "True", " ", "Counts"}]}], " ", "*)"}],
         "\[IndentingNewLine]", 
        RowBox[{"bckOccupInPixelInBCOTime", " ", ":=", 
         RowBox[{"toCounts", "@", 
          RowBox[{"calcBinaryOccupancyFromTrueToApparent", "[", 
           RowBox[{"(", 
            RowBox[{"bckTrueCntsInPixelInBCOTime", "/", 
             RowBox[{"toCounts", "[", "1", "]"}]}], ")"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dniOccupInPixelInBCOTime", " ", ":=", 
