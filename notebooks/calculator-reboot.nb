             RowBox[{"0", ",", 
              RowBox[{"yNumPix", "+", "1"}]}], "}"}], "]"}], ",", "1"}], 
          "]"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "numSrc"}], "}"}]}], "]"}]}], ";"}], 
   RowBox[{"(*", " ", 
