            "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"ring", ":", " ", 
          RowBox[{
           RowBox[{
           "rescale", " ", "Bck", " ", "and", " ", "DNI", " ", "for", " ", 
