     RowBox[{"UniformDistribution", "[", 
      RowBox[{"{", 
       RowBox[{"a", ",", 
        RowBox[{"a", "+", "1"}]}], "}"}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"\[ScriptCapitalD]2", "=", 
  RowBox[{"TransformedDistribution", "[", 
   RowBox[{
    SuperscriptBox["v", "2"], ",", 
    RowBox[{"v", "\[Distributed]", 
     RowBox[{"UniformDistribution", "[", 
      RowBox[{"{", 
       RowBox[{"b", ",", 
        RowBox[{"b", "+", "1"}]}], "}"}], "]"}]}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"\[ScriptCapitalD]", "=", 
    RowBox[{
     RowBox[{"TransformedDistribution", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"u", "+", "v"}], "]"}], ",", 
