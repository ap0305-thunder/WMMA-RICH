               SuperscriptBox["n1", "2"], 
               SuperscriptBox[
                RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], ")"}], "/", 
             SuperscriptBox["n2", "2"]}]}], ")"}]}]}]}], ")"}]}], ")"}], 
    "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FresnelEqS", "[", 
