     RowBox[{"gSmooth", "[", 
      RowBox[{"theIntSrc", ",", "theIntSrcSigma"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"theRes", "=", 
    RowBox[{"precise", "[", 
     RowBox[{"yEff", "*", 
      RowBox[{"(", 
       RowBox[{"fGMat", ".", "theIntSrc"}], ")"}]}], "]"}]}], 
