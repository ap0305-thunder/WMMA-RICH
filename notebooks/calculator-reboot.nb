Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"momentumCherenkovThreshold", "[", 
    RowBox[{"m", ",", "n"}], "]"}], "\[InvisibleSpace]", "\<\" = \"\>", "\[InvisibleSpace]", 
   FractionBox["m", 
    SqrtBox[
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["n", "2"]}]]]}],
  SequenceForm[
   physicsGeneral`momentumCherenkovThreshold[
   physicsGeneral`m, physicsGeneral`n], " = ", 
   physicsGeneral`m (-1 + physicsGeneral`n^2)^Rational[-1, 2]],
  Editable->False]], "Print",
