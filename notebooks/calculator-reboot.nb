Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"ClearAll", "[", "refrIndex", "]"}], ";"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "bigBanner", "[", "\"\<MAKE SURE TO RUN calcRICHYield LATER IF NEEDED\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"doAllRichCalcFlag", "=", "True"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numSim", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"ParallelMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<Kernel \>\"", "<>", 
        RowBox[{"ToString", "[", "$KernelID", "]"}], "<>", "\"\< : \>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"f", "[", "#", "]"}], "]"}]}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4", ",", "4"}], "}"}]}], "}"}]}], "]"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"params1", "=", 
      RowBox[{"{", 
       RowBox[{"\"\<C1F04-0980-293\>\"", ",", "\[Lambda]MinRef", ",", 
        "\[Lambda]MaxRef", ",", "2", ",", "\"\<MAPMT22s\>\"", ",", 
        "nominalLengthRich2", ",", "numSim", ",", "True"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"params2", "=", 
      RowBox[{"{", 
       RowBox[{"\"\<C4F10-0980-293\>\"", ",", "\[Lambda]MinRef", ",", 
        "\[Lambda]MaxRef", ",", "1", ",", "\"\<MPPCHPK\>\"", ",", 
        "nominalLengthRich1", ",", "numSim", ",", "True"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ParallelMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Apply", "[", 
         RowBox[{"calcRICHYield", ",", "#"}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"params1", ",", "params2"}], "}"}]}], "]"}]}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"(*", " ", "TEST", "*)"}], 
    RowBox[{
     RowBox[{"calcRICHYield", "[", 
      RowBox[{"\"\<C1F04-0980-293\>\"", ",", "\[Lambda]MinRef", ",", 
       "\[Lambda]MaxRef", ",", "2", ",", "\"\<MAPMT22s\>\"", ",", 
       "nominalLengthRich2", ",", "numSim", ",", "True"}], "]"}], ";"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"(*", " ", "TEST", "*)"}], 
    RowBox[{
     RowBox[{"calcRICHYield", "[", 
      RowBox[{"\"\<C4F10-0980-293\>\"", ",", "\[Lambda]MinRef", ",", 
       "\[Lambda]MaxRef", ",", "1", ",", "\"\<MPPCHPK\>\"", ",", 
       "nominalLengthRich1", ",", "numSim", ",", "True"}], "]"}], ";"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "Print", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"res", "=", 
        RowBox[{"calcRICHYield", "[", 
         RowBox[{"\"\<C1F04-0980-293\>\"", ",", "\[Lambda]MinRef", ",", 
          "\[Lambda]MaxRef", ",", "2", ",", "\"\<MAPMT22s\>\"", ",", 
          "nominalLengthRich2", ",", "numSim", ",", "True"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Echo", "[", "res", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
    "*)"}]}]}]], "Input",
