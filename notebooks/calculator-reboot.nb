Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"ClearAll", "[", "f", "]"}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f", "[", "z_", "]"}], "=", 
    RowBox[{
     RowBox[{"intensity", "[", 
      RowBox[{
       RowBox[{"zPixRef", "=", "300"}], ",", "z"}], "]"}], "/", 
     "intensity0"}]}], ";", "\n", 
   RowBox[{"list", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"f", "[", "z", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "z0", ",", "z1", ",", 
        RowBox[{"lenCol", "/", "1000"}]}], "}"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"riseTime", "[", 
     RowBox[{"list__", ",", "thr_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v0", ",", "iSol", ",", "zSol"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"v0", "=", 
            RowBox[{
             RowBox[{"list", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", "thr"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"list", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "-", "thr"}], ")"}], "*", 
               "v0"}], "<", "0"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"iSol", "=", "i"}], ";", 
              RowBox[{"zSol", "=", 
               RowBox[{"lenCol", "*", 
                RowBox[{"iSol", "/", 
                 RowBox[{"Length", "[", "list", "]"}]}]}]}], ";", 
              RowBox[{"Break", "[", "]"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{"Continue", "[", "]"}]}], "\[IndentingNewLine]", "]"}]}],
           "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "list", "]"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<zPixRef(mm)=\>\"", ",", "zPixRef", 
          ",", "\"\<zPixEms(mm)=\>\"", ",", 
          RowBox[{"N", "[", "zSol", "]"}], ",", "\"\<tOA(ps)=\>\"", ",", 
          RowBox[{"tOA", "[", 
           RowBox[{"zPixRef", ",", "zSol"}], "]"}], ",", "\"\<low-value=\>\"",
           ",", 
          RowBox[{"list", "[", 
           RowBox[{"[", 
            RowBox[{"iSol", "-", "1"}], "]"}], "]"}], 
          ",", "\"\<high-value=\>\"", ",", 
          RowBox[{"list", "[", 
           RowBox[{"[", "iSol", "]"}], "]"}]}], "]"}]}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"riseTime", "[", 
     RowBox[{"list", ",", "0.1"}], "]"}], "\[IndentingNewLine]", 
    RowBox[{"riseTime", "[", 
     RowBox[{"list", ",", "0.5"}], "]"}], "\[IndentingNewLine]", 
