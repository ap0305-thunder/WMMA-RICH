       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"0", ",", "#"}], "]"}], "&"}], ",", 
       RowBox[{
        RowBox[{"Sort", "@", 
         RowBox[{"First", "@", 
          RowBox[{"Transpose", "[", "pdeWavLen", "]"}]}]}], "-", 
        "the\[Lambda]Min"}]}], "]"}], "               ", ",", 
     RowBox[{"u_", "/;", 
      RowBox[{"u", "<=", "0"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"pntMax", "=", 
  RowBox[{
   RowBox[{"Length", "[", "pdeWavLen", "]"}], "-", 
