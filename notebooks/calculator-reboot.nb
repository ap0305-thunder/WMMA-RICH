Cell[CellGroupData[{

Cell["3 VARIABLES -  APPROX FOR HIGH MOMENTUM", "Section",
 CellTags->{
  "3 VARIABLES -  APPROX FOR HIGH \n\nMOMENTUM", "i:3", 
   "i:4"},ExpressionUUID->"93020db9-3bc8-4b74-ae04-2165697453a3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"3", " ", "VARIABLES"}], "-", 
    RowBox[{"APPROX", " ", "FOR", " ", "HIGH", " ", "MOMENTUM"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"p", ",", "mmmm", ",", "n", ",", "\[Theta]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mmmm", "=", 
     RowBox[{"p", " ", "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         SuperscriptBox["n", "2"], "*", 
         SuperscriptBox[
          RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "-", "1"}], 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theMassErrorProp", "=", 
     RowBox[{"errorProp", "[", 
      RowBox[{"mmmm", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", "20.", ",", "\[Delta]p", ",", "0.2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
          "\[Theta]", ",", "0.045", ",", "\[Delta]\[Theta]", ",", "0.001"}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "n0", ",", "\[Delta]n", ",", "0.00001"}], "}"}]}],
         "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"theMassErrorPropSq", "=", 
    RowBox[{"Collect", "[", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"theMassErrorProp", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "2"], ",", 
      RowBox[{"{", 
       RowBox[{
        SuperscriptBox["\[Delta]p", "2"], ",", 
        SuperscriptBox["\[Delta]\[Theta]", "2"], ",", 
        SuperscriptBox["\[Delta]n", "2"]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"theMassErrorProp", "=", 
    RowBox[{"Sqrt", "[", "theMassErrorPropSq", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"theMassErrorProp", "/.", 
    RowBox[{"n", "->", "n0"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theMassErrorPropSq", "//.", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "4"], "->", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{
             SuperscriptBox["theMass", "2"], "/", 
             SuperscriptBox["p", "2"]}]}], ")"}], "/", 
          SuperscriptBox["n", "2"]}], ")"}], "2"]}]}], "//.", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], "->", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          SuperscriptBox["theMass", "2"], "/", 
          SuperscriptBox["p", "2"]}]}], ")"}], "/", 
       SuperscriptBox["n", "2"]}]}]}], "//", "Simplify"}], "\[IndentingNewLine]", 
   RowBox[{"Collect", "[", 
    RowBox[{"%", ",", 
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox["\[Delta]p", "2"], ",", 
       SuperscriptBox["\[Delta]\[Theta]", "2"], ",", 
       SuperscriptBox["\[Delta]n", "2"]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"%", "//.", 
      RowBox[{
       RowBox[{
        SuperscriptBox["theMass", "2"], "+", 
        SuperscriptBox["p", "2"]}], "->", 
       SuperscriptBox["p", "2"]}]}], "//.", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["theMass", "4"], " ", 
         SuperscriptBox["p", "2"]}], "+", 
        RowBox[{"2", " ", 
         SuperscriptBox["theMass", "2"], " ", 
         SuperscriptBox["p", "4"]}], "+", 
        SuperscriptBox["p", "6"]}], ")"}], "->", 
      RowBox[{
       SuperscriptBox["p", "2"], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["theMass", "2"], "+", 
          SuperscriptBox["p", "2"]}], ")"}], "2"]}]}]}], "//.", 
    RowBox[{
     RowBox[{
      SuperscriptBox["theMass", "2"], "+", 
      SuperscriptBox["p", "2"]}], "->", 
     SuperscriptBox["p", "2"]}]}], "\[IndentingNewLine]", 
   RowBox[{"theMassErrorPropRelSq", "=", 
    RowBox[{
     RowBox[{"%", "/", 
      SuperscriptBox["theMass", "2"]}], "//", "Cancel"}]}], "\[IndentingNewLine]", 
   RowBox[{"theMassErrorPropRelSq", "=", 
    RowBox[{"Collect", "[", 
     RowBox[{"theMassErrorPropRelSq", ",", 
      RowBox[{"{", 
       RowBox[{
        SuperscriptBox["\[Delta]p", "2"], ",", 
        SuperscriptBox["\[Delta]\[Theta]", "2"], ",", 
        SuperscriptBox["\[Delta]n", "2"]}], "}"}]}], "]"}]}]}]}]], "Input",
 CellTags->{"i:3", "i:4"},
 CellLabel->
  "1/23/25 21:13:28 \
In[852]:=",ExpressionUUID->"cef57e34-348d-4f0d-abee-bff453729786"],

