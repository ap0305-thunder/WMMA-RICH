  RowBox[{"ClearAll", "[", "biSection", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"biSection", "[", 
     RowBox[{"func_", ",", 
      RowBox[{"{", 
       RowBox[{"x1_", ",", "x2_"}], "}"}], ",", 
      RowBox[{"eps_", "?", "Positive"}]}], "]"}], "/;", 
    RowBox[{
     RowBox[{
      RowBox[{"func", "[", "x1", "]"}], 
      RowBox[{"func", "[", "x2", "]"}]}], "<", "0"}]}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xl", ",", "xh"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xl", ",", "xh"}], "}"}], "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"func", "[", "x1", "]"}], ">", "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"x2", ",", "x1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x1", ",", "x2"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"xh", "-", "xl"}], ">", "eps"}], ",", "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"mid", "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"xl", "+", "xh"}], ")"}], "/", "2"}]}], "}"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"func", "[", "mid", "]"}], "<", "0"}], ",", 
            RowBox[{"xl", "=", "mid"}], ",", 
            RowBox[{"xh", "=", "mid"}]}], "]"}]}], "]"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"N", "@", 
       RowBox[{"{", 
        RowBox[{"xl", ",", "xh", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"xl", "+", "xh"}], ")"}], "/", "2"}], ",", "eps"}], 
        "}"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"thrl", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"thrh", "=", "0.9"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eps", "=", "0.001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"min", "=", 
  RowBox[{"NMinimize", "[", 
   RowBox[{
    RowBox[{"observedIntensity", "[", 
     RowBox[{"t", ",", "thisZPixRef"}], "]"}], ",", "t"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"max", "=", 
  RowBox[{"NMaximize", "[", 
   RowBox[{
    RowBox[{"observedIntensity", "[", 
     RowBox[{"t", ",", "thisZPixRef"}], "]"}], ",", "t"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"timeMin", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"t", "/.", 
     RowBox[{"min", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "*", 
   RowBox[{"(", 
    RowBox[{"1", "+", "eps"}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"timeMax", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"t", "/.", 
     RowBox[{"max", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{"1", "+", "eps"}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"soll", "=", 
  RowBox[{"biSection", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"observedIntensity", "[", 
       RowBox[{"#", ",", "thisZPixRef"}], "]"}], "-", "thrl"}], "&"}], ",", 
    RowBox[{"{", 
     RowBox[{"timeMin", ",", "timeMax"}], "}"}], ",", "eps"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"solh", "=", 
  RowBox[{"biSection", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"observedIntensity", "[", 
       RowBox[{"#", ",", "thisZPixRef"}], "]"}], "-", "thrh"}], "&"}], ",", 
    RowBox[{"{", 
     RowBox[{"timeMin", ",", "timeMax"}], "}"}], ",", "eps"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tRise", "=", 
   RowBox[{
    RowBox[{"solh", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "-", 
    RowBox[{"soll", "[", 
     RowBox[{"[", "3", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"printD", "[", "tRise", "]"}], "\[IndentingNewLine]", 
