                RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], ")"}], "/", 
             SuperscriptBox["n2", "2"]}]}], ")"}]}]}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"n2", "*", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
