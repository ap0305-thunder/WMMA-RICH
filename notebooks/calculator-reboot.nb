 RowBox[{
  RowBox[{"the\[Lambda]Min", "=", "270"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"the\[Lambda]Max", "=", "370"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"pntMin", "=", 
  RowBox[{"1", "+", 
   RowBox[{"Count", "[", "               ", 
    RowBox[{
     RowBox[{"Map", "[", 
