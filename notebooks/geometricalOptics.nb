            RowBox[{
             RowBox[{
              RowBox[{"theRay1", "[", "t", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", "xc"}], ")"}], "2"], "/", 
          SuperscriptBox["ax", "2"]}], "+", 
