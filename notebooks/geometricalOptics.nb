             RowBox[{
              RowBox[{"theRay1", "[", "t", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", "yc"}], ")"}], "2"], "/", 
          SuperscriptBox["ay", "2"]}], "+", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"theRay1", "[", "t", "]"}], "[", 
              RowBox[{"[", "3", "]"}], "]"}], "-", "zc"}], ")"}], "2"], "/", 
          SuperscriptBox["az", "2"]}]}], "==", 
