   RowBox[{
    RowBox[{"urkX", ":=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Cross", "[", 
         RowBox[{"eZ", ",", "dirTheTrk"}], "]"}], "/", 
        RowBox[{"Sin", "[", "\[CapitalTheta]", "]"}]}], "//.", "ruleTrig"}], "//",
       "blob"}]}], ";"}], "\[IndentingNewLine]", 
