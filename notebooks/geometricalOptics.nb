   RowBox[{"Intersect", " ", "with", " ", "mirror"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "sol1", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol1", "=", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"theRay0", "[", "t", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", "xc"}], ")"}], "2"], "/", 
          SuperscriptBox["ax", "2"]}], "+", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"theRay0", "[", "t", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", "yc"}], ")"}], "2"], "/", 
          SuperscriptBox["ay", "2"]}], "+", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"theRay0", "[", "t", "]"}], "[", 
              RowBox[{"[", "3", "]"}], "]"}], "-", "zc"}], ")"}], "2"], "/", 
          SuperscriptBox["az", "2"]}]}], "==", 
        SuperscriptBox["r", "2"]}], ",", 
       RowBox[{"{", "t", "}"}], ",", "Reals"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< # of sol1 = \>\"", ",", 
      RowBox[{"Length", "@", "sol1"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t1", "=", 
     RowBox[{
      RowBox[{"t", "/.", 
       RowBox[{"blob", "[", 
        RowBox[{"Last", "@", "sol1"}], "]"}]}], "//.", "ruleCompact"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ============== t1 = \>\"", ",", "t1"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pntOnMir0", "=", 
     RowBox[{
      RowBox[{"blob", "[", 
       RowBox[{"theRay0", "[", "t1", "]"}], "]"}], "//.", "ruleCompact"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ============== pntOnMir0 = \>\"", ",", "pntOnMir0"}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dirNormal", "=", 
     RowBox[{
      RowBox[{"blob", "[", 
       RowBox[{"Normalize", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"xc", ",", "yc", ",", "zc"}], "}"}], "-", "pntOnMir0"}], 
        "]"}], "]"}], "//.", "ruleCompact"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ============== dirNormal = \>\"", ",", "dirNormal"}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dirReflectedRay0", "=", 
     RowBox[{
      RowBox[{"blob", "[", 
       RowBox[{"reflect", "[", 
        RowBox[{"dirTheRay", ",", "dirNormal"}], "]"}], "]"}], "//.", 
      "ruleCompact"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
