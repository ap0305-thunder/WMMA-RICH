Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"grids", "[", 
     RowBox[{"min_", ",", "max_", ",", 
      RowBox[{"step_", ":", "1"}]}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"EvenQ", "[", "i", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "Red"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "Blue"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Ceiling", "[", "min", "]"}], ",", 
        RowBox[{"Floor", "[", "max", "]"}], ",", "step"}], "}"}]}], "]"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Print", "[", 
   RowBox[{"Show", "[", 
