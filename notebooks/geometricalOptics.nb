       RowBox[{"Norm", "@", "dirReflectedRay0"}]}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theReflectedRay0", "[", "t_", "]"}], "=", 
     RowBox[{"blob", "[", 
      RowBox[{
       RowBox[{"pntOnMir0", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"t", "-", "t1"}], ")"}], "*", "dirReflectedRay0"}]}], "//.",
        "ruleCompact"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ============== theReflectedRay0[t] = \>\"", ",", 
