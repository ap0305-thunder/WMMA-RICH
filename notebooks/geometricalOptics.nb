  RowBox[{
   RowBox[{"thePeriAxis", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theRay1", "[", "s_", "]"}], "=", 
     RowBox[{"blob", "[", 
      RowBox[{"First", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"+", "thePeriAxis"}], "+", 
         RowBox[{"s", "*", "dirTheRay"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"rule", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{"Dot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"theRay0", "[", "t", "]"}], "-", 
          RowBox[{"theRay1", "[", "s", "]"}]}], ",", "dirTheRay"}], "]"}], 
       "]"}]}], ";"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"theRay1", "[", "s", "]"}], "-", 
       RowBox[{"theRay0", "[", "t", "]"}]}], "/.", 
      RowBox[{"s", "->", 
       RowBox[{"t", "+", 
        RowBox[{"h", " ", 
         RowBox[{"Sin", "[", "\[Alpha]", "]"}]}]}]}]}], "//", "Simplify"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}]}]}]], "Input",
