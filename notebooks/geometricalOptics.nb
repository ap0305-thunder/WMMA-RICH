Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "just", " ", "another", " ", "parametrization", " ", "of", " ", "the", " ",
      "ray"}], ",", " ", 
    RowBox[{"starting", " ", "from", " ", "the", " ", "calcPeriCentPnt"}]}], 
