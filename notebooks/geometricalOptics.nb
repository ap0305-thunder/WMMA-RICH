Cell[CellGroupData[{

Cell["calc1 - analytic ray-tracing to FS", "Section",
 CellTags->
  "calc1 - analytic ray-tracing to \
FS",ExpressionUUID->"12706710-53a4-4dbe-b63c-f8f7ceb28180"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Intersect", " ", "with", " ", "mirror"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "sol1", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol1", "=", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"theRay1", "[", "t", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", "xc"}], ")"}], "2"], "/", 
          SuperscriptBox["ax", "2"]}], "+", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"theRay1", "[", "t", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", "yc"}], ")"}], "2"], "/", 
          SuperscriptBox["ay", "2"]}], "+", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"theRay1", "[", "t", "]"}], "[", 
              RowBox[{"[", "3", "]"}], "]"}], "-", "zc"}], ")"}], "2"], "/", 
          SuperscriptBox["az", "2"]}]}], "==", 
        SuperscriptBox["r", "2"]}], ",", 
       RowBox[{"{", "t", "}"}], ",", "Reals"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< # of sol1 = \>\"", ",", 
      RowBox[{"Length", "@", "sol1"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t1", "=", 
     RowBox[{"Assuming", "[", 
      RowBox[{
       RowBox[{"\[Alpha]", "\[NotEqual]", "0"}], ",", 
       RowBox[{
        RowBox[{"blob", "[", 
         RowBox[{"t", "/.", 
          RowBox[{"Last", "@", "sol1"}]}], "]"}], "//.", "ruleCompact"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ============== t1 = \>\"", ",", "t1"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pntOnMir1", "=", 
     RowBox[{"blob", "[", 
      RowBox[{
       RowBox[{"theRay1", "[", "t1", "]"}], "//.", "ruleCompact"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ============== pntOnMir = \>\"", ",", "pntOnMir1"}], "]"}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dirNormal", "=", 
     RowBox[{"blob", "[", 
      RowBox[{
       RowBox[{"Normalize", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"xc", ",", "yc", ",", "zc"}], "}"}], "-", "pntOnMir1"}], 
        "]"}], "//.", "ruleCompact"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ============== dirNormal  = \>\"", ",", "dirNormal"}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dirReflectedRay1", "=", 
     RowBox[{"blob", "[", 
      RowBox[{"reflect", "[", 
       RowBox[{"dirTheRay", ",", "dirNormal"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ============== dirReflectedRay1 = \>\"", ",", 
      "dirReflectedRay1"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ============== dirReflectedRay1 norm = \>\"", ",", 
      RowBox[{"Simplify", "@", 
       RowBox[{"Norm", "@", "dirReflectedRay1"}]}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theReflectedRay1", "[", "t_", "]"}], "=", 
     RowBox[{"blob", "[", 
      RowBox[{"pntOnMir1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"t", "-", "t1"}], ")"}], "*", "dirReflectedRay1"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ============== theReflectedRay1[t] = \>\"", ",", 
      RowBox[{"theReflectedRay1", "[", "t", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Intersect", " ", "with", " ", "FS"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "sol2", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol2", "=", 
     RowBox[{"intersectLineToPlane", "[", 
      RowBox[{
      "fpVec", ",", "fpPnt", ",", "pntOnMir1", ",", "dirReflectedRay1"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ============== # of sol2 \>\"", ",", 
      RowBox[{"Length", "@", 
       RowBox[{"Flatten", "@", "sol2"}]}]}], " ", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t2", "=", 
     RowBox[{"blob", "[", 
      RowBox[{
       RowBox[{"First", "@", "sol2"}], "//.", "ruleCompact"}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ============== t2 \>\"", ",", "t2"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pEnd1", "=", 
     RowBox[{"blob", "[", 
      RowBox[{
       RowBox[{"Last", "@", "sol2"}], "//.", "ruleCompact"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\< ============== pEnd1 \>\"", ",", "pEnd1"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pEnd1a", "=", "pEnd1"}], ";"}]}]}]], "Input",
 CellLabel->
