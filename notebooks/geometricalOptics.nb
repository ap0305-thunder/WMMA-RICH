      RowBox[{"Simplify", "[", 
       RowBox[{"Dot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"theRay0", "[", "t", "]"}], "-", 
          RowBox[{"theRay1", "[", "s", "]"}]}], ",", "dirTheRay"}], "]"}], 
       "]"}]}], ";"}], "*)"}], "\n", 
   RowBox[{
