             RowBox[{
              RowBox[{"theRay1", "[", "t", "]"}], "[", 
              RowBox[{"[", "3", "]"}], "]"}], "-", "zc"}], ")"}], "2"], "/", 
          SuperscriptBox["az", "2"]}]}], "==", 
