      RowBox[{"s", "->", 
       RowBox[{"t", "+", 
        RowBox[{"h", " ", 
         RowBox[{"Sin", "[", "\[Alpha]", "]"}]}]}]}]}], "//", "Simplify"}], 
    ";"}], "\[IndentingNewLine]", 
