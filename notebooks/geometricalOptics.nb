      RowBox[{"Sin", "[", "\[Xi]", "]"}]}], "+", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Alpha]", "]"}], " ", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ",", 
