    RowBox[{
     RowBox[{"Cos", "[", "\[Alpha]", "]"}], " ", 
     RowBox[{"Sin", "[", "\[Xi]", "]"}], " ", 
     RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], "//.", 
   RowBox[{
