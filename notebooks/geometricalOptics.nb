 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"grids", "[", 
     RowBox[{"min_", ",", "max_", ",", 
      RowBox[{"step_", ":", "1"}]}], "]"}], ":=", 
    RowBox[{"Table", "[", 
