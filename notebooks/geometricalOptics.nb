Cell[BoxData[Cell[TextData[{
  "Focusing error improves for low theta? \nMomentum resolution improves? for \
low momentum?\n",
  Cell[BoxData[
   RowBox[{"ArcCos", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Sqrt]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["h", "2"]}], "+", 
         SuperscriptBox["r", "2"], "+", 
         RowBox[{
          SuperscriptBox["h", "2"], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Alpha]", "]"}], "2"]}]}], ")"}]}], ")"}], "/",
      "r"}], "]"}]],ExpressionUUID->"8d125dc2-bb73-9649-8057-4d4ca6d4335e"],
  " == gamma // angolo di incidenza!!!\n!@#$%CHECK:\nIf ",
  Cell[BoxData[
   RowBox[{
    SuperscriptBox["r", "2"], "-", 
    RowBox[{"2", 
     SuperscriptBox["\[DoubleStruckP]\[DoubleStruckB]", "2"]}]}]],
   ExpressionUUID->"86e00a08-ace3-b04d-b06a-5cb03e1be977"],
  "<0 the reflected ray continues in the positive z direction, so no \
intersection coming back...."
 }], "Text",
  CellGroupingRules->{"GroupTogetherGrouping", 10001.},
  InitializationCell->True,
  $CellContext`InitializationGroup -> True,ExpressionUUID->
  "8855304f-8fc3-f442-a7ac-5ae2f2907cd8"]], "Text",
 $CellContext`InitializationGroup -> 
 True,ExpressionUUID->"eaab2951-95d2-0148-9906-2192211df662"]
}, Open  ]],

