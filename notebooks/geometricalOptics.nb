     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"uz", "/", 
          RowBox[{"Cos", "[", "\[Xi]", "]"}]}], ")"}], "2"]}], "]"}]}]}]}], "//.", 
  RowBox[{
   RowBox[{"Cos", "[", "\[Alpha]", "]"}], " ", "->", 
   RowBox[{"(", 
    RowBox[{"uz", "/", 
     RowBox[{"Cos", "[", "\[Xi]", "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"%", "//.", 
  RowBox[{
   RowBox[{"Cos", "[", "\[Alpha]", "]"}], " ", "->", 
   RowBox[{"uz", "/", 
    RowBox[{"Cos", "[", "\[Xi]", "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"eq", "=", 
