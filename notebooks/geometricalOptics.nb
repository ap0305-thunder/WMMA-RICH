    RowBox[{"grids", "[", 
     RowBox[{"min_", ",", "max_", ",", 
      RowBox[{"step_", ":", "1"}]}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"EvenQ", "[", "i", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "Red"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "Blue"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
