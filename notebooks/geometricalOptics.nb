   RowBox[{"thePeriAxis", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theRay1", "[", "s_", "]"}], "=", 
     RowBox[{"blob", "[", 
      RowBox[{"First", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"+", "thePeriAxis"}], "+", 
         RowBox[{"s", "*", "dirTheRay"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
