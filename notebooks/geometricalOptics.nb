     RowBox[{
     "d0x", "|", "d0y", "|", "\[Alpha]x", "|", "\[Alpha]y", "|", 
      "\[Alpha]z"}], ",", "Reals"}], "]"}], "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Beta]", ":=", 
