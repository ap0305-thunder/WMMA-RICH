Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "estVal", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"estVal", "[", 
      RowBox[{"list_", ",", 
       RowBox[{"n0_", ":", "30"}], ",", 
       RowBox[{"s1_", ":", "0.0"}], ",", 
       RowBox[{"s2_", ":", "0.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Mu]", ",", "\[Sigma]", ",", "\[Sigma]m", ",", "n", ",", "res"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "list", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Mu]", "=", 
         RowBox[{"Mean", "[", "list", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Sigma]", "=", 
         RowBox[{"StandardDeviation", "[", "list", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"res", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           SuperscriptBox["\[Sigma]", "2"], "+", 
           SuperscriptBox["s1", "2"], "+", 
           SuperscriptBox["s2", "2"]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Sigma]m", "=", 
         RowBox[{"res", "/", 
          RowBox[{"Sqrt", "[", "n0", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"{", 
          RowBox[{
          "n", ",", "\[Mu]", ",", "\[Sigma]", ",", "res", ",", "\[Sigma]m"}], 
          "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"num", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"photonEnergies", "=", 
     RowBox[{"generatePhotonEnergy", "[", "num", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Histogram", "[", 
      RowBox[{"photonEnergies", ",", 
       RowBox[{"PlotLabel", "\[Rule]", "\"\< generated energies \>\""}]}], 
      "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"calcChroma", "[", 
      RowBox[{"\[Lambda]Min_", ",", "\[Lambda]Max_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"res", ",", "partMom"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"Histogram", "[", 
          RowBox[{
           RowBox[{"\[Lambda]", "[", "photonEnergies", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Lambda]Min", ",", "\[Lambda]Max", ",", "10"}], "}"}]}],
           "]"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"wavelnList", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"\[Lambda]", "[", "photonEnergies", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\[Lambda]Min", "\[LessEqual]", "#"}], ")"}], "&&", 
             RowBox[{"(", 
              RowBox[{"#", "\[LessEqual]", "\[Lambda]Max"}], ")"}]}], "&"}]}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "@", 
         RowBox[{"Histogram", "[", 
          RowBox[{"wavelnList", ",", 
           RowBox[{"{", 
            RowBox[{"\[Lambda]Min", ",", "\[Lambda]Max", ",", "10"}], "}"}]}],
           "]"}]}], ";", 
        RowBox[{"Print", "[", 
         RowBox[{"Histogram", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ArcCos", "[", 
             RowBox[{"1", "/", 
              RowBox[{"theRefrIndex", "[", "wavelnList", "]"}]}], "]"}], "*", 
            "1000"}], ",", 
           RowBox[{"{", 
            RowBox[{"48", ",", "56", ",", "0.03"}], "}"}], ",", 
           RowBox[{"Background", "\[Rule]", "White"}], ",", 
           RowBox[{"LabelStyle", "\[Rule]", 
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"Background", "\[Rule]", "White"}], ",", 
              RowBox[{"FontFamily", "->", "\"\<Helvetica\>\""}], ",", "Bold", 
              ",", "20"}], "]"}]}], ",", 
           RowBox[{"Axes", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"True", ",", "False"}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"\"\<mrad\>\"", ",", "\"\<\>\""}], "}"}]}], ",", 
           RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "]"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"histoDisplay", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ArcCos", "[", 
            RowBox[{"1", "/", 
             RowBox[{"theRefrIndex", "[", "wavelnList", "]"}]}], "]"}], "*", 
           "1000"}], ",", "halfOpenAngleMRad", ",", "True"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fact", "=", "4"}], ";", "\[IndentingNewLine]", 
        RowBox[{"maxP", "=", "99"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Histogram", "[", 
             RowBox[{
              RowBox[{"Evaluate", "[", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"tpl", "[", 
                  RowBox[{
                   RowBox[{"thePartMasses", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "partMom", ",", 
                   "wavelnList"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "1", ",", "5"}], "}"}]}], "]"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "56", ",", "0.3"}], "}"}], ",", 
              RowBox[{"Frame", "\[Rule]", "Automatic"}], ",", 
              RowBox[{"PlotLabel", "\[Rule]", 
               RowBox[{"N", "@", "partMom"}]}]}], "]"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"nfpm", "[", 
             RowBox[{
              RowBox[{"res", "=", "           ", 
               RowBox[{"Map", "[", "          ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"estVal", "[", "            ", 
                   RowBox[{
                   "#", "          ", ",", "31", ",", " ", "0.3", ",", 
                    "0.3"}], "                  ", "]"}], "     ", "&"}], ",", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"tpl", "[", 
                    RowBox[{
                    RowBox[{"thePartMasses", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "partMom", ",", 
                    "wavelnList"}], "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "1", ",", "5"}], "}"}]}], "]"}]}], 
                "]"}]}], "                    ", ",", "3", ",", "2"}], "]"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"results", ",", "res"}], "]"}]}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"partMom", ",", "1", ",", "maxP", ",", "10"}], "}"}]}], 
         "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"results", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"calcChroma", "[", 
    RowBox[{"300", ",", "700"}], "]"}]}]}]], "Input",
 Evaluatable->True,
 Background->ThemeColor[{0.971 -> "Foreground", 0.029 -> "Background"}],
 CellLabel->
  "3/29/25 05:48:16 \
In[921]:=",ExpressionUUID->"fd0db2c9-3c6e-4c92-99c5-353815c06508"],

