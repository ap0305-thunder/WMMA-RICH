Cell["\<\
This notebook does all the calculations on optics for a RICH detector, based \
on OpticaEM.\
\>", "Text",
 InitializationCell->False,
 CellChangeTimes->{
  3.945862080410919*^9, {3.9828965532211285`*^9, 3.982896555289139*^9}, {
