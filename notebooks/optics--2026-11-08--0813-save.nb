         RowBox[{"trackPathLength", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"(*", 
          RowBox[{
          "else", " ", "compute", " ", "the", " ", "Euclidean", " ", 
           "distance"}], "*)"}], 
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"allTracedAnalyzedTracksOnPriPoint", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", 
           RowBox[{"allTracedAnalyzedTracksOnSecPoint", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}]}], "]"}], ",", 
