Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "get", " ", "rid", " ", "of", " ", "all", " ", "previusly", " ", "defined",
     " ", "Epilog"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"graphicsList", "=", 
