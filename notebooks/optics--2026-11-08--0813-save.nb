Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"whichOptics", "!=", "\"\<LHCb35Upg2Split\>\""}], ")"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
