            RowBox[{"half", " ", 
             RowBox[{"Cos", "[", "tiltScreen", "]"}]}]}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Centre\>\"", "->", "cen"}], ",", 
          RowBox[{"\"\<Top\>\"", "->", "top"}], ",", 
          RowBox[{"\"\<Bottom\>\"", "->", "bot"}]}], "|>"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
