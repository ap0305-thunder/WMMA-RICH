Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"whichOptics", "==", "\"\<LHCb35Upg2Split\>\""}], ")"}], "\n", ",",
     "\n", 
    RowBox[{
     RowBox[{"Unprotect", "[", 
      RowBox[{
      "onThePriMirrorL", ",", "onThePriMirrorH", ",", "onTheSecMirrorL", ",", 
       "onTheSecMirrorH", ",", "onTheTerMirrorL", ",", "onTheTerMirrorH", ",",
        "onTheQuartzPlateFronL", ",", "onTheQuartzPlateBackL", ",", 
       "onTheQuartzPlateFronH", ",", "onTheQuartzPlateBackH", ",", "onTheFSL",
        ",", "onTheFSH", ",", "onTheBox"}], "]"}], ";", "\n", 
     RowBox[{"(*", "*)"}], "\n", 
     RowBox[{"onThePriMirrorL", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ComponentNumber", "->", "1"}], ",", 
        RowBox[{"SurfaceNumber", "->", "1"}]}], "}"}]}], ";", "\n", 
     RowBox[{"onThePriMirrorH", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ComponentNumber", "->", "2"}], ",", 
        RowBox[{"SurfaceNumber", "->", "1"}]}], "}"}]}], ";", "\n", 
     RowBox[{"onTheSecMirrorL", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ComponentNumber", "->", "3"}], ",", 
        RowBox[{"SurfaceNumber", "->", "1"}]}], "}"}]}], ";", "\n", 
     RowBox[{"onTheSecMirrorH", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ComponentNumber", "->", "4"}], ",", 
        RowBox[{"SurfaceNumber", "->", "1"}]}], "}"}]}], ";", "\n", 
     RowBox[{"onTheFSL", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ComponentNumber", "->", "5"}], ",", 
        RowBox[{"SurfaceNumber", "->", "1"}]}], "}"}]}], ";", "\n", 
     RowBox[{"onTheFSH", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ComponentNumber", "->", "6"}], ",", 
        RowBox[{"SurfaceNumber", "->", "1"}]}], "}"}]}], ";", "\n", 
     RowBox[{"onTheBox", "=", 
      RowBox[{"{", 
       RowBox[{"ComponentNumber", "->", "7"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", "*)"}], "\n", 
     RowBox[{"Protect", "[", 
