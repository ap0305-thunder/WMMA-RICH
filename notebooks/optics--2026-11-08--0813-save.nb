         RowBox[{"optValue", "[", 
          RowBox[{"\"\<tiltScreen\>\"", ",", "suffix"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"half", "=", 
         RowBox[{"sizeTrnsvrsScreen", "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cen", "=", 
         RowBox[{"{", 
          RowBox[{"zScreen", ",", "xScreen"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"top", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"zScreen", "-", 
