Cell[CellGroupData[{

Cell["split2", \
"Subsection",ExpressionUUID->"1d3c3eb2-385b-994a-a993-31239585ad7a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "=", 
    RowBox[{"===", "===", "===", "===", "=="}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"SurfaceNumber", " ", "is", " ", "PER"}], "-", 
     RowBox[{
      RowBox[{"COMPONENT", "!!"}], "!"}]}], " ", "//", " ", 
    RowBox[{
    "if", " ", "you", " ", "resonate", " ", "all", " ", "then", " ", 
     "SufaceNumber", " ", "uniquely", " ", "identifies", " ", "the", " ", 
     "different", " ", 
     RowBox[{
      RowBox[{"surfaces", "!!"}], "!"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "=", 
    RowBox[{"===", "===", "===", "===", "=="}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"whichOptics", "==", "\"\<LHCb35Upg2Split\>\""}], ")"}], 
     "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"onTheFSAll", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ComponentNumber", "\[Rule]", "5"}], ",", 
           RowBox[{"SurfaceNumber", "\[Rule]", "1"}]}], "}"}], ",", "   ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ComponentNumber", "\[Rule]", "6"}], ",", 
           RowBox[{"SurfaceNumber", "\[Rule]", "1"}]}], "}"}]}], "      ", 
        "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"onTheFS", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ComponentNumber", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"5", ",", "6"}], "}"}]}], ",", 
           RowBox[{"SurfaceNumber", "\[Rule]", "1"}]}], "}"}]}], ";"}], 
       "*)"}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{
           RowBox[{"@", "#$"}], "%", " ", "list", " ", "does", " ", "not", " ",
            "work"}]}], "..."}], "."}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Unprotect", "[", "onTheFS", "]"}], ";", 
        RowBox[{"Remove", "[", "onTheFS", "]"}], ";", 
        RowBox[{"Clear", "[", "onTheFS", "]"}], ";"}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{"!", 
        RowBox[{
         RowBox[{"@", "#$"}], "%"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"iSurf1", "=", "False"}], ";", "\[IndentingNewLine]", 
      RowBox[{"iSurf2", "=", "False"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "@", "analyzedSystem"}], ">", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"printD", "@", "onTheFSL"}], ";", "\[IndentingNewLine]", 
         RowBox[{"printD", "@", "onTheFSH"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "==="}], "=", 
           RowBox[{"===", "===", "===", "===", "=="}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"on", " ", "the", " ", "FSL"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "==="}], "=", 
           RowBox[{"===", "===", "===", "===", "=="}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"raysOnTheFS2DL", "=", 
          RowBox[{"ReadRays", "[", 
           RowBox[{
           "analyzedSystem", ",", "SurfaceCoordinates", ",", "onTheFSL"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"raysOnTheFS3DL", "=", 
          RowBox[{"ReadRays", "[", 
           RowBox[{"analyzedSystem", ",", "RayEnd", ",", "onTheFSL"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"raysOnTheFSTiltL", "=", 
          RowBox[{"ReadRays", "[", 
           RowBox[{"analyzedSystem", ",", "RayTilt", ",", "onTheFSL"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Length", "@", "raysOnTheFS2DL"}], ">", "0"}], ")"}], "&&", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Length", "@", "raysOnTheFS3DL"}], ">", "0"}], ")"}], "&&", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Length", "@", "raysOnTheFSTiltL"}], ">", "0"}], 
             ")"}]}], ",", 
           RowBox[{"iSurf1", "=", "True"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "==="}], "=", 
           RowBox[{"===", "===", "===", "===", "=="}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"on", " ", "the", " ", "FSH"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "==="}], "=", 
           RowBox[{"===", "===", "===", "===", "=="}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"raysOnTheFS2DH", "=", 
          RowBox[{"ReadRays", "[", 
           RowBox[{
           "analyzedSystem", ",", "SurfaceCoordinates", ",", "onTheFSH"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"raysOnTheFS3DH", "=", 
          RowBox[{"ReadRays", "[", 
           RowBox[{"analyzedSystem", ",", "RayEnd", ",", "onTheFSH"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"raysOnTheFSTiltH", "=", 
          RowBox[{"ReadRays", "[", 
           RowBox[{"analyzedSystem", ",", "RayTilt", ",", "onTheFSH"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Length", "@", "raysOnTheFS2DH"}], ">", "0"}], ")"}], "&&", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Length", "@", "raysOnTheFS3DH"}], ">", "0"}], ")"}], "&&", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Length", "@", "raysOnTheFSTiltH"}], ">", "0"}], 
             ")"}]}], ",", 
           RowBox[{"iSurf2", "=", "True"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "==="}], "=", 
           RowBox[{"===", "===", "===", "===", "=="}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"on", " ", "the", " ", "FS"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "==="}], "=", 
           RowBox[{"===", "===", "===", "===", "=="}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"raysOnTheFS2D", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"raysOnTheFS2DL", ",", "raysOnTheFS2DH"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Rotate", "[", 
             RowBox[{
              RowBox[{"Show", "[", 
               RowBox[{"Graphics", "[", 
                RowBox[{
                 RowBox[{"Point", "[", "raysOnTheFS2D", "]"}], ",", 
                 RowBox[{"AspectRatio", "->", "Automatic"}]}], "]"}], "]"}], ",", 
              RowBox[{"Pi", "/", "2"}]}], "]"}], "]"}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"Rotate", "[", 
           RowBox[{
            RowBox[{"Show", "[", 
             RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"Red", ",", 
                   RowBox[{"Point", "[", 
                    RowBox[{"swapTheXYCoords", "/@", "raysOnTheFS2DL"}], 
                    "]"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"Blue", ",", 
                   RowBox[{"Point", "[", 
                    RowBox[{"swapTheXYCoords", "/@", "raysOnTheFS2DH"}], 
