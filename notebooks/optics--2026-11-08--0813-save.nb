    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"OpticalLayout", "[", 
      RowBox[{"opticalSystemLHCbRICH", ",", 
       RowBox[{"ImageSize", "->", "Full"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"bigBanner", "[", "\"\< optical system printout \>\"", "]"}], 
        ";", "\[IndentingNewLine]", 
