Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", "turboTracedSystem"}], ">", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
       "miniBanner", "[", "\"\< found a turbo-traced system ... \>\"", "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
       "bigBanner", 
        "[", "\"\< make sure that turbo-trace did not miss rays..... // DONT \
USE HERE \>\"", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "@", 
        RowBox[{"Tally", "@", 
         RowBox[{"ReadTurboRays", "[", 
          RowBox[{"turboTracedSystem", ",", 
           RowBox[{"{", 
            RowBox[{"ComponentNumber", ",", "SurfaceNumber"}], "}"}]}], 
          "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"theCompSurfTurbo", "=", 
        RowBox[{"DeleteDuplicates", "@", 
         RowBox[{"ReadTurboRays", "[", 
          RowBox[{"turboTracedSystem", ",", 
           RowBox[{"{", 
            RowBox[{"ComponentNumber", ",", "SurfaceNumber"}], "}"}]}], 
          "]"}]}]}], ";", 
       RowBox[{"TableForm", "[", 
        RowBox[{"theCompSurfTurbo", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"theCompSurfTurbo", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"#1", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ">", 
               RowBox[{"#2", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "&"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#1", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<", 
             RowBox[{"#2", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\< component # = \>\"", ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "\"\< surface # = \>\"", ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}], ",", 
         "theCompSurfTurbo"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", "analyzedSystem"}], ">", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
       "miniBanner", "[", "\"\< found an analyzed system ... \>\"", "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "@", 
        RowBox[{"Tally", "@", 
         RowBox[{"ReadRays", "[", 
          RowBox[{"analyzedSystem", ",", 
           RowBox[{"{", 
            RowBox[{"ComponentNumber", ",", "SurfaceNumber"}], "}"}]}], 
          "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"theCompSurf", "=", 
        RowBox[{"DeleteDuplicates", "@", 
         RowBox[{"ReadRays", "[", 
          RowBox[{"analyzedSystem", ",", 
           RowBox[{"{", 
            RowBox[{"ComponentNumber", ",", "SurfaceNumber"}], "}"}]}], 
          "]"}]}]}], ";"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "@", "turboTracedSystem"}], ">", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
          "Print", 
           "[", "\"\< found a turbo-traced system and not an analyzed system \
: use turbo... \>\"", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{
          "bigBanner", 
           "[", "\"\< make sure that turbo-trace did not miss rays.....\>\"", 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "@", 
           RowBox[{"Tally", "@", 
            RowBox[{"ReadTurboRays", "[", 
             RowBox[{"turboTracedSystem", ",", 
              RowBox[{"{", 
               RowBox[{"ComponentNumber", ",", "SurfaceNumber"}], "}"}]}], 
             "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"theCompSurfTurbo", "=", 
           RowBox[{"DeleteDuplicates", "@", 
            RowBox[{"ReadTurboRays", "[", 
             RowBox[{"turboTracedSystem", ",", 
              RowBox[{"{", 
               RowBox[{"ComponentNumber", ",", "SurfaceNumber"}], "}"}]}], 
             "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"theCompSurf", "=", "theCompSurfTurbo"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\< NO DATA FOUND \>\"", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}]}]}]], "Input",
