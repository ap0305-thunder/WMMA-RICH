Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"iRICH", "==", "1"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"plotRangeAnglesScan", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "301"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "251"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.01", ",", "All"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"plotRangeFocusingError", "=", 
      RowBox[{"{", 
       RowBox[{"0.0", ",", "0.8", ",", "0.01"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"plotLabelAnglesScan", "=", 
      RowBox[{"{", 
       RowBox[{"\"\<RICH1 hor\>\"", ",", " ", "\"\<RICH1 ver\>\"", ",", 
        " ", "\"\< focusing \\n error \\n angle \\n (mrad) \>\""}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"thisPlotLabel", "=", "\"\<RICH1-U half-PDA\>\""}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ticks", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{"i", ",", 
