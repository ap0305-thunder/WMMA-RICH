Cell[CellGroupData[{

Cell["\<\
(*FIX 2026-11-07 (review 2-4): load an optics definition file from src/ and \
stop the evaluation if the file is missing, fails to load, or defines no \
optical system (stub, or wrong iRICH/whichOptics)*)
ClearAll[loadOpticsDefinition];
loadOpticsDefinition[file_String]:=Module[{dir,path,res,nonSplitQ,splitQ},
lastOpticsDefinition=None;
dir=Quiet@Check[RICHProjectPath[\"src\"],$Failed];
If[!StringQ[dir]||!DirectoryQ[dir],dir=FileNameJoin[{ParentDirectory[\
NotebookDirectory[]],\"src\"}]];
path=FileNameJoin[{dir,file}];
If[!FileExistsQ[path],
bigBanner[\" OPTICS FILE NOT FOUND: \"<>file<>\" -- choose another \
whichOptics/opticsVersion \"];
Print[\"  looked for: \",path];
Abort[]
];
res=loadMyFile[file,dir];
If[res===$Failed,
bigBanner[\" OPTICS FILE FAILED TO LOAD: \"<>file];
Abort[]
];
(*doResetAllVariables[], called at the top of every definition file, clears \
the optical components: a complete file must rebuild them*)
nonSplitQ=ValueQ[priMirror]&&ValueQ[secMirror]&&ValueQ[thePDA];
splitQ=ValueQ[priMirrorL]&&ValueQ[priMirrorH]&&ValueQ[secMirrorL]&&ValueQ[\
secMirrorH]&&ValueQ[thePDAL]&&ValueQ[thePDAH];
If[!(nonSplitQ||splitQ),
bigBanner[\" OPTICS FILE DEFINES NO OPTICAL SYSTEM (stub, or wrong \
iRICH/whichOptics): \"<>file];
Abort[]
];
lastOpticsDefinition=<|\"file\"->file,\"iRICH\"->iRICH,\"whichOptics\"->\
whichOptics,\"opticsVersion\"->opticsVersion|>;
res
];\
\>", "Input",
 CellTags->"FIX-2026-11-07",
 CellLabel->
  "11/8/26 07:43:07 \
In[42]:=",ExpressionUUID->"70b1ce15-a794-5349-b47c-744c70d267c6"],

