         RowBox[{"(", 
          RowBox[{"\[Beta]", "*", 
           RowBox[{"theRefrIndex", "[", "\[Lambda]", "]"}]}], ")"}]}], ")"}], 
       "2"]}], ")"}], "/", 
    SuperscriptBox["\[Lambda]", "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"integratedNumberWavLenSpectrum", "[", 
    RowBox[{"\[Lambda]_", ",", "\[Beta]_"}], "]"}], ":=", 
   RowBox[{"Evaluate", "@", 
    RowBox[{"Re", "[", 
     RowBox[{"theChrYieldConstant", "*", "theConstantWavLenFromToEnergy", "*", 
