Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Ellipseparametersfromgeneralconicequation", "*)"}], "\n", 
  "\n", 
  RowBox[{
   RowBox[{"ClearAll", "[", "ellipseParameters", "]"}], "\n", "\n", 
   RowBox[{
    RowBox[{"ellipseParameters", "[", 
     RowBox[{"{", 
      RowBox[{
      "aa_", ",", "bb_", ",", "cc_", ",", "dd_", ",", "ee_", ",", "ff_"}], 
      "}"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\n", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"(*", "Matrixformofconic", "*)"}], 
       RowBox[{
       "M", ",", "v", ",", "center", ",", "evals", ",", "evecs", ",", "axes", 
        ",", "aaa", ",", "bbb", ",", "angle"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "Conicmatrixinhomogeneouscoordinates", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"M", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"aa", ",", 
            RowBox[{"bb", "/", "2"}], ",", 
            RowBox[{"dd", "/", "2"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"bb", "/", "2"}], ",", "cc", ",", 
            RowBox[{"ee", "/", "2"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"dd", "/", "2"}], ",", 
            RowBox[{"ee", "/", "2"}], ",", "ff"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Center", "=", 
         RowBox[{"solutionofgradient", "=", "0"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"center", "=", 
        RowBox[{"LinearSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"2", "*", "aa"}], ",", "bb"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"bb", ",", 
              RowBox[{"2", "*", "cc"}]}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "dd"}], ",", 
            RowBox[{"-", "ee"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "Quadraticformfortheellipsepart", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"v", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"aa", ",", 
            RowBox[{"bb", "/", "2"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"bb", "/", "2"}], ",", "cc"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Eigen", "-", "decompositiontogetaxesorientationandlengths"}],
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"evals", ",", "evecs"}], "}"}], "=", 
        RowBox[{"Eigensystem", "[", "v", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Semi", "-", 
         RowBox[{"axeslengths", ":", "needvalueofquadraticformatcenter"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x0", ",", "y0", ",", "val"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x0", ",", "y0"}], "}"}], "=", "center"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"val", "=", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x0", ",", "y0", ",", "1"}], "}"}], ".", "M", ".", 
            RowBox[{"{", 
             RowBox[{"x0", ",", "y0", ",", "1"}], "}"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "plugcenterintoconiceq", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"axes", "=", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"-", "val"}], "/", "evals"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"aaa", ",", "bbb"}], "}"}], "=", 
           RowBox[{"Sort", "[", 
            RowBox[{"axes", ",", "Greater"}], "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "Rotationangleofmajoraxis", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"angle", "=", 
        RowBox[{"ArcTan", "@@", 
         RowBox[{"evecs", "[", 
          RowBox[{"[", 
           RowBox[{"First", "@", 
            RowBox[{"FirstPosition", "[", 
             RowBox[{"axes", ",", "aaa"}], "]"}]}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Center\>\"", "->", "center"}], ",", 
         RowBox[{"\"\<SemiMajorAxis\>\"", "->", "aaa"}], ",", 
         RowBox[{"\"\<SemiMinorAxis\>\"", "->", "bbb"}], ",", 
         RowBox[{"\"\<RotationAngle\>\"", "->", "angle"}]}], "|>"}]}]}], "\n",
      "]"}]}], "\n", "\n", 
   RowBox[{"(*", "Exampleusage", "*)"}], "\n", "\n", 
   RowBox[{"ellipseParameters", "[", 
    RowBox[{"{", 
     RowBox[{"3", ",", "1.", ",", "2", ",", 
      RowBox[{"-", "4"}], ",", 
      RowBox[{"-", "5"}], ",", 
      RowBox[{"-", "20."}]}], "}"}], "]"}]}]}]], "Input",
 Evaluatable->True,
 CellChangeTimes->{
  3.945862080410919*^9, 3.9468070237038136`*^9, 3.9839261387239513`*^9, 
   3.9839262562624493`*^9, {3.9875866048311005`*^9, 3.987586625575983*^9}, {
