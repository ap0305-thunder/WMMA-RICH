Cell["\<\
This notebook does all the calculations on optics for a RICH detector, based \
on OpticaEM.\
\>", "Text",
 InitializationCell->False,
 CellChangeTimes->{
  3.945862080410919*^9, {3.9828965532211285`*^9, 3.982896555289139*^9}, {
   3.98360537715271*^9, 3.983605377287899*^9}},
 Background->RGBColor[
  0.3686274509803922, 0.7098039215686275, 
   0.9333333333333333],ExpressionUUID->"a6d896d7-3a9e-8b4f-88c8-a1229d1e2af9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["RUN CONTROL PANEL", "Title",
 CellTags->"RICHRunPanel",
 Background->RGBColor[1, 0.95, 0.8]],

Cell["\<\
Choose RICH, optics, source and options here, then press Run: it evaluates \
the chapters OPTICAL SYSTEM DESIGN and OPTICS ANALYSIS (their Title cells \
carry the cell tag RICHRunChapter). Export drawing writes the detailed side \
view and the geometry report of the current optics to the output folder; \
Export summary writes run-summary--<tagString>--<date>.txt. Float opens the \
same panel as a floating palette window bound to this notebook (not saved: \
press Float again after reopening). The choices are saved with the notebook. \
Untick \"use panel values\" to go back to editing the cell *** DEFINE RUN \
OPTIONS by hand. If the panel below is missing or does not respond, evaluate \
the input cell once.\
\>", "Text",ExpressionUUID->"a1e2286c-f506-1e4a-b123-b686bf95065e"],

Cell[CellGroupData[{
Cell["\<
(* ============================================================================================ *)
(* RUN CONTROL PANEL (2026-11-08; 2026-11-12: title, high-contrast choices)                      *)
(*  - the choices are saved in this notebook (notebook option TaggingRules -> \"RICHRunOptions\")   *)
(*  - \"use panel values\" ticked: the cell after *** DEFINE RUN OPTIONS replaces the values set     *)
(*    there with the ones chosen here; unticked: *** DEFINE RUN OPTIONS works as before            *)
(*  - Apply options: evaluates only the DEFINE RUN OPTIONS cells (cell tag \"RICHDefineRunOptions\") *)
(*  - Run: evaluates the chapters OPTICAL SYSTEM DESIGN and OPTICS ANALYSIS                        *)
(*    (the Title cells with cell tag \"RICHRunChapter\")                                             *)
(*  - Stop: aborts the running evaluation and the queued cells (same as Alt+.)                     *)
(*  - Export drawing: exportRunDrawings[] (detailed side view + geometry report)                   *)
(*  - Export summary: exportRunSummary[] (run-summary--<tagString>--<date>.txt)                    *)
(*  - Float: opens the same panel as a floating palette window, bound to this notebook            *)
(*    (the palette is not saved: press Float again after reopening the notebook)                   *)
(*  Evaluate this cell only to rebuild the panel: the panel is saved with the notebook.            *)
(* ============================================================================================ *)
Module[{rpTmpl},
(*panel template: richRunPanelNB / richRunPanelButtonNB stand for the notebook the panel acts on*)
rpTmpl=Hold[Module[{rpCtl,rpSetter,rpCheck},
rpCtl[k_]:=Dynamic[CurrentValue[richRunPanelNB,{TaggingRules,\"RICHRunOptions\",k}]];
(*choice buttons: the selected one is dark blue with bold white text, the others light grey*)
rpSetter[k_,choices_List]:=Row[Map[Function[ch,With[{v=If[Head[ch]===Rule,First[ch],ch],lbl=If[Head[ch]===Rule,Last[ch],ToString[ch]]},
Button[Dynamic[Style[lbl,If[CurrentValue[richRunPanelNB,{TaggingRules,\"RICHRunOptions\",k}]===v,Directive[Bold,White],GrayLevel[0.35]]]],
CurrentValue[richRunPanelButtonNB,{TaggingRules,\"RICHRunOptions\",k}]=v,
Background->Dynamic[If[CurrentValue[richRunPanelNB,{TaggingRules,\"RICHRunOptions\",k}]===v,RGBColor[0.10,0.33,0.72],GrayLevel[0.95]]],
ImageSize->All]]],choices],\" \"];
(*check boxes: the label is bold dark blue when ticked, light grey when not*)
rpCheck[k_,lbl_String]:=Row[{Checkbox[rpCtl[k]],Dynamic[Style[\" \"<>lbl,If[TrueQ[CurrentValue[richRunPanelNB,{TaggingRules,\"RICHRunOptions\",k}]],Directive[Bold,RGBColor[0.10,0.33,0.72]],GrayLevel[0.6]]]]}];
Panel[Column[{
Style[\"RICH optics run control\",Bold,14],
Grid[{
{\"notebook\",Dynamic[With[{rpF=Quiet@Check[FileNameTake[NotebookFileName[richRunPanelNB]],$Failed]},If[StringQ[rpF],Style[rpF,\"Program\"],Style[\"notebook not open\",Red]]]]},
{\"use panel values\",Row[{rpCheck[\"usePanel\",\"in use\"],Style[\"   (untick: *** DEFINE RUN OPTIONS uses the values written in its cell)\",Gray]}]},
{\"RICH\",rpSetter[\"iRICH\",{1->\"RICH1\",2->\"RICH2\"}]},
{\"optics\",rpSetter[\"whichOptics\",{\"LHCb22Upg1\",\"LHCb35Upg2FTDR\",\"LHCb35Upg2Split\"}]},
{\"optics version\",PopupMenu[rpCtl[\"opticsVersion\"],{\"Ale\",\"butterfly\",\"Eli\",\"Rob\",\"zero\"}]},
{\"source\",rpSetter[\"sourceType\",{\"gun\"->\"gun (particle guns)\",\"chr\"->\"chr (single particle Cherenkov)\",\"grd\"->\"grd (rectangular grid)\",\"line\"->\"line (line source)\"}]},
{\"sensor\",rpSetter[\"theSensor\",{\"MAPMT22\",\"MPPCHPK\"}]},
{\"Optica\",Row[{rpCheck[\"resonate\",\"resonate\"],\"      \",rpCheck[\"propagateSystemYes\",\"propagate system\"],\"      \",rpCheck[\"turboTraceYes\",\"turbo trace\"]}]},
{\"debug print\",rpCheck[\"debugPrintEnabledFlag\",\"on\"]},
{\"numQuantiles\",InputField[rpCtl[\"numQuantiles\"],Number,FieldSize->4]},
{\"addTag\",InputField[rpCtl[\"addTag\"],String,FieldSize->24]},
{\"tagString\",Dynamic[Module[{rpO},
rpO=Replace[CurrentValue[richRunPanelNB,{TaggingRules,\"RICHRunOptions\"}],Except[_Association|{___Rule}]-><||>];
Style[StringJoin[\"RICH\",ToString[Lookup[rpO,\"iRICH\",\"?\"]],\"_\",ToString[Lookup[rpO,\"sourceType\",\"?\"]],\"_\",ToString[Lookup[rpO,\"whichOptics\",\"?\"]],\"_\",ToString[Lookup[rpO,\"opticsVersion\",\"?\"]],\"_\",ToString[Lookup[rpO,\"addTag\",\"\"]]],\"Program\"]
]]},
{\"optics file\",Dynamic[Module[{rpO,rpI,rpW,rpV,rpF,rpDir,rpMsg={}},
rpO=Replace[CurrentValue[richRunPanelNB,{TaggingRules,\"RICHRunOptions\"}],Except[_Association|{___Rule}]-><||>];
rpI=Lookup[rpO,\"iRICH\",0];rpW=Lookup[rpO,\"whichOptics\",\"\"];rpV=Lookup[rpO,\"opticsVersion\",\"\"];
(*same choice of file as the cells in OPTICAL SYSTEM DESIGN > SYSTEM DEFINITION > OPTICS*)
rpF=Which[
rpW==\"LHCb22Upg1\"&&rpV==\"Ale\",\"optics-def-LHCb22Upg1-rich\"<>ToString[rpI]<>\".wl\",
rpW==\"LHCb35Upg2FTDR\",\"optics-def-LHCb35Upg2FTDR-rich\"<>ToString[rpI]<>\".wl\",
rpW==\"LHCb35Upg2Split\"&&rpV==\"Ale\",\"optics-def-LHCb35Upg2Split-rich\"<>ToString[rpI]<>\".wl\",
rpW==\"LHCb35Upg2Split\"&&rpV==\"Eli\",If[rpI==1,\"optics-def-LHCb35Upg2Split-rich1_E-v3-11-9.wl\",\"optics-def-LHCb35Upg2Split-rich2_E-v8-09-1.wl\"],
rpW==\"LHCb35Upg2Split\"&&rpV==\"butterfly\"&&rpI==1,\"optics-def-LHCb35Upg2Split-rich1-butterfly.wl\",
True,None];
rpDir=Quiet@Check[FileNameJoin[{ParentDirectory[NotebookDirectory[richRunPanelNB]],\"src\"}],\"\"];
If[rpF===None,AppendTo[rpMsg,\"no optics definition for this RICH / optics / version: the run will stop at OPTICS\"],
If[!FileExistsQ[FileNameJoin[{rpDir,rpF}]],AppendTo[rpMsg,\"file not found in src: the run will stop at OPTICS\"]]];
If[rpW==\"LHCb35Upg2FTDR\"&&rpI==1,AppendTo[rpMsg,\"FTDR RICH1 optics is still a stub (TO DO): the run will stop at OPTICS\"]];
If[rpV==\"butterfly\"&&!(rpW==\"LHCb35Upg2Split\"&&rpI==1),AppendTo[rpMsg,\"butterfly exists only for the Split RICH1 optics\"]];
Column[Join[{Style[If[rpF===None,\"-\",rpF],\"Program\"]},
If[rpMsg==={},{Style[\"ok\",Darker[Green]]},Style[\"\\[WarningSign] \"<>#,Red]&/@rpMsg]]]
]]}
},Alignment->{Left,Center},Spacings->{2,0.7}],
Row[{
Button[\"Apply options\",
Module[{rpNb=richRunPanelButtonNB,rpCells},
If[FreeQ[Notebooks[],rpNb],MessageDialog[\"the notebook of this panel is not open\"],
rpCells=Cells[rpNb,CellTags->\"RICHDefineRunOptions\"];
If[rpCells==={},MessageDialog[\"no cell with the cell tag RICHDefineRunOptions\"],
Do[SelectionMove[rpC,All,Cell];SelectionEvaluate[rpNb],{rpC,rpCells}]]]],
Method->\"Queued\"],
\"   \",
Button[Style[\"  Run  \",Bold],
Module[{rpNb=richRunPanelButtonNB,rpCells},
If[FreeQ[Notebooks[],rpNb],MessageDialog[\"the notebook of this panel is not open\"],
rpCells=Cells[rpNb,CellTags->\"RICHRunChapter\"];
If[rpCells==={},MessageDialog[\"no Title cell with the cell tag RICHRunChapter\"],
Do[SelectionMove[rpC,All,CellGroup];SelectionEvaluate[rpNb],{rpC,rpCells}]]]],
Method->\"Queued\"],
\"   \",
Button[\"Stop\",FrontEndExecute[FrontEndToken[\"EvaluatorAbort\"]],Evaluator->None],
\"      \",
Button[\"Export drawing\",
If[Length[DownValues[exportRunDrawings]]==0,MessageDialog[\"exportRunDrawings[] is not defined yet: Run first (it is defined in OPTICS ANALYSIS > RAY-TRACING > optics geometry printout/export)\"],exportRunDrawings[]],
Method->\"Queued\"],
\"   \",
Button[\"Export summary\",
If[Length[DownValues[exportRunSummary]]==0,MessageDialog[\"exportRunSummary[] is not defined yet: Run first (it is defined in OPTICAL SYSTEM DESIGN > SYSTEM DEFINITION > summary data export)\"],exportRunSummary[]],
Method->\"Queued\"]
}],
