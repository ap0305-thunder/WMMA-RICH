          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"resSpotSize", ",", 
            RowBox[{"SpotSize", "/.", "focus"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"debugOptimizationScanFlag", "==", "True"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"\"\<   FocalPoint       => \>\"", ",", 
               RowBox[{"FocalPoint", "/.", "focus"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<   WeightedSpotSize => \>\"", ",", 
               RowBox[{"WeightedSpotSize", "/.", "focus"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<   SpotSize         => \>\"", ",", 
               RowBox[{"SpotSize", "/.", "focus"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<   BackFocalLength  => \>\"", ",", 
               RowBox[{"BackFocalLength", "/.", "focus"}]}], "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
         RowBox[{"(*", "*)"}], "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"azimuthAngleTwist", ",", "0", ",", 
           RowBox[{"(", 
            RowBox[{"360", "-", "epsilonQuantum"}], ")"}], ",", 
           RowBox[{"(", 
            RowBox[{"360", "/", "numPhoInAzimuth"}], ")"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
      RowBox[{"(*", "*)"}], "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
