  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "rayDump", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rayDump", "[", "sys_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "dump", "}"}], ",", "\[IndentingNewLine]", 
