Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "trackPathLenth", " ", "as", " ", "difference", " ", 
    "between", " ", "2", " ", 
    RowBox[{"intersections", ":", " ", 
     RowBox[{
     "between", " ", "vectors", " ", "inters1", " ", "and", " ", 
      "inters2"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"trackPathLength", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{"inters2", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "-", 
        RowBox[{"inters1", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", 
        RowBox[{"Length", "[", "inters1", "]"}]}], "}"}]}], "]"}]}], 
   "*)"}]}]], "Input",
