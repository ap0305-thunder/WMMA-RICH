         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Histogram", "[", 
    RowBox[{"trackPathLength", ",", 
     RowBox[{"{", 
      RowBox[{"trackPathLengthMin", ",", "trackPathLengthMax", ",", "20"}], 
