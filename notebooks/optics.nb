Cell[CellGroupData[{

Cell["\<\

(*FIX 2026-11-08: RUN CONTROL PANEL (Title \"RUN CONTROL PANEL\" at the top \
of the notebook): when \"use panel values\" is ticked there, the values \
chosen in the panel replace the ones set in the cell above; unticked, the \
values of the cell above are used as before*)
With[{rpOpt=Quiet@CurrentValue[EvaluationNotebook[],{TaggingRules,\"\
RICHRunOptions\"}]},
If[(AssociationQ[rpOpt]||MatchQ[rpOpt,{___Rule}])&&TrueQ[Lookup[rpOpt,\"\
usePanel\",False]],
Unprotect[addTag,iRICH,numQuantiles,propagateSystemYes,resonate,theSensor,\
sourceType,turboTraceYes,whichOptics,opticsVersion];
With[{rpV=Lookup[rpOpt,\"iRICH\"]},If[IntegerQ[rpV],iRICH=rpV]];
With[{rpV=Lookup[rpOpt,\"whichOptics\"]},If[StringQ[rpV]&&StringLength[rpV]>0,\
whichOptics=rpV]];
With[{rpV=Lookup[rpOpt,\"opticsVersion\"]},If[StringQ[rpV]&&StringLength[rpV]>\
0,opticsVersion=rpV]];
With[{rpV=Lookup[rpOpt,\"sourceType\"]},If[StringQ[rpV]&&StringLength[rpV]>0,\
sourceType=rpV]];
With[{rpV=Lookup[rpOpt,\"theSensor\"]},If[StringQ[rpV]&&StringLength[rpV]>0,\
theSensor=rpV]];
With[{rpV=Lookup[rpOpt,\"resonate\"]},If[BooleanQ[rpV],resonate=rpV]];
With[{rpV=Lookup[rpOpt,\"propagateSystemYes\"]},If[BooleanQ[rpV],\
propagateSystemYes=rpV]];
With[{rpV=Lookup[rpOpt,\"turboTraceYes\"]},If[BooleanQ[rpV],turboTraceYes=rpV]\
];
With[{rpV=Lookup[rpOpt,\"debugPrintEnabledFlag\"]},If[BooleanQ[rpV],\
debugPrintEnabledFlag=rpV]];
With[{rpV=Lookup[rpOpt,\"numQuantiles\"]},If[NumericQ[rpV]&&rpV>0,\
numQuantiles=Round[rpV]]];
With[{rpV=Lookup[rpOpt,\"addTag\"]},If[StringQ[rpV],addTag=rpV]];
Protect[addTag,iRICH,numQuantiles,propagateSystemYes,resonate,theSensor,\
sourceType,turboTraceYes,whichOptics,opticsVersion];
runOptionsFrom=\"RUN CONTROL PANEL\",
runOptionsFrom=\"cell *** DEFINE RUN OPTIONS\"
]];
Print[\" run options from \",runOptionsFrom,\":   RICH\",iRICH,\"   \
\",whichOptics,\"   \",opticsVersion,\"   source = \",sourceType,\"   sensor \
= \",theSensor,\"   resonate = \",resonate,\"   propagate = \
\",propagateSystemYes,\"   turbo = \",turboTraceYes,\"   debug = \
\",debugPrintEnabledFlag,\"   numQuantiles = \",numQuantiles];
Print[\" tagString = \",tagString];\
\>", "Input",
 CellTags->{"RICHDefineRunOptions", "FIX-2026-11-08"},
 CellLabel->
  "11/12/26 16:04:42 \
In[42]:=",ExpressionUUID->"e1ad25da-27bd-ef45-b5e4-be41b1794ca3"],

