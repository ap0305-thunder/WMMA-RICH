          RowBox[{
          "in", " ", "case", " ", "you", " ", "call", " ", "it", " ", "too", " ",
            "early"}], "..."}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"iRICH", "\[NotEqual]", "1"}], ")"}], "&&", 
          RowBox[{"(", 
