Cell["non-split (==split1)", \
"Subsection",ExpressionUUID->"bb289842-8c3e-2d48-9171-aa6c052d52c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"whichOptics", "!=", "\"\<LHCb35Upg2Split\>\""}], ")"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", "analyzedSystem"}], ">", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"plotS", "=", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Blue", ",", 
               RowBox[{"Point", "[", 
                RowBox[{"ReadRays", "[", 
                 RowBox[{
