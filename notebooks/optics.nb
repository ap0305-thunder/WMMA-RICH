Notebook[{
Cell["\<\
RICH project notebook: optics. Role: interactive-top-level. Runtime source: \
src/optics.wl.\
\>", "Text",
 Background->RGBColor[1., 1., 0.6],
 CellTags->
  "RICHNotebookHeader",ExpressionUUID->"e4ecd6ac-3069-6a45-9dc6-aece603025e1"],

Cell[CellGroupData[{

Cell["---... SETUP", "Title",
 InitializationCell->False,
 Background->RGBColor[0.88, 1, 0.88],
 CellTags->
  "RICHNotebookSetup",ExpressionUUID->"48eb934d-7d30-4b43-b940-982a03ba8d96"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "notebook", ",", "notebookDirectory", ",", "projectCase", ",", "loader", ",",
      "loadResult"}], "}"}], ",", 
   RowBox[{
    RowBox[{"notebook", "=", 
     RowBox[{"EvaluationNotebook", "[", "]"}]}], ";", 
    RowBox[{"projectCase", "=", 
     RowBox[{"CurrentValue", "[", 
      RowBox[{"notebook", ",", 
       RowBox[{"{", 
        RowBox[{"TaggingRules", ",", "\"\<RICHProjectCase\>\""}], "}"}]}], 
      "]"}]}], ";", 
    RowBox[{"notebookDirectory", "=", 
     RowBox[{"Quiet", "[", 
      RowBox[{"Check", "[", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "notebook", "]"}], ",", "$Failed"}],
        "]"}], "]"}]}], ";", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"StringQ", "[", "notebookDirectory", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<RICH bootstrap failed: save the notebook inside the \
project's \>\"", 
         ",", "\"\<notebooks directory before evaluating initialization \
cells.\>\""}], "]"}], ";", 
       RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
    RowBox[{"loader", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ParentDirectory", "[", "notebookDirectory", "]"}], 
        ",", "\"\<src\>\"", ",", "\"\<LoadProject.wl\>\""}], "}"}], "]"}]}], ";", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"FileExistsQ", "[", "loader", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<RICH bootstrap failed: project loader not found at \>\"",
          ",", "loader"}], "]"}], ";", 
       RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
    RowBox[{"loadResult", "=", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"$RICHProjectSkipAutoLoad", "=", "True"}], "}"}], ",", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"Get", "[", "loader", "]"}], ",", "$Failed"}], "]"}]}], 
      "]"}]}], ";", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"loadResult", "===", "$Failed"}], ",", 
      RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
    RowBox[{"RICHNotebookBootstrap", "[", "projectCase", "]"}]}]}], 
  "]"}]], "Input",
 InitializationCell->True,
 CellTags->{"RICHUniversalBootstrap", "i:1"},
 CellLabel->
  "11/7/26 14:45:00 \
In[1]:=",ExpressionUUID->"82686b0d-4bb3-d045-96d7-c80ad7596217"],

