        RowBox[{"zLinePD", ",", "xLinePD", ",", "tiltLinePD"}], "}"}], "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"whichOptics", "==", "\"\<LHCb35Upg2Split\>\""}], ",", 
         RowBox[{"{", 
          RowBox[{"zScreenL", ",", "xScreenL", ",", "tiltScreenL"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"zScreen", ",", "xScreen", ",", "tiltScreen"}], "}"}]}], 
