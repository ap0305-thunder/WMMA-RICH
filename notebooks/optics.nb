Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "to2D", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"to2D", "[", "w_List", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Last", "@", 
       RowBox[{"Dimensions", "[", "w", "]"}]}], "==", "3"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Drop", "[", 
         RowBox[{"#", ",", 
          RowBox[{"-", "1"}]}], "]"}], "&"}], ",", "w"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\< Error - to2D \>\"", "]"}]}], 
