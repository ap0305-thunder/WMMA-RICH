          "<>", "\"\< GeV --- \!\(\*SubscriptBox[\(\[Theta]\), \(c\)]\) \
(mrad) \>\""}]}]}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
    RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"Histogram", "[", "\[IndentingNewLine]", 
