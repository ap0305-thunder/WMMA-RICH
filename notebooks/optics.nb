                    RowBox[{"{", "2", "}"}]}], "]"}], ")"}]}], "/", 
                    RowBox[{"Sqrt", "[", "12", "]"}]}], ")"}], "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}]}]}], 
