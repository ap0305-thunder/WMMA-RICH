Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"tworaysout", "=", 
    RowBox[{"CustomDeflections", "[", 
     RowBox[{"myOptics", ",", 
      RowBox[{"Function", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Ray", "[", 
          RowBox[{
           RowBox[{"WaveLength", "->", ".6"}], ",", 
           RowBox[{"Intensity", "->", 
