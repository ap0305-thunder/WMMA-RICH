      RowBox[{
       RowBox[{"ReadRays", "[", 
        RowBox[{"allTracedAnalyzedTracks", ",", 
         RowBox[{"{", 
          RowBox[{"RayStart", ",", "RayEnd"}], "}"}]}], "]"}], "\[IndentingNewLine]",
        "inters2"}], " ", "=", 
      RowBox[{"(*", 
       RowBox[{"[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "*)"}], 
      RowBox[{
       RowBox[{
        RowBox[{"b", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "allTracks", "]"}], "+", "1"}], ";;", 
           RowBox[{"2", "*", 
            RowBox[{"Length", "[", "allTracks", "]"}]}]}], "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1", ",", " ", "All"}], "]"}], "]"}], "\[IndentingNewLine]", 
       RowBox[{"Dimensions", "[", "inters2", "]"}]}]}]}]}]}], "*)"}]], "Input",
