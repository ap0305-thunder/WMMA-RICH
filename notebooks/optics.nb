          "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Show", "[", "plotCircle", "]"}]}], "\[IndentingNewLine]", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
