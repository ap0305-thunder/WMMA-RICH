   RowBox[{
    RowBox[{"numPhoAlongTrack", "=", "11"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numPhoInAzimuth", "=", "1"}], ";"}], 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"must", " ", "be", " ", "1"}], ",", " ", 
     RowBox[{"here", " ", "only", " ", "one", " ", 
      RowBox[{"azimuth", "!"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"azimuthAngleTwist", "=", "0"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1.5", 
         RowBox[{"\[Pi]", "/", "2"}]}], ")"}], "/", "Degree"}], "//", "N"}], 
     ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaX", "=", "0.075"}], ";"}], 
   RowBox[{"(*", "test", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaY", "=", "0.075"}], ";"}], 
   RowBox[{"(*", "test", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mySourceFindFocus", "=", 
     RowBox[{"{", 
      RowBox[{"CherenkovPhotonsXYTrack", "[", 
       RowBox[{
        RowBox[{"thetaMax", "/", "Degree"}], ",", "numPhoAlongTrack", ",", 
        "numPhoInAzimuth", ",", "thetaX", ",", "thetaY", ",", "0", ",", "1", ",",
         "azimuthAngleTwist"}], "]"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Remove", " ", "the", " ", "Quartz", " ", "as", " ", "it", " ", "block", " ",
