            "\[IndentingNewLine]", 
            RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"effectivePSFAngleH", "=", 
             RowBox[{"1000", "*", 
              RowBox[{"sigma2DH", "/", "focalLengthEffectiveH"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"maxEffectivePSFAngleH", "=", 
             RowBox[{"1000", "*", 
              RowBox[{"maxSigma2DH", "/", "focalLengthEffectiveH"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"meanEffectivePSFAngleH", "=", 
