Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"myOptics2", " ", "=", " ", 
    RowBox[{"Resonate", "[", "myOptics", "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"opticalSystemLHCbRICHAllTracks", "=", 
    RowBox[{"{", 
     RowBox[{"allTracks", ",", "myOptics2", ",", "myBoundary"}], "}"}]}], ";",
    "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
