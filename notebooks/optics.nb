12a12b148057"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"TEST", ":", " ", 
     RowBox[{"1", " ", "fixed", " ", "track"}]}], ",", " ", 
    RowBox[{"1", " ", "fixed", " ", "azimuth"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
    "bigBanner", 
     "[", "\"\<ONE SINGLE TRACK AND ITS CHERENKOV PHOTONS AT FIXED \
AZIMUTH\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numPhoAlongTrack", "=", "11"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numPhoInAzimuth", "=", "1"}], ";"}], 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"must", " ", "be", " ", "1"}], ",", " ", 
     RowBox[{"here", " ", "only", " ", "one", " ", 
      RowBox[{"azimuth", "!"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"azimuthAngleTwist", "=", "0"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1.5", 
         RowBox[{"\[Pi]", "/", "2"}]}], ")"}], "/", "Degree"}], "//", "N"}], 
     ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaX", "=", "0.075"}], ";"}], 
   RowBox[{"(*", "test", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaY", "=", "0.075"}], ";"}], 
   RowBox[{"(*", "test", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mySourceFindFocus", "=", 
     RowBox[{"{", 
      RowBox[{"CherenkovPhotonsXYTrack", "[", 
       RowBox[{
        RowBox[{"thetaMax", "/", "Degree"}], ",", "numPhoAlongTrack", ",", 
        "numPhoInAzimuth", ",", "thetaX", ",", "thetaY", ",", "0", ",", "1", ",",
         "azimuthAngleTwist"}], "]"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Remove", " ", "the", " ", "Quartz", " ", "as", " ", "it", " ", "block", " ",
      "the", " ", 
     RowBox[{
      RowBox[{"rays", " ", "!"}], "@", "#$"}], "%"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"opticalSystemLHCbRICHFindFocus", "=", 
     RowBox[{"Quiet", "[", 
      RowBox[{"{", 
       RowBox[{"mySourceFindFocus", ",", "myOptics"}], "}"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"traced", "=", 
     RowBox[{"TurboPlot", "[", 
      RowBox[{"opticalSystemLHCbRICHFindFocus", ",", 
       RowBox[{"SequentialTrace", "\[Rule]", "False"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"traced", "=", 
      RowBox[{"TurboTrace", "[", 
       RowBox[{"opticalSystemLHCbRICHFindFocus", ",", 
        RowBox[{"SequentialTrace", "\[Rule]", "False"}]}], "]"}]}], ";"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"focus", "=", 
     RowBox[{"FindFocus", "[", 
      RowBox[{"traced", ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Show", "->", "True"}], ","}], "*)"}], 
       RowBox[{"Show", "->", "False"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "focus", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<   FocalPoint 3D coordinates       => \>\"", ",", 
      RowBox[{"FocalPoint", "/.", "focus"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<   WeightedSpotSize => \>\"", ",", 
      RowBox[{"WeightedSpotSize", "/.", "focus"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<   SpotSize         => \>\"", ",", 
      RowBox[{"SpotSize", "/.", "focus"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<   BackFocalLength  => \>\"", ",", 
      RowBox[{"BackFocalLength", "/.", "focus"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"It", " ", 
     RowBox[{"works", "!"}], " ", "long", " ", "ouput"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FindIntensity", "[", 
     RowBox[{"traced", ",", 
      RowBox[{"ImageSize", "->", "Full"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
