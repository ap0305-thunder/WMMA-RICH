Cell["\<\

(*FIX 2026-11-08: ONE text file with all the summary parameters of the run: \
run options, optics definition file, geometry, radiator/Cherenkov/sensor \
data, source settings and results. Written at the end of OPTICS ANALYSIS \
(SINGLE HIGH-MOMENTUM TRACK PERFORMANCE > END) and by the button \"Export \
summary\" of the RUN CONTROL PANEL. File: \
$dirOut/run-summary--<tagString>--yyyy-mm-dd--HHMMSS.txt (time stamp of the \
run)*)
ClearAll[runSummaryValue,runSummaryLine,runSummaryBlock,runSummaryNumber,\
runSummaryStats,runSummaryText,exportRunSummary];
(*value of a variable at full precision; tilts (Optica rotation angles, rad) \
also in degrees*)
runSummaryValue[name_String]:=If[ToExpression[name,InputForm,ValueQ],
With[{v=ToExpression[name]},
If[StringStartsQ[name,\"tilt\"]&&!StringContainsQ[name,\"Degree\"]&&NumericQ[\
v],
ToString[N[v],InputForm]<>\"   (rad;  = \"<>ToString[N[v/Degree],InputForm]<>\
\" deg)\",
With[{s=ToString[v,InputForm]},If[StringLength[s]>4000,StringTake[s,4000]<>\" \
... (truncated)\",s]]]],
\"(not defined)\"];
runSummaryLine[name_String]:=StringPadRight[name,44]<>\" \
\"<>runSummaryValue[name];
runSummaryLine[label_String,value_]:=StringPadRight[label,44]<>\" \
\"<>If[StringQ[value],value,ToString[value,InputForm]];
(*FIX 2026-11-12: paths shown relative to the project folder*)
runSummaryRel[p_String]:=Module[{root=If[StringQ[$RICHProjectRoot],$RICHProjectRoot,\
Quiet@ParentDirectory[NotebookDirectory[]]],q=ExpandFileName[p],r},
If[!StringQ[root],Return[q]];r=ExpandFileName[root];
Which[q===r,\"<project>\",\
StringStartsQ[q,r<>$PathnameSeparator,IgnoreCase->True],\"<project>\"<>StringDrop[q,\
StringLength[r]],
True,q]];
runSummaryRel[p_]:=ToString[p];
runSummaryBlock[title_String,lines_List]:=Join[{\"\",\"==== \"<>title<>\" \
\"<>StringRepeat[\"=\",Max[3,72-StringLength[title]]]},lines];
runSummaryNumber[x_]:=ToString[NumberForm[N[x],6]];
(*statistics of a list of values; -1 marks a missing value (azzera)*)
runSummaryStats[label_String,vals_]:=Module[{v=Select[Flatten[{vals}],\
NumericQ[#]&&#!=-1&]},
StringPadRight[label,44]<>\" \"<>If[Length[v]==0,\"no values\",
\"N = \"<>ToString[Length[v]]<>\"   mean = \"<>runSummaryNumber[Mean[v]]<>\"  \
 median = \"<>runSummaryNumber[Median[v]]<>
If[Length[v]>1,\"   sd = \"<>runSummaryNumber[StandardDeviation[v]],\"\"]<>\" \
  min = \"<>runSummaryNumber[Min[v]]<>\"   max = \
\"<>runSummaryNumber[Max[v]]]];
runSummaryText[]:=Module[{split=(whichOptics==\"LHCb35Upg2Split\"),runOpt,\
file,srcDir,path,names,vals,src,hdr,rows,cols,thisRun,lines},
runOpt={\"iRICH\",\"whichOptics\",\"opticsVersion\",\"sourceType\",\"\
theSensor\",\"resonate\",\"propagateSystemYes\",\"turboTraceYes\",\"\
simulateCherenkovLightYield\",\"numQuantiles\",\"addTag\",\"\
debugPrintEnabledFlag\"};
(*header*)
lines={\"RICH OPTICS RUN SUMMARY\",
runSummaryLine[\"notebook\",\"optics.nb\"],
runSummaryLine[\"written\",DateString[{\"Year\",\"-\",\"Month\",\"-\",\"Day\",\
\"  \",\"Hour\",\":\",\"Minute\",\":\",\"Second\"}]],
runSummaryLine[\"tagString\",tagString],
runSummaryLine[\"run time stamp (thisTimeStamp)\",ToString[thisTimeStamp]],
runSummaryLine[\"run options \
from\",If[StringQ[runOptionsFrom],runOptionsFrom,\"cell *** DEFINE RUN \
OPTIONS\"]],
runSummaryLine[\"output folder\",runSummaryRel[$dirOut]],
runSummaryLine[\"Wolfram Language\",$Version]};
(*run options*)
lines=Join[lines,runSummaryBlock[\"RUN OPTIONS\",runSummaryLine/@runOpt]];
(*optics definition file*)
file=If[AssociationQ[lastOpticsDefinition],lastOpticsDefinition[\"file\"],\
None];
srcDir=Quiet@Check[RICHProjectPath[\"src\"],$Failed];
If[!StringQ[srcDir],srcDir=Quiet@Check[FileNameJoin[{ParentDirectory[\
NotebookDirectory[]],\"src\"}],\"?\"]];
path=If[StringQ[file],FileNameJoin[{srcDir,file}],None];
lines=Join[lines,runSummaryBlock[\"OPTICS DEFINITION\",Join[{
runSummaryLine[\"optics definition file\",If[StringQ[file],file,\"(none \
loaded)\"]],
runSummaryLine[\"path\",If[StringQ[path],runSummaryRel[path],\"-\"]],
runSummaryLine[\"file last \
modified\",If[StringQ[path]&&FileExistsQ[path],DateString[FileDate[path],{\"\
Year\",\"-\",\"Month\",\"-\",\"Day\",\"  \
\",\"Hour\",\":\",\"Minute\",\":\",\"Second\"}],\"-\"]],
runSummaryLine[\"useQuartzPlate\"],
runSummaryLine[\"number of entries of \
myOptics\",If[ListQ[myOptics],Length[myOptics],\"-\"]]},
runSummaryLine/@{\"priMirrorNumber\",\"secMirrorNumber\",\"terMirrorNumber\",\
\"quartzPlateNumber\",\"focalSurfaceNumber\",\"boxNumber\"}]]];
(*geometry*)
lines=Join[lines,runSummaryBlock[\"GEOMETRY (full precision; tilts = Optica \
rotation angles; (not defined) = not used by this optics)\",
Join[If[ListQ[opticalSystemDefVars],runSummaryLine/@Select[\
opticalSystemDefVars,StringQ[#]&&!MemberQ[Join[runOpt,{\"tagString\",\"\
placeHolderFromGenToSplit\"}],#]&],{\"(opticalSystemDefVars not defined: \
evaluate OPTICAL SYSTEM DESIGN > SYSTEM DEFINITION > INIT > full dataset)\"}],
{\"   -- additional --\"},
runSummaryLine/@If[split,{\"tiltScreenL\",\"tiltScreenH\",\"PDADepth\"},
{\"tiltScreen\",\"PDADepth\",\"distanceQuartzPlateFromPD\",\"quartzPlateThick\
\",\"tiltScreenAddToQuartzPlateDegrees\",\"zQuartzPlateDist\",\"\
xQuartzPlateDist\"}]]]];
(*radiator, Cherenkov and sensor: same numbers as rich-detector-data-*.txt*)
names=First[Select[Quiet[ToExpression/@Names[\"*`detectorResultsNames\"]],\
ListQ],$Failed];
vals=If[ValueQ[resultsCalcRICHYield],resultsCalcRICHYield,$Failed];
lines=Join[lines,runSummaryBlock[\"RADIATOR, CHERENKOV, SENSOR \
(calcRICHYield)\",
If[ListQ[names]&&ListQ[vals]&&Length[names]==Length[vals],
MapThread[StringPadRight[ToString[#1],56]<>\" \"<>ToString[#2]&,{names,vals}],
{\"(not available: simulateCherenkovLightYield = False or calcRICHYield not \
evaluated)\"}]]];
(*source*)
src=Switch[sourceType,
\"gun\",{\"minAcc\",\"numStepsThrdDim\",\"minThrdDim\",\"maxThrdDim\",\"\
numStepsTrnsvrs\",\"minTrnsvrs\",\"maxTrnsvrs\",\"numPhoAlongTrack\",\"\
numPhoInAzimuth\",\"azimuthAngleTwist\",\"minWavLenSim\",\"medWavLenSim\",\"\
maxWavLenSim\",\"minThetaCSim\",\"medThetaCSim\",\"maxThetaCSim\",\"theThetas\
\"},
\"chr\",{\"numPhoAlongTrack\",\"numPhoInAzimuth\",\"numRandomPhotons\",\"\
numRandRings\",\"twistDegree\",\"dThetaT\",\"dTheta3\",\"minDThetaT\",\"\
numStepT\",\"numStep3\",\"plRangeTrackAngles\",\"partMass\",\"partMomentum\"},
\"line\",{\"distanceLineFromPD\",\"lenghtOfLine\",\"directionAnglesLineLight\"\
,\"zLinePD\",\"xLinePD\",\"tiltLinePD\"},
_,{}];
lines=Join[lines,runSummaryBlock[\"SOURCE \
(\"<>ToString[sourceType]<>\")\",Join[
Switch[sourceType,
\"gun\",{runSummaryLine[\"number of tracks \
(Length[theThetas])\",If[ListQ[theThetas],Length[theThetas],\"-\"]]},
\"grd\",{\"ConeOfRays[{0.05/Degree,35},NumberOfRays->100], rotated by 0.1 and \
moved to {0,0} with angle 8 (LIGHT > RECTANGULAR GRID)\"},
\"line\",{\"LineOfRays[lenghtOfLine,NumberOfRays->11,MonteCarlo->True], one \
line per angle in directionAnglesLineLight, at distanceLineFromPD in front of \
the photodetector plane\"},
_,{}],
runSummaryLine/@src,
{runSummaryLine[\"number of entries of \
mySource\",If[ListQ[mySource],Length[mySource],\"-\"]]},
runSummaryLine/@{\"listOfWavLenSim\",\"listOfThetaCSim\"}]]];
(*results: only those of this run (allResultsRunStamp is set right after \
doEvalOpticsPerformance)*)
thisRun=ValueQ[allResultsRunStamp]&&allResultsRunStamp===thisTimeStamp&&ListQ[\
allResults]&&Length[allResults]>1;
lines=Join[lines,runSummaryBlock[\"RESULTS\",If[!thisRun,
{\"single-track performance not evaluated in this run (OPTICS ANALYSIS > \
SINGLE HIGH-MOMENTUM TRACK PERFORMANCE)\"},
hdr=ToString/@First[allResults];rows=Select[Rest[allResults],ListQ[#]&&Length[\
#]==Length[hdr]&];
cols=Select[Range[Length[hdr]],AllTrue[rows[[All,#]],NumericQ]&];
Join[{runSummaryLine[\"number of tracks\",Length[rows]],\"\"},
{If[ValueQ[focusingErrorAngleRingAll],runSummaryStats[\"focusing error \
(mrad), all tracks\",focusingErrorAngleRingAll[[All,3]]],\"focusing error: \
-\"],
If[ValueQ[focusingErrorAngleRingMeanCentral],runSummaryStats[\"focusing error \
(mrad), central region\",focusingErrorAngleRingMeanCentral[[All,3]]],Nothing],
If[ValueQ[focusingErrorAngleRingMeanCentralL],runSummaryStats[\"focusing \
error (mrad), L angles \
only\",focusingErrorAngleRingMeanCentralL[[All,3]]],Nothing],
If[ValueQ[focusingErrorAngleRingMeanCentralH],runSummaryStats[\"focusing \
error (mrad), H angles \
only\",focusingErrorAngleRingMeanCentralH[[All,3]]],Nothing],
If[ValueQ[focusingErrorAngleRingAll],runSummaryStats[\"effective local focal \
length (mm)\",focusingErrorAngleRingAll[[All,4]]],Nothing],
If[ValueQ[pixelErrorAngleRingMeanL],runSummaryStats[\"pixel error (mrad), \
L\",Quiet[1000/Sqrt[12]/pixelErrorAngleRingMeanL[[All,3]]]],Nothing],
If[ValueQ[pixelErrorAngleRingMeanH],runSummaryStats[\"pixel error (mrad), \
H\",Quiet[1000/Sqrt[12]/pixelErrorAngleRingMeanH[[All,3]]]],Nothing],
If[ValueQ[allSemimajorAxisLength],runSummaryStats[\"ellipse fit: semi-major \
axis\",allSemimajorAxisLength],Nothing],
If[ValueQ[allEccentricity],runSummaryStats[\"ellipse fit: \
eccentricity\",allEccentricity],Nothing],
If[ValueQ[allRotationAngleMrad],runSummaryStats[\"ellipse fit: rotation angle \
(mrad)\",allRotationAngleMrad],Nothing]},
{\"\",\"per-track results (numeric columns of doEvalOpticsPerformance; -1 or \
missing = not available):\",StringRiffle[hdr[[cols]],\"\\t\"]},
StringRiffle[If[IntegerQ[#],ToString[#],ToString[N[#],InputForm]]&/@#,\"\\t\"]\
&/@rows[[All,cols]]]]]];
lines];
exportRunSummary[]:=Module[{file=FileNameJoin[{$dirOut,\"run-summary--\"<>\
tagString<>If[StringQ[thisTimeStamp],thisTimeStamp,timeStamp]<>\".txt\"}]},
Export[file,StringRiffle[runSummaryText[],\"\\n\"],\"Text\"];
Print[\" run summary written to \",file];
file];\
\>", "Input",
 CellTags->{"RICHRunSummary", "FIX-2026-11-08"},
 CellLabel->
  "11/12/26 16:06:59 \
In[203]:=",ExpressionUUID->"e00bcd1d-a9f7-734a-b0fb-88fac170a5d6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["RayTracing DEBUG", \
"Subsubtitle",ExpressionUUID->"073d882b-db90-6340-bf21-677cae58d071"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Print", "@", 
     RowBox[{"Column", "@", 
      RowBox[{"Sort", "@", 
       RowBox[{"Options", "[", "Ray", "]"}]}]}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "rayDump", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rayDump", "[", "sys_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "dump", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"dump", "=", 
         RowBox[{"ReadRays", "[", 
          RowBox[{"sys", ",", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
            "SourceID", ",", "RaySourceNumber", ",", "ComponentNumber", ",", 
             "ComponentNumberPrevious", ",", "SurfaceNumber", ",", 
             "SurfaceNumberPrevious", ",", "ComponentIncrement", ",", 
             "\[IndentingNewLine]", "SurfaceIncrement", ",", 
             "RayStartPrevious", ",", "RayEndPrevious", ",", "RayStart", ",", 
             "RayEnd", ",", "RayLengthPrevious", ",", "RayLength", ",", 
             "\[IndentingNewLine]", "OpticalLengthPrevious", ",", 
             "OpticalLength", ",", "IntersectionNumber", ",", 
             "GenerationNumber", ",", "SurfaceCoordinates"}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "@", 
         RowBox[{"Print", "@", 
          RowBox[{"TableForm", "[", 
           RowBox[{
            RowBox[{"nf1", "[", 
             RowBox[{"(*", 
              RowBox[{"Transpose", "@"}], "*)"}], "dump", "]"}], ",", 
            RowBox[{"TableAlignments", "->", "Right"}], ",", 
            RowBox[{"TableHeadings", "->", 
             RowBox[{"{", 
              RowBox[{"None", ",", 
               RowBox[{"{", "\[IndentingNewLine]", 
                
                RowBox[{"\"\<SourceID\>\"", ",", "\"\<RaySourceNumber\>\"", 
                 ",", "\"\<ComponentNumber\>\"", 
                 ",", "\"\<ComponentNumberPrevious\>\"", 
                 ",", "\"\<SurfaceNumber\>\"", 
                 ",", "\"\<SurfaceNumberPrevious\>\"", 
                 ",", "\"\<ComponentIncrement\>\"", ",", 
                 "\[IndentingNewLine]", "\"\<SurfaceIncrement\>\"", 
                 ",", "\"\<RayStartPrevious\>\"", 
                 ",", "\"\<RayEndPrevious\>\"", ",", "\"\<RayStart\>\"", 
                 ",", "\"\<RayEnd\>\"", ",", "\"\<RayLengthPrevious\>\"", 
                 ",", "\"\<RayLength\>\"", ",", 
                 "\[IndentingNewLine]", "\"\<OpticalLengthPrevious\>\"", 
                 ",", "\"\<OpticalLength\>\"", 
                 ",", "\"\<IntersectionNumber\>\"", 
                 ",", "\"\<GenerationNumber\>\"", 
                 ",", "\"\<SurfaceCoordinates\>\""}], "}"}]}], 
              "\[IndentingNewLine]", "}"}]}]}], "]"}]}]}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 Evaluatable->True,
 Background->ThemeColor[{0.971 -> "Foreground", 0.029 -> "Background"}],
