             RowBox[{"(", 
              RowBox[{"1000", "*", "maxAccR2Hor"}], ")"}]}], "+", "q", "-", 
            "lenTrnsvrs"}], "==", "0"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"p", ",", "q"}], "}"}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"printD", "@", "sol2"}], ";", "\[IndentingNewLine]", 
    RowBox[{"printD", "@", 
     RowBox[{"Mean", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", "/.", "sol1"}], ")"}], ",", 
        RowBox[{"(", 
         RowBox[{"p", "/.", "sol2"}], ")"}]}], "}"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"printD", "@", 
     RowBox[{"Mean", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"q", "/.", "sol1"}], ")"}], ",", 
        RowBox[{"(", 
         RowBox[{"q", "/.", "sol2"}], ")"}]}], "}"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
