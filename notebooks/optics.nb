Cell[BoxData[{
 RowBox[{
  RowBox[{"lenTrnsvrs", "=", "678.7"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lenThrdDim", "=", 
   RowBox[{"1328.4", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"printD", "@", "maxAccR2Hor"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"printD", "@", "maxAccR2Ver"}], ";"}], "\n", 
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "p", ",", "q", ",", "xx", ",", "x", ",", "yy", ",", "fff1", ",", "sol1", ",",
      "sol2", ",", "focLenScaleFactor"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eq", "=", 
     RowBox[{
      RowBox[{"p", "*", "xx"}], "+", "q", "-", "yy"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"sol1", "=", 
     RowBox[{"First", "@", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"p", "*", "0"}], "+", "q", "-", "rad1"}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"p", "*", 
             RowBox[{"(", 
              RowBox[{"1000", "*", "maxAccR2Ver"}], ")"}]}], "+", "q", "-", 
            "lenThrdDim"}], "==", "0"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"p", ",", "q"}], "}"}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"printD", "@", "sol1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"sol2", "=", 
