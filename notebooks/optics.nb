Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"fff", ",", "a", ",", "b"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fff", "[", 
    RowBox[{"x_", ",", "a_", ",", "b_"}], "]"}], "=", 
   RowBox[{"a", "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"x", "/", "b"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"fff", "[", 
        RowBox[{"0", ",", "a", ",", "b"}], "]"}], "==", "p1"}], "&&", 
      RowBox[{
       RowBox[{"fff", "[", 
        RowBox[{"10", ",", "a", ",", "b"}], "]"}], "\[Equal]", "p2"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "b"}], "}"}]}], "]"}], "/.", 
   RowBox[{
    TemplateBox[{"1"},
     "C"], "\[Rule]", "0"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"a", "/.", 
    RowBox[{"sol", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"b", "/.", 
    RowBox[{"sol", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"pp", ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"fff", "[", 
     RowBox[{"p", ",", "a", ",", "b"}], "]"}], "/.", 
    RowBox[{"p1", "\[Rule]", "1"}]}], "/.", 
   RowBox[{"p2", "\[Rule]", "100"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "@", "pp"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numPhoGoal", "=", "35"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxHistoHig", "=", 
   RowBox[{"1.001", "*", 
    RowBox[{"theRefrIndex", "[", "\[Lambda]Min", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxHistoHig", "=", "1.0015"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numFact", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"num", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]CutL", "=", "300"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"photonEnergies", "=", 
   RowBox[{"generatePhotonEnergy", "[", "num", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Histogram", "[", 
    RowBox[{"photonEnergies", ",", 
     RowBox[{"PlotLabel", "\[Rule]", "\"\< generated energy \>\""}]}], "]"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Histogram", "[", 
    RowBox[{
     RowBox[{"\[Lambda]", "[", "photonEnergies", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0.9", "*", "\[Lambda]Min"}], ",", 
       RowBox[{"1.1", "*", "\[Lambda]Max"}], ",", "10"}], "}"}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", "\"\< generated waveln \>\""}]}], "]"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"wavelnList", "=", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"\[Lambda]", "[", "photonEnergies", "]"}], ",", 
      RowBox[{
       RowBox[{"#", "\[GreaterEqual]", "\[Lambda]CutL"}], "&"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{
  "(*", "******************************************************************************************)"}\
], 
  RowBox[{
  "(*", "******************************************************************************************)"}\
], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"TO", " ", "BE", " ", "IMPROVED"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"IT", " ", "IS", " ", "CHROMATIC", " ", "ONLY"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"THE", " ", "SPECTRUM", " ", "ALSO", " ", "DEPENDS", " ", "ON", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"VELOCITY", " ", "!!"}], "!!"}], "!!"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
  "(*", "******************************************************************************************)"}\
], 
  RowBox[{
  "(*", "******************************************************************************************)"}\
]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"bigBanner", "[", "\"\<-\>\"", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Histogram", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Evaluate", "[", "\[IndentingNewLine]", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"tpl", "[", 
            RowBox[{
             RowBox[{"thePartMasses", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "\[IndentingNewLine]", 
             "        ", "pp", ",", "\[IndentingNewLine]", "        ", 
             RowBox[{"wavelnList", "[", 
              RowBox[{"[", 
               RowBox[{"RandomInteger", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"1", ",", 
                   RowBox[{"Length", "@", "wavelnList"}]}], "}"}], ",", 
                 RowBox[{"Round", "[", 
