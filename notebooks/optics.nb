Cell[BoxData[
 ButtonBox["\<\"Export optics geometry\"\>",
  Appearance->Automatic,
  ButtonFunction:>
   Module[{$CellContext`outDir, $CellContext`baseName}, $CellContext`outDir = \
$CellContext`$dirOut; If[
      Not[
       DirectoryQ[$CellContext`outDir]], 
      CreateDirectory[$CellContext`outDir, CreateIntermediateDirectories -> 
       True]]; $CellContext`baseName = 
     FileNameJoin[{$CellContext`outDir, "optics-geometry-all-" <> 
        ToString[$CellContext`tagString]}]; \
$CellContext`exportOpticsGeometry[$CellContext`baseName]],
  Evaluator->Automatic,
  ImageSize->220,
  Method->"Queued"]], "Output",
 CellLabel->
  "11/7/26 14:49:07 \
Out[336]=",ExpressionUUID->"cb16234b-2f70-3645-be70-cce919892876"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "exportSelectedGeneratedCellPDF", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exportSelectedGeneratedCellPDF", "[", "file_String", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nb", ",", "cells", ",", "cell", ",", "expr", ",", "tmp", ",", 
      "result"}], "}"}], ",", 
    RowBox[{
     RowBox[{"nb", "=", 
      RowBox[{"InputNotebook", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cells", "=", 
      RowBox[{"SelectedCells", "[", "nb", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "cells", "]"}], "=!=", "1"}], ",", 
       RowBox[{
        RowBox[{
        "MessageDialog", "[", "\"\<Select exactly one cell first.\>\"", "]"}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cell", "=", 
      RowBox[{"First", "[", "cells", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"expr", "=", 
      RowBox[{"NotebookRead", "[", "cell", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmp", "=", 
      RowBox[{"CreateDocument", "[", 
       RowBox[{
        RowBox[{"{", "expr", "}"}], ",", 
        RowBox[{"Visible", "->", "False"}], ",", 
        RowBox[{"WindowSelected", "->", "False"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"result", "=", 
      RowBox[{"Export", "[", 
       RowBox[{"file", ",", "tmp", ",", "\"\<PDF\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"NotebookClose", "[", "tmp", "]"}], ";", "\[IndentingNewLine]", 
     "result"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{
  3.945862080410919*^9, 3.9468070237038136`*^9, {3.9885946859222813`*^9, 
