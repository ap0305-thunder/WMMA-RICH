Cell[BoxData[{
 RowBox[{
  RowBox[{"lenTrnsvrs", "=", "572.9"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lenThrdDim", "=", 
   RowBox[{"1340.3", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"printD", "@", "maxAccR1Hor"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"printD", "@", "maxAccR1Ver"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "p", ",", "q", ",", "xx", ",", "x", ",", "yy", ",", "fff1", ",", "sol1", ",",
      "sol2", ",", "focLenScaleFactor"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eq", "=", 
     RowBox[{
      RowBox[{"p", "*", "xx"}], "+", "q", "-", "yy"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"sol1", "=", 
     RowBox[{"First", "@", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"p", "*", "0"}], "+", "q", "-", "rad1"}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"p", "*", 
             RowBox[{"(", 
              RowBox[{"1000", "*", "maxAccR1Hor"}], ")"}]}], "+", "q", "-", 
            "lenThrdDim"}], "==", "0"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"p", ",", "q"}], "}"}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"printD", "@", "sol1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"sol2", "=", 
     RowBox[{"First", "@", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"p", "*", "0"}], "+", "q", "-", "rad1"}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"p", "*", 
             RowBox[{"(", 
              RowBox[{"1000", "*", "maxAccR1Ver"}], ")"}]}], "+", "q", "-", 
            "lenTrnsvrs"}], "==", "0"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"p", ",", "q"}], "}"}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"printD", "@", "sol2"}], ";", "\[IndentingNewLine]", 
    RowBox[{"printD", "@", 
     RowBox[{"Mean", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", "/.", "sol1"}], ")"}], ",", 
        RowBox[{"(", 
         RowBox[{"p", "/.", "sol2"}], ")"}]}], "}"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"printD", "@", 
     RowBox[{"Mean", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"q", "/.", "sol1"}], ")"}], ",", 
        RowBox[{"(", 
         RowBox[{"q", "/.", "sol2"}], ")"}]}], "}"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fff1", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{"{", 
