         RowBox[{"Clear", "/", "ClearAll"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"ClearAll", "[", "resultsCalcRICHYield", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Keep", " ", "it", " ", "here", " ", 
          RowBox[{"and", "/", "or"}], " ", "make", " ", "sure", " ", "that", " ",
           "the", " ", "parameters", " ", "have", " ", "been", " ", 
          "defined"}], ",", " ", 
