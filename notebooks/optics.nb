Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Then", " ", "export", " ", "the", " ", "full", " ", 
    RowBox[{"report", "."}]}], "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"exportOpticsGeometry", "[", 
    RowBox[{"\"\<optics-geometry-all_\>\"", "<>", "tagString"}], "]"}], 
   "*)"}], "\n", "\n", 
  RowBox[{"Button", "[", "\n", "  ", 
   RowBox[{"\"\<Export optics geometry\>\"", "\n", "  ", ",", "\n", "  ", 
    RowBox[{"Module", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"outDir", ",", " ", "baseName"}], "}"}], "\n", "    ", ",", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"outDir", " ", "=", " ", "$dirOut"}], ";", "\n", "    ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"DirectoryQ", "[", "outDir", "]"}]}], ",", "\n", "      ", 
         RowBox[{"CreateDirectory", "[", 
          RowBox[{"outDir", ",", " ", 
           RowBox[{
           "CreateIntermediateDirectories", " ", "->", " ", "True"}]}], 
          "]"}]}], "\n", "    ", "]"}], ";", "\n", "    ", 
       RowBox[{"baseName", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"outDir", ",", " ", 
           RowBox[{"\"\<optics-geometry-all-\>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", "\n", "      ", "tagString", "]"}]}]}], 
          "}"}], "]"}]}], ";", "\n", "    ", 
       RowBox[{"exportOpticsGeometry", "[", "baseName", "]"}]}]}], "\n", "  ",
      "]"}], "\n", "  ", ",", "\n", "  ", 
    RowBox[{"Method", " ", "->", " ", "\"\<Queued\>\""}], "\n", "  ", ",", 
    "\n", "  ", 
    RowBox[{"ImageSize", " ", "->", " ", "220"}]}], "\n", "]"}]}]], "Input",
 Background->ThemeColor[{0.971 -> "Foreground", 0.029 -> "Background"}],
