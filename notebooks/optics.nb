Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "==="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Simplified", " ", 
    RowBox[{"chromatic", ":", " ", 
     RowBox[{
      RowBox[{"just", " ", "use", " ", "high"}], "-", 
      RowBox[{"p", " ", "tracks"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "==="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "@", "evalChromaticError"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"evalChromaticError", "[", 
      RowBox[{"num_", ",", "\[Lambda]CutL_", ",", 
       RowBox[{"refNum_", ":", "1"}], ",", 
       RowBox[{"sigmaOthersAll_", ":", "0"}], ",", 
       RowBox[{"\[Lambda]CutH_", ":", "\[Lambda]Max"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "sigma", ",", "sigmaAll", ",", "numSel", ",", "benchmark", ",", 
         "benchmarkAll", ",", "wavelnList", ",", "photonEnergies"}], "}"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"photonEnergies", "=", 
         RowBox[{"generatePhotonEnergy", "[", "num", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"Histogram", "[", 
          RowBox[{"photonEnergies", ",", 
           RowBox[{"PlotLabel", "\[Rule]", "\"\< generated energy \>\""}]}], 
          "]"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"Histogram", "[", 
          RowBox[{
           RowBox[{"\[Lambda]", "[", "photonEnergies", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"0.9", "*", "\[Lambda]Min"}], ",", 
             RowBox[{"1.1", "*", "\[Lambda]Max"}], ",", "10"}], "}"}], ",", 
           RowBox[{"PlotLabel", "\[Rule]", "\"\< generated waveln \>\""}]}], 
          "]"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"wavelnList", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"\[Lambda]", "[", "photonEnergies", "]"}], ",", 
           RowBox[{
            RowBox[{"#", "\[GreaterEqual]", "\[Lambda]CutL"}], "&"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sigma", "=", 
         RowBox[{"StandardDeviation", "[", 
          RowBox[{"1000", "*", 
           RowBox[{"ArcCos", "[", 
            RowBox[{"1", "/", 
             RowBox[{"theRefrIndex", "[", "wavelnList", "]"}]}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sigmaAll", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           SuperscriptBox["sigma", "2"], "+", 
           SuperscriptBox["sigmaOthersAll", "2"]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"numSel", "=", 
         RowBox[{"Length", "@", "wavelnList"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"benchmark", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"sigma", "/", 
            RowBox[{"Sqrt", "[", "numSel", "]"}]}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sqrt", "[", "num", "]"}], "/", 
            RowBox[{"Sqrt", "[", "refNum", "]"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"benchmarkAll", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"sigmaAll", "/", 
            RowBox[{"Sqrt", "[", "numSel", "]"}]}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sqrt", "[", "num", "]"}], "/", 
            RowBox[{"Sqrt", "[", "refNum", "]"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"{", 
          RowBox[{"num", ",", "numSel", ",", 
           RowBox[{"1.0", "*", "numSel", "*", 
            RowBox[{"refNum", "/", "num"}]}], ",", "\[Lambda]CutL", ",", 
           "sigma", ",", "benchmark"}], "}"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"results", ",", 
          RowBox[{"{", 
           RowBox[{"num", ",", 
            RowBox[{"1.0", "*", "numSel", "*", 
             RowBox[{"refNum", "/", "num"}]}], ",", "\[Lambda]CutL", ",", 
            "sigma", ",", "benchmark", ",", "sigmaAll", ",", "benchmarkAll", ",",
             "sigmaAll", ",", "benchmarkAll"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"Histogram", "[", 
          RowBox[{"wavelnList", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"0.9", "*", "\[Lambda]Min"}], ",", 
             RowBox[{"1.1", "*", "\[Lambda]Max"}], ",", "10"}], "}"}], ",", 
           RowBox[{"PlotLabel", "\[Rule]", "\"\< selected waveln \>\""}]}], 
          "]"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"Histogram", "[", 
          RowBox[{
           RowBox[{"1000", "*", 
            RowBox[{"ArcCos", "[", 
             RowBox[{"1", "/", 
              RowBox[{"theRefrIndex", "[", "wavelnList", "]"}]}], "]"}]}], ",", 
           RowBox[{"{", " ", 
            RowBox[{
             RowBox[{"halfOpenAngleMRad", "-", "2"}], " ", ",", " ", 
             RowBox[{"halfOpenAngleMRad", "+", "2"}], " ", ",", "0.04"}], 
            "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"Background", "\[Rule]", "White"}], ",", 
           RowBox[{"LabelStyle", "\[Rule]", 
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"Background", "\[Rule]", "White"}], ",", 
              RowBox[{"FontFamily", "->", "\"\<Helvetica\>\""}], ",", "Bold", 
              ",", "20"}], "]"}]}], ",", 
           RowBox[{"Axes", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"True", ",", "False"}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"\"\<mrad\>\"", ",", "\"\<\>\""}], "}"}]}], ",", 
           RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "]"}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"displayHistoStats", "[", 
         RowBox[{"ca", "=", 
          RowBox[{
           RowBox[{"ArcCos", "[", 
            RowBox[{"1", "/", 
             RowBox[{"theRefrIndex", "[", "wavelnList", "]"}]}], "]"}], "*", 
           "1000"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "ca", "]"}], ";"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}]}]}]], "Input",
 Evaluatable->True,
