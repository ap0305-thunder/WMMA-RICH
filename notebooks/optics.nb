Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\" myBoundary : \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    DynamicModuleBox[{OpticaEM`OpticaEM`Private`col$$ = None}, 
     TagBox[
      StyleBox[
       TagBox[
        StyleBox[
         TagBox[
          RowBox[{"Boundary", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"985.`", ",", "0", ",", 
              RowBox[{"-", "1000"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2245", ",", "1900", ",", "1000"}], "}"}]}], "]"}],
          HoldForm],
         FontColor->RGBColor[0., 0.392193, 0.]],
        DisplayForm],
       StripOnInput->False,
       Background->Dynamic[
         Refresh[
         If[$CellContext`$SelectedOpticalSystem === {}, 
            OpticaEM`OpticaEM`Private`col$$ = None]; 
          OpticaEM`OpticaEM`Private`col$$, 
          TrackedSymbols -> {$CellContext`$SelectedOpticalSystem, 
            OpticaEM`OpticaEM`Private`col$$}]]],
      EventHandlerTag[{
