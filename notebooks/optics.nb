      RowBox[{"Mean", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q", "/.", "sol1"}], ")"}], ",", 
         RowBox[{"(", 
          RowBox[{"q", "/.", "sol2"}], ")"}]}], "}"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"printD", "[", 
     RowBox[{"fff1", "[", "x", "]"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"printD", "[", 
     RowBox[{"fff1", "[", "100", "]"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"4", "*", 
       SuperscriptBox[
        RowBox[{"(", 
