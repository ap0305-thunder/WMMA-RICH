Cell[BoxData[{
 RowBox[{
  RowBox[{"printD", "@", "propagateSystemYes"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"printD", "@", "turboTraceYes"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"propagateSystemYes", "==", "True"}], ")"}], "||", 
     RowBox[{"(", 
      RowBox[{"turboTraceYes", "==", "True"}], ")"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"OpticalLayout", "[", 
      RowBox[{"opticalSystemLHCbRICH", ",", 
       RowBox[{"ImageSize", "->", "Full"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"bigBanner", "[", "\"\< optical system printout \>\"", "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "@", 
         RowBox[{"opticalSystemLHCbRICH", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "@", "opticalSystemLHCbRICH"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"printD", "[", 
      RowBox[{"Options", "@", "OpticalLayout"}], "]"}], ";", "\n", 
     RowBox[{
     "bigBanner", 
      "[", "\"\< Keep this plot to show extrapolated rays to visualize \
focusing \>\"", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pl", "=", 
      RowBox[{"OpticalLayout", "[", 
       RowBox[{"opticalSystemLHCbRICH", ",", 
        RowBox[{"PlotType", "->", "TopView"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<OPTICAL LAYOUT\>\""}], ",", 
        RowBox[{"PlotRange", "->", "plotRange2D"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Show", "[", 
      RowBox[{"pl", ",", 
       RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}]}], 
   RowBox[{"(*", 
    RowBox[{
    "use", " ", "this", " ", "workaround", " ", "to", " ", "manage", " ", 
     "ImageSize", " ", "with", " ", "OpticalLayout"}], "*)"}], 
