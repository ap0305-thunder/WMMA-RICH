  0.88, 1, 0.88],ExpressionUUID->"4a75da1f-77f6-45ae-9052-13f691bcb7b4"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{
   "(*", "*************************************************************************************************)"}\
],
   FontColor->RGBColor[0.5, 0, 0.5],
   Background->RGBColor[1., 0.4823529411764706, 1.]], 
  StyleBox["\[IndentingNewLine]",
   FontColor->RGBColor[0.5, 0, 0.5],
   Background->RGBColor[1., 0.4823529411764706, 1.]], 
  RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"whichOptics", "==", "\"\<LHCb22Upg1\>\""}], ")"}], "&&", 
      RowBox[{"(", 
       RowBox[{"iRICH", "==", "2"}], ")"}]}], "\[IndentingNewLine]", 
     StyleBox[
      RowBox[{
      "(*", "*************************************************************************************************)"}\
],
      FontColor->RGBColor[0.5, 0, 0.5],
      Background->RGBColor[1., 0.4823529411764706, 1.]], 
     "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"bigBanner", "[", 
       RowBox[{"\"\<\\n\>\"", ",", 
        "\[IndentingNewLine]", "\"\<  component # TBD ==>>  \>\"", 
        ",", "\"\<PRI-MIR\>\"", ",", "\"\<\\n\>\"", ",", 
        "\[IndentingNewLine]", "\"\<  component # TBD ==>>  \>\"", 
        ",", "\"\<SEC-MIR\>\"", ",", "\"\<\\n\>\"", ",", 
        "\[IndentingNewLine]", "\"\<  component # TBD ==>>  \>\"", 
        ",", "\"\<TER-MIR\>\"", ",", "\"\<\\n\>\"", ",", 
        "\[IndentingNewLine]", "\"\<  component # TBD ==>>  \>\"", 
        ",", "\"\<QUA-PLA\>\"", ",", "\"\<\\n\>\"", ",", 
        "\[IndentingNewLine]", "\"\<  component # TBD ==>>  \>\"", 
        ",", "\"\<PD\>\"", ",", "\"\<\\n\>\"", ",", 
        "\[IndentingNewLine]", "\"\<  component # TBD ==>>  \>\"", 
        ",", "\"\<BOX\>\""}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "*)"}], "\[IndentingNewLine]", "setData2022Rich2", ";", 
      "\[IndentingNewLine]", 
      RowBox[{"thickSecMir", "=", "10"}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{"random", " ", 
        RowBox[{"number", ":", " ", 
         RowBox[{"to", " ", "check"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"thickPriMir", "=", "10"}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{"random", " ", 
        RowBox[{"number", ":", " ", 
         RowBox[{"to", " ", "check"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"calcSphericalPrimaryMirror", "[", 
       RowBox[{
       "sizeTrnsvrsPriMir", ",", "tiltPriMir", ",", "radiusPriMir", ",", 
        "thetaMinPriMir", ",", "p2z"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"priMirror", "=", 
       RowBox[{"Move", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SphericalMirror", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"radiusPriMirVar", ",", 
             RowBox[{"-", "radiusPriMir"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"sizeTrnsvrsPriMir", ",", "sizeThirdDimPriMir"}], "}"}], ",",
            "thickPriMir", ",", "\[IndentingNewLine]", "\"\<PRI-MIR-NOW\>\"", 
           RowBox[{"(*", 
            RowBox[{",", " ", 
             RowBox[{"FlatSubstrate", " ", "->", " ", "False"}]}], "*)"}], ",", 
           RowBox[{"FrontSurface", "\[Rule]", "True"}]}], "]"}], ",", 
         RowBox[{"(*", 
          RowBox[{"FlatSubstrate", " ", "->", " ", 
           RowBox[{"False", " ", "gives", " ", "errors"}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"zPriMirVar", ",", "zVrtxPriMir"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"xPriMirVar", ",", "xVrtxPriMir"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"tiltPriMirVar", ",", 
           RowBox[{"180", "+", 
            RowBox[{"tiltPriMir", "/", "Degree"}]}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"secMirror", "=", 
       RowBox[{"Move", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SphericalMirror", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"radiusSecMirVar", ",", "radiusSecMir"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"sizeTrnsvrsSecMir", ",", "sizeThirdDimSecMir"}], "}"}], ",",
            "thickSecMir", ",", "\[IndentingNewLine]", "\"\<SEC-MIR-NOW\>\"", 
           RowBox[{"(*", 
            RowBox[{",", 
             RowBox[{"FlatSubstrate", " ", "->", " ", "False"}]}], "*)"}], ",", 
           RowBox[{"FrontSurface", "\[Rule]", "True"}]}], "]"}], ",", 
         RowBox[{"(*", 
          RowBox[{"FlatSubstrate", " ", "->", " ", 
           RowBox[{"False", " ", "gives", " ", "errors"}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"zSecMirVar", ",", "zSecMir"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"xSecMirVar", ",", "xSecMir"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"tiltSecMirVar", ",", 
           RowBox[{"180", "+", 
            RowBox[{"tiltSecMir", "/", "Degree"}]}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"QUARTZ", " ", "PLATE"}], " ", "//", " ", 
        RowBox[{"TO", " ", 
         RowBox[{"FIX", "/", "check"}], " ", 
         RowBox[{"(", 
          RowBox[{"wavlen", " ", "model"}], ")"}]}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Optical Medium data\>\"", ",", 
        RowBox[{"SearchData", "[", 
         RowBox[{"OpticalMedium", "->", "\"\<F_SILICA\>\""}], "]"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"testQuartzPlate", "=", "False"}], ";", "\[IndentingNewLine]", 
      RowBox[{"quartzPlateDist", ":=", 
       RowBox[{"{", 
        RowBox[{"zQuartzPlateDist", ",", "xQuartzPlateDist"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tiltQuartzPlate", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"testQuartzPlate", "==", "True"}], "\[IndentingNewLine]", ",",
         "\[IndentingNewLine]", 
        StyleBox[
         RowBox[{
         "(*", "*************************************************************************************************)"}\
],
         FontColor->RGBColor[0.5, 0, 0.5],
         Background->RGBColor[1., 0.4823529411764706, 1.]], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"distanceQuartzPlateFromPD", "=", 
          RowBox[{"-", "300"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"zQuartzPlateDist", ",", "xQuartzPlateDist"}], "}"}], "=", 
          RowBox[{
           RowBox[{"distanceQuartzPlateFromPD", "*", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Cos", "[", "tiltScreen", "]"}], ",", 
              RowBox[{"Sin", "[", "tiltScreen", "]"}]}], "}"}]}], "+", 
           RowBox[{"{", 
            RowBox[{"zScreen", ",", "xScreen"}], "}"}]}]}], ";", 
         RowBox[{"(*", 
          RowBox[{
          "set", " ", "delayed", " ", "does", " ", "not", " ", "work"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"quartzPlateThick", "=", "8"}], 
         RowBox[{"(*", " ", 
          RowBox[{"!", 
           RowBox[{
            RowBox[{"@", "#$"}], "%", " ", "CHECK"}]}], " ", "*)"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tiltScreenAddToQuartzPlateDegrees", "=", "25"}], ";"}], 
        "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        StyleBox[
         RowBox[{
         "(*", "*************************************************************************************************)"}\
],
         FontColor->RGBColor[0.5, 0, 0.5],
         Background->RGBColor[1., 0.4823529411764706, 1.]], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"distanceQuartzPlateFromPD", "=", 
          RowBox[{"-", "200"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"zQuartzPlateDist", ",", "xQuartzPlateDist"}], "}"}], "=", 
          RowBox[{
           RowBox[{"distanceQuartzPlateFromPD", "*", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Cos", "[", "tiltScreen", "]"}], ",", 
              RowBox[{"Sin", "[", "tiltScreen", "]"}]}], "}"}]}], "+", 
           RowBox[{"{", 
            RowBox[{"zScreen", ",", "xScreen"}], "}"}]}]}], ";", 
         RowBox[{"(*", 
          RowBox[{
          "set", " ", "delayed", " ", "does", " ", "not", " ", "work"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"quartzPlateThick", "=", "8"}], ";", "\[IndentingNewLine]", 
         RowBox[{"tiltScreenAddToQuartzPlateDegrees", "=", "0"}]}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"quartzPlate", "=", 
       RowBox[{"Move", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"PlanoConvexLens", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"sizeTrnsvrsScreen", ",", "sizeThirdDimScreen"}], "}"}], ",",
            "quartzPlateThick", ",", 
           "\[IndentingNewLine]", "\"\<QUA-WIN-NOW\>\"", ",", 
           RowBox[{"Transmittance", "\[Rule]", "100"}], ",", 
           RowBox[{"OpticalMedium", "->", "\"\<F_SILICA\>\""}], ",", 
           RowBox[{"DesignWaveLength", "\[Rule]", "0.350"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"zQuartzPlateDistVar", ",", "zQuartzPlateDist"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"xQuartzPlateDistVar", ",", "xQuartzPlateDist"}], "}"}]}],
           "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"tiltQuartzPlateVar", ",", 
           RowBox[{"tiltScreenAddToQuartzPlateDegrees", "+", 
            RowBox[{"tiltScreen", "/", "Degree"}]}]}], "}"}]}], 
        RowBox[{"(*", 
         RowBox[{"here", " ", 
          RowBox[{"tiltScreen", "!"}]}], "*)"}], "\[IndentingNewLine]", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Transmittance", "\[Rule]", "0.5"}], ",", 
        RowBox[{"Reflectance", "\[Rule]", "0.5"}], ",", 
        RowBox[{"CurvatureDirection", "\[Rule]", "Back"}], ",", 
        RowBox[{"SwitchDirectionOnReflection", "\[Rule]", "True"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"thePDA", "=", 
       RowBox[{"Move", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Screen", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"sizeTrnsvrsScreen", ",", "sizeThirdDimScreen"}], "}"}], ",",
            "\[IndentingNewLine]", "\"\<THE-PDA-NOW\>\"", ",", 
           RowBox[{"Transmittance", "\[Rule]", "0"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"zScreenVar", ",", "zScreen"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"xScreenVar", ",", "xScreen"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"tiltScreenVar", ",", 
           RowBox[{"tiltScreen", "/", "Degree"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
