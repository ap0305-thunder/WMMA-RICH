                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "*", 
                  RowBox[{"(", 
                   RowBox[{"1000", "/", "focalLengthEffectiveH"}], ")"}], "*",
                   "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"First", "@", "#"}], "-", 
                    RowBox[{"Last", "@", "#"}]}], "]"}], "&"}], "/@", 
                    RowBox[{"(", 
                    RowBox[{"Map", "[", 
