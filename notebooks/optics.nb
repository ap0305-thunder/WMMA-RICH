Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "exportSelectedGeneratedCellPDF", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exportSelectedGeneratedCellPDF", "[", "file_String", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nb", ",", "cells", ",", "cell", ",", "expr", ",", "tmp", ",", 
      "result"}], "}"}], ",", 
    RowBox[{
     RowBox[{"nb", "=", 
      RowBox[{"InputNotebook", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cells", "=", 
      RowBox[{"SelectedCells", "[", "nb", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "cells", "]"}], "=!=", "1"}], ",", 
       RowBox[{
        RowBox[{
        "MessageDialog", "[", "\"\<Select exactly one cell first.\>\"", "]"}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cell", "=", 
      RowBox[{"First", "[", "cells", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"expr", "=", 
      RowBox[{"NotebookRead", "[", "cell", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmp", "=", 
      RowBox[{"CreateDocument", "[", 
       RowBox[{
        RowBox[{"{", "expr", "}"}], ",", 
        RowBox[{"Visible", "->", "False"}], ",", 
        RowBox[{"WindowSelected", "->", "False"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"result", "=", 
      RowBox[{"Export", "[", 
       RowBox[{"file", ",", "tmp", ",", "\"\<PDF\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"NotebookClose", "[", "tmp", "]"}], ";", "\[IndentingNewLine]", 
     "result"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{
  3.945862080410919*^9, 3.9468070237038136`*^9, {3.9885946859222813`*^9, 
   3.988594685923794*^9}},
 CellLabel->
  "11/12/26 16:08:22 \
In[427]:=",ExpressionUUID->"7efa4326-ad05-ae41-8a1c-def26816429b"]
