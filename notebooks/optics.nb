Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"setExternalParameters", "[", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"bigBanner", "[", 
        RowBox[{"\"\< start RICH = \>\"", "<>", 
         RowBox[{"ToString", "[", "iRICH", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Unprotect", "[", 
