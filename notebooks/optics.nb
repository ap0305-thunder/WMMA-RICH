In[369]:=",ExpressionUUID->"ee7fce72-6baa-1243-9bdf-ca6987abb891"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"doRingFits", "[", "points2D_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "plotEllipse", ",", "plotCircle", ",", "ringCenterFitUV", ",", 
       "ringRadiusFit", ",", "points", ",", "x", ",", "y", ",", "curve", ",", 
       "a$", ",", "b$", ",", "c$", ",", "e$", ",", "thisEllipseResult"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", 
       "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
        "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
        "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
        "**", "**", "**", "**", "**", "**", "**", "**", "**"}], "**)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", "fits", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", 
       "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
        "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
        "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
        "**", "**", "**", "**", "**", "**", "**", "**", "**"}], "**)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"points", "=", 
       RowBox[{"Round", "[", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Join", "[", 
             RowBox[{"#", ",", 
              RowBox[{"{", "0", "}"}]}], "]"}], "&"}], ",", "points2D"}], 
          "]"}], ",", "0.001"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"circle", " ", "fit"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ringCenterFitUV", "=", 
       RowBox[{"Drop", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"findRingCenter", "[", "points", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"-", "1"}]}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
       "findRingCenterworks", " ", "with", " ", "3", "D", " ", "points"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ringRadiusFit", "=", 
       RowBox[{
        RowBox[{"findRingCenter", "[", "points", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
       "findRingCenterworks", " ", "with", " ", "3", "D", " ", "points"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"printD", "@", 
       RowBox[{"nfpm1", "@", "ringCenterFitUV"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"printD", "@", 
       RowBox[{"nf1", "@", "ringRadiusFit"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"graph", " ", "circle", " ", "fit"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"plotCircle", "=", 
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"PointSize", "[", "Large", "]"}], ",", "Green", ",", 
             RowBox[{"Point", "[", "points2D", "]"}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Circle", "[", 
            RowBox[{"(*", 
             RowBox[{"swapTheXYCoords", "@"}], "*)"}], 
            RowBox[{"ringCenterFitUV", ",", "ringRadiusFit"}], "]"}]}], 
          "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
         RowBox[{"PlotLabel", "->", "\"\<circle fit with points\>\""}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Rotate", "[", 
             RowBox[{"\"\<mm \\n(u-coord)\>\"", ",", 
              RowBox[{"90", "Degree"}]}], "]"}], 
            ",", "\"\<mm \\n (v-coord)\>\""}], "}"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"debugPrint", "@", "plotCircle"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"ellipse", " ", "fit"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "points", "]"}], ">=", "6"}], 
        "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"curve", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"EllipseFit", "[", 
             RowBox[{
              RowBox[{"precisionify", "@", 
               RowBox[{"to2D", "[", "points", "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "/.", 
            RowBox[{"x", "->", "\[FormalX]"}]}], "/.", 
           RowBox[{"y", "->", "\[FormalY]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"debugPrint", "@", "curve"}], ";", "\[IndentingNewLine]", 
         RowBox[{"plotEllipse", "=", 
          RowBox[{"ContourPlot", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Evaluate", "@", "curve"}], ",", 
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"plRangeAllHits", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "\[FormalX]"}], "]"}], ",", 
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"plRangeAllHits", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "\[FormalY]"}], "]"}], ",",
             "\[IndentingNewLine]", 
            RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Axes", "->", "True"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
            RowBox[{"PlotPoints", "->", "100"}], ",", "\[IndentingNewLine]", 
            RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
            RowBox[{
            "PlotLabel", "->", "\"\<ellipse contour plot of fit\>\""}]}], 
           "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"graph", " ", "ellipse", " ", "fit"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"debugPrint", "@", "plotEllipse"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"thisEllipseResult", "=", 
            RowBox[{"{", "}"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"thisEllipseResult", "=", 
          RowBox[{
           RowBox[{
           "ResourceFunction", "[", "\"\<EllipseProperties\>\"", "]"}], "[", 
           RowBox[{"curve", ",", 
            RowBox[{"{", 
             RowBox[{"\[FormalX]", ",", "\[FormalY]"}], "}"}]}], "]"}]}], ";", 
         RowBox[{"(*", 
          RowBox[{"need", " ", "high", " ", "numerical", " ", "precision"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"debugPrintD", "@", "thisEllipseResult"}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"ellipseAllResults", ",", "thisEllipseResult"}], "]"}], ";", 
         RowBox[{"(*", 
          RowBox[{"!", 
           RowBox[{
            RowBox[{"@", "#$"}], "%", "to", " ", 
            RowBox[{"fix", ":", " ", 
             RowBox[{"global", " ", "to", " ", "manage", " ", "passage", " ", 
              RowBox[{"from", "/", "to"}], " ", "doRingFit"}]}]}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"showEllipseResults", "[", 
          RowBox[{"thisEllipseResult", ",", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\< a= \>\"", ",", "a$", ",", "\"\< b= \>\"", ",", "b$",
              ",", "\"\< c= \>\"", ",", "c$", ",", "\"\< e= \>\"", ",", 
             "e$"}], "]"}]}], "\[IndentingNewLine]", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
        "miniBanner", 
         "[", "\"\<Less than six points: too few points to fit an ellipse - \
SKIPPING \>\"", "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "show", " ", "combine", " ", "naive", " ", "circle", " ", "and", " ", 
