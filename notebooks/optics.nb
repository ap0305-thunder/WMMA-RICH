                    RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], 
                    "\[IndentingNewLine]", "}"}], ",", 
                    RowBox[{"ImageSize", "->", "Full"}]}], "]"}]}], ";"}]}], 
                "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
             "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"allAzimuthAnglesHSorted", "=", 
             RowBox[{"Sort", "@", "allAzimuthAnglesH"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"debugPrint", "[", 
             
             RowBox[{"\"\<{allAzimuthAnglesH,allAzimuthAnglesHSorted}   \>\"",
               ",", 
              RowBox[{"TableForm", "@", 
               RowBox[{"Transpose", "@", 
                RowBox[{"nfpm2", "@", 
                 RowBox[{"{", 
                  RowBox[{
                  "allAzimuthAnglesH", ",", "allAzimuthAnglesHSorted"}], 
                  "}"}]}]}]}]}], "]"}], ";", 
            RowBox[{"printD", "@", 
             RowBox[{"Median", "@", 
              RowBox[{"Differences", "@", "allAzimuthAnglesHSorted"}]}]}], ";", 
            RowBox[{"deltaH", ":=", 
             RowBox[{
              RowBox[{"(", "allAzimuthAnglesHSorted", ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"2", 
                RowBox[{"Pi", "/", "numPhoInAzimuth"}]}], ")"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Block", "[", 
             RowBox[{
              RowBox[{"{", "}"}], ",", 
              RowBox[{"line", "=", 
               RowBox[{"Fit", "[", 
                RowBox[{"deltaH", ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "s"}], "}"}], ",", "s"}], "]"}]}]}], 
             "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
             "doEvalOpticsPerformance$debug", ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "@", 
                RowBox[{"Show", "[", 
                 RowBox[{
                  RowBox[{"ListPlot", "[", 
                   RowBox[{"deltaH", ",", 
                    RowBox[{"Epilog", "->", "thisGraphicsInset"}], ",", 
                    RowBox[{"PlotStyle", "->", "Red"}]}], "]"}], ",", 
                  RowBox[{"Plot", "[", 
                   RowBox[{
                    RowBox[{"{", "line", "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"s", ",", "0", ",", "numPhoInAzimuth"}], "}"}]}], 
                   "]"}]}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
            RowBox[{
            "miniBanner", 
             "[", "\"\< Full Summary for Single Track All Azimuth \>\"", 
             "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{
            "miniBanner", "[", "\"\< optics-PDA relationships \>\"", "]"}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"numPhotonHitsOnTheFS2DSingleTrackGroupedByAzimuthUVH", "=", 
             RowBox[{
             "Length", "/@", 
              "allPhotonHitsOnTheFS2DSingleTrackGroupedByAzimuthUVH"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"anisotropicAngleToDistanceMagnificationH", "=", 
             RowBox[{"anisotropicRawDistanceOnTheFSH", "/", "deltaThetaC"}]}],
             ";", "\[IndentingNewLine]", 
            RowBox[{"(*", "sigma2D", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
               "Min", "[", 
                "numPhotonHitsOnTheFS2DSingleTrackGroupedByAzimuthUVH", "]"}],
                ">", "1"}], 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                 RowBox[{"conservative", "..."}], ".", " ", "some"}], " ", 
                "might", " ", "be", " ", "saved"}], "*)"}], 
              "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
              RowBox[{"sigma2DH", "=", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"Total", "/@", 
                 RowBox[{"(", 
                  RowBox[{
                  "Variance", "/@", 
                   "allPhotonHitsOnTheFS2DSingleTrackGroupedByAzimuthUVH"}], 
                  ")"}]}], "]"}]}], "\[IndentingNewLine]", ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "Print", 
                "[", "\"\<Not enough data for variance (if any azimuth has \
too few... conservative to fix): sigma2D-->> 0 \>\"", "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"sigma2DH", "=", 
                RowBox[{"ConstantArray", "[", 
                 RowBox[{"0", ",", "numPhoInAzimuthDetectedH"}], "]"}]}]}]}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"(*", "fullDistanceMatrix", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"fullDistanceMatrixH", "=", 
             RowBox[{
             "DistanceMatrix", "/@", 
              "allPhotonHitsOnTheFS2DSingleTrackGroupedByAzimuthUVH"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"maxDist2DH", "=", 
             RowBox[{"Max", "/@", "fullDistanceMatrixH"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"focalLengthEffectiveH", "=", 
             RowBox[{"ringRadiusFitH", "/", 
              RowBox[{"Tan", "[", 
               RowBox[{"Median", "[", 
                RowBox[{"theListOfThetaCSim", "/", "1000"}], "]"}], "]"}]}]}],
             ";", "        ", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{"APPROX", ":", " ", 
               RowBox[{"1000", "*", 
                RowBox[{"ringRadiusFitH", "/", 
                 RowBox[{"Median", "@", "theListOfThetaCSim"}]}]}]}], ";"}], 
             "*)"}], "\[IndentingNewLine]", 
            RowBox[{"focalLengthNominalMeterH", "=", 
             RowBox[{"focalLengthNominalH", "/", "1000"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"oneMmToMradH", "=", 
             RowBox[{"1000", "/", "focalLengthEffectiveH"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"oneMradToMmH", "=", 
             RowBox[{"focalLengthEffectiveH", "/", "1000"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"printD", "@", 
             RowBox[{"nf2", "@", "sigma2DH"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"maxSigma2DH", "=", 
             RowBox[{"Max", "[", "sigma2DH", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"meanSigma2DH", "=", 
             RowBox[{"Mean", "[", "sigma2DH", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"medianSigma2DH", "=", 
             RowBox[{"Median", "[", "sigma2DH", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"effectivePSFAngleH", "=", 
             RowBox[{"1000", "*", 
              RowBox[{"sigma2DH", "/", "focalLengthEffectiveH"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"maxEffectivePSFAngleH", "=", 
             RowBox[{"1000", "*", 
              RowBox[{"maxSigma2DH", "/", "focalLengthEffectiveH"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"meanEffectivePSFAngleH", "=", 
             RowBox[{"1000", "*", 
              RowBox[{"meanSigma2DH", "/", "focalLengthEffectiveH"}]}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"medianEffectivePSFAngleH", "=", 
             RowBox[{"1000", "*", 
              RowBox[{"medianSigma2DH", "/", "focalLengthEffectiveH"}]}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
            RowBox[{
            "miniBanner", 
             "[", "\"\< !@#$% USING SMALL ANGLE/FSDISTANCE APPROX for \
FOCUSING ERROR - to be checked/improved \>\"", "]"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"Do", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{"(*", 
                RowBox[{
                 RowBox[{
                 "in", " ", "this", " ", "case", " ", "you", " ", "have", " ",
                   "collected", " ", "all", " ", "photons"}], ",", " ", 
                 RowBox[{
                 "including", " ", "first", " ", "and", " ", "last"}]}], 
                "*)"}], "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                 RowBox[{
                 "numPhotonHitsOnTheFS2DSingleTrackGroupedByAzimuthUVH", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "==", "numPhoAlongTrack"}], 
                "*)"}], "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"1", "<", 
                 RowBox[{
                 "numPhotonHitsOnTheFS2DSingleTrackGroupedByAzimuthUVH", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "<=", "numPhoAlongTrack"}], 
                "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"SMALL", " ", 
                   RowBox[{"ANGLE", "/", "FSDISTANCE"}], " ", "APPROX"}], ",",
                   " ", 
                  RowBox[{"SHOULD", " ", "BE", " ", "OK"}]}], "*)"}], " ", 
                RowBox[{"(*", "RESCALE", "*)"}], "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"focusingErrorAngleRingH", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "=", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"focErrCoeff", "[", 
                   RowBox[{"numPhoAlongTrack", ",", 
                    RowBox[{
                    "numPhotonHitsOnTheFS2DSingleTrackGroupedByAzimuthUVH", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "*", 
                  RowBox[{"(", 
                   RowBox[{"1000", "/", "focalLengthEffectiveH"}], ")"}], "*",
                   "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"First", "@", "#"}], "-", 
                    RowBox[{"Last", "@", "#"}]}], "]"}], "&"}], "/@", 
                    RowBox[{"(", 
                    RowBox[{"Map", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Norm", "[", 
                    RowBox[{"#", "-", "ringCenterFitUVH"}], "]"}], "&"}], ",",
                     "allPhotonHitsOnTheFS2DSingleTrackGroupedByAzimuthUVH", ",", 
                    RowBox[{"{", "2", "}"}]}], "]"}], ")"}]}], "/", 
                    RowBox[{"Sqrt", "[", "12", "]"}]}], ")"}], "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}]}]}], 
               "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
