Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "listInfo", "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"listInfo", "[", "lst_", "]"}], ":=", 
   RowBox[{"Dataset", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Head\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"Head", "[", "lst", "]"}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<The outermost Wolfram expression head of the object. For \
ordinary lists this is usually List.\>\""}]}], "|>"}]}], ",", 
      RowBox[{"\"\<Length\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"Length", "[", "lst", "]"}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<Number of elements at the first level only.\>\""}]}], 
        "|>"}]}], ",", 
      RowBox[{"\"\<Dimensions\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"Dimensions", "[", "lst", "]"}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<Shape of a rectangular/ragged array where Wolfram can \
infer it. For a matrix this is {rows, columns}.\>\""}]}], "|>"}]}], ",", 
      RowBox[{"\"\<Depth\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"Depth", "[", "lst", "]"}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<Maximum expression depth, including heads and atoms. \
Useful for seeing how deeply nested the object is.\>\""}]}], "|>"}]}], ",", 
      RowBox[{"\"\<ArrayDepth\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"ArrayDepth", "[", "lst", "]"}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<Depth as an array-like object. A vector has ArrayDepth \
1, a matrix 2, a rank-3 tensor 3.\>\""}]}], "|>"}]}], ",", 
      RowBox[{"\"\<LeafCount\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"LeafCount", "[", "lst", "]"}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<Approximate number of atomic leaves in the expression. \
Useful as a rough complexity/size measure.\>\""}]}], "|>"}]}], ",", 
      RowBox[{"\"\<ByteCount\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"ByteCount", "[", "lst", "]"}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<Approximate memory used by the expression in \
bytes.\>\""}]}], "|>"}]}], ",", 
      RowBox[{"\"\<PackedArrayQ\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"Developer`PackedArrayQ", "[", "lst", "]"}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<Whether the expression is stored internally as a packed \
array, which is usually faster and more memory efficient for numerical \
arrays.\>\""}]}], "|>"}]}], ",", 
      RowBox[{"\"\<NumericArrayQ\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"ArrayQ", "[", 
           RowBox[{"lst", ",", "_", ",", "NumericQ"}], "]"}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<Whether the object is an array whose elements are \
numeric.\>\""}]}], "|>"}]}], ",", 
      RowBox[{"\"\<VectorQ\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"VectorQ", "[", "lst", "]"}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<Whether the object is a one-dimensional list.\>\""}]}], 
        "|>"}]}], ",", 
      RowBox[{"\"\<MatrixQ\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"MatrixQ", "[", "lst", "]"}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<Whether the object is a two-dimensional rectangular \
list.\>\""}]}], "|>"}]}], ",", 
      RowBox[{"\"\<ComponentHeads\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"Head", "/@", "lst"}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<The heads of the first-level elements, equivalent to \
Head /@ lst.\>\""}]}], "|>"}]}], ",", 
      RowBox[{"\"\<ComponentHeadCounts\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"Counts", "[", 
           RowBox[{"Head", "/@", "lst"}], "]"}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<Counts of the different heads appearing among \
first-level elements.\>\""}]}], "|>"}]}], ",", 
      RowBox[{"\"\<NestedComponentHeads\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"Map", "[", 
           RowBox[{"Head", ",", "lst", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<Heads of components at all levels. This can be large for \
deeply nested arrays.\>\""}]}], "|>"}]}], ",", 
      RowBox[{"\"\<MinMax\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"Quiet", "@", 
           RowBox[{"Check", "[", 
            RowBox[{
             RowBox[{"MinMax", "[", 
              RowBox[{"Flatten", "[", "lst", "]"}], "]"}], ",", 
             RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], 
            "]"}]}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<Minimum and maximum after flattening. Only meaningful \
for mutually comparable elements, usually numbers.\>\""}]}], "|>"}]}], ",", 
      RowBox[{"\"\<Preview\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", 
          RowBox[{"Take", "[", 
           RowBox[{"lst", ",", 
            RowBox[{"UpTo", "[", "10", "]"}]}], "]"}]}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<First elements of the list, to avoid printing a huge \
object immediately.\>\""}]}], "|>"}]}], ",", 
      RowBox[{"\"\<FullArray\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Value\>\"", "->", "lst"}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<The complete original object.\>\""}]}], "|>"}]}]}], 
     "|>"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{
  3.945862080410919*^9, 3.9468070237038136`*^9, 3.9876836061177197`*^9, {
   3.987720733115076*^9, 3.987720750571972*^9}, {3.98772081143346*^9, 
   3.9877208157563515`*^9}, 3.987720904167286*^9, 3.9877210299399414`*^9, {
   3.987721193129385*^9, 3.987721194936428*^9}, {3.9877215075937843`*^9, 
   3.9877215700798855`*^9}, {3.9877216801541023`*^9, 
   3.9877216904297085`*^9}, {3.98772373485338*^9, 3.9877238277533283`*^9}},
 CellLabel->"In[670]:=",ExpressionUUID->"23a90a5f-b0ae-9a4d-8948-56235f1db5b3"]
}, Closed]],

