Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"cross", "-", 
    RowBox[{"check", ":", " ", 
     RowBox[{"must", " ", "be", " ", "the", " ", "origin"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"allTracedAnalyzedTracksOnPriPoint", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allTracedAnalyzedTracksOnSecPoint", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"allTracedAnalyzedTracksOnPriPoint", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"allTracedAnalyzedTracksOnSecPoint", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], ";"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trackPathLengthCorrected", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"allTracedAnalyzedTracksOnPriPoint", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}], "==", 
          RowBox[{"allTracedAnalyzedTracksOnSecPoint", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"if", " ", "points", " ", "are", " ", "equal"}], ",", 
           RowBox[{
           "use", " ", "the", " ", "previously", " ", "computed", " ", 
            "value"}]}], "*)"}], 
         RowBox[{"trackPathLength", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"(*", 
          RowBox[{
          "else", " ", "compute", " ", "the", " ", "Euclidean", " ", 
           "distance"}], "*)"}], 
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"allTracedAnalyzedTracksOnPriPoint", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", 
           RowBox[{"allTracedAnalyzedTracksOnSecPoint", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "allTracedAnalyzedTracksOnPriPoint", "]"}]}], 
        "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "trackPathLengthCorrected", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "trackPathLength", "]"}], ";"}]}]}]], "Input",
