  Appearance->Automatic,
  ButtonFunction:>
   Module[{$CellContext`outDir, $CellContext`baseName}, $CellContext`outDir = \
$CellContext`$dirOut; If[
      Not[
       DirectoryQ[$CellContext`outDir]], 
      CreateDirectory[$CellContext`outDir, CreateIntermediateDirectories -> 
       True]]; $CellContext`baseName = 
     FileNameJoin[{$CellContext`outDir, "optics-geometry-all-" <> 
        ToString[$CellContext`tagString]}]; \
