    {"\<\"sizeTrnsvrsScreenL\"\>", 
     TagBox[
      InterpretationBox[
       StyleBox["\<\"+350\"\>",
        ShowStringCharacters->False],
       350,
       Editable->False],
      NumberForm[#, {10, 2}, 
       ExponentFunction -> (If[-99 < # < Plus[99], Null, 3 Quotient[#, 3]]& ),
        NumberMultiplier -> "*", NumberSigns -> {"-", "+"}]& ]},
    {"\<\"sizeTrnsvrsScreenH\"\>", 
     TagBox[
      InterpretationBox[
       StyleBox["\<\"+500\"\>",
        ShowStringCharacters->False],
       500,
       Editable->False],
      NumberForm[#, {10, 2}, 
       ExponentFunction -> (If[-99 < # < Plus[99], Null, 3 Quotient[#, 3]]& ),
        NumberMultiplier -> "*", NumberSigns -> {"-", "+"}]& ]},
    {"\<\"sizeThrdDimScreenL\"\>", 
     TagBox[
      InterpretationBox[
       StyleBox["\<\"+1500\"\>",
        ShowStringCharacters->False],
       1500,
       Editable->False],
      NumberForm[#, {10, 2}, 
       ExponentFunction -> (If[-99 < # < Plus[99], Null, 3 Quotient[#, 3]]& ),
        NumberMultiplier -> "*", NumberSigns -> {"-", "+"}]& ]},
    {"\<\"sizeThrdDimScreenH\"\>", 
     TagBox[
      InterpretationBox[
       StyleBox["\<\"+1500\"\>",
        ShowStringCharacters->False],
       1500,
       Editable->False],
      NumberForm[#, {10, 2}, 
       ExponentFunction -> (If[-99 < # < Plus[99], Null, 3 Quotient[#, 3]]& ),
        NumberMultiplier -> "*", NumberSigns -> {"-", "+"}]& ]},
    {"\<\"dirVectScreenL\"\>", 
     TagBox["dirVectScreenL",
      NumberForm[#, {10, 2}, 
       ExponentFunction -> (If[-99 < # < Plus[99], Null, 3 Quotient[#, 3]]& ),
        NumberMultiplier -> "*", NumberSigns -> {" ", " "}]& ]},
    {"\<\"dirVectScreenH\"\>", 
     TagBox["dirVectScreenH",
      NumberForm[#, {10, 2}, 
       ExponentFunction -> (If[-99 < # < Plus[99], Null, 3 Quotient[#, 3]]& ),
        NumberMultiplier -> "*", NumberSigns -> {" ", " "}]& ]},
    {"\<\"dirVectScreenAxisL\"\>", 
     TagBox["dirVectScreenAxisL",
      NumberForm[#, {10, 2}, 
       ExponentFunction -> (If[-99 < # < Plus[99], Null, 3 Quotient[#, 3]]& ),
        NumberMultiplier -> "*", NumberSigns -> {" ", " "}]& ]},
    {"\<\"dirVectScreenAxisH\"\>", 
     TagBox["dirVectScreenAxisH",
      NumberForm[#, {10, 2}, 
       ExponentFunction -> (If[-99 < # < Plus[99], Null, 3 Quotient[#, 3]]& ),
        NumberMultiplier -> "*", NumberSigns -> {" ", " "}]& ]},
    {"\<\"dirVectScreenAngleDegreeL\"\>", 
     TagBox["dirVectScreenAngleDegreeL",
      NumberForm[#, {10, 2}, 
       ExponentFunction -> (If[-99 < # < Plus[99], Null, 3 Quotient[#, 3]]& ),
        NumberMultiplier -> "*", NumberSigns -> {" ", " "}]& ]},
    {"\<\"dirVectScreenAngleDegreeH\"\>", 
     TagBox["dirVectScreenAngleDegreeH",
      NumberForm[#, {10, 2}, 
       ExponentFunction -> (If[-99 < # < Plus[99], Null, 3 Quotient[#, 3]]& ),
        NumberMultiplier -> "*", NumberSigns -> {" ", " "}]& ]},
    {"\<\"wxyzL\"\>", 
     TagBox["wxyzL",
      NumberForm[#, {10, 2}, 
       ExponentFunction -> (If[-99 < # < Plus[99], Null, 3 Quotient[#, 3]]& ),
        NumberMultiplier -> "*", NumberSigns -> {" ", " "}]& ]},
    {"\<\"wxyzH\"\>", 
     TagBox["wxyzH",
      NumberForm[#, {10, 2}, 
       ExponentFunction -> (If[-99 < # < Plus[99], Null, 3 Quotient[#, 3]]& ),
        NumberMultiplier -> "*", NumberSigns -> {" ", " "}]& ]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Right}}},
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Print",
 CellTags->"FIX-2026-11-08",
 CellLabel->
  "11/12/26 16:08:22 During evaluation of \
In[343]:=",ExpressionUUID->"c186af6a-9061-8647-9ffc-0773c97633a4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["optics geometry printout/export", \
"Subsubtitle",ExpressionUUID->"6928e12e-6f6b-e34e-be23-120a7de1e5ce"],

Cell["\<\

(*FIX 2026-11-08: the geometry report works for the split optics (L and H \
sets) and for the non-split optics (one set, no suffix; quartz plate included \
when useQuartzPlate). componentData[] collects the components once; the side \
view, the aperture view and the table are drawn from it. Tilts are the Optica \
rotation angles. exportRunDrawings[] (button \"Export drawing\" of the RUN \
CONTROL PANEL) exports the detailed side view and this report*)

ClearAll[deg, mm, normal2, tangent2, rot2, closedPolygon, 
  transverseRangeFromAperture, thirdDimRangeFromAperture, 
  transverseExtentFromAperture, thirdDimExtentFromAperture, 
  flatSegmentFromFullSize, sphericalSegmentFromAperture, 
  shiftPointList, sphericalBandFromAperture, componentData, 
  opticsComponentTable, opticsSideView, opticsApertureView, 
  opticsGeometryReport, exportOpticsGeometry, geometrySets, geoValue, 
  geoValueQ, rectangleAperture, componentStyle, exportRunDrawings];

(*Small utilities*)

deg[a_] := Quiet@N[a/Degree];
mm[x_] := NumberForm[Chop[Quiet@N[x], 10^-6], {10, 2}];(*FIX 2026-11-08: \
Chop, no -4.5*10^-13 in the table*)
normal2[t_] := {Cos[t], Sin[t]};
tangent2[t_] := {-Sin[t], Cos[t]};
swapAxes[pts_] := Reverse /@ pts;
swapPoint[p_] := Reverse[p];


(*Local surface coordinates:dn=displacement along surface normal dt=\\
displacement along transverse(radial) coordinate Global side-\\
view coordinates:{z,x}*)
rot2[{z0_, x0_}, t_, {dn_, dt_}] := {z0, x0} + dn normal2[t] + 
   dt tangent2[t];
closedPolygon[p_] := If[First[p] === Last[p], p, Append[p, First[p]]];
transverseRangeFromAperture[apert_] := 
  Module[{qvals}, qvals = apert[[All, 1]];
   {Min[qvals], Max[qvals]}];
thirdDimRangeFromAperture[apert_] := 
  Module[{uvals}, uvals = apert[[All, 2]];
   {Min[uvals], Max[uvals]}];
transverseExtentFromAperture[apert_] := 
  Subtract @@ Reverse[transverseRangeFromAperture[apert]];
thirdDimExtentFromAperture[apert_] := 
  Subtract @@ Reverse[thirdDimRangeFromAperture[apert]];

(*Geometry construction*)

(*Flat mirrors and screens.In your definitions:SphericalMirror[...,\\
{sizeTrnsvrs,sizeThrdDim},...] Screen[{sizeTrnsvrs,\\
sizeThrdDim},...] sizeTrnsvrs and sizeThrdDim are full aperture sizes.\\
Therefore the side-view segment runs from-sizeTrnsvrs/2 to+\\
sizeTrnsvrs/2.*)
flatSegmentFromFullSize[z_, x_, t_, fullTransverseSize_] := 
  Module[{half = fullTransverseSize/2}, {rot2[{z, x}, t, {0, -half}], 
    rot2[{z, x}, t, {0, +half}]}];

(*Primary mirror side-view curve.\\
The primary mirrors use real aperture polygons.\\
Therefore the transverse(radial) range is taken from apertPriMirL/H,\\
not from+/-sizeTrnsvrsPriMirL/H.*)
sphericalSegmentFromAperture[z_, x_, t_, radius_, apert_, n_ : 160] :=
   Module[{r = N[radius], qmin, qmax, qs, sag}, {qmin, qmax} = 
    transverseRangeFromAperture[apert];
   qs = Subdivide[qmin, qmax, n];
   Table[sag = Sqrt[Max[0, r^2 - q^2]] - r;
    rot2[{z, x}, t, {sag, q}], {q, qs}]];

(*Shift a list of {z,x} points by a vector.\\
This avoids Thread::tdlen from expressions like curve+offset.*)
shiftPointList[pts_, v_] := (# + v) & /@ pts;

(*Optional filled band for primary mirrors.\\
This is only a visual thickness,not an optical thickness.*)
sphericalBandFromAperture[z_, x_, t_, radius_, apert_, 
   visualThickness_ : 25, n_ : 160] := 
  Module[{curve, offset}, 
   curve = sphericalSegmentFromAperture[z, x, t, radius, apert, n];
   offset = visualThickness normal2[t];
   Join[shiftPointList[curve, +offset/2], 
    Reverse[shiftPointList[curve, -offset/2]]]];

(*Extreme points/side-view endpoints*)
formatPoint[p_] := 
  \"{\" <> ToString[mm[p[[1]]]] <> \", \" <> ToString[mm[p[[2]]]] <> \"}\";

formatPointList[pts_] := StringRiffle[formatPoint /@ pts, \" ; \"];

sideViewExtremePointsPrimary[z_, x_, t_, radius_, apert_] := 
  Module[{curve}, 
   curve = sphericalSegmentFromAperture[z, x, t, radius, apert];
   {First[curve], Last[curve]}];

sideViewExtremePointsFlat[z_, x_, t_, fullTransverseSize_] := 
  flatSegmentFromFullSize[z, x, t, fullTransverseSize];

sideViewBoundingBox[pts_] := 
  Module[{zvals, xvals}, zvals = pts[[All, 1]];
   xvals = pts[[All, 2]];
   <|\"zMin\" -> Min[zvals], \"zMax\" -> Max[zvals], \"xMin\" -> Min[xvals],
     \"xMax\" -> Max[xvals]|>];

(*Optics sets: L and H for the split optics, one set without suffix for the \
non-split optics*)
geometrySets[] := If[whichOptics == \"LHCb35Upg2Split\", {\"L\", \"H\"}, \
{\"\"}];
geoValueQ[name_String, s_String] := ToExpression[name <> s, InputForm, ValueQ];
geoValue[name_String, s_String] := ToExpression[name <> s];
(*rectangular aperture centred on the component, from its full sizes*)
rectangleAperture[t_, d_] := {{-t/2, -d/2}, {+t/2, -d/2}, {+t/2, +d/2}, \
{-t/2, +d/2}};

(*Component table data*)
componentData[] := 
  Module[{sets = geometrySets[], sfx, pri, sec, qua, pda},
   sfx[s_] := If[s == \"\", \"\", \"-\" <> s];
   (*primary mirror: split = CustomMirror placed at {zPriMirL/H, xPriMirL/H} \
with an aperture polygon; non-split = SphericalMirror placed at its vertex \
{zVrtxPriMir, xVrtxPriMir} with full rectangular sizes*)
   pri = Table[
     Module[{z, x, t, r, ap, ext, split = (s != \"\")},
      {z, x} = If[split, {geoValue[\"zPriMir\", s], geoValue[\"xPriMir\", \
s]}, {zVrtxPriMir, xVrtxPriMir}];
      t = geoValue[\"tiltPriMir\", s];
      r = geoValue[\"radiusPriMir\", s];
      ap = If[split, geoValue[\"apertPriMir\", s], \
rectangleAperture[sizeTrnsvrsPriMir, sizeThrdDimPriMir]];
      ext = sideViewExtremePointsPrimary[z, x, t, r, ap];
      <|\"Set\" -> If[split, s, \"-\"], \"Name\" -> \"PRI-MIR\" <> sfx[s], \
\"Kind\" -> \"primary\",
       \"Type\" -> \"spherical primary mirror\", \"z\" -> z, \"x\" -> x, \
\"Tilt\" -> t, \"Radius\" -> r,
       \"ApertureType\" -> If[split, \"polygon\", \"full rectangular size\"],
       \"TransverseSize\" -> transverseExtentFromAperture[ap], \"ThirdDimSize\
\" -> thirdDimExtentFromAperture[ap],
       \"Aperture\" -> ap, \"ExtremePoints\" -> ext, \"BoundingBox\" -> \
sideViewBoundingBox[ext]|>], {s, sets}];
   sec = Table[
     Module[{z = geoValue[\"zSecMir\", s], x = geoValue[\"xSecMir\", s], t = \
geoValue[\"tiltSecMir\", s],
       st = geoValue[\"sizeTrnsvrsSecMir\", s], sd = \
geoValue[\"sizeThrdDimSecMir\", s], ext},
      ext = sideViewExtremePointsFlat[z, x, t, st];
      <|\"Set\" -> If[s == \"\", \"-\", s], \"Name\" -> \"SEC-MIR\" <> \
sfx[s], \"Kind\" -> \"flat\",
       \"Type\" -> \"flat secondary mirror\", \"z\" -> z, \"x\" -> x, \
\"Tilt\" -> t,
       \"Radius\" -> If[geoValueQ[\"radiusSecMir\", s], \
geoValue[\"radiusSecMir\", s], \"-\"],
       \"ApertureType\" -> \"full rectangular size\", \"TransverseSize\" -> \
st, \"ThirdDimSize\" -> sd,
       \"Aperture\" -> rectangleAperture[st, sd], \"ExtremePoints\" -> ext, \
\"BoundingBox\" -> sideViewBoundingBox[ext]|>], {s, sets}];
   (*quartz plate: non-split optics only, when used; placed as in the \
optics-def files*)
   qua = If[sets === {\"\"} && TrueQ[useQuartzPlate] && \
ValueQ[zQuartzPlateDist],
     Module[{z = zQuartzPlateDist, x = xQuartzPlateDist, t = tiltScreen + \
tiltScreenAddToQuartzPlateDegrees Degree, ext},
      ext = sideViewExtremePointsFlat[z, x, t, sizeTrnsvrsScreen];
      {<|\"Set\" -> \"-\", \"Name\" -> \"QUA-PLA\", \"Kind\" -> \"flat\",
        \"Type\" -> \"quartz plate, \" <> ToString[quartzPlateThick] <> \" mm \
thick\", \"z\" -> z, \"x\" -> x, \"Tilt\" -> t, \"Radius\" -> \"-\",
        \"ApertureType\" -> \"full rectangular size\", \"TransverseSize\" -> \
sizeTrnsvrsScreen, \"ThirdDimSize\" -> sizeThrdDimScreen,
        \"Aperture\" -> rectangleAperture[sizeTrnsvrsScreen, \
sizeThrdDimScreen], \"ExtremePoints\" -> ext,
        \"BoundingBox\" -> sideViewBoundingBox[ext]|>}], {}];
   pda = Table[
     Module[{z = geoValue[\"zScreen\", s], x = geoValue[\"xScreen\", s], t = \
geoValue[\"tiltScreen\", s],
       st = geoValue[\"sizeTrnsvrsScreen\", s], sd = \
geoValue[\"sizeThrdDimScreen\", s], ext},
      ext = sideViewExtremePointsFlat[z, x, t, st];
      <|\"Set\" -> If[s == \"\", \"-\", s], \"Name\" -> \"PDA\" <> sfx[s], \
\"Kind\" -> \"flat\",
       \"Type\" -> \"detection plane\", \"z\" -> z, \"x\" -> x, \"Tilt\" -> \
t, \"Radius\" -> \"-\",
       \"ApertureType\" -> \"full rectangular size\", \"TransverseSize\" -> \
st, \"ThirdDimSize\" -> sd,
       \"Aperture\" -> rectangleAperture[st, sd], \"ExtremePoints\" -> ext, \
\"BoundingBox\" -> sideViewBoundingBox[ext]|>], {s, sets}];
   Join[pri, sec, qua, pda]];

opticsComponentTable[] := Module[{data, rows}, data = componentData[];
   rows = 
    Prepend[({#[\"Set\"], #[\"Name\"], #[\"Type\"], mm[#[\"z\"]], \
mm[#[\"x\"]], 
         NumberForm[deg[#[\"Tilt\"]], {8, 3}], 
         If[#[\"Radius\"] === \"-\", \"-\", mm[#[\"Radius\"]]], 
         mm[#[\"TransverseSize\"]], 
         mm[#[\"ThirdDimSize\"]], #[\"ApertureType\"], 
         formatPoint[#[\"ExtremePoints\"][[1]]], 
         formatPoint[#[\"ExtremePoints\"][[2]]], 
         mm[#[\"BoundingBox\"][\"zMin\"]], mm[#[\"BoundingBox\"][\"zMax\"]], 
         mm[#[\"BoundingBox\"][\"xMin\"]], 
         mm[#[\"BoundingBox\"][\"xMax\"]]} & /@ data), {\"Set\", \"Component\",
       \"Type\", \"centre z [mm]\", \"centre x [mm]\", \"tilt [deg]\", 
      \"radius [mm]\", \"transverse(radial) size [mm]\", 
      \"third-dim size [mm]\", \"aperture definition\", 
      \"extreme point 1 {z,x} [mm]\", \"extreme point 2 {z,x} [mm]\", 
      \"z min [mm]\", \"z max [mm]\", \"x min [mm]\", \"x max [mm]\"}];
   Grid[rows, Frame -> All, Background -> {None, {LightGray, {White}}},
     Alignment -> Center, Spacings -> {0.8, 0.65}, 
    BaseStyle -> {FontFamily -> \"Helvetica\", FontSize -> 8}]];

(*Side-view optical layout*)

componentStyle[name_String] := Which[
   StringStartsQ[name, \"PRI-MIR\"], Directive[If[StringEndsQ[name, \"-H\"], \
Darker[Blue], Blue], Thick],
   StringStartsQ[name, \"SEC-MIR\"], Directive[If[StringEndsQ[name, \"-H\"], \
Darker[Red], Red], Thick],
   StringStartsQ[name, \"QUA-PLA\"], Directive[Purple, Thick],
   True, Directive[If[StringEndsQ[name, \"-H\"], Darker[GrayLevel[0.3]], \
GrayLevel[0.3]], Dashed, Thick]];

opticsSideView[showPrimaryFill_ : True, primaryVisualThickness_ : 25] := 
  Module[{data = componentData[], isH, curveOf, fills, lines, centres, labels},
   isH[c_] := StringEndsQ[c[\"Name\"], \"-H\"];
   curveOf[c_] := If[c[\"Kind\"] === \"primary\",
     sphericalSegmentFromAperture[c[\"z\"], c[\"x\"], c[\"Tilt\"], c[\"Radius\
\"], c[\"Aperture\"]],
     flatSegmentFromFullSize[c[\"z\"], c[\"x\"], c[\"Tilt\"], \
c[\"TransverseSize\"]]];
   fills = If[TrueQ[showPrimaryFill],
     {Directive[If[isH[#], RGBColor[0.25, 0.50, 0.75], RGBColor[0.45, 0.65, \
0.85]], Opacity[0.75]],
        Polygon[sphericalBandFromAperture[#[\"z\"], #[\"x\"], #[\"Tilt\"], #[\
\"Radius\"], #[\"Aperture\"], primaryVisualThickness]]} & /@ 
      Select[data, #[\"Kind\"] === \"primary\" &], {}];
   lines = {componentStyle[#[\"Name\"]], Line[curveOf[#]]} & /@ data;
   centres = {#[\"z\"], #[\"x\"]} & /@ data;
   labels = Text[Style[#[\"Name\"], 10, Bold],
       If[#[\"Kind\"] === \"primary\", Last[curveOf[#]], Mean[curveOf[#]]],
       Which[StringStartsQ[#[\"Name\"], \"PRI-MIR\"], If[isH[#], {-1.2, \
-1.2}, {-1.2, 1.1}],
        StringStartsQ[#[\"Name\"], \"SEC-MIR\"], If[isH[#], {-1.0, 1.1}, \
{-1.0, -1.1}],
        StringStartsQ[#[\"Name\"], \"QUA-PLA\"], {1.2, 0},
        True, {-1.1, -1.1}]] & /@ data;
   Graphics[{fills, lines, {Black, PointSize[0.012], Point[centres]}, \
labels}, Frame -> True, 
    FrameLabel -> {Style[\"z [mm]\", 13], 
      Style[\"transverse(radial) [mm]\", 13]}, GridLines -> Automatic, 
    PlotRange -> All, ImageSize -> Full, AspectRatio -> 0.75, 
    BaseStyle -> {FontFamily -> \"Helvetica\", FontSize -> 11}, 
    PlotLabel -> Style[\"OPTICAL LAYOUT\", 16, Bold]]];

(*Aperture view*)

opticsApertureView[] := 
  Module[{data = componentData[], isH, poly, style, label},
   isH[c_] := StringEndsQ[c[\"Name\"], \"-H\"];
   poly[c_] := swapAxes[closedPolygon[c[\"Aperture\"]]];
   style[c_] := Which[
     StringStartsQ[c[\"Name\"], \"PRI-MIR\"], Directive[If[isH[c], \
Darker[Blue], Blue], Thick],
     StringStartsQ[c[\"Name\"], \"SEC-MIR\"], Directive[If[isH[c], \
Darker[Red], Red], Dashed, Thick],
     StringStartsQ[c[\"Name\"], \"QUA-PLA\"], Directive[Purple, DotDashed, \
Thick],
     True, Directive[If[isH[c], GrayLevel[0.3], Black], Dotted, Thick]];
   label[c_] := If[whichOptics != \"LHCb35Upg2Split\",
     (*non-split: the apertures are centred on the same point, labels on the \
edges*)
     Module[{p = Most[poly[c]], xs, ys},
      xs = p[[All, 1]]; ys = p[[All, 2]];
      Text[Style[c[\"Name\"], 10, Bold],
       Which[StringStartsQ[c[\"Name\"], \"PRI-MIR\"], {Min[xs] + 0.2 (Max[xs] \
- Min[xs]), Max[ys]},
        StringStartsQ[c[\"Name\"], \"SEC-MIR\"], {Mean[{Min[xs], Max[xs]}], \
Max[ys]},
        StringStartsQ[c[\"Name\"], \"QUA-PLA\"], {Min[xs] + 0.25 (Max[xs] - \
Min[xs]), Min[ys]},
        True, {Min[xs] + 0.8 (Max[xs] - Min[xs]), Max[ys]}],
       If[StringStartsQ[c[\"Name\"], \"QUA-PLA\"], {0, -1.3}, {0, 1.3}]]],
     Which[
     StringStartsQ[c[\"Name\"], \"PRI-MIR\"], Text[Style[c[\"Name\"], 10, \
Bold], Mean[Most[poly[c]]], If[isH[c], {-1, 1}, {-1, -1}]],
     StringStartsQ[c[\"Name\"], \"SEC-MIR\"], Text[Style[c[\"Name\"], 10, \
Bold], Mean[Most[poly[c]]], If[isH[c], {0, 1.2}, {0, -1.2}]],
     StringStartsQ[c[\"Name\"], \"QUA-PLA\"], Text[Style[c[\"Name\"], 10, \
Bold], Mean[Most[poly[c]]] + {0, 60}],
     True, Text[Style[c[\"Name\"], 10, Bold], Mean[Most[poly[c]]] + \
If[isH[c], {-100, 0}, {100, 0}]]]];
   Graphics[{{style[#], Line[poly[#]]}, label[#]} & /@ data,
    Frame -> True, 
    FrameLabel -> {Style[\"local third-dimension coordinate [mm]\", 13],
       Style[\"local transverse(radial) coordinate [mm]\", 13]}, 
    GridLines -> Automatic, PlotRange -> All, ImageSize -> Full, 
    AspectRatio -> 1/0.75, 
    BaseStyle -> {FontFamily -> \"Helvetica\", FontSize -> 11}, 
    PlotLabel -> Style[\"Aperture definitions\", 15, Bold]]];


(*Report and export*)

opticsGeometryReport[] := 
  Module[{names = #[\"Name\"] & /@ componentData[]},
   Column[{Style[\"optics-geometry_\" <> tagString, 20, Bold], 
     Style[\"Included: \" <> StringRiffle[names, \", \"] <> \".\", 11], 
     Style[If[whichOptics == \"LHCb35Upg2Split\",
        \"Primary mirrors are drawn from their aperture polygons.  \",
        \"The primary mirror is drawn from its full rectangular size, centred \
on its vertex.  \"] <>
       \"Flat mirrors\" <> If[MemberQ[names, \"QUA-PLA\"], \", the quartz \
plate\", \"\"] <>
       \" and PDAs are drawn using full transverse(radial) aperture size/2 on \
each side of the centre.  Tilts are the Optica rotation angles.\", 11], 
     opticsSideView[True], Style[\"Component parameters\", 15, Bold], 
     opticsComponentTable[], Style[\"Aperture definitions\", 15, Bold], 
     opticsApertureView[]}, Spacings -> 2]];

exportOpticsGeometry[
   baseName_String : \"optics-geometry_\" <> tagString] := 
  Module[{report, side, apertures},
   report = opticsGeometryReport[];
   side = opticsSideView[True];
   apertures = opticsApertureView[];
   Export[baseName <> \".pdf\", report];
   Export[baseName <> \"_sideview.pdf\", side];
   Export[baseName <> \"_sideview.svg\", side];
   Export[baseName <> \"_sideview.png\", side, ImageResolution -> 300];
   Export[baseName <> \"_apertures.pdf\", apertures];
   Export[baseName <> \"_apertures.svg\", apertures];
   Print[\"Exported: \", baseName <> \".pdf\"];
   Print[\"Exported: \", baseName <> \"_sideview.pdf\"];
   Print[\"Exported: \", baseName <> \"_sideview.svg\"];
   Print[\"Exported: \", baseName <> \"_sideview.png\"];
   Print[\"Exported: \", baseName <> \"_apertures.pdf\"];
   Print[\"Exported: \", baseName <> \"_apertures.svg\"];
   report];

(*All the drawings of the current optics in one call (button \"Export drawing\
\" of the RUN CONTROL PANEL): the detailed side view with the traced rays (it \
needs the ray tracing of OPTICS ANALYSIS) and the geometry report above*)
exportRunDrawings[] := 
  Module[{stamp = If[StringQ[thisTimeStamp], thisTimeStamp, timeStamp], 
    suffixes = If[whichOptics == \"LHCb35Upg2Split\", {\"L\", \"H\"}, \
{\"\"}], side, files = {}},
   side = \"optics-geometry--\" <> tagString <> stamp <> \".pdf\";
   If[ValueQ[analyzedSystem] && Length[DownValues[exportDetailedSideView]] > 0,
    exportDetailedSideView[suffixes, FileNameJoin[{$dirOut, side}]];
    AppendTo[files, side],
    Print[\" no ray tracing yet (OPTICS ANALYSIS > RAY-TRACING): the detailed \
side view is not exported \"]];
   exportOpticsGeometry[FileNameJoin[{$dirOut, \"optics-geometry-all-\" <> \
tagString}]];
   AppendTo[files, \"optics-geometry-all-\" <> tagString <> \" (.pdf, \
_sideview.pdf/.svg/.png, _apertures.pdf/.svg)\"];
   Print[\" exported to \", $dirOut, \":  \", StringRiffle[files, \" ;  \"]];
   files];\
\>", "Input",
 CellTags->"FIX-2026-11-08",
