         "limMinThrdDim", ",", "kThrdDim", ",", "limMaxThrdDim", 
          ",", "\"\<         \>\"", ",", 
          RowBox[{"nf3", "@", "tThrdDim"}]}], "}"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\< azimuthAngleTwist = \>\"", ",", 
            "azimuthAngleTwist"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"mySourceFindFocus", "=", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{"CherenkovPhotonsXYTrack", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", "thetaMax", ")"}], "/", "Degree"}], ",", 
              "numPhoAlongTrack", ",", "1", ",", "tTrnsvrs", ",", "tThrdDim", 
              ",", "0", ",", "1", ",", "azimuthAngleTwist"}], "]"}], 
            "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"the", " ", "next"}], " ", "..."}], " ", "seems", " ", 
            "to", " ", "fail", " ", "in", " ", "the", " ", "AnalyzeSystem"}], 
           " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"opticalSystemLHCbRICHFindFocus", "=", 
           RowBox[{"{", 
            RowBox[{"mySourceFindFocus", ",", "myOptics"}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"debugOptimizationScanFlag", "==", "True"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"traced", "=", 
             RowBox[{"TurboPlot", "[", 
              RowBox[{"opticalSystemLHCbRICHFindFocus", ",", 
               RowBox[{"SequentialTrace", "\[Rule]", "False"}]}], "]"}]}], 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{"traced", "=", 
             RowBox[{"TurboTrace", "[", 
              RowBox[{"opticalSystemLHCbRICHFindFocus", ",", 
               RowBox[{"SequentialTrace", "\[Rule]", "False"}]}], "]"}]}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"focus", "=", 
           RowBox[{"FindFocus", "[", 
            RowBox[{"traced", ",", 
             RowBox[{"Frame", "->", "True"}], ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"Show", "->", "True"}], ","}], "*)"}], 
             RowBox[{"Show", "->", "False"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"usedTrackAngles", ",", 
            RowBox[{"{", 
             RowBox[{"tTrnsvrs", ",", "tThrdDim", ",", "azimuthAngleTwist"}], 
             "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"allTracedTracks", ",", "tracedTrack"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"allSources", ",", "mySourceFindFocus"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"resFocus", ",", 
