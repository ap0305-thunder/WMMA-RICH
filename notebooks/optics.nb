           RowBox[{"ViewPoint", "\[Rule]", "Above"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"PlotRange", "\[Rule]", "plotRange3D"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"AspectRatio", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ","}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"tagString", "<>", "\"\<--RayEnd\>\""}], ",", "Large", ",",
               "Bold", ",", "Blue"}], "]"}]}]}], "\[IndentingNewLine]", 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"exportGraphicsToPDF", "[", 
        RowBox[{
        "plotE", ",", "\"\<RayTraceRayEndView\>\"", ",", "\"\<-optics-\>\"", ",",
          "tagString", ",", "True", ",", "$dirOut"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
           "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
           "===", "===", "===", "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "select", " ", "and", " ", "tag", " ", "all", " ", "rays", " ", 
         "reaching", " ", "the", " ", "FS"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
           "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
           "===", "===", "===", "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"raysOnTheFSId", "=", 
        RowBox[{"ReadRays", "[", 
         RowBox[{"analyzedSystem", ",", 
          RowBox[{"{", 
           RowBox[{"SourceID", ",", "RaySourceNumber"}], "}"}], ",", 
          "onTheFS"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< # of selected rays on the FS                 \>\"", ",", 
         RowBox[{"Length", "[", "raysOnTheFSId", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< # of selected rays on the FS - no duplicates \>\"", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"DeleteDuplicates", "@", "raysOnTheFSId"}], "]"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\< # of different SourceId - no duplicates      \>\"", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"Tally", "[", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Part", "[", 
               RowBox[{"#", ",", "1"}], "]"}], "&"}], ",", "raysOnTheFSId"}], 
            "]"}], "]"}], "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", 
     "]"}]}], "\[IndentingNewLine]", "]"}], ";"}]], "Input",
