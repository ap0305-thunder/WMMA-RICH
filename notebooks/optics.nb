      "===", "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"limMinTrnsvrs", ":=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"limMinThrdDim", ":=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxScanTrnsvrs", "=", "4"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxScanThrdDim", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minAccThrdDim", "=", "0.050"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minAccTrnsvrs", "=", "0.050"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"offsetThrdDim", "=", 
     RowBox[{"-", "0.050"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"offsetTrnsvrs", "=", 
     RowBox[{"(*", 
      RowBox[{"-", "0.050"}], "*)"}], "0.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"scaleFactOffsetThrdDim", "=", 
     RowBox[{"6", "/", "5"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"scaleFactOffsetTrnsvrs", "=", "1.0"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numPhoAlongTrack", "=", "7"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numPhoInAzimuth", "=", 
     RowBox[{"(*", 
      RowBox[{"12", 
       RowBox[{"(*", 
        RowBox[{"*", "4"}], "*)"}], "*", "3"}], "*)"}], "24"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"resFocus", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"resSpotSize", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allSources", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allTracedTracks", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"usedTrackAngles", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allResults", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"debugOptimizationScanFlag", "=", "False"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"tTrnsvrs", ":=", 
        RowBox[{"offsetTrnsvrs", "+", "minAccTrnsvrs", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"trnsvrsAcc", "-", "minAccTrnsvrs"}], ")"}], "*", 
          RowBox[{
           RowBox[{"(", "kTrnsvrs", ")"}], "/", "maxScanTrnsvrs"}]}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"tThrdDim", ":=", 
        RowBox[{"offsetThrdDim", "+", "minAccThrdDim", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"thrdDimAcc", "-", "minAccThrdDim"}], ")"}], "*", 
          RowBox[{
           RowBox[{"(", "kThrdDim", ")"}], "/", "maxScanThrdDim"}]}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"bigBanner", "[", 
        RowBox[{"\"\< NEW TRACK : \>\"", ",", " ", "\"\<tTrnsvrs\>\"", ",", 
         "tTrnsvrs", ",", "\"\<   \>\"", ",", "\"\<tThrdDim\>\"", ",", 
         "tThrdDim"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", "\"\< ============================================ \>\"",
         "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"printD", "[", 
        RowBox[{"{", 
         RowBox[{
         "limMinTrnsvrs", ",", "kTrnsvrs", ",", "limMaxTrnsvrs", 
          ",", "\"\<         \>\"", ",", 
          RowBox[{"nf3", "@", "tTrnsvrs"}]}], "}"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"printD", "[", 
        RowBox[{"{", 
