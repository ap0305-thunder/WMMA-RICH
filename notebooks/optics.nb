Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"allTracedAnalyzedTracksOnSec", "=", 
     RowBox[{"AnalyzeSystem", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"allTracks", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "2"}], "]"}], "]"}], ",", 
        RowBox[{"Resonate", "[", "myOptics", "]"}], ",", "myBoundary"}], 
       "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pointOnSec", "=", 
     RowBox[{"ReadRays", "[", 
      RowBox[{"allTracedAnalyzedTracksOnSec", ",", 
       RowBox[{"{", "RayEnd", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Dimensions", "[", "pointOnSec", "]"}], "]"}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"TableForm", "@", "pointOnSec"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allTracedAnalyzedTracksOnPri", "=", 
     RowBox[{"AnalyzeSystem", "[", 
      RowBox[{"{", 
       RowBox[{"allTracks", ",", "myOptics", ",", "myBoundary"}], "}"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pointOnPri", "=", 
     RowBox[{"ReadRays", "[", 
      RowBox[{"allTracedAnalyzedTracksOnPri", ",", 
       RowBox[{"{", "RayEnd", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Dimensions", "[", "pointOnPri", "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"TableForm", "@", "pointOnPri"}], "]"}], ";"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ReadRays", "[", 
      RowBox[{"allTracedAnalyzedTracksOnPri", ",", 
       RowBox[{"{", 
        RowBox[{"ComponentNumber", ",", "SurfaceNumber"}], "}"}]}], "]"}], "//",
      "Tally"}], "//", "Sort"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ReadRays", "[", 
      RowBox[{"allTracedAnalyzedTracksOnSec", ",", 
       RowBox[{"{", 
        RowBox[{"ComponentNumber", ",", "SurfaceNumber"}], "}"}]}], "]"}], "//",
      "Tally"}], "//", "Sort"}], "\n", 
   RowBox[{
    RowBox[{"allTracedAnalyzedTracksOnPriPoint", "=", 
     RowBox[{"ReadRays", "[", 
      RowBox[{"allTracedAnalyzedTracksOnPri", ",", 
       RowBox[{"{", 
        RowBox[{"RayStart", ",", "RayEnd"}], 
        RowBox[{"(*", 
         RowBox[{
         ",", "ComponentNumber", ",", "SurfaceNumber", ",", 
          "IntersectionNumber", ",", "GenerationNumber"}], "*)"}], "}"}], ",", 
       RowBox[{"GenerationNumber", "->", "1"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"Tally", "[", "allTracedAnalyzedTracksOnPriPoint", "]"}], "]"}],
      ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Dimensions", "[", "allTracedAnalyzedTracksOnPriPoint", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allTracedAnalyzedTracksOnSecPoint", "=", 
     RowBox[{"ReadRays", "[", 
      RowBox[{"allTracedAnalyzedTracksOnSec", ",", 
       RowBox[{"{", 
        RowBox[{"RayStart", ",", "RayEnd"}], 
        RowBox[{"(*", 
         RowBox[{
         ",", "ComponentNumber", ",", "SurfaceNumber", ",", 
          "IntersectionNumber", ",", "GenerationNumber"}], "*)"}], "}"}], ",", 
       RowBox[{"GenerationNumber", "->", "1"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"Tally", "[", "allTracedAnalyzedTracksOnSecPoint", "]"}], "]"}],
      ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Dimensions", "[", "allTracedAnalyzedTracksOnSecPoint", "]"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"cross", "-", 
     RowBox[{"check", ":", " ", 
      RowBox[{"must", " ", "be", " ", "the", " ", "origin"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allTracedAnalyzedTracksOnPriPoint", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allTracedAnalyzedTracksOnSecPoint", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trackPathLengthMin", "=", "900"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trackPathLengthMax", "=", "2500"}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "if", " ", "one", " ", "of", " ", "the", " ", "mirrors", " ", "is", " ", 
     "missed", " ", "you", " ", "get", " ", "the", " ", "same", " ", "point", 
     " ", "and", " ", "zero", " ", "distance"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trackPathLength", "=", 
     RowBox[{"Norm", "/@", 
