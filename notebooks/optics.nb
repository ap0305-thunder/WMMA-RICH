     RowBox[{
      RowBox[{"rays", " ", "!"}], "@", "#$"}], "%"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"opticalSystemLHCbRICHFindFocus", "=", 
