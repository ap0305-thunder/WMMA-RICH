Cell[CellGroupData[{

Cell["Test 1: central cell, 400 nm", "Subsection",ExpressionUUID->"05e584b8-0b60-6c4d-b23d-f8d48f56962f"],

Cell["\<\
Cell 1 of row 1 (z = 0). The track comes from the interaction point and \
crosses the cell along its axis; the 36 photons are emitted at R = 2000 mm, \
between the sensor (front at about 1941 mm) and the mirror (about 2098 mm), \
with the Cherenkov angle of C4F10 at 400 nm (51.5 mrad).\
\>", "Text",ExpressionUUID->"b29f1864-e375-f84b-a06e-9cf2b86d1e1a"],

