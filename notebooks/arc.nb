Cell[CellGroupData[{

Cell["Test 2: every cell of row 1", "Subsection",ExpressionUUID->"08fe0f47-1d82-4143-8040-dc45c526b37b"],

Cell["\<\
Same test for the 17 cells of row 1 (about a minute). Moving away from z = 0 \
the mirror centres move off the cell axis (up to 216 mm) and the sensors are \
tilted (up to 0.40 rad): this is where a wrong rotation or a wrong sign shows \
up. Expected: 36 photons on the sensor in every cell, Optica and model ring \
radii within a few hundredths of a millimetre (the aerogel plate is crossed \
at larger angles in the outer cells), maxDist small.\
\>", "Text",ExpressionUUID->"ab18d1c6-04c8-9041-9a11-358e772a0566"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rowCells", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", "\"\<SignedNumber\>\"", "]"}], " ", "&"}], " ", "/@", 
    " ", 
    RowBox[{"b1", "[", "\"\<Cells\>\"", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tests", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"traceCell", ",", " ", "rowCells"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"geos", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"geoCell", ",", " ", "rowCells"}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "11/8/26 18:38:02 \
In[24]:=",ExpressionUUID->"dfbfdd92-a420-5e45-a66a-ad5dd51177d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dataset", "[", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cell\>\"", " ", "->", " ", "#"}], ",", " ", 
       RowBox[{"\"\<Zcell (mm)\>\"", " ", "->", " ", 
        RowBox[{"Round", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"tests", "[", "#", "]"}], "[", "\"\<Cell\>\"", "]"}], 
           "[", "\"\<CentreZ\>\"", "]"}], ",", " ", "0.1"}], "]"}]}], ",", 
       "\n", "    ", 
       RowBox[{"\"\<sensor tilt (rad)\>\"", " ", "->", " ", 
        RowBox[{"Round", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"tests", "[", "#", "]"}], "[", "\"\<Cell\>\"", "]"}], 
           "[", "\"\<SensorTilt\>\"", "]"}], ",", " ", "0.0001"}], "]"}]}], ",",
        "\n", "    ", 
       RowBox[{"\"\<photons on sensor\>\"", " ", "->", " ", 
        RowBox[{"Length", "[", 
         RowBox[{
          RowBox[{"tests", "[", "#", "]"}], "[", "\"\<SensorHits\>\"", "]"}], 
         "]"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<ring radius Optica (mm)\>\"", " ", "->", " ", 
        RowBox[{"Round", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ringFit", "[", 
            RowBox[{
             RowBox[{"tests", "[", "#", "]"}], "[", "\"\<SensorHits\>\"", 
             "]"}], "]"}], "[", "\"\<Radius\>\"", "]"}], ",", " ", "0.001"}], 
         "]"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<ring radius model (mm)\>\"", " ", "->", " ", 
        RowBox[{"Round", "[", 
