 TagBox[GridBox[{
    {"\<\"wavelength (nm)\"\>", "\<\"n gas\"\>", "\<\"Cherenkov angle \
(mrad)\"\>", "\<\"ring radius Optica (mm)\"\>", "\<\"ring radius model (mm)\"\
\>"},
    {"250", "1.001403`", "52.95`", "9.073`", "9.08`"},
