            " ", "0.01"}], ",", " ", "\"\<aerogel outer face\>\"", ",", " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"#", " ", "-", " ", 
              RowBox[{"(", 
