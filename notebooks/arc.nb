Cell["\<\
Validation (2026-11-08). The tests below trace Cherenkov photons with Optica, \
one cell at a time, and compare the result with an independent geometric \
model written in plain Mathematica (reflection on the spherical mirror, \
intersection with the sensor plane, no aerogel). The adapter needed one fix \
for OpticaEM: Rotate[object, matrix] applies the transpose of the matrix (see \
place[] in ARCBarrelOptica.wl). Before that fix the mirrors were mirrored \
about the cell axis and the aerogel and sensor planes were tilted (0.029 rad \
in cell 1), so most photons missed the sensor window of the hit search.\
\>", "Text",ExpressionUUID->"ba379419-f7b3-4f4d-9667-a84124c31d8b"],

Cell[CellGroupData[{

Cell["Tools for the tests", "Subsection",ExpressionUUID->"5f0820db-4c5a-6340-8d70-25628f412c83"],

Cell["\<\
traceCell[n, rEm, \[Lambda], nPhot] traces with Optica, in cell n of row 1 \
only, a cone of nPhot Cherenkov photons (\[Beta] = 1, wavelength \[Lambda] in \
nm) emitted at the point at radius rEm (mm) on the cell axis, by a track \
coming from the interaction point. It returns the cell, the Cherenkov angle, \
the ray segments, the height of every segment end above the sensor front \
(along the sensor normal) and the photon hits on the sensor in sensor \
coordinates (e, v) in mm. geoCell[n, rEm, \[Lambda], nPhot] gives the same \
sensor hits from the geometric model. ringFit fits a circle (centre, radius, \
rms of the distances); maxDist is the largest distance between a model hit \
and the nearest Optica hit; surfaceOf says where the ray segments end.\
\>", "Text",ExpressionUUID->"8b156d15-d6cd-ea42-a13d-cb693e1f8723"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pts", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"Cases", "[", 
    RowBox[{"x", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"_", "?", "NumericQ"}]}], "}"}], ",", " ", "Infinity"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cellOf", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"SelectFirst", "[", 
    RowBox[{
     RowBox[{"b1", "[", "\"\<Cells\>\"", "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<SignedNumber\>\"", "]"}], " ", "==", " ", "n"}],
       " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"traceCell", "[", 
    RowBox[{"n_", ",", " ", 
     RowBox[{"rEm_", " ", ":", " ", "2000."}], ",", " ", 
     RowBox[{"lambda_", " ", ":", " ", "400."}], ",", " ", 
     RowBox[{"nPhot_", " ", ":", " ", "36"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cell", " ", "=", " ", 
        RowBox[{"cellOf", "[", "n", "]"}]}], ",", " ", "p", ",", " ", "th", ",",
        " ", "rays", ",", " ", "sysCell", ",", " ", "traced", ",", " ", 
       "ends"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"ARCToGlobal", "[", 
        RowBox[{"cell", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.", ",", " ", "0.", ",", " ", "rEm"}], "}"}]}], "]"}]}], ";",
       "\n", "  ", 
      RowBox[{"th", " ", "=", " ", 
       RowBox[{"ArcCos", "[", 
        RowBox[{"1", "/", 
         RowBox[{"ARCIndex", "[", 
          RowBox[{"\"\<Gas\>\"", ",", " ", "lambda"}], "]"}]}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"rays", " ", "=", " ", 
       RowBox[{"ARCOpticaRays", "[", 
        RowBox[{"p", ",", " ", 
         RowBox[{"ARCCherenkovCone", "[", 
          RowBox[{
           RowBox[{"Normalize", "[", "p", "]"}], ",", " ", "th", ",", " ", 
           "nPhot"}], "]"}], ",", " ", "lambda", ",", " ", "\"\<Gas\>\""}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"sysCell", " ", "=", " ", 
       RowBox[{"ARCOpticaSystem", "[", 
        RowBox[{
         RowBox[{"Append", "[", 
          RowBox[{"b1", ",", " ", 
           RowBox[{"\"\<Cells\>\"", " ", "->", " ", 
            RowBox[{"{", "cell", "}"}]}]}], "]"}], ",", " ", 
         RowBox[{"\"\<FullBoundaryModel\>\"", " ", "->", " ", "False"}]}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"traced", " ", "=", " ", 
       RowBox[{"PropagateSystem", "[", 
        RowBox[{"{", 
         RowBox[{"rays", ",", " ", "sysCell"}], "}"}], "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{"ends", " ", "=", " ", 
       RowBox[{"pts", "@", 
        RowBox[{"ReadRays", "[", 
         RowBox[{"traced", ",", " ", "RayEnd"}], "]"}]}]}], ";", "\n", "  ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Cell\>\"", " ", "->", " ", "cell"}], ",", " ", 
        RowBox[{"\"\<CherenkovAngle\>\"", " ", "->", " ", "th"}], ",", " ", 
        RowBox[{"\"\<Traced\>\"", " ", "->", " ", "traced"}], ",", "\n", 
        "    ", 
        RowBox[{"\"\<Segments\>\"", " ", "->", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pts", "@", 
             RowBox[{"ReadRays", "[", 
              RowBox[{"traced", ",", " ", "RayStart"}], "]"}]}], ",", " ", 
            "ends"}], "}"}], "]"}]}], ",", "\n", "    ", 
        RowBox[{"\"\<Heights\>\"", " ", "->", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ARCToLocal", "[", 
                RowBox[{"cell", ",", " ", "#"}], "]"}], " ", "-", " ", 
               RowBox[{"cell", "[", "\"\<SensorFront\>\"", "]"}]}], ")"}], 
             " ", ".", " ", 
             RowBox[{"cell", "[", "\"\<PlaneN\>\"", "]"}]}], " ", "&"}], " ", 
           "/@", " ", "ends"}], ")"}]}], ",", "\n", "    ", 
        RowBox[{"\"\<SensorHits\>\"", " ", "->", " ", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"d", " ", "=", " ", 
                 RowBox[{
                  RowBox[{"ARCToLocal", "[", 
                   RowBox[{"cell", ",", " ", "#"}], "]"}], " ", "-", " ", 
                  RowBox[{"cell", "[", "\"\<SensorFront\>\"", "]"}]}]}], 
                "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"d", " ", ".", " ", 
                  RowBox[{"cell", "[", "\"\<PlaneE\>\"", "]"}]}], ",", " ", 
                 RowBox[{"d", " ", ".", " ", 
                  RowBox[{"cell", "[", "\"\<PlaneV\>\"", "]"}]}], ",", " ", 
                 RowBox[{"d", " ", ".", " ", 
                  RowBox[{"cell", "[", "\"\<PlaneN\>\"", "]"}]}]}], "}"}]}], 
              "]"}], " ", "&"}], " ", "/@", " ", "ends"}], ",", "\n", 
           "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"e_", ",", " ", "v_", ",", " ", "h_"}], "}"}], " ", "/;",
              " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", "h", "]"}], " ", "<", " ", "0.01"}], " ", "&&",
               " ", 
              RowBox[{
               RowBox[{"Abs", "[", "e", "]"}], " ", "<=", " ", 
               RowBox[{
                RowBox[{"cell", "[", "\"\<SensorHalfSizes\>\"", "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], " ", "&&", " ", 
              RowBox[{
               RowBox[{"Abs", "[", "v", "]"}], " ", "<=", " ", 
               RowBox[{
                RowBox[{"cell", "[", "\"\<SensorHalfSizes\>\"", "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}]}], " ", ":>", " ", 
            RowBox[{"{", 
             RowBox[{"e", ",", " ", "v"}], "}"}]}]}], "]"}]}]}], "|>"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"geoCell", "[", 
    RowBox[{"n_", ",", " ", 
     RowBox[{"rEm_", " ", ":", " ", "2000."}], ",", " ", 
     RowBox[{"lambda_", " ", ":", " ", "400."}], ",", " ", 
     RowBox[{"nPhot_", " ", ":", " ", "36"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cell", " ", "=", " ", 
        RowBox[{"cellOf", "[", "n", "]"}]}], ",", " ", "pL", ",", " ", "th", ",",
        " ", "mc", ",", " ", "rad", ",", " ", "sf"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"pL", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"0.", ",", " ", "0.", ",", " ", "rEm"}], "}"}]}], ";", " ", 
      RowBox[{"th", " ", "=", " ", 
       RowBox[{"ArcCos", "[", 
        RowBox[{"1", "/", 
         RowBox[{"ARCIndex", "[", 
          RowBox[{"\"\<Gas\>\"", ",", " ", "lambda"}], "]"}]}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"mc", " ", "=", " ", 
       RowBox[{"cell", "[", "\"\<MirrorCentre\>\"", "]"}]}], ";", " ", 
      RowBox[{"rad", " ", "=", " ", 
       RowBox[{"cell", "[", "\"\<MirrorInnerRadius\>\"", "]"}]}], ";", " ", 
      RowBox[{"sf", " ", "=", " ", 
       RowBox[{"cell", "[", "\"\<SensorFront\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"d", ",", " ", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"q", " ", "=", " ", 
               RowBox[{"pL", " ", "-", " ", "mc"}]}], ",", " ", "b", ",", " ",
               "m", ",", " ", "nrm", ",", " ", "r", ",", " ", "h"}], "}"}], ",",
             "\n", "      ", 
            RowBox[{
             RowBox[{"b", " ", "=", " ", 
              RowBox[{"q", " ", ".", " ", "d"}]}], ";", " ", 
             RowBox[{"m", " ", "=", " ", 
              RowBox[{"pL", " ", "+", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "b"}], " ", "+", " ", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{
                    RowBox[{"b", "^", "2"}], " ", "-", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"q", " ", ".", " ", "q"}], " ", "-", " ", 
                    RowBox[{"rad", "^", "2"}]}], ")"}]}], "]"}]}], ")"}], " ",
                 "d"}]}]}], ";", "\n", "      ", 
             RowBox[{"nrm", " ", "=", " ", 
              RowBox[{"Normalize", "[", 
               RowBox[{"m", " ", "-", " ", "mc"}], "]"}]}], ";", " ", 
             RowBox[{"r", " ", "=", " ", 
              RowBox[{"d", " ", "-", " ", 
               RowBox[{"2", " ", 
                RowBox[{"(", 
                 RowBox[{"d", " ", ".", " ", "nrm"}], ")"}], " ", "nrm"}]}]}],
              ";", "\n", "      ", 
             RowBox[{"h", " ", "=", " ", 
              RowBox[{"m", " ", "+", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"sf", " ", "-", " ", "m"}], ")"}], " ", ".", " ", 
                   RowBox[{"cell", "[", "\"\<PlaneN\>\"", "]"}]}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"r", " ", ".", " ", 
                   RowBox[{"cell", "[", "\"\<PlaneN\>\"", "]"}]}], ")"}]}], " ",
                 "r"}]}]}], ";", "\n", "      ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"h", " ", "-", " ", "sf"}], ")"}], " ", ".", " ", 
                RowBox[{"cell", "[", "\"\<PlaneE\>\"", "]"}]}], ",", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"h", " ", "-", " ", "sf"}], ")"}], " ", ".", " ", 
                RowBox[{"cell", "[", "\"\<PlaneV\>\"", "]"}]}]}], "}"}]}]}], 
           "]"}]}], "]"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"cell", "[", "\"\<Rotation\>\"", "]"}], "]"}], " ", ".", 
           " ", "#"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"ARCCherenkovCone", "[", 
          RowBox[{
           RowBox[{"Normalize", "[", 
            RowBox[{"ARCToGlobal", "[", 
             RowBox[{"cell", ",", " ", "pL"}], "]"}], "]"}], ",", " ", "th", ",",
            " ", "nPhot"}], "]"}]}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ringFit", "[", "h_List", "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "h", "]"}], " ", "<", " ", "3"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Centre\>\"", " ", "->", " ", 
        RowBox[{"Missing", "[", "]"}]}], ",", " ", 
       RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
        RowBox[{"Missing", "[", "]"}]}], ",", " ", 
       RowBox[{"\"\<RMS\>\"", " ", "->", " ", 
        RowBox[{"Missing", "[", "]"}]}]}], "|>"}], ",", "\n", "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"c0", " ", "=", " ", 
          RowBox[{"Mean", "[", "h", "]"}]}], ",", " ", "r"}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"r", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{"#", " ", "-", " ", "c0"}], "]"}], " ", "&"}], " ", "/@", 
          " ", "h"}]}], ";", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Centre\>\"", " ", "->", " ", "c0"}], ",", " ", 
          RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
           RowBox[{"Mean", "[", "r", "]"}]}], ",", " ", 
          RowBox[{"\"\<RMS\>\"", " ", "->", " ", 
           RowBox[{"StandardDeviation", "[", "r", "]"}]}]}], "|>"}]}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxDist", "[", 
    RowBox[{"model_List", ",", " ", "optica_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"optica", " ", "===", " ", 
      RowBox[{"{", "}"}]}], ",", " ", 
     RowBox[{"Missing", "[", "]"}], ",", " ", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"g", " ", "-", " ", "#"}], "]"}], " ", "&"}], " ", "/@", 
           " ", "optica"}], "]"}]}], "]"}], " ", "/@", " ", "model"}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"surfaceOf", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cell", " ", "=", " ", 
        RowBox[{"t", "[", "\"\<Cell\>\"", "]"}]}], ",", " ", "hA", ",", " ", 
       "hW"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"hA", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"cell", "[", "\"\<AerogelCentre\>\"", "]"}], " ", "-", " ", 
          RowBox[{"cell", "[", "\"\<SensorFront\>\"", "]"}]}], ")"}], " ", ".",
         " ", 
        RowBox[{"cell", "[", "\"\<PlaneN\>\"", "]"}]}]}], ";", " ", 
      RowBox[{"hW", " ", "=", " ", 
