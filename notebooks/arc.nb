           RowBox[{
            RowBox[{"Abs", "[", "#", "]"}], " ", "<", " ", "0.01"}], ",", 
           " ", "\"\<sensor front\>\"", ",", " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"#", " ", "-", " ", 
              RowBox[{"(", 
