Cell[CellGroupData[{

Cell["\<\
Test 4: gaps between sensor, aerogel and cooling plates (geometry, no Optica)\
\>", "Subsection",ExpressionUUID->"8691be8e-6d72-2942-bf93-6b23a456bf75"],

Cell["\<\
The ARC source sets a safe distance of 262 \[Micro]m between the sensor and \
the aerogel plate and between the sensor and the cooling plate \
(safe_distance_from_sensor). In ARCBarrel.wl the aerogel and cooling centres \
are offset from the sensor centre along the radial axis of the cell, while \
the plates are oriented like the tilted sensor: the gaps are then 262 \
\[Micro]m only where the sensor is not tilted, and in cells \[PlusMinus]17 \
(tilt 0.40 rad) the aerogel plate overlaps the sensor by 0.24 mm. TO CHECK \
against ARC_barrel_geo.cpp: if the offsets are applied there in the sensor \
frame, ARCBarrel.wl should do the same.\
\>", "Text",ExpressionUUID->"3fcfa2de-5654-4146-b4e3-ea403b1e4167"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<cell\>\"", " ", "->", " ", 
       RowBox[{"#", "[", "\"\<SignedNumber\>\"", "]"}]}], ",", " ", 
      RowBox[{"\"\<sensor tilt (rad)\>\"", " ", "->", " ", 
       RowBox[{"Round", "[", 
        RowBox[{
         RowBox[{"#", "[", "\"\<SensorTilt\>\"", "]"}], ",", " ", "0.0001"}], 
        "]"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<gap sensor-aerogel (mm)\>\"", " ", "->", " ", 
       RowBox[{"Round", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", "\"\<AerogelCentre\>\"", "]"}], " ", "-", " ", 
             RowBox[{"#", "[", "\"\<SensorFront\>\"", "]"}]}], ")"}], " ", ".",
            " ", 
           RowBox[{"#", "[", "\"\<PlaneN\>\"", "]"}]}], " ", "-", " ", 
          RowBox[{"#", "[", "\"\<AerogelHalfThickness\>\"", "]"}]}], ",", " ",
          "0.001"}], "]"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<gap sensor-cooling (mm)\>\"", " ", "->", " ", 
       RowBox[{"Round", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", "\"\<SensorFront\>\"", "]"}], " ", "-", " ", 
             RowBox[{"2", " ", 
              RowBox[{
               RowBox[{"#", "[", "\"\<SensorHalfSizes\>\"", "]"}], "[", 
               RowBox[{"[", "3", "]"}], "]"}], " ", 
              RowBox[{"#", "[", "\"\<PlaneN\>\"", "]"}]}], " ", "-", " ", 
             RowBox[{"#", "[", "\"\<CoolingCentre\>\"", "]"}]}], ")"}], " ", ".",
            " ", 
           RowBox[{"#", "[", "\"\<PlaneN\>\"", "]"}]}], " ", "-", " ", 
          RowBox[{"#", "[", "\"\<CoolingHalfThickness\>\"", "]"}]}], ",", " ",
          "0.001"}], "]"}]}]}], "|>"}], " ", "&"}], " ", "/@", " ", 
   RowBox[{"b1", "[", "\"\<Cells\>\"", "]"}]}], "]"}]], "Input",
 CellLabel->
