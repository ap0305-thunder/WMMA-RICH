Cell[CellGroupData[{

Cell["Test 3: chromatic dispersion of the gas radiator (cell 1)", "Subsection",ExpressionUUID->"af03d93d-2d1e-6c46-885a-4b7fa74509d2"],

Cell["\<\
The Cherenkov angle depends on the refractive index of C4F10, n(\[Lambda]), \
so photons of different wavelength make rings of different radius on the \
sensor: this spread is the chromatic error of the radiator. Here cell 1 is \
traced at 250, 400 and 650 nm (ARCIndex interpolates the refractive-index \
table of the ARC XML).\
\>", "Text",ExpressionUUID->"6ca5bb7a-288e-5b41-a3f1-9dec23c13b2b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"lams", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"250.", ",", " ", "400.", ",", " ", "650."}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"chrom", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"traceCell", "[", 
       RowBox[{"1", ",", " ", "2000.", ",", " ", "#"}], "]"}], " ", "&"}], ",",
      " ", "lams"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Round", "[", "#", "]"}], ",", " ", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{"ARCIndex", "[", 
            RowBox[{"\"\<Gas\>\"", ",", " ", "#"}], "]"}], ",", " ", 
           "0.000001"}], "]"}], ",", " ", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{"1000", " ", 
            RowBox[{
             RowBox[{"chrom", "[", "#", "]"}], "[", "\"\<CherenkovAngle\>\"", 
             "]"}]}], ",", " ", "0.01"}], "]"}], ",", "\n", "     ", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ringFit", "[", 
             RowBox[{
              RowBox[{"chrom", "[", "#", "]"}], "[", "\"\<SensorHits\>\"", 
              "]"}], "]"}], "[", "\"\<Radius\>\"", "]"}], ",", " ", "0.001"}],
           "]"}], ",", " ", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ringFit", "[", 
             RowBox[{"geoCell", "[", 
              RowBox[{"1", ",", " ", "2000.", ",", " ", "#"}], "]"}], "]"}], 
            "[", "\"\<Radius\>\"", "]"}], ",", " ", "0.001"}], "]"}]}], "}"}],
        " ", "&"}], " ", "/@", " ", "lams"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<wavelength (nm)\>\"", ",", " ", "\"\<n gas\>\"", ",", 
       " ", "\"\<Cherenkov angle (mrad)\>\"", ",", 
       " ", "\"\<ring radius Optica (mm)\>\"", ",", 
       " ", "\"\<ring radius model (mm)\>\""}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}], "Input",
 CellLabel->
  "11/8/26 18:38:23 \
In[29]:=",ExpressionUUID->"0ae172a6-290e-b744-a6f2-3f8372f3f347"],

