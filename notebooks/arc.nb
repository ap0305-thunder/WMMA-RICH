In[18]:=",ExpressionUUID->"b9a565e3-1e38-1f4a-9e8f-38bb39c33135"],

Cell["\<\
3D view: geometry of cell 1 (mirror in gold, sensor in red, cell walls in \
grey) and the 36 traced photons (blue): up to the mirror, then back down \
through the aerogel plate to the sensor.\
\>", "Text",ExpressionUUID->"2a821ed1-a7b5-ae4b-8878-b10a192006b6"],

