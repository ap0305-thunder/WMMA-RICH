            ExpressionUUID -> "116b1f50-14b3-499e-8c6a-b86c6e29be2c"]}, 
          Closed]]}, Closed]], Cell[CellGroupData[
       {Cell[">>> START INITIALIZATION", "Subtitle", InitializationCell -> 
          True, CellTags -> {"INIT", "i:3", "i:4"}, ExpressionUUID -> 
          "c02cf13a-82a2-fe44-84eb-81bf8d1c8674"], 
        Cell[CellGroupData[{Cell["INIT", "Subsubtitle", InitializationCell -> 
