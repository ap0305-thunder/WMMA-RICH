Notebook[{
Cell["\<\
RICH project notebook: RICH. Role: package-bootstrap. Runtime source: \
src/RICH.wl.\
\>", "Text",
 Background->RGBColor[0.92, 0.97, 1.],
 CellTags->
  "RICHNotebookHeader",ExpressionUUID->"8d21ab6d-580a-4e44-92f2-0fa53c945227"],

Cell[CellGroupData[{

Cell["---... SETUP", "Title",
 InitializationCell->False,
 Background->RGBColor[0.88, 1, 0.88],
 CellTags->
  "RICHNotebookSetup",ExpressionUUID->"8f2431df-d6a8-8f45-b195-b05f603a23aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "notebook", ",", "notebookDirectory", ",", "projectCase", ",", "loader", ",",
      "loadResult"}], "}"}], ",", 
   RowBox[{
    RowBox[{"notebook", "=", 
     RowBox[{"EvaluationNotebook", "[", "]"}]}], ";", 
    RowBox[{"projectCase", "=", 
     RowBox[{"CurrentValue", "[", 
      RowBox[{"notebook", ",", 
       RowBox[{"{", 
        RowBox[{"TaggingRules", ",", "\"\<RICHProjectCase\>\""}], "}"}]}], 
      "]"}]}], ";", 
    RowBox[{"notebookDirectory", "=", 
     RowBox[{"Quiet", "[", 
      RowBox[{"Check", "[", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "notebook", "]"}], ",", "$Failed"}],
        "]"}], "]"}]}], ";", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"StringQ", "[", "notebookDirectory", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<RICH bootstrap failed: save the notebook inside the \
project's \>\"", 
         ",", "\"\<notebooks directory before evaluating initialization \
cells.\>\""}], "]"}], ";", 
       RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
    RowBox[{"loader", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ParentDirectory", "[", "notebookDirectory", "]"}], 
        ",", "\"\<src\>\"", ",", "\"\<LoadProject.wl\>\""}], "}"}], "]"}]}], ";", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"FileExistsQ", "[", "loader", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<RICH bootstrap failed: project loader not found at \>\"",
          ",", "loader"}], "]"}], ";", 
       RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
    RowBox[{"loadResult", "=", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"$RICHProjectSkipAutoLoad", "=", "True"}], "}"}], ",", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"Get", "[", "loader", "]"}], ",", "$Failed"}], "]"}]}], 
      "]"}]}], ";", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"loadResult", "===", "$Failed"}], ",", 
      RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
    RowBox[{"RICHNotebookBootstrap", "[", "projectCase", "]"}]}]}], 
  "]"}]], "Input",
 InitializationCell->True,
 CellTags->{"RICHUniversalBootstrap", "i:1"},
 CellLabel->
  "9/6/26 16:20:13 \
In[1]:=",ExpressionUUID->"6423df0d-41a7-af4d-a940-ba5b0ac34565"],

